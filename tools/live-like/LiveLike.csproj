<Project Sdk="Microsoft.NET.Sdk">

  <!-- D-88: builds the live-like cast and its history in the LOCAL database through the application, hosted in-process.
       Usage: see Program.cs (stop run-demo.ps1 first). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LiveLike</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- the alias tells the web app's Program apart from this tool's own -->
    <ProjectReference Include="..\..\TOP4HONEYCHAINS\TOP4HoneyChains.Web\TOP4HoneyChains.Web.csproj" Aliases="global,web" />
  </ItemGroup>

  <ItemGroup>
    <None Include="cast.json" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
