@using TOP4HoneyChains.Web.Models.Entities
@using TOP4HoneyChains.Web.Services.OrgModel
@{
    ViewData["Title"] = L["Cust.Ship"];
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var batch = (FinalHoneyProduction)ViewBag.Batch;
    var holding = (CustodyService.Holding)ViewBag.Holding;
    var receivers = ViewBag.Receivers as List<Organization> ?? new();
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">@L["Cust.Ship"]: @batch.FinalHoneyProductionTitle</h4>
                    <p class="card-title-desc">@L["Cust.ShipHelp"] <strong id="available">@holding.Available.ToString("0.##")</strong> kg</p>
                    <form asp-action="Create" method="post" id="ship-form" class="field-form">
                        <input type="hidden" name="batchId" value="@batch.FinalHoneyProductionId" />
                        <div class="row">
                            <div class="col-md-5 mb-3">
                                <label class="form-label required" for="toOrgId">@L["Cust.To"]</label>
                                <select name="toOrgId" id="toOrgId" class="form-select">
                                    @foreach (var o in receivers) { <option value="@o.OrgId">@o.DisplayName</option> }
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label required" for="quantity">@L["Org.Amount"]</label>
                                <input name="quantity" id="quantity" type="text" inputmode="decimal" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label" for="note">@L["Cust.Note"]</label>
                                <input name="note" id="note" class="form-control" maxlength="500" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">@L["Cust.Ship"]</button>
                        <a asp-action="Index" class="btn btn-secondary">@L["Org.Cancel"]</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
