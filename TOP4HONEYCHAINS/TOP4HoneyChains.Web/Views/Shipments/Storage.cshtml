@using TOP4HoneyChains.Web.Models.Entities
@{
    ViewData["Title"] = Ref.Code("CCP 10");
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var batch = ViewBag.Batch as FinalHoneyProduction;
    var holder = ViewBag.Holder as Organization;
    var record = ViewBag.Record as HolderStorageRecord;
    var parameters = ViewBag.Parameters as List<CriticalControlPointParameter> ?? new();
    var access = (TOP4HoneyChains.Web.Controllers.ShipmentsController.StorageAccess)ViewBag.Access;
    bool canEnter = access.Enter;
    bool canApprove = access.Approve;
    string? enterDenied = access.EnterDenied;
    string? approveDenied = access.ApproveDenied;
    HolderStorageValue? ValueOf(int id) => record?.Values.FirstOrDefault(v => v.ParameterId == id);
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">CCP 10 – @L["Cust.Storage"]: @batch?.FinalHoneyProductionTitle</h4>
                    <p class="card-title-desc">@L["Cust.StorageHelp"] <strong>@holder?.DisplayName</strong> · @L["Cust.Held"]: <strong id="held">@(((decimal)ViewBag.Held).ToString("0.##"))</strong> kg</p>
                    @if (!canEnter && enterDenied != null)
                    {
                        <div class="alert alert-secondary" id="storage-read-only">@L["Ccp.ReadOnly"]: @Msg.T(enterDenied)</div>
                    }
                    <form asp-action="Storage" method="post" id="storage-form" class="field-form">
                        <input type="hidden" name="batchId" value="@batch?.FinalHoneyProductionId" />
                        <div class="table-responsive"><table class="table table-sm">
                            <thead><tr><th>@L["Corr.Parameter"]</th><th>@L["Cust.Value"]</th><th>@L["Cust.Limit"]</th></tr></thead>
                            <tbody>
                                @foreach (var p in parameters)
                                {
                                    var v = ValueOf(p.ParameterId);
                                    <tr>
                                        <td>@Limits.Label(p)</td>
                                        <td>
                                            @if (p.DataType == CcpDataType.YesNo)
                                            {
                                                <select name="values[@p.ParameterId]" class="form-select form-select-sm" disabled="@(!canEnter)">
                                                    <option value=""></option>
                                                    <option value="Yes" selected="@(v?.MeasuredTextValue == "Yes")">@L["Yes"]</option>
                                                    <option value="No" selected="@(v?.MeasuredTextValue == "No")">@L["No"]</option>
                                                </select>
                                            }
                                            else
                                            {
                                                <input name="values[@p.ParameterId]" class="form-control form-control-sm" value="@(v?.MeasuredNumericValue?.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) ?? v?.MeasuredTextValue)" readonly="@(!canEnter)" maxlength="100" />
                                            }
                                        </td>
                                        <td class="small">@Limits.Describe(p) @if (v?.IsInRange == false) { <span class="st-pill st-outlimit"><i class="mdi mdi-alert-outline" aria-hidden="true"></i><span>@L["Out of limit"]</span></span> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                        @if (canEnter)
                        {
                            <button type="submit" class="btn btn-success">@L["Org.Save"]</button>
                        }
                    </form>
                </div>
            </div>

            <div class="card" id="storage-approval">
                <div class="card-body">
                    <h2 class="h6">@L["Ccp.ApprovalTitle"]</h2>
                    @if (record != null)
                    {
                        <partial name="_RecordStrip" model="@(new TOP4HoneyChains.Web.Models.ViewModels.RecordStrip(record.RecordedByUserId, record.RecordedAt, record.ApprovedByUserId, record.ApprovedAt, record.SelfApproved, IdsNotNames: true, TimesAreUtc: true))" />
                    }
                    @if (record?.ApprovedAt != null)
                    {
                        <partial name="_StatusPill" model="@(new TOP4HoneyChains.Web.Models.ViewModels.StatusPill(TOP4HoneyChains.Web.Models.ViewModels.StatusPill.Approved, L["Ccp.Approved"].Value, "storage-approved", Fresh: TempData["JustApproved"] as bool? == true))" />
                    }
                    else
                    {
                        <div class="text-muted" id="storage-state">@(record?.Status == AssignmentStatusIds.Submitted ? L["Cust.Submitted"] : L["Ccp.NotApproved"])</div>
                        @if (canApprove && record?.Status == AssignmentStatusIds.Submitted)
                        {
                            <form asp-action="ApproveStorage" method="post" class="mt-2" id="storage-approve-form">
                                <input type="hidden" name="batchId" value="@batch?.FinalHoneyProductionId" />
                                <input type="hidden" name="confirmOutOfLimit" value="false" />
                                <button type="submit" class="btn btn-sm btn-success" id="approve-storage">@L["Ccp.Approve"]</button>
                                <small class="text-muted ms-2 approve-note">@L["Ccp.ApproveNote"]</small>
                            </form>
                                // D-64: the values outside their limits, confirmed in-page before approving
                                var outOfLimit = record!.Values.Where(v => v.IsInRange == false)
                                    .Select(v => (Value: v, Parameter: parameters.FirstOrDefault(p => p.ParameterId == v.ParameterId)))
                                    .Select(x => new TOP4HoneyChains.Web.Models.ViewModels.OutOfLimitItem(x.Value.ParameterId, x.Parameter?.ParameterName, x.Value.MeasuredNumericValue,
                                        x.Value.MeasuredTextValue, x.Parameter?.ParameterUnit, x.Parameter != null ? Limits.Describe(x.Parameter) : x.Value.AppliedLimit, x.Parameter?.LimitVerified == true)).ToList();
                            <partial name="_OutOfLimitConfirm" model="@(new TOP4HoneyChains.Web.Models.ViewModels.OutOfLimitConfirm("storage-approve-form", "approve-storage", outOfLimit))" />
                        }
                        else if (!canApprove && approveDenied != null)
                        {
                            <div class="small text-muted mt-1">@Msg.T(approveDenied)</div>
                        }
                    }
                </div>
            </div>
            <a asp-action="Index" class="btn btn-link app-back"><i class="mdi mdi-arrow-left" aria-hidden="true"></i> @L["Org.Back"]</a>
        </div>
    </div>
</body>
