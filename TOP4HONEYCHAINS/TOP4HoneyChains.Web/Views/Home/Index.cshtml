@model TOP4HoneyChains.Web.Models.ViewModels.LandingViewModel
@using TOP4HoneyChains.Web.Services
@{
    // Public landing page (D-65, D-71). Styles: wwwroot/css/brand.css + landing.css + honey-mark.css; motion: wwwroot/js/hero-comb.js
    // (the hero honeycomb), landing.js (language switch, reveals, counters, phone) and honey-mark.js; rules in docs/brand/MOTION.md.
    // No external requests: fonts, scripts and images are served by the app. Counters are aggregates only (no personal data).
    Layout = null;
    var culture = System.Globalization.CultureInfo.CurrentUICulture;
    var lang = culture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var languages = new[] { ("tr", "Türkçe"), ("en", "English"), ("es", "Español"), ("pl", "Polski"), ("lv", "Latviešu") };
    var tagline = L["Trustable and Sustainable Open Platform for Smart Honey Value Chains"].Value;
    var description = L["Land.MetaDescription"].Value;
    var baseUrl = Model.PublicBaseUrl?.TrimEnd('/');
    var stations = new[] { L["Land.Station.Apiary"].Value, L["Land.Station.Delivery"].Value, L["Land.Station.Lab"].Value, L["Land.Station.Processing"].Value, L["Land.Station.Shelf"].Value };
    var steps = new[]
    {
        (Title: L["Land.Step1.Title"].Value, Tag: L["Land.Step1.Tag"].Value, Text: L["Land.Step1.Text"].Value, Icon: "apiary"),
        (Title: L["Land.Step2.Title"].Value, Tag: L["Land.Step2.Tag"].Value, Text: L["Land.Step2.Text"].Value, Icon: "delivery"),
        (Title: L["Land.Step3.Title"].Value, Tag: L["Land.Step3.Tag"].Value, Text: L["Land.Step3.Text"].Value, Icon: "lab"),
        (Title: L["Land.Step4.Title"].Value, Tag: L["Land.Step4.Tag"].Value, Text: L["Land.Step4.Text"].Value, Icon: "processing"),
        (Title: L["Land.Step5.Title"].Value, Tag: L["Land.Step5.Tag"].Value, Text: L["Land.Step5.Text"].Value, Icon: "shelf")
    };
    var trust = new[]
    {
        (Title: L["Land.Trust.FourEyes.Title"].Value, Text: L["Land.Trust.FourEyes.Text"].Value, Icon: "foureyes"),
        (Title: L["Land.Trust.Audit.Title"].Value, Text: L["Land.Trust.Audit.Text"].Value, Icon: "chain"),
        (Title: L["Land.Trust.Orgs.Title"].Value, Text: L["Land.Trust.Orgs.Text"].Value, Icon: "verified"),
        (Title: L["Land.Trust.Verify.Title"].Value, Text: L["Land.Trust.Verify.Text"].Value, Icon: "report")
    };
    var audiences = new[]
    {
        (Title: L["Land.Who.Beekeepers.Title"].Value, Text: L["Land.Who.Beekeepers.Text"].Value, Icon: "apiary"),
        (Title: L["Land.Who.Processors.Title"].Value, Text: L["Land.Who.Processors.Text"].Value, Icon: "processing"),
        (Title: L["Land.Who.Labs.Title"].Value, Text: L["Land.Who.Labs.Text"].Value, Icon: "lab"),
        (Title: L["Land.Who.Retailers.Title"].Value, Text: L["Land.Who.Retailers.Text"].Value, Icon: "shelf"),
        (Title: L["Land.Who.Consumers.Title"].Value, Text: L["Land.Who.Consumers.Text"].Value, Icon: "qr")
    };
    var partners = new[]
    {
        ("Boğaziçi University", L["Türkiye"].Value), ("Işık University", L["Türkiye"].Value), ("Apiculture Research Institute", L["Türkiye"].Value),
        ("Instituto Nacional de Tecnología Agropecuaria (INTA)", L["Argentina"].Value), ("NEXCO S.A", L["Argentina"].Value),
        ("CNORTEGRANDE Cooperative", L["Argentina"].Value), ("Alimentos Naturales Natural Foods S.A.", L["Argentina"].Value),
        ("University of Economics in Katowice", L["Poland"].Value), ("Latvia University of Life Sciences and Technologies", L["Latvia"].Value)
    };
    var heroLines = new[] { L["Land.Hero.Line1"].Value, L["Land.Hero.Line2"].Value, L["Land.Hero.Line3"].Value, L["Land.Hero.Line4"].Value, L["Land.Hero.Line5"].Value };
    var heroSpots = new[] { (16, 76), (33, 26), (50, 76), (67, 26), (84, 76) };   // medallion centres (% of the chain area) on wide screens
    var currentName = languages.First(l => l.Item1 == lang).Item2;
    var storyUrl = Model.DemoQr != null ? $"/honeystory/{Model.DemoQr.Value.ToString().ToUpperInvariant()}" : null;
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>TOP4HoneyChains · @tagline</title>
    <meta name="description" content="@description">
    <meta name="theme-color" content="#FFFFFF">
    @if (baseUrl != null)
    {
        <link rel="canonical" href="@baseUrl/">
        <meta property="og:url" content="@baseUrl/">
    }
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="TOP4HoneyChains">
    <meta property="og:title" content="TOP4HoneyChains · @tagline">
    <meta property="og:description" content="@description">
    <meta property="og:locale" content="@culture.Name.Replace('-', '_')">
    @if (Model.OgImage?.Jpeg != null)
    {
        <meta property="og:image" content="@(baseUrl + Model.OgImage.Jpeg)">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:type" content="image/jpeg">
        <meta property="og:image:alt" content="@L["Land.OgImageAlt"]">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="TOP4HoneyChains · @tagline">
        <meta name="twitter:description" content="@description">
        <meta name="twitter:image" content="@(baseUrl + Model.OgImage.Jpeg)">
        <meta name="twitter:image:alt" content="@L["Land.OgImageAlt"]">
    }
    <partial name="~/Views/Shared/_Favicons.cshtml" />
    <link rel="preload" href="~/fonts/bricolage-grotesque/bricolage-grotesque-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="~/fonts/instrument-sans/instrument-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link href="~/css/brand.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/landing.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/honey-mark.css" rel="stylesheet" asp-append-version="true">
    <script>document.documentElement.classList.add('js');</script>
</head>
<body class="ld">
    <a class="ld-skip b-btn b-btn-ink" href="#main">@L["Land.SkipToContent"]</a>

    <header class="ld-top" id="top">
        <div class="ld-wrap ld-top-in">
            <a class="ld-brand b-link th-logo-trigger" href="/" aria-label="TOP4HoneyChains">
                <honey-mark size="40" class="b-brand-mark" /><img class="b-logo b-brand-word" src="~/img/brand/top4-wordmark-w3.svg" alt="" width="177" height="13">
            </a>
            <nav class="ld-nav" aria-label="TOP4HoneyChains">
                <a class="b-link" href="#chain">@L["Land.Nav.Chain"]</a>
                <a class="b-link" href="#trust">@L["Land.Nav.Trust"]</a>
                <a class="b-link" href="#for-whom">@L["Land.Nav.ForWhom"]</a>
                <a class="b-link" href="#story">@L["Land.Nav.Story"]</a>
            </nav>
            <nav class="ld-lang" aria-label="@L["Language"]" data-lang-switch>
                <span class="ld-lang-thumb" aria-hidden="true"></span>
                <span class="ld-lang-globe"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.8 3 2.8 15 0 18M12 3c-2.8 3-2.8 15 0 18"/></svg></span>
                @foreach (var (code, name) in languages)
                {
                    <a class="ld-lang-opt" href="@Url.Action("SetLanguage", "Home", new { culture = code, returnUrl })" lang="@code" hreflang="@code" aria-label="@name" data-name="@name" aria-current="@(code == lang ? "true" : null)">@code.ToUpperInvariant()</a>
                }
            </nav>
            <div class="ld-lang-mini" data-lang-mini>
                <button type="button" class="ld-lang-btn" aria-expanded="false" aria-controls="lang-pop" aria-label="@string.Format(L["Land.Lang.Current"].Value, currentName)"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.8 3 2.8 15 0 18M12 3c-2.8 3-2.8 15 0 18"/></svg><span>@lang.ToUpperInvariant()</span></button>
                <div class="ld-lang-pop" id="lang-pop" hidden>
                    @foreach (var (code, name) in languages)
                    {
                        <a href="@Url.Action("SetLanguage", "Home", new { culture = code, returnUrl })" lang="@code" hreflang="@code" aria-current="@(code == lang ? "true" : null)"><span class="ld-lang-hex" aria-hidden="true">@code.ToUpperInvariant()</span>@name</a>
                    }
                </div>
            </div>
            <a class="b-btn b-btn-honey ld-top-signin ld-shine" href="/Account/Login">@L["Land.SignIn"]</a>
        </div>
    </header>

    <main id="main">
        @* 1. hero: the live honeycomb behind the copy and the five-step chain (hero-comb.js) *@
        <section class="ld-hero" data-hero aria-labelledby="hero-title">
            <div class="ld-hero-rays" aria-hidden="true"></div>
            <canvas class="ld-hcomb" data-hero-comb aria-hidden="true"></canvas>
            <div class="ld-wrap ld-hero-in">
                <div class="ld-hcopy">
                    <p class="ld-kicker" data-comb-calm>@L["Land.HeroKicker"]</p>
                    <div class="ld-title-row">
                        <button type="button" class="ld-hero-mark th-logo-trigger" data-hm-click aria-label="@L["Land.PlayBee"]"><honey-mark mode="once" size="110" /></button>
                        <h1 id="hero-title" class="ld-hero-title" data-comb-calm><span class="b-visually-hidden">TOP4HoneyChains</span><span class="ld-wm" aria-hidden="true"><img src="~/img/brand/top4-wordmark-w3.svg" alt="" width="620" height="46"><span class="ld-wm-sweep"><i></i></span></span></h1>
                    </div>
                    <p class="ld-hero-tagline" data-comb-calm>@tagline</p>
                    <p class="ld-hero-lead" data-comb-calm>@L["Land.HeroLead"]</p>
                    <div class="ld-hero-actions">
                        <a class="b-btn b-btn-honey ld-shine" href="/Account/Login">@L["Land.SignIn"]</a>
                        @if (Model.OrgModel)
                        {
                            <a class="b-btn b-btn-ghost ld-arrow" href="/verify-report">@L["Land.VerifyReport"]<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                        }
                    </div>
                    <p class="ld-consumer" data-comb-calm>
                        <span class="ld-qr-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4"/><rect x="8" y="8" width="3" height="3"/><rect x="13" y="8" width="3" height="3"/><rect x="8" y="13" width="3" height="3"/><path d="M13 13h3v3"/></svg><i></i></span>
                        <span>@L["Land.Consumer"]</span>
                    </p>
                </div>
                <ol class="ld-hchain" aria-label="@L["Land.Hero.ChainLabel"]">
                    @for (var i = 0; i < 5; i++)
                    {
                        var image = Model.Steps.Count > i ? Model.Steps[i] : null;
                        <li class="ld-hnode @(i % 2 == 1 ? "is-up" : "")" style="--x: @(heroSpots[i].Item1)%; --y: @(heroSpots[i].Item2)%">
                            <div class="ld-hx">
                                <span class="ld-hglow" aria-hidden="true"></span>
                                @if (image?.Exists == true)
                                {
                                    <picture>
                                        @if (image.Avif?.Count > 0)
                                        {
                                            <source type="image/avif" srcset="@image.AvifSrcSet" sizes="128px">
                                        }
                                        @if (image.WebP.Count > 0)
                                        {
                                            <source type="image/webp" srcset="@image.WebPSrcSet" sizes="128px">
                                        }
                                        <img src="@image.Jpeg" alt="" width="128" height="148" loading="lazy" decoding="async">
                                    </picture>
                                }
                                else
                                {
                                    <span class="ld-hx-icon" aria-hidden="true"><partial name="_LandingIcon" model="@steps[i].Icon" /></span>
                                }
                                <span class="ld-hno" aria-hidden="true">@(i + 1)</span>
                            </div>
                            <p class="ld-hcap"><b>@stations[i]</b><small>@heroLines[i]</small></p>
                        </li>
                    }
                </ol>
            </div>
            <a class="ld-scroll b-link" href="#chain"><img class="ld-scroll-bee" src="~/img/brand/top4-mark-small.svg" alt="" width="34" height="30"><span>@L["Land.ScrollHint"]</span></a>
        </section>

        @if (Model.Stats.Any)
        {
            <section class="ld-stats" aria-label="@L["Land.Stats.Title"]">
                <div class="ld-wrap ld-stats-in">
                    <p class="ld-kicker">@L["Land.Stats.Title"]</p>
                    <dl class="ld-stats-list">
                        @foreach (var (count, label, id) in new[] { (Model.Stats.FinalizedBatches, L["Land.Stats.Batches"].Value, "batches"), (Model.Stats.VerifiedOrganizations, L["Land.Stats.Orgs"].Value, "orgs"), (Model.Stats.ApprovedLabReports, L["Land.Stats.Reports"].Value, "reports") })
                        {
                            if (count > 0)
                            {
                                <div class="ld-stat" id="stat-@id">
                                    <dt>@label</dt>
                                    <dd data-count="@count" style="min-width: @(count.ToString("N0", culture).Length)ch">@count.ToString("N0", culture)</dd>
                                </div>
                            }
                        }
                    </dl>
                </div>
            </section>
        }

        @* 2. the chain, revealed on scroll; the honey line draws itself along the steps *@
        <section class="ld-section ld-chain" id="chain" aria-labelledby="chain-title">
            <div class="ld-wrap">
                <header class="ld-head ld-reveal">
                    <p class="ld-kicker">@L["Land.Chain.Kicker"]</p>
                    <h2 id="chain-title" class="ld-title">@L["Land.Chain.Title"]</h2>
                    <p class="ld-lead">@L["Land.Chain.Lead"]</p>
                </header>
                <ol class="ld-steps" data-honey-line>
                    <li class="ld-spine" aria-hidden="true"><span class="ld-spine-fill"></span></li>
                    @for (var i = 0; i < steps.Length; i++)
                    {
                        var s = steps[i];
                        var image = Model.Steps.Count > i ? Model.Steps[i] : null;
                        <li class="ld-step ld-reveal @(i % 2 == 1 ? "is-flip" : "")">
                            <span class="ld-node" aria-hidden="true"><partial name="_LandingIcon" model="@s.Icon" /></span>
                            <figure class="ld-step-media">
                                <span class="ld-hexmask" aria-hidden="true"></span>
                                @if (image?.Exists == true)
                                {
                                    <picture>
                                        @if (image.Avif?.Count > 0)
                                        {
                                            <source type="image/avif" srcset="@image.AvifSrcSet" sizes="(min-width: 960px) 520px, calc(100vw - 72px)">
                                        }
                                        @if (image.WebP.Count > 0)
                                        {
                                            <source type="image/webp" srcset="@image.WebPSrcSet" sizes="(min-width: 960px) 520px, calc(100vw - 72px)">
                                        }
                                        <img src="@image.Jpeg" alt="@L["Land.Step" + (i + 1) + ".Alt"]" width="1440" height="901" loading="lazy" decoding="async">
                                    </picture>
                                }
                                else
                                {
                                    <div class="ld-placeholder" role="img" aria-label="@L["Land.ImagePending"]"><partial name="_LandingIcon" model="@s.Icon" /></div>
                                }
                            </figure>
                            <div class="ld-step-body">
                                <p class="ld-step-meta"><span>@string.Format(L["Land.StepN"].Value, i + 1)</span><span class="ld-chip">@s.Tag</span></p>
                                <h3 class="ld-step-title">@s.Title</h3>
                                <p>@s.Text</p>
                            </div>
                        </li>
                    }
                </ol>
            </div>
        </section>

        <div class="ld-divider" aria-hidden="true"></div>
        @* 3. trust: light honey-glow section with the background video *@
        <section class="ld-section ld-night" id="trust" aria-labelledby="trust-title">
            <div class="ld-night-media" aria-hidden="true">
                <video class="ld-night-video" muted loop playsinline preload="none" poster="/media/honey-loop-poster.jpg" tabindex="-1" disablepictureinpicture disableremoteplayback>
                    <source src="/media/honey-loop-720.webm" type="video/webm">
                    <source src="/media/honey-loop-720.mp4" type="video/mp4">
                </video>
            </div>
            <div class="ld-night-rays" aria-hidden="true"></div>
            <div class="ld-wrap">
                <header class="ld-head ld-reveal">
                    <p class="ld-kicker">@L["Land.Trust.Kicker"]</p>
                    <h2 id="trust-title" class="ld-title">@L["Land.Trust.Title"]</h2>
                </header>
                <ul class="ld-trust">
                    @foreach (var t in trust)
                    {
                        <li class="ld-trust-card ld-card ld-reveal">
                            <span class="ld-hex-icon" aria-hidden="true"><partial name="_LandingIcon" model="@t.Icon" /></span>
                            <h3>@t.Title</h3>
                            <p>@t.Text</p>
                        </li>
                    }
                </ul>
                @if (Model.OrgModel)
                {
                    <p class="ld-night-cta ld-reveal"><a class="b-btn b-btn-honey" href="/verify-report">@L["Land.VerifyReport"]</a></p>
                }
            </div>
        </section>

        <div class="ld-divider" aria-hidden="true"></div>
        @* 4. for whom *@
        <section class="ld-section" id="for-whom" aria-labelledby="who-title">
            <div class="ld-wrap">
                <header class="ld-head ld-reveal">
                    <p class="ld-kicker">@L["Land.Who.Kicker"]</p>
                    <h2 id="who-title" class="ld-title">@L["Land.Who.Title"]</h2>
                </header>
                <ul class="ld-who">
                    @foreach (var a in audiences)
                    {
                        <li class="ld-who-card ld-card ld-reveal">
                            <span class="ld-hex-icon" aria-hidden="true"><partial name="_LandingIcon" model="@a.Icon" /></span>
                            <h3>@a.Title</h3>
                            <p>@a.Text</p>
                        </li>
                    }
                </ul>
            </div>
        </section>

        <div class="ld-divider" aria-hidden="true"></div>
        @* 5. Honey Story preview: the real page of the demo batch in a phone frame (float, tilt, slow scroll) *@
        <section class="ld-section ld-story" id="story" aria-labelledby="story-title">
            <div class="ld-wrap ld-story-in">
                <div class="ld-story-text ld-reveal">
                    <p class="ld-kicker">@L["Land.Story.Kicker"]</p>
                    <h2 id="story-title" class="ld-title">@L["Land.Story.Title"]</h2>
                    <p class="ld-lead">@L["Land.Story.Text"]</p>
                    <ul class="ld-checks">
                        @foreach (var point in L["Land.Story.Points"].Value.Split('|'))
                        {
                            <li>@point</li>
                        }
                    </ul>
                    @if (storyUrl != null)
                    {
                        <a class="b-btn b-btn-honey" href="@storyUrl" id="demo-story-link">@L["Land.Story.Cta"]</a>
                    }
                    else
                    {
                        <p class="ld-consumer"><span>@L["Land.Consumer"]</span></p>
                    }
                </div>
                <div class="ld-phone-stage ld-reveal">
                <div class="ld-phone" data-tilt aria-hidden="@(storyUrl == null ? "true" : "false")">
                    <div class="ld-phone-screen">
                        @if (storyUrl != null)
                        {
                            <div class="ld-phone-scroll"><iframe src="@(storyUrl)?culture=@lang" title="@L["Land.Story.FrameTitle"]" loading="lazy" tabindex="-1" scrolling="no" referrerpolicy="same-origin"></iframe></div>
                        }
                        else
                        {
                            <div class="ld-phone-mock">
                                <div class="ld-mock-hero"><span class="ld-mock-jar"></span><span>@L["Land.Nav.Story"]</span></div>
                                @foreach (var station in stations)
                                {
                                    <div class="ld-mock-row"><span class="ld-mock-dot"></span><span>@station</span></div>
                                }
                            </div>
                        }
                    </div>
                </div>
                </div>
            </div>
        </section>
        <div class="ld-divider" aria-hidden="true"></div>
    </main>

    @* 6. footer: language switch, partners (logos from wwwroot/img/partners when added), contact *@
    <footer class="ld-footer">
        <div class="ld-wrap">
            <div class="ld-footer-grid">
                <div>
                    <a class="ld-brand b-link" href="#top">
                        <img class="b-logo" src="~/img/brand/top4-logo-w2.svg" alt="TOP4HoneyChains" width="115" height="48" loading="lazy" decoding="async">
                    </a>
                    <p class="ld-footer-tag">@tagline</p>
                    <h2 class="ld-footer-h">@L["Contact"]</h2>
                    <p class="ld-footer-contact">
                        <a class="b-link" href="mailto:intalalab@isikun.edu.tr">intalalab@isikun.edu.tr</a><br>
                        <a class="b-link" href="tel:+902165288000">+90 216 528 80 00</a>
                    </p>
                </div>
                <div>
                    <h2 class="ld-footer-h">@L["Land.Footer.Partners"]</h2>
                    @if (Model.PartnerLogos.Count > 0)
                    {
                        <ul class="ld-logos">
                            @foreach (var logo in Model.PartnerLogos)
                            {
                                <li><img src="@logo" alt="@System.IO.Path.GetFileNameWithoutExtension(logo)" loading="lazy" height="48"></li>
                            }
                        </ul>
                    }
                    else
                    {
                        <ul class="ld-partners" id="partner-list">
                            @foreach (var (name, country) in partners)
                            {
                                <li><span class="ld-partner">@name</span> <span class="ld-country">@country</span></li>
                            }
                        </ul>
                    }
                </div>
                <div>
                    <h2 class="ld-footer-h">@L["Language"]</h2>
                    <ul class="ld-footer-langs">
                        @foreach (var (code, name) in languages)
                        {
                            <li>
                                @if (code == lang)
                                {
                                    <span class="ld-lang-full is-current" lang="@code" aria-current="true">@name</span>
                                }
                                else
                                {
                                    <a class="ld-lang-full b-link" href="@Url.Action("SetLanguage", "Home", new { culture = code, returnUrl })" hreflang="@code" lang="@code">@name</a>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <p class="ld-footer-rights b-credit-row"><span>@string.Format(L["Land.Footer.Rights"].Value, DateTime.Now.Year)</span><span class="b-credit-sep" aria-hidden="true">·</span><partial name="_IntalaCredit" /></p>
        </div>
    </footer>

    <script src="~/js/hero-comb.js" asp-append-version="true" defer></script>
    <script src="~/js/landing.js" asp-append-version="true" defer></script>
    <script src="~/js/honey-mark.js" asp-append-version="true" defer></script>
</body>
</html>
