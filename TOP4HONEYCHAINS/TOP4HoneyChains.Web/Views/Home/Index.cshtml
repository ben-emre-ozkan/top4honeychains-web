    <script>
        
        function goToPlatform() {

            let lang = "en";

            if (document.documentElement.classList.contains("lang-tr")) lang = "tr";
            if (document.documentElement.classList.contains("lang-es")) lang = "es";
            if (document.documentElement.classList.contains("lang-pl")) lang = "pl";
            if (document.documentElement.classList.contains("lang-lv")) lang = "lv";

            window.location.href =
                "/Home/SetLanguage?culture=" + lang + "&returnUrl=/Account/Login";
        }
