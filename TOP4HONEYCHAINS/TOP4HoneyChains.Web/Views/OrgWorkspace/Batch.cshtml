@using TOP4HoneyChains.Web.Models.Entities
@model FinalHoneyProduction
@{
    ViewData["Title"] = Model.FinalHoneyProductionTitle;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var readable = ViewBag.Readable as Dictionary<string, HashSet<int>> ?? new();
    var blockers = ViewBag.Blockers as List<string> ?? new();
    var done = (Func<int, DateTime?, int, bool>)ViewBag.Done;
    var batchCan = readable.TryGetValue("batch" + Model.FinalHoneyProductionId, out var bs) ? bs : new HashSet<int>();
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-1">@Model.FinalHoneyProductionTitle</h4>
                    <div class="text-muted small">@Model.FinalHoneyProductionDate?.ToString("dd.MM.yyyy") · @Model.FinalHoneyProductionTotalAmount kg ·
                        <strong id="batch-state">@(Model.FinalHoneyProductionIsFinalized ? L["Org.Finalized"] : L["Org.Draft"])</strong></div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@L["Org.BatchCcps"]</h5>
                    @foreach (var a in Model.FinalHoneyCCPAssignments.Where(a => batchCan.Contains(a.FinalHoneyCCPAssignmentCCP)).OrderBy(a => a.FinalHoneyCCPAssignmentCCP))
                    {
                        <a asp-controller="CCPMonitoring" asp-action="FinalHoneyProductionManageCCP"
                           asp-route-finalHoneyProductionId="@Model.FinalHoneyProductionId" asp-route-ccpId="@a.FinalHoneyCCPAssignmentCCP"
                           class="btn btn-sm @(done(a.FinalHoneyCCPAssignmentStatus, a.ApprovedAt, a.FinalHoneyCCPAssignmentCCP) ? "btn-success" : "btn-secondary") me-1 mb-1">@Ref.Code(a.CCP?.Code)</a>
                    }
                    @if (batchCan.Count > 0)
                    {
                        @* D-88: every batch CCP on one page *@
                        <div class="mt-2"><a href="@TOP4HoneyChains.Web.Services.OrgModel.ControlSheets.Url("batch", Model.FinalHoneyProductionId)" class="btn btn-primary" id="open-sheet"><i class="mdi mdi-clipboard-list-outline me-1" aria-hidden="true"></i>@L["Sheet.OpenSheet"]</a></div>
                    }

                    <h5 class="card-title mt-4">@L["Org.SourceLots"]</h5>
                    <p class="small text-muted">@L["Org.SourceLotsHelp"]</p>
                    <div class="table-responsive"><table class="table table-sm" id="source-lots">
                        <thead><tr><th>#</th><th>@L["Org.Apiary"]</th><th>@L["Org.Amount"]</th><th>@L["Org.Ccps"]</th></tr></thead>
                        <tbody>
                            @foreach (var d in Model.FinalHoneyProductionDetails)
                            {
                                var can = readable.TryGetValue("raw" + d.RawHoneyProductionId, out var set) ? set : new HashSet<int>();
                                <tr>
                                    <td>@d.RawHoneyProductionId</td>
                                    <td>@d.RawHoneyProduction.RawHoneyProductionApiary?.ApiaryTitle</td>
                                    <td>@d.UsedAmount</td>
                                    <td>
                                        @foreach (var a in d.RawHoneyProduction.RawHoneyCCPAssignments.Where(a => can.Contains(a.RawHoneyCCPAssignmentCCP)).OrderBy(a => a.RawHoneyCCPAssignmentCCP))
                                        {
                                            <a asp-controller="CCPMonitoring" asp-action="RawHoneyProductionManageCCP"
                                               asp-route-rawHoneyProductionId="@d.RawHoneyProductionId" asp-route-ccpId="@a.RawHoneyCCPAssignmentCCP"
                                               class="btn btn-sm @(done(a.RawHoneyCCPAssignmentStatus, a.ApprovedAt, a.RawHoneyCCPAssignmentCCP) ? "btn-success" : "btn-secondary") me-1 mb-1">@Ref.Code(a.CCP?.Code)</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                </div>
            </div>

            @{
                var final = ViewBag.Final as TOP4HoneyChains.Web.Services.OrgModel.BatchSampleService.State;
                var finalDenied = ViewBag.FinalDenied as string;
                var labs = ViewBag.Labs as Dictionary<int, string>;
            }
            @if (final != null && (final.Applies || final.Sample != null))
            {
                @* D-98: the final honey result, apart from the lot results *@
                <div class="card" id="final-result">
                    <div class="card-body">
                        <h5 class="card-title"><i class="mdi mdi-flask-outline me-1" aria-hidden="true"></i>@L["Final.Title"]<info-tip key="Final.Info" about="@L["Final.Title"].Value" /></h5>
                        <p class="small text-muted">@L["Final.Help"]</p>
                        @if (final.Approved != null)
                        {
                            var r = final.Approved;
                            <div class="mb-2" id="final-report"><partial name="_StatusPill" model="@(new TOP4HoneyChains.Web.Models.ViewModels.StatusPill(TOP4HoneyChains.Web.Models.ViewModels.StatusPill.Approved, L["Final.Approved"].Value))" />
                                <a asp-controller="Verify" asp-action="Index" asp-route-code="@r.ReportCode" class="ms-2"><code>@r.ReportCode</code></a>
                                <span class="small text-muted">· @final.Sample?.LabOrg?.DisplayName · @r.ApprovedAt?.ToLocalTime().ToString("dd.MM.yyyy")</span></div>
                            <div class="table-responsive"><table class="table table-sm" id="final-values">
                                <thead><tr><th>@L["Final.Parameter"]</th><th>@L["Final.Value"]</th><th>@L["Final.Limit"]</th></tr></thead>
                                <tbody>
                                    @foreach (var v in r.Results.OrderBy(v => v.ParameterId))
                                    {
                                        <tr class="@(v.IsInRange == false ? "table-danger" : null)">
                                            <td>@Ref.T("Parameter", v.ParameterId, "Name", v.Parameter?.ParameterName)</td>
                                            <td>@(v.MeasuredNumericValue?.ToString("0.####") ?? v.MeasuredTextValue) @(v.Parameter?.ParameterUnit is string u && u != "None" ? Ref.T("Parameter", v.ParameterId, "Unit", u) : "")</td>
                                            <td class="small text-muted">@Ref.Limit(v.AppliedLimit, k => L[k])</td>
                                        </tr>
                                    }
                                </tbody>
                            </table></div>
                        }
                        else if (final.Sample != null && final.Sample.Status != TOP4HoneyChains.Web.Models.Entities.SampleStatus.Rejected)
                        {
                            <div id="final-pending"><partial name="_StatusPill" model="@(new TOP4HoneyChains.Web.Models.ViewModels.StatusPill(TOP4HoneyChains.Web.Models.ViewModels.StatusPill.Pending, L["Final.AtLab"].Value))" />
                                <span class="small text-muted ms-1">@final.Sample.SampleCode · @final.Sample.LabOrg?.DisplayName</span></div>
                        }
                        @if (final.Approved == null && finalDenied == null && labs != null)
                        {
                            @if (final.Sample?.Status == TOP4HoneyChains.Web.Models.Entities.SampleStatus.Rejected)
                            {
                                <div class="alert alert-warning small">@L["Final.Rejected", final.Sample.SampleCode]</div>
                            }
                            <details class="mt-2" id="final-sample-box" open="@(final.Sample == null)">
                                <summary class="text-primary" style="cursor:pointer">@L["Final.TakeSample"]</summary>
                                <form asp-action="FinalSample" asp-route-id="@Model.FinalHoneyProductionId" method="post" class="row g-2 mt-1" id="final-sample-form">
                                    <div class="col-md-6">
                                        <label class="form-label required" for="final-lab">@L["Final.Lab"]</label>
                                        <select class="form-select" id="final-lab" name="labOrgId" required>
                                            <option value="">—</option>
                                            @foreach (var l in labs) { <option value="@l.Key">@l.Value</option> }
                                        </select>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label required" for="final-seal">@L["Ci.JarSeal"]</label>
                                        <input class="form-control" id="final-seal" name="sealNumber" maxlength="80" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="TS-000000" required />
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label required" for="final-counter">@L["Ci.CounterSeal"]</label>
                                        <input class="form-control" id="final-counter" name="counterSealNumber" maxlength="80" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="TS-000000" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label required" for="final-where">@L["Final.CounterWhere"]</label>
                                        <input class="form-control" id="final-where" name="counterLocation" maxlength="200" required />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label required" for="final-until">@L["Final.RetainUntil"]</label>
                                        <input class="form-control" type="date" id="final-until" name="retainUntil" value="@DateTime.Today.AddYears(1).ToString("yyyy-MM-dd")" required />
                                    </div>
                                    <div class="col-md-3 d-flex align-items-end">
                                        <button type="submit" class="btn btn-primary w-100" id="final-sample-send">@L["Final.Send"]</button>
                                    </div>
                                </form>
                            </details>
                        }
                        else if (final.Approved == null && finalDenied != null && final.Sample == null)
                        {
                            <p class="small text-muted mb-0" id="final-denied">@Msg.T(finalDenied)</p>
                        }
                    </div>
                </div>
            }

            <div class="card" id="finalize-card">
                <div class="card-body">
                    <h5 class="card-title">@L["Org.Finalize"]</h5>
                    <p class="small text-muted">@L["Org.FinalizeHelp"]</p>
                    @if (Model.FinalHoneyProductionIsFinalized)
                    {
                        @* D-67: the seal; it presses in once right after the approval, then the Honey Story and the QR appear *@
                        var fresh = TempData["Sealed"] as bool? == true;
                        var sealedAt = Model.FinalHoneyProductionFinalizedDate?.ToLocalTime();
                        var qr = Model.FinalHoneyProductionQR.ToString().ToUpperInvariant();
                        <div class="seal @(fresh ? "is-fresh" : "")" id="batch-seal">
                            <div class="seal-stamp" role="img" aria-label="@L["Sealed"] · #@Model.FinalHoneyProductionId · @sealedAt?.ToString("dd.MM.yyyy")">
                                <svg viewBox="0 0 160 160" width="150" height="150" aria-hidden="true">
                                    <defs>
                                        <radialGradient id="seal-wax" cx="40%" cy="35%" r="70%">
                                            <stop offset="0" stop-color="#FFD25A" />
                                            <stop offset="0.55" stop-color="#FFB547" />
                                            <stop offset="1" stop-color="#FFA23A" />
                                        </radialGradient>
                                    </defs>
                                    <path d="M80 6 L144 43 L144 117 L80 154 L16 117 L16 43 Z" fill="url(#seal-wax)" />
                                    <path d="M80 20 L132 50 L132 110 L80 140 L28 110 L28 50 Z" fill="none" stroke="#FFFFFF" stroke-opacity="0.8" stroke-width="2" stroke-dasharray="3 4" />
                                    <path class="seal-check" d="M62 74 l12 12 l24 -26" fill="none" stroke="#4A3F36" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
                                    <text x="80" y="108" text-anchor="middle" font-family="Bricolage Grotesque, system-ui, sans-serif" font-weight="800" font-size="17" fill="#4A3F36">#@Model.FinalHoneyProductionId</text>
                                    <text x="80" y="126" text-anchor="middle" font-family="Instrument Sans, system-ui, sans-serif" font-weight="600" font-size="11" fill="#4A3F36">@sealedAt?.ToString("dd.MM.yyyy")</text>
                                </svg>
                            </div>
                            <div class="seal-info">
                                <p class="seal-title">@L["Sealed"]</p>
                                <p class="seal-sub">@L["Org.Finalized"] · @sealedAt?.ToString("dd.MM.yyyy HH:mm")
                                    @if (Model.SelfFinalized) { <span class="st-pill st-pending ms-1"><i class="mdi mdi-alert-outline" aria-hidden="true"></i><span>@L["Org.SelfApproved"]</span></span> }</p>
                                <div class="seal-actions">
                                    <a class="btn btn-primary" href="/honeystory/@qr" target="_blank" id="seal-story"><i class="mdi mdi-book-open-page-variant-outline" aria-hidden="true"></i>@L["Open the Honey Story"]</a>
                                    <a class="btn btn-outline-secondary" href="/honeystory/qrcode?code=@qr" download="honeystory-@(Model.FinalHoneyProductionId).png" id="seal-download"><i class="mdi mdi-download" aria-hidden="true"></i>@L["Download QR"]</a>
                                </div>
                            </div>
                            <img class="seal-qr" src="/honeystory/qrcode?code=@qr" alt="@L["QR code of the Honey Story"]" width="120" height="120" loading="lazy" />
                        </div>
                    }
                    else
                    {
                        @if (blockers.Any())
                        {
                            <div class="alert alert-warning" id="finalize-blockers">
                                <strong>@L["Org.MissingBeforeFinalize"]</strong>
                                <ul class="mb-0">@foreach (var b in blockers) { <li>@Msg.T(b)</li> }</ul>
                            </div>
                        }
                        @if (final != null && final.Applies && final.Approved == null)
                        {
                            @* D-98: a warning, not a block *@
                            <div class="alert alert-info small" id="final-warning"><i class="mdi mdi-information-outline me-1" aria-hidden="true"></i>@L["Final.Warning"]</div>
                        }
                        @if (Model.FinalizeRequestedByUserId == null)
                        {
                            @if (ViewBag.CanRequest == true)
                            {
                                <form asp-action="RequestFinalize" asp-route-id="@Model.FinalHoneyProductionId" method="post">
                                    <button type="submit" class="btn btn-outline-primary" id="request-finalize" @(blockers.Any() ? "disabled" : "")>@L["Org.RequestFinalize"]</button>
                                </form>
                            }
                        }
                        else
                        {
                            <div class="mb-2" id="finalize-requested">@L["Org.FinalizeRequested"] @Model.FinalizeRequestedAt?.ToString("dd.MM.yyyy HH:mm")</div>
                            @if (ViewBag.CanFinalize == true)
                            {
                                <form asp-action="Finalize" asp-route-id="@Model.FinalHoneyProductionId" method="post" data-loader="seal">
                                    <button type="submit" class="btn btn-danger" id="confirm-finalize" @(blockers.Any() ? "disabled" : "")>@L["Org.ConfirmFinalize"]</button>
                                </form>
                            }
                        }
                    }
                </div>
            </div>
            <a asp-action="Index" class="btn btn-link app-back"><i class="mdi mdi-arrow-left" aria-hidden="true"></i> @L["Org.Back"]</a>
            <a asp-controller="Recall" asp-action="Batch" asp-route-id="@Model.FinalHoneyProductionId" class="btn btn-outline-secondary">@L["Cust.RecallReport"]</a>
            <a asp-controller="Flow" asp-action="Batch" asp-route-id="@Model.FinalHoneyProductionId" class="btn btn-outline-secondary">@L["Flow.Title"]</a>
        </div>
    </div>
</body>
