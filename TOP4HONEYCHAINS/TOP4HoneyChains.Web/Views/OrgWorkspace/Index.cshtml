@using TOP4HoneyChains.Web.Models.Entities
@using TOP4HoneyChains.Web.Services.OrgModel
@{
    ViewData["Title"] = L["Org.MyOrganization"];
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var active = ViewBag.Active as ActiveMembership;
    var memberships = ViewBag.Memberships as List<MembershipOption> ?? new();
    var lots = ViewBag.Lots as List<RawHoneyProduction> ?? new();
    var batches = ViewBag.Batches as List<FinalHoneyProduction> ?? new();
    var readable = ViewBag.Readable as Dictionary<string, HashSet<int>> ?? new();
    string Chip(int status, DateTime? approvedAt) => status switch
    {
        AssignmentStatusIds.Completed => approvedAt != null ? "btn-success" : "btn-outline-success",
        AssignmentStatusIds.NotApplicable => "btn-outline-dark",
        AssignmentStatusIds.Submitted => "btn-warning",
        _ => "btn-secondary"
    };
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">

            <div class="card">
                <div class="card-body">
                    @if (active == null)
                    {
                        <h4 class="card-title">@L["Org.NoMembership"]</h4>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                            <div>
                                <h4 class="card-title mb-1" id="active-org">@active.OrgName</h4>
                                <div>
                                    @L["Org.Role"]: <strong id="active-role">@active.OrgRole</strong> ·
                                    @L["Org.Status"]: <strong id="active-status">@active.OrgStatus</strong> ·
                                    @L["Org.Capabilities"]: @string.Join(", ", active.Capabilities)
                                </div>
                                @if (!active.IsVerified)
                                {
                                    <div class="alert alert-warning mt-2 mb-0" id="not-verified">@L["Org.NotVerifiedBanner"]</div>
                                }
                                <a asp-controller="Organizations" asp-action="Details" asp-route-id="@active.OrgId" class="btn btn-sm btn-outline-primary mt-2">@L["Org.OrganizationPage"]</a>
                                <a asp-controller="Shipments" asp-action="Index" class="btn btn-sm btn-outline-primary mt-2" id="link-shipments">@L["Cust.Shipments"]</a>
                                @if (active.Has(TOP4HoneyChains.Web.Models.Entities.Capabilities.Processing))
                                {
                                    <a asp-controller="Intake" asp-action="Index" class="btn btn-sm btn-outline-primary mt-2" id="link-intakes">@L["Cust.Intakes"]</a>
                                }
                            </div>
                            @if (memberships.Count > 1)
                            {
                                <form asp-action="Switch" method="post" class="d-flex gap-2 align-items-end" id="switch-form">
                                    <div>
                                        <label class="form-label small mb-0">@L["Org.ActAs"]</label>
                                        <select name="membershipId" class="form-select">
                                            @foreach (var m in memberships)
                                            {
                                                <option value="@m.MembershipId" selected="@(m.MembershipId == active.MembershipId)">@m.OrgName – @m.OrgRole</option>
                                            }
                                        </select>
                                    </div>
                                    <button type="submit" class="btn btn-primary">@L["Org.Switch"]</button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@L["Org.RawLots"]</h5>
                    <p class="small text-muted">@L["Org.RawLotsHelp"]</p>
                    <table class="table table-sm table-bordered" id="lots">
                        <thead><tr><th>#</th><th>@L["Org.Apiary"]</th><th>@L["Org.HoneyType"]</th><th>@L["Org.Amount"]</th><th>@L["Org.Date"]</th><th>@L["Org.Ccps"]</th></tr></thead>
                        <tbody>
                            @foreach (var l in lots)
                            {
                                var can = readable.TryGetValue("raw" + l.RawHoneyProductionId, out var set) ? set : new HashSet<int>();
                                <tr data-lot-id="@l.RawHoneyProductionId">
                                    <td>@l.RawHoneyProductionId</td>
                                    <td>@l.RawHoneyProductionApiary?.ApiaryTitle</td>
                                    <td>@l.RawHoneyProductionHoneyTypeNavigation?.HoneyTypeTitle</td>
                                    <td>@l.RawHoneyProductionAmount</td>
                                    <td>@l.RawHoneyProductionDate?.ToString("dd.MM.yyyy") <a asp-controller="Recall" asp-action="Lot" asp-route-id="@l.RawHoneyProductionId" class="small ms-1">@L["Cust.Recall"]</a></td>
                                    <td>
                                        @foreach (var a in l.RawHoneyCCPAssignments.Where(a => can.Contains(a.RawHoneyCCPAssignmentCCP)).OrderBy(a => a.RawHoneyCCPAssignmentCCP))
                                        {
                                            <a asp-controller="CCPMonitoring" asp-action="RawHoneyProductionManageCCP"
                                               asp-route-rawHoneyProductionId="@l.RawHoneyProductionId" asp-route-ccpId="@a.RawHoneyCCPAssignmentCCP"
                                               class="btn btn-sm @Chip(a.RawHoneyCCPAssignmentStatus, a.ApprovedAt) me-1 mb-1 ccp-chip" data-ccp="@a.CCP?.Code">@a.CCP?.Code @(a.ApprovedAt != null ? "✓" : "")</a>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!lots.Any())
                            {
                                <tr><td colspan="6" class="text-muted">@L["Org.None"]</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@L["Org.Batches"]</h5>
                    <table class="table table-sm table-bordered" id="batches">
                        <thead><tr><th>#</th><th>@L["Org.Title"]</th><th>@L["Org.Date"]</th><th>@L["Org.Total"]</th><th>@L["Org.Status"]</th><th>@L["Org.Ccps"]</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var b in batches)
                            {
                                var can = readable.TryGetValue("batch" + b.FinalHoneyProductionId, out var set) ? set : new HashSet<int>();
                                <tr data-batch-id="@b.FinalHoneyProductionId">
                                    <td>@b.FinalHoneyProductionId</td>
                                    <td>@b.FinalHoneyProductionTitle</td>
                                    <td>@b.FinalHoneyProductionDate?.ToString("dd.MM.yyyy")</td>
                                    <td>@b.FinalHoneyProductionTotalAmount</td>
                                    <td>@(b.FinalHoneyProductionIsFinalized ? L["Org.Finalized"] : L["Org.Draft"])</td>
                                    <td>
                                        @foreach (var a in b.FinalHoneyCCPAssignments.Where(a => can.Contains(a.FinalHoneyCCPAssignmentCCP)).OrderBy(a => a.FinalHoneyCCPAssignmentCCP))
                                        {
                                            <a asp-controller="CCPMonitoring" asp-action="FinalHoneyProductionManageCCP"
                                               asp-route-finalHoneyProductionId="@b.FinalHoneyProductionId" asp-route-ccpId="@a.FinalHoneyCCPAssignmentCCP"
                                               class="btn btn-sm @Chip(a.FinalHoneyCCPAssignmentStatus, a.ApprovedAt) me-1 mb-1 ccp-chip" data-ccp="@a.CCP?.Code">@a.CCP?.Code @(a.ApprovedAt != null ? "✓" : "")</a>
                                        }
                                    </td>
                                    <td><a asp-action="Batch" asp-route-id="@b.FinalHoneyProductionId" class="btn btn-sm btn-primary">@L["Org.Open"]</a></td>
                                </tr>
                            }
                            @if (!batches.Any())
                            {
                                <tr><td colspan="7" class="text-muted">@L["Org.None"]</td></tr>
                            }
                        </tbody>
                    </table>
                    <div class="small text-muted">@L["Org.ChipLegend"]</div>
                </div>
            </div>
        </div>
    </div>
</body>
