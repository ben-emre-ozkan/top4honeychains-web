@model TOP4HoneyChains.Web.Controllers.OrgWorkspaceController.NewBatchModel
@{
    // D-88: the processing or packing organization creates its own batch from its own eligible lots
    ViewData["Title"] = L["Batch.New"];
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var posted = Model.Problems.Count > 0;
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid" id="new-batch-page">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-1">@L["Batch.New"]</h4>
                    <p class="text-muted mb-0">@L["Batch.NewHelp"]</p>
                </div>
            </div>

            @if (Model.Problems.Count > 0)
            {
                <div class="alert alert-danger" id="new-batch-problems" role="alert">
                    <ul class="mb-0">
                        @foreach (var p in Model.Problems) { <li>@Msg.T(p)</li> }
                    </ul>
                </div>
            }

            @if (!Model.Lots.Any())
            {
                <div class="card" id="new-batch-empty">
                    <div class="card-body">
                        <p class="mb-2">@L["Batch.NoLots"]</p>
                        <a href="/MyWork/Index" class="btn btn-outline-primary btn-sm">@L["Work.Title"]</a>
                        <a href="/OrgWorkspace/Index" class="btn btn-link btn-sm app-back"><i class="mdi mdi-arrow-left me-1"></i>@L["Back"]</a>
                    </div>
                </div>
            }
            else
            {
                <form asp-action="NewBatch" method="post" id="new-batch-form" class="card">
                    <div class="card-body">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label for="batch-title" class="form-label required">@L["Batch.Name"]</label>
                                <input id="batch-title" name="title" class="form-control" maxlength="@TOP4HoneyChains.Web.Services.OrgModel.PlantBatchService.TitleMax" required value="@Model.Title" placeholder="@L["Batch.NamePlaceholder"]" />
                            </div>
                            <div class="col-md-3">
                                <label for="batch-date" class="form-label required">@L["Production Date"]</label>
                                <input id="batch-date" name="date" type="date" class="form-control" required max="@DateTime.Today.ToString("yyyy-MM-dd")" value="@Model.Date?.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle" id="new-batch-lots">
                                <thead>
                                    <tr>
                                        <th scope="col">@L["Batch.Use"]</th>
                                        <th scope="col">#</th>
                                        <th scope="col">@L["Org.HoneyType"]</th>
                                        <th scope="col">@L["Org.Apiary"]</th>
                                        <th scope="col">@L["Org.Date"]</th>
                                        <th scope="col" class="text-end">@L["Batch.Left"]</th>
                                        <th scope="col">@L["Batch.Kg"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var lot in Model.Lots)
                                    {
                                        var ticked = posted ? Model.Chosen.Contains(lot.LotId) : true;
                                        var kg = Model.Amounts.TryGetValue(lot.LotId, out var v) ? v : lot.Left;
                                        <tr data-lot-id="@lot.LotId">
                                            <td><input type="checkbox" class="form-check-input" name="lots" value="@lot.LotId" id="use-@lot.LotId" checked="@ticked" aria-label="@L["Batch.Use"] #@lot.LotId" /></td>
                                            <td><label for="use-@lot.LotId" class="mb-0">@lot.LotId</label></td>
                                            <td>@Ref.T("HoneyType", lot.HoneyTypeId, "Title", lot.HoneyType)</td>
                                            <td>@lot.Apiary</td>
                                            <td>@lot.Date?.ToString("dd.MM.yyyy")</td>
                                            <td class="text-end">@lot.Left.ToString("0.##")</td>
                                            <td style="max-width: 10rem">
                                                <input type="text" inputmode="decimal" autocomplete="off" class="form-control form-control-sm" name="kg[@lot.LotId]"
                                                       value="@kg.ToString("0.##")" aria-label="@L["Batch.Kg"] #@lot.LotId" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
                            <a href="/OrgWorkspace/Index" class="btn btn-link app-back"><i class="mdi mdi-arrow-left me-1"></i>@L["Back"]</a>
                            <button type="submit" class="btn btn-success px-4" id="new-batch-submit"><i class="mdi mdi-package-variant-closed me-1" aria-hidden="true"></i>@L["Batch.Create"]</button>
                        </div>
                    </div>
                </form>
            }
        </div>
    </div>
</body>
