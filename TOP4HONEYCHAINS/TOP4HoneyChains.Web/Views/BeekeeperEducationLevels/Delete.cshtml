@model TOP4HoneyChains.Web.Models.Entities.BeekeeperEducationLevel

@{
    ViewData["Title"] = L["Delete Education Level"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card border-danger">
                        <div class="card-body">

                            <h4 class="card-title text-danger">
                                @L["Confirm Deletion"]
                            </h4>

                            <p class="card-title-desc text-muted">
                                @L["Are you sure you want to delete this education level? This action cannot be undone."]
                            </p>

                            <hr />

                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    @L["Education Level Title"]
                                </label>
                                <div class="form-control bg-light">
                                    @Ref.T("EducationLevel", Model.BeekeeperEducationLevelId, "Title", Model.BeekeeperEducationLevelTitle)
                                </div>
                            </div>

                            <form asp-action="Delete">

                                <input type="hidden" asp-for="BeekeeperEducationLevelId" />

                                <div class="d-flex gap-2">

                                    <button type="submit"
                                            class="btn btn-danger waves-effect waves-light">
                                        @L["Delete"]
                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-secondary waves-effect">
                                        @L["Cancel"]
                                    </a>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/js/app.js"></script>
    }

</body>
