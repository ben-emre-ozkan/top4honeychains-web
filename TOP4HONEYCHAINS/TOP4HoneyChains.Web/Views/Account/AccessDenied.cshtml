@{
    ViewBag.Title = L["AccessDenied"].Value;
    Layout = "~/Views/Shared/_BlankLayout.cshtml";
}

<div class="account-pages my-5 pt-sm-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 col-xl-5">
                <div class="card overflow-hidden">
                    <div class="card-body pt-0">

                        <div class="ex-page-content text-center">

                            <h1 class="text-dark">403</h1>

                            <h3 class="">@L["Access Denied"]</h3>

                            <p class="text-muted">
                                @L["You do not have permission to access this page."]
                            </p>

                            <br>

                            <a class="btn btn-info mb-4 waves-effect waves-light" href="/Dashboard">
                                <i class="mdi mdi-home"></i> @L["Back to Dashboard"]
                            </a>

                        </div>

                    </div>
                </div>

                <div class="mt-5 text-center">
                    ©
                    <script>document.write(new Date().getFullYear())</script>
                    TOP4HoneyChains
                </div>

            </div>
        </div>
    </div>
</div>

<script src="~/assets/js/app.js"></script>