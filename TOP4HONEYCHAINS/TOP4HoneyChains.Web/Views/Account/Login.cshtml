@model TOP4HoneyChains.Web.Models.ViewModels.LoginViewModel
@{
    ViewBag.Title = L["Login"].Value;
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    // the return URL in the query (if any) stays on the form's address; authentication itself is unchanged
    var returnUrl = Context.Request.Query["ReturnUrl"].ToString();
}
@section AddToHead {
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
}

<h1 class="au-title">@L["Login.WelcomeBack"]</h1>
<p class="au-sub">@L["Login.SignInContinue"]</p>

<form asp-action="Login" asp-controller="Account" asp-route-ReturnUrl="@(string.IsNullOrEmpty(returnUrl) ? null : returnUrl)" method="post" class="au-form" id="login-form">
    @Html.AntiForgeryToken()

    <div class="au-field">
        <label asp-for="UserName">@L["Login.Username"]</label>
        <input asp-for="UserName" placeholder="@L["Login.UsernamePlaceholder"]" autocomplete="username" autocapitalize="none" spellcheck="false" />
        <span asp-validation-for="UserName" class="au-field-error"></span>
    </div>

    <div class="au-field">
        <label asp-for="Password">@L["Login.Password"]</label>
        <input asp-for="Password" type="password" placeholder="@L["Login.PasswordPlaceholder"]" autocomplete="current-password" />
        <span asp-validation-for="Password" class="au-field-error"></span>
    </div>

    <div class="au-row">
        <label class="au-check">
            <input asp-for="RememberMe" />
            <span>@L["Login.RememberMe"]</span>
        </label>
        <a asp-action="ForgotPassword" asp-controller="Account" class="au-link b-link">@L["Login.ForgotPassword"]</a>
    </div>

    <button class="b-btn b-btn-honey au-submit" type="submit">@L["Login.LoginButton"]</button>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="au-alert au-alert-error" role="alert">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    @if (TempData[TOP4HoneyChains.Web.Controllers.AccountController.LoginErrorKey] is string loginError)
    {
        <div class="au-alert au-alert-error" role="alert">@loginError</div>
    }

    @if (TempData[TOP4HoneyChains.Web.Controllers.AccountController.LoginSuccessKey] is string loginSuccess)
    {
        <div class="au-alert au-alert-ok" role="status">@loginSuccess</div>
    }
</form>
