@model TOP4HoneyChains.Web.Models.ViewModels.LoginViewModel
@inject Microsoft.Extensions.Options.IOptionsSnapshot<TOP4HoneyChains.Web.Services.OrgModel.FeatureFlags> Flags
@{
    ViewBag.Title = L["Login"].Value;
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    // the return URL in the query (if any) stays on the form's address; after sign-in it is followed when it is local
    var returnUrl = Context.Request.Query["ReturnUrl"].ToString();
}
@section AddToHead {
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
}

<h1 class="au-title">@L["Login.WelcomeBack"]</h1>

@if (ViewBag.SignedInAs is string signedInAs)
{
    @* D-91: someone is already signed in in this browser: say who, and offer to continue or to sign out *@
    <div class="au-alert au-alert-ok" role="status" id="signed-in-as">@L["Login.SignedInAs", signedInAs]</div>
    <p class="au-sub">@L["Login.SignedInAsHelp"]</p>
    <a class="b-btn b-btn-honey au-submit" id="signed-in-continue" href="@ViewBag.ContinueUrl">@L["Login.ContinueAs", signedInAs]</a>
    <a class="b-btn au-submit mt-2" id="signed-in-sign-out" href="/Account/Logout">@L["Login.SignOutToSwitch"]</a>
    @if (TempData[TOP4HoneyChains.Web.Controllers.AccountController.LoginErrorKey] is string signedInError)
    {
        <div class="au-alert au-alert-error mt-3" role="alert">@signedInError</div>
    }
    return;
}

<p class="au-sub">@L["Login.SignInContinue"]</p>

<form asp-action="Login" asp-controller="Account" asp-route-ReturnUrl="@(string.IsNullOrEmpty(returnUrl) ? null : returnUrl)" method="post" class="au-form" id="login-form">
    @Html.AntiForgeryToken()

    <div class="au-field">
        <label asp-for="UserName">@L["Login.Username"]</label>
        <input asp-for="UserName" placeholder="@L["Login.UsernamePlaceholder"]" autocomplete="username" autocapitalize="none" spellcheck="false" aria-describedby="login-beekeeper-hint" />
        @* D-98: a beekeeper's user name is the platform number *@
        <small class="au-sub d-block" id="login-beekeeper-hint">@L["Login.BeekeeperHint"]</small>
        <span asp-validation-for="UserName" class="au-field-error"></span>
    </div>

    <div class="au-field">
        <label asp-for="Password">@L["Login.Password"]</label>
        <input asp-for="Password" type="password" placeholder="@L["Login.PasswordPlaceholder"]" autocomplete="current-password" />
        <span asp-validation-for="Password" class="au-field-error"></span>
    </div>

    <div class="au-row">
        <label class="au-check">
            <input asp-for="RememberMe" />
            <span>@L["Login.RememberMe"]</span>
        </label>
        <a asp-action="ForgotPassword" asp-controller="Account" class="au-link b-link">@L["Login.ForgotPassword"]</a>
    </div>

    <button class="b-btn b-btn-honey au-submit" type="submit">@L["Login.LoginButton"]</button>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="au-alert au-alert-error" role="alert">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    @if (TempData[TOP4HoneyChains.Web.Controllers.AccountController.LoginErrorKey] is string loginError)
    {
        <div class="au-alert au-alert-error" role="alert">@loginError</div>
    }

    @if (TempData[TOP4HoneyChains.Web.Controllers.AccountController.LoginSuccessKey] is string loginSuccess)
    {
        <div class="au-alert au-alert-ok" role="status">@loginSuccess</div>
    }
</form>

@* D-87: a quiet way in for consumers; staff accounts are created by the organizations *@
@if (Flags.Value.ConsumerAccounts)
{
    <p class="au-sub au-consumer-hint" id="consumer-signup-hint">
        @L["Consumer.LoginHint"]
        <a class="au-link b-link" href="/Consumer/SignUp@(TOP4HoneyChains.Web.Controllers.AccountController.IsConsumerReturnUrl(returnUrl) ? "?returnUrl=" + Uri.EscapeDataString(returnUrl) : "")">@L["Consumer.LoginHintLink"]</a>
        <br /><small>@L["Consumer.LoginHintStaff"]</small>
    </p>
}
