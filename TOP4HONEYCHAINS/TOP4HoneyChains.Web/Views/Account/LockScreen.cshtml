@using TOP4HoneyChains.Web.Models.ViewModels
@model UnlockViewModel
@{
    ViewBag.Title = L["Lock-screen"].Value;
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    var name = User.Identity?.Name ?? "";
}

<div class="au-who">
    <span class="au-who-hex" aria-hidden="true">@(name.Length > 0 ? name.Substring(0, 1).ToUpperInvariant() : "?")</span>
    <span>@string.Format(L["Auth.SignedInAs"].Value, name)</span>
</div>
<h1 class="au-title">@L["LockScreen.Locked"]</h1>
<p class="au-sub">@L["LockScreen.EnterPassword"]</p>

<form asp-controller="Account" asp-action="Unlock" method="post" class="au-form">
    @Html.AntiForgeryToken()

    <div class="au-field">
        <label asp-for="Password">@L["LockScreen.Password"]</label>
        <input asp-for="Password" type="password" placeholder="@L["LockScreen.PasswordPlaceholder"]" autocomplete="current-password" />
        <span asp-validation-for="Password" class="au-field-error"></span>
    </div>

    <button class="b-btn b-btn-honey au-submit" type="submit">@L["LockScreen.Unlock"]</button>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="au-alert au-alert-error" role="alert">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }
</form>

<p class="au-alt">
    @L["LockScreen.NotYou"]
    <a asp-controller="Account" asp-action="Login" class="au-link b-link">@L["LockScreen.SignIn"]</a>
</p>
