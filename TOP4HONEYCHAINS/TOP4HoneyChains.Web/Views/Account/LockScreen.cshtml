@using TOP4HoneyChains.Web.Models.ViewModels
@model UnlockViewModel

@{
    ViewBag.Title = "Lock-screen";
    Layout = "~/Views/Shared/_BlankLayout.cshtml";
}

<div class="account-pages my-5 pt-sm-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 col-xl-5">

                <div class="card overflow-hidden">
                    <div class="card-body pt-0">

                        <h3 class="text-center mt-5 mb-4">
                            <a href="/" class="d-block auth-logo">
                                <img src="~/assets/images/logo-dark.png" alt="" height="100" class="auth-logo-dark">
                                <img src="~/assets/images/logo-light.png" alt="" height="100" class="auth-logo-light">
                            </a>
                        </h3>

                        <div class="p-3">

                            <h4 class="text-muted font-size-18 mb-1 text-center">
                                @L["LockScreen.Locked"]
                            </h4>

                            <p class="text-muted text-center">
                                @L["LockScreen.EnterPassword"]
                            </p>

                            <form class="form-horizontal mt-4"
                                  asp-controller="Account"
                                  asp-action="Unlock"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <div class="user-thumb text-center mb-4">

                                    <img src="~/assets/images/users/user-4.jpg"
                                         class="rounded-circle avatar-md img-thumbnail"
                                         alt="thumbnail">

                                    <h6 class="font-size-16 mt-3">
                                        @User.Identity.Name
                                    </h6>

                                </div>

                                <div class="mb-3">

                                    <label>@L["LockScreen.Password"]</label>

                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control"
                                           placeholder="@L["LockScreen.PasswordPlaceholder"]" />

                                    <span asp-validation-for="Password" class="text-danger"></span>

                                </div>

                                <div class="mb-3 row">
                                    <div class="col-12 text-end">

                                        <button class="btn btn-primary w-md waves-effect waves-light"
                                                type="submit">

                                            @L["LockScreen.Unlock"]

                                        </button>

                                    </div>
                                </div>

                            </form>

                        </div>

                    </div>
                </div>

                <div class="mt-5 text-center">

                    <p>
                        @L["LockScreen.NotYou"]

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="text-primary">

                            @L["LockScreen.SignIn"]

                        </a>

                    </p>

                    ©
                    <script>document.write(new Date().getFullYear())</script>
                    TOP4HoneyChains

                </div>

            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/assets/js/app.js"></script>
}