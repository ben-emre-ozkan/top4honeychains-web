@{
    ViewBag.Title = L["FirstPassword.Title"].Value;
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
@* D-78 (D78-SPEC 4.3 step 4): a temporary password issued by SMS (or set by an administrator) is replaced before anything else *@

<h1 class="au-title">@L["FirstPassword.Title"]</h1>
<p class="au-sub">@L["FirstPassword.Intro"]</p>

<form asp-action="FirstPassword" asp-controller="Account" method="post" class="au-form" id="first-password">
    <div class="au-field">
        <label for="password">@L["New Password"]</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="10" required />
        <small class="text-muted">@L["Password.Rule"]</small>
    </div>
    <div class="au-field">
        <label for="confirmPassword">@L["Confirm Password"]</label>
        <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="10" required />
    </div>
    <button type="submit" class="b-btn b-btn-honey au-submit">@L["Update Password"]</button>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="au-alert au-alert-error" role="alert" id="first-password-errors">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@Msg.T(error.ErrorMessage)</div>
            }
        </div>
    }
</form>
<form asp-controller="Account" asp-action="Logout" method="post" class="au-alt m-0">
    <button type="submit" class="b-btn b-btn-ghost">@L["Menu.Logout"]</button>
</form>
