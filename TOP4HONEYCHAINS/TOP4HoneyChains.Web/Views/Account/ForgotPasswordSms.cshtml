@{
    ViewBag.Title = L["Forgot Password"].Value;
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
@* D-78 (D78-SPEC 4.10): the password is reset with a code sent by SMS to the account's verified mobile phone *@

<h1 class="au-title">@L["ForgotPassword.ResetPassword"]</h1>
<p class="au-sub">@L["Reset.SmsIntro"]</p>

<form asp-action="SendResetCode" asp-controller="Account" method="post" class="au-form" id="reset-send-code">
    <div class="au-field">
        <label for="userName">@L["User Name"]</label>
        <input id="userName" name="userName" autocomplete="username" required />
    </div>
    <button type="submit" class="b-btn b-btn-honey au-submit">@L["Notice.SendCode"]</button>
</form>

<p class="au-alt">@L["Reset.NoPhone"]</p>
<p class="au-alt">
    @L["ForgotPassword.RememberYourPassword"]
    <a asp-action="Login" asp-controller="Account" class="au-link b-link">@L["ForgotPassword.SignIn"]</a>
</p>
