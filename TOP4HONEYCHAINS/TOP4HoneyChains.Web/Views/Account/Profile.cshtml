@using TOP4HoneyChains.Web.Models.ViewModels
@model ProfileViewModel

@{
    ViewData["Title"] = L["Profile"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}
<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title">@L["Profile"]</h4>
                            <p class="card-title-desc">
                                @L["Manage your account information."]
                            </p>

                            <form asp-action="UpdatePhone" class="custom-validation">

                                <div class="mb-3">

                                    <label class="form-label">@L["Username"]</label>

                                    <input class="form-control"
                                           value="@Model.UserName"
                                           readonly />

                                </div>

                                <div class="mb-3">

                                    <label class="form-label">@L["Email"]</label>

                                    <input class="form-control"
                                           value="@Model.Email"
                                           readonly />

                                </div>

                                <div class="mb-3">

                                    <label class="form-label">@L["Phone Number"]
                                        @if (Model.PhoneConfirmed)
                                        {
                                            <span class="badge bg-success-subtle text-success border ms-1" id="phone-verified"><i class="mdi mdi-check"></i> @L["Phone.Verified"]</span>
                                        }
                                        else if (!string.IsNullOrEmpty(Model.PhoneNumber))
                                        {
                                            <span class="badge bg-warning-subtle text-dark border ms-1" id="phone-unverified">@L["Phone.NotVerified"]</span>
                                        }
                                    </label>

                                    <input asp-for="PhoneNumber"
                                           class="form-control"
                                           placeholder="+90 5xx xxx xxxx" />
                                    <div class="form-text">@L["Phone.Help"]</div>

                                </div>

                                <div class="d-flex gap-2">

                                    <button type="submit"
                                            class="btn btn-primary waves-effect waves-light" id="phone-send-code">
                                        @L["Notice.SendCode"]
                                    </button>

                                    <button type="button"
                                            class="btn btn-warning"
                                            data-bs-toggle="modal"
                                            data-bs-target="#changePasswordModal">
                                        @L["Change Password"]
                                    </button>

                                </div>

                            </form>

                            @if (TempData.Peek("PendingPhone") is string pendingPhone)
                            {
                                <form asp-action="VerifyPhone" method="post" class="row g-2 align-items-end mt-3" id="phone-verify">
                                    <input type="hidden" name="phone" value="@pendingPhone" />
                                    <div class="col-auto">
                                        <label class="form-label" for="phone-code">@L["Notice.Code"] · @TOP4HoneyChains.Web.Services.PhoneNumberPolicy.Display(pendingPhone)</label>
                                        <input id="phone-code" name="code" class="form-control" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required />
                                    </div>
                                    <div class="col-auto"><button type="submit" class="btn btn-success">@L["Notice.Accept"]</button></div>
                                </form>
                            }

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <div class="modal fade"
         id="changePasswordModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog">
            <div class="modal-content">

                <form asp-action="ChangePassword">

                    <div class="modal-header">
                        <h5 class="modal-title">@L["Change Password"]</h5>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">

                        <div class="mb-3">

                            <label class="form-label">@L["Current Password"]</label>

                            <input type="password"
                                   name="CurrentPassword"
                                   class="form-control"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">@L["New Password"]</label>

                            <input type="password"
                                   name="NewPassword"
                                   class="form-control"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">@L["Confirm Password"]</label>

                            <input type="password"
                                   name="ConfirmPassword"
                                   class="form-control"
                                   required />

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">
                            @L["Cancel"]
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            @L["Update Password"]
                        </button>

                    </div>

                </form>

            </div>
        </div>
    </div>
</body>