@using TOP4HoneyChains.Web.Models.ViewModels
@model ProfileViewModel

@{
    ViewData["Title"] = L["Profile"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}
<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title">@L["Profile"]</h4>
                            <p class="card-title-desc">
                                @L["Manage your account information."]
                            </p>

                            <form asp-action="UpdatePhone" class="custom-validation">

                                <div class="mb-3">

                                    <label class="form-label">@L["Username"]</label>

                                    <input class="form-control"
                                           value="@Model.UserName"
                                           readonly />

                                </div>

                                <div class="mb-3">

                                    <label class="form-label">@L["Email"]</label>

                                    <input class="form-control"
                                           value="@Model.Email"
                                           readonly />

                                </div>

                                <div class="mb-3">

                                    <label class="form-label">@L["Phone Number"]</label>

                                    <input asp-for="PhoneNumber"
                                           class="form-control"
                                           placeholder="+90 5xx xxx xxxx" />

                                </div>

                                <div class="d-flex gap-2">

                                    <button type="submit"
                                            class="btn btn-primary waves-effect waves-light">
                                        @L["Save"]
                                    </button>

                                    <button type="button"
                                            class="btn btn-warning"
                                            data-bs-toggle="modal"
                                            data-bs-target="#changePasswordModal">
                                        @L["Change Password"]
                                    </button>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <div class="modal fade"
         id="changePasswordModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog">
            <div class="modal-content">

                <form asp-action="ChangePassword">

                    <div class="modal-header">
                        <h5 class="modal-title">@L["Change Password"]</h5>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">

                        <div class="mb-3">

                            <label class="form-label">@L["Current Password"]</label>

                            <input type="password"
                                   name="CurrentPassword"
                                   class="form-control"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">@L["New Password"]</label>

                            <input type="password"
                                   name="NewPassword"
                                   class="form-control"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">@L["Confirm Password"]</label>

                            <input type="password"
                                   name="ConfirmPassword"
                                   class="form-control"
                                   required />

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">
                            @L["Cancel"]
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            @L["Update Password"]
                        </button>

                    </div>

                </form>

            </div>
        </div>
    </div>
</body>