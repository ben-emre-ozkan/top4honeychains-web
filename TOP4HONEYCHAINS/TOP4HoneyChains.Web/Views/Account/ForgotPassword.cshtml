@model TOP4HoneyChains.Web.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewBag.Title = "Forgot Password";
    Layout = "~/Views/Shared/_BlankLayout.cshtml";
}

<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
<meta http-equiv="Pragma" content="no-cache" />
<meta http-equiv="Expires" content="0" />

<style>

    html, body {
        height: 100%;
        margin: 0;
    }

    .login-page {
        height: 100vh;
        display: flex;
    }

    /* LEFT FORM */

    .login-left {
        width: 40%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
    }

    /* RIGHT VIDEO */

    .login-right {
        width: 60%;
        position: relative;
        overflow: hidden;
    }

    /* VIDEO */

    .login-video {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* OVERLAY */

    .video-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.35);
    }

    /* VIDEO TEXT */

    .video-text {
        position: absolute;
        bottom: 80px;
        left: 60px;
        color: white;
        max-width: 420px;
    }

        .video-text h2 {
            font-size: 48px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .video-text p {
            font-size: 24px;
            opacity: 0.9;
        }

    /* CARD */

    .login-card {
        width: 420px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.25);
        border-radius: 12px;
    }

</style>


<div class="login-page">


    <!-- LEFT CARD -->

    <div class="login-left">

        <div class="card login-card overflow-hidden">

            <div class="card-body pt-0">

                <h3 class="text-center mt-5 mb-4">

                    <a href="/" class="d-block auth-logo">

                        <img src="~/assets/images/logo-dark.png" height="120">

                    </a>

                </h3>


                <div class="p-3">

                    <h4 class="text-muted font-size-18 mb-3 text-center">
                        @L["ForgotPassword.ResetPassword"]
                    </h4>

                    <div class="alert alert-info">
                        @L["ForgotPassword.MessageText"]
                    </div>


                    <form asp-action="ForgotPassword"
                          asp-controller="Account"
                          method="post"
                          class="form-horizontal mt-4">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">

                            <label asp-for="Email">@L["ForgotPassword.Email"]</label>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder=@L["ForgotPassword.EmailPlaceholder"] />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>

                        </div>


                        <div class="mb-3 row">

                            <div class="col-12 text-end">

                                <button type="submit"
                                        class="btn btn-primary w-md waves-effect waves-light">

                                    @L["ForgotPassword.ResetButton"]

                                </button>

                            </div>

                        </div>


                        @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                        {
                            <div class="text-danger mt-3">
                                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                            </div>
                        }

                        @if (ViewBag.Message != null)
                        {
                            <div class="alert alert-success mt-3">
                                @ViewBag.Message
                            </div>
                        }

                        @if (ViewBag.DebugLink != null)
                        {
                            <div class="alert alert-warning mt-2">

                                <strong>DEV MODE:</strong><br />

                                <a href="@ViewBag.DebugLink">
                                    @ViewBag.DebugLink
                                </a>

                            </div>
                        }

                    </form>


                    <hr class="mt-4">


                    <div class="text-center">

                        <p class="mb-0 text-muted">

                            @L["ForgotPassword.RememberYourPassword"]

                            <a asp-action="Login"
                               asp-controller="Account"
                               class="fw-semibold text-primary">

                                @L["ForgotPassword.SignIn"]

                            </a>

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- RIGHT VIDEO -->

    <div class="login-right">

        <video autoplay muted loop playsinline class="login-video">
            <source src="~/landingassets/videos/261844.mp4" type="video/mp4">
        </video>

        <div class="video-overlay"></div>

        <div class="video-text">

            <h2>TOP4HoneyChains</h2>

            <p>
                Trustable and Sustainable Open Platform
                for Smart Honey Value Chains
            </p>

        </div>

    </div>


</div>


@section scripts {

    <script src="~/assets/js/app.js"></script>

    <partial name="_ValidationScriptsPartial" />

}