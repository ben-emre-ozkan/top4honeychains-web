@model TOP4HoneyChains.Web.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewBag.Title = L["Forgot Password"].Value;
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
@section AddToHead {
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
}

<h1 class="au-title">@L["ForgotPassword.ResetPassword"]</h1>
<p class="au-sub">@L["ForgotPassword.MessageText"]</p>

<form asp-action="ForgotPassword" asp-controller="Account" method="post" class="au-form">
    @Html.AntiForgeryToken()

    <div class="au-field">
        <label asp-for="Email">@L["ForgotPassword.Email"]</label>
        <input asp-for="Email" placeholder="@L["ForgotPassword.EmailPlaceholder"]" autocomplete="email" />
        <span asp-validation-for="Email" class="au-field-error"></span>
    </div>

    <button type="submit" class="b-btn b-btn-honey au-submit">@L["ForgotPassword.ResetButton"]</button>

    @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="au-alert au-alert-error" role="alert">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    @if (ViewBag.Message != null)
    {
        <div class="au-alert au-alert-ok" role="status">@ViewBag.Message</div>
    }

    @if (ViewBag.DebugLink != null)
    {
        <div class="au-alert au-alert-warn">
            <strong>@L["DEV MODE:"]</strong><br />
            <a href="@ViewBag.DebugLink" class="au-link b-link">@ViewBag.DebugLink</a>
        </div>
    }
</form>

<p class="au-alt">
    @L["ForgotPassword.RememberYourPassword"]
    <a asp-action="Login" asp-controller="Account" class="au-link b-link">@L["ForgotPassword.SignIn"]</a>
</p>
