@model TOP4HoneyChains.Web.Models.ViewModels.ResetPasswordViewModel
@{
    ViewBag.Title = L["Reset Password"].Value;
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<h1 class="au-title">@L["Create New Password"]</h1>

<form asp-action="ResetPassword" asp-controller="Account" method="post" class="au-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />

    <div class="au-field">
        <label asp-for="Password">@L["New Password"]</label>
        <input asp-for="Password" type="password" placeholder="@L["Enter new password"]" autocomplete="new-password" />
        <span asp-validation-for="Password" class="au-field-error"></span>
    </div>

    <div class="au-field">
        <label asp-for="ConfirmPassword">@L["Confirm Password"]</label>
        <input asp-for="ConfirmPassword" type="password" placeholder="@L["Confirm Password"]" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="au-field-error"></span>
    </div>

    <button type="submit" class="b-btn b-btn-honey au-submit">@L["Reset Password"]</button>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="au-alert au-alert-error" role="alert">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }
</form>
