@model TOP4HoneyChains.Web.Models.Entities.RawHoneyProductionPeriod

@{
    ViewData["Title"] = L["Delete Production Period"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card border-danger">
                        <div class="card-body">

                            <h4 class="card-title text-danger">
                                @L["Delete Production Period"]
                            </h4>

                            <p class="card-title-desc">
                                @L["Are you sure you want to delete this production period? This action cannot be undone."]
                            </p>

                            <hr />

                            <dl class="row">

                                <dt class="col-sm-3">
                                    @L["Period Title"]
                                </dt>
                                <dd class="col-sm-9">
                                    @Model.RawHoneyProductionPeriodTitle
                                </dd>

                                <dt class="col-sm-3">
                                    @L["Start Date"]
                                </dt>
                                <dd class="col-sm-9">
                                    @Model.RawHoneyProductionPeriodStartDate.Value.ToString("dd.MM.yyyy")
                                </dd>

                                <dt class="col-sm-3">
                                    @L["End Date"]
                                </dt>
                                <dd class="col-sm-9">
                                    @Model.RawHoneyProductionPeriodEndDate.Value.ToString("dd.MM.yyyy")
                                </dd>

                            </dl>

                            <hr />

                            <form asp-action="Delete" class="d-flex gap-2">

                                <input type="hidden" asp-for="RawHoneyProductionPeriodId" />

                                <button type="submit"
                                        class="btn btn-danger waves-effect waves-light">
                                    @L["Delete"]
                                </button>

                                <a asp-action="Index"
                                   class="btn btn-secondary waves-effect">
                                    @L["Cancel"]
                                </a>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/js/app.js"></script>
    }

</body>
