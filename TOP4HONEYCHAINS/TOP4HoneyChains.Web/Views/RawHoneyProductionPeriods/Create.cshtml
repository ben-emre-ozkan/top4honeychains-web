@model TOP4HoneyChains.Web.Models.Entities.RawHoneyProductionPeriod

@{
    ViewData["Title"] = "Create Production Period";
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title">Create New Production Period</h4>
                            <p class="card-title-desc">
                                Define a new raw honey production period.
                            </p>

                            <form asp-action="Create" class="custom-validation">

                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                <!-- Title -->
                                <div class="mb-3">
                                    <label asp-for="RawHoneyProductionPeriodTitle"
                                           class="form-label">
                                        Period Title
                                    </label>
                                    <input asp-for="RawHoneyProductionPeriodTitle"
                                           class="form-control"
                                           placeholder="Enter production period title" />
                                    <span asp-validation-for="RawHoneyProductionPeriodTitle"
                                          class="text-danger"></span>
                                </div>

                                <!-- Start Date -->
                                <div class="mb-3">
                                    <label asp-for="RawHoneyProductionPeriodStartDate"
                                           class="form-label">
                                        Start Date
                                    </label>
                                    <input asp-for="RawHoneyProductionPeriodStartDate"
                                           type="date"
                                           class="form-control" />
                                    <span asp-validation-for="RawHoneyProductionPeriodStartDate"
                                          class="text-danger"></span>
                                </div>

                                <!-- End Date -->
                                <div class="mb-3">
                                    <label asp-for="RawHoneyProductionPeriodEndDate"
                                           class="form-label">
                                        End Date
                                    </label>
                                    <input asp-for="RawHoneyProductionPeriodEndDate"
                                           type="date"
                                           class="form-control" />
                                    <span asp-validation-for="RawHoneyProductionPeriodEndDate"
                                          class="text-danger"></span>
                                </div>

                                <!-- Buttons -->
                                <div class="d-flex gap-2">

                                    <button type="submit"
                                            class="btn btn-primary waves-effect waves-light">
                                        Save
                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-secondary waves-effect">
                                        Back to List
                                    </a>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/libs/parsleyjs/parsley.min.js"></script>
        <script src="~/assets/js/pages/form-validation.init.js"></script>
        <script src="~/assets/js/app.js"></script>
    }

</body>
