@using TOP4HoneyChains.Web.Services.OrgModel
@inject Permissions WorkPermissions
@{
    // "İşlerim" (D-44), redesigned with the app skin (D-66): greeting, role chip, one hexagon tile per group, one card per
    // group; "New" marks are set in the browser (wwwroot/js/app-shell.js), per membership.
    ViewData["Title"] = L["Work.Title"];
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var items = ViewBag.Items as List<MyWorkService.Item> ?? new();
    var active = ViewBag.Active as ActiveMembership;
    var memberships = ViewBag.Memberships as List<MembershipOption> ?? new();
    var isAdmin = User.IsInRole("Administrator");
    string KindText(string k) => L["Work.Kind." + k].Value;
    string KindIcon(string k) => k switch
    {
        "Approve" => "mdi-check-decagram", "LabApprove" => "mdi-flask-outline", "Finalize" => "mdi-package-variant-closed",
        "Confirm" => "mdi-truck-check-outline", "Receive" => "mdi-inbox-arrow-down-outline", "Results" => "mdi-test-tube",
        "Verify" => "mdi-shield-check-outline", "Registry" => "mdi-card-account-details-outline", "Correction" => "mdi-pencil-circle-outline",
        _ => "mdi-clipboard-edit-outline"
    };
    var order = new[] { "Approve", "LabApprove", "Finalize", "Confirm", "Receive", "Results", "Verify", "Registry", "Correction", "Enter" };
    var groups = items.GroupBy(i => i.Kind).OrderBy(g => Array.IndexOf(order, g.Key)).ToList();
    // D-67: the person's full name when the account has one (name claims), otherwise the user name
    var fullName = User.FindFirst("full_name")?.Value
        ?? string.Join(" ", new[] { User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value, User.FindFirst(System.Security.Claims.ClaimTypes.Surname)?.Value }.Where(x => !string.IsNullOrWhiteSpace(x)));
    var userName = !string.IsNullOrWhiteSpace(fullName) ? fullName : User.Identity?.Name ?? "";

    // how long an item has been waiting: whole days, the exact date in the tooltip; more than 3 days gets an amber mark
    (string Text, string Exact, bool Old)? Age(DateTime? since)
    {
        if (since == null) return null;
        var local = since.Value.ToLocalTime();
        var days = (DateTime.Now.Date - local.Date).Days;
        var text = days <= 0 ? L["Work.WaitingToday"].Value : days == 1 ? L["Work.WaitingOneDay"].Value : string.Format(L["Work.WaitingDays"].Value, days);
        return (text, local.ToString("dd.MM.yyyy HH:mm"), days > 3);
    }

    // the menu entries this user can open, for the empty state
    var links = new List<(string Url, string Text, string Icon)>();
    if (isAdmin)
    {
        links.Add(("/Organizations/Index", L["Org.Organizations"].Value, "mdi-domain"));
        links.Add(("/Registry/Index", L["Reg.Title"].Value, "mdi-card-account-details-outline"));
        links.Add(("/CCPMonitoring/Corrections", L["Corr.Title"].Value, "mdi-pencil-circle-outline"));
    }
    else
    {
        links.Add(("/OrgWorkspace/Index", L["Org.MyOrganization"].Value, "mdi-domain"));
        if (active != null && MemberMenu.Intake(active, WorkPermissions)) { links.Add(("/Intake/Index", L["Cust.Intakes"].Value, "mdi-truck-delivery-outline")); }
        if (active != null && MemberMenu.Samples(active, WorkPermissions)) { links.Add(("/Samples/Index", L["Lab.Samples"].Value, "mdi-flask-outline")); }
        if (active != null && MemberMenu.Shipments(active, WorkPermissions)) { links.Add(("/Shipments/Index", L["Cust.Shipments"].Value, "mdi-truck-outline")); }
        if (active != null && MemberMenu.Storefronts(active, WorkPermissions)) { links.Add(("/Storefronts/Index", L["P5.Storefronts"].Value, "mdi-storefront-outline")); }
    }
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid" id="work-page">
            <header class="work-head">
                <div class="work-head-text">
                    <p class="app-kicker">@L["Work.Title"]</p>
                    <h1 class="work-greeting">@string.Format(L["Work.Greeting"].Value, userName)</h1>
                    @if (active != null)
                    {
                        <div class="work-head-chip" id="work-membership">
                            <partial name="_RoleChip" model="@(new TOP4HoneyChains.Web.Models.ViewModels.RoleChipModel(active, memberships))" />
                        </div>
                        @if (!active.IsVerified) { <div class="alert alert-warning mt-3 mb-0">@L["Org.NotVerifiedBanner"]</div> }
                    }
                    @if (items.Count > 0)
                    {
                        <p class="work-summary">@(items.Count == 1 ? L["Work.SummaryOne"].Value : string.Format(L["Work.SummaryMany"].Value, items.Count))</p>
                    }
                </div>
                @if (groups.Any())
                {
                    <nav class="work-tiles" aria-label="@L["Work.Groups"]">
                        @foreach (var g in groups)
                        {
                            <a class="work-tile" href="#group-@g.Key">
                                <span class="work-tile-hex" aria-hidden="true"><i class="mdi @KindIcon(g.Key)"></i></span>
                                <span class="work-tile-count">@g.Count()</span>
                                <span class="work-tile-label">@KindText(g.Key)</span>
                            </a>
                        }
                    </nav>
                }
            </header>

            @if (!items.Any())
            {
                <section class="card work-empty" id="work-empty">
                    <div class="card-body">
                        <partial name="_BeeArt" model="@L["Work.EmptyArt"].Value" />
                        <p class="work-empty-text">@L["Work.Empty"]</p>
                        @if (links.Any())
                        {
                            <p class="work-empty-sub">@L["Work.YouCanOpen"]</p>
                            <ul class="work-empty-links">
                                @foreach (var l in links)
                                {
                                    <li><a class="btn btn-outline-secondary" href="@l.Url"><i class="mdi @l.Icon me-1" aria-hidden="true"></i>@l.Text</a></li>
                                }
                            </ul>
                        }
                    </div>
                </section>
            }

            @foreach (var group in groups)
            {
                <section class="card work-group" data-kind="@group.Key" id="group-@group.Key" aria-labelledby="group-title-@group.Key">
                    <div class="card-body">
                        <h2 class="work-group-title" id="group-title-@group.Key">
                            <span class="work-group-hex" aria-hidden="true"><i class="mdi @KindIcon(group.Key)"></i></span>
                            <span>@KindText(group.Key)</span>
                            <span class="work-group-count">@group.Count()</span>
                        </h2>
                        <ul class="work-list">
                            @foreach (var i in group.OrderBy(i => i.Since ?? DateTime.MaxValue).Take(100))
                            {
                                var age = Age(i.Since);
                                <li>
                                    <a href="@i.Url" class="work-item @(age?.Old == true ? "is-old" : "")" data-key="@(i.Kind)|@(i.Url)">
                                        <span class="work-item-main">
                                            <span class="work-item-title">@i.Title@if (i.TitleKind != null) {<text> · @L[i.TitleKind]</text>}</span>
                                            <span class="work-new" hidden>@L["Work.New"]</span>
                                            @if (i.Detail != null) { <span class="work-item-detail">@(i.Detail is "lot" or "batch" or "storage" ? L["Kind." + i.Detail].Value : i.Detail)</span> }
                                            @if (i.Waiting != null) { <span class="work-waiting"><i class="mdi mdi-timer-sand" aria-hidden="true"></i> @Msg.T(i.Waiting)</span> }
                                        </span>
                                        @if (age != null)
                                        {
                                            <span class="work-age" title="@age.Value.Exact">
                                                @if (age.Value.Old) { <i class="mdi mdi-alert-outline" aria-hidden="true"></i> }
                                                @age.Value.Text
                                            </span>
                                        }
                                        <i class="mdi mdi-chevron-right work-go" aria-hidden="true"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </section>
            }
        </div>
    </div>
</body>
