@using Microsoft.AspNetCore.Identity
@using TOP4HoneyChains.Web.Models.Identity
@inject UserManager<ApplicationUser> UserManager

@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = L["Users"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    // D-87: the account kind of every user, and the consumer accounts' pseudonym and status
    var kinds = ViewBag.Kinds as Dictionary<string, string> ?? new();
    var consumerRows = ViewBag.Consumers as Dictionary<string, TOP4HoneyChains.Web.Models.Entities.ConsumerAccount> ?? new();
    var kindFilter = ViewBag.Kind as string;
}

@section AddToHead {

    <link href="~/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" />

    <link href="~/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" />

}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-12">

                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title">@L["User Management"]</h4>

                            <p class="card-title-desc">

                                <a asp-action="Create"
                                   class="btn btn-primary waves-effect waves-light">

                                    @L["Add New User"]

                                </a>

                            </p>

                            <nav class="d-flex flex-wrap gap-2 small mb-2" id="user-kind-filter" aria-label="@L["Users.Kind"]">
                                <a href="/UserManagement/Index" class="@(kindFilter == null ? "fw-bold" : "")">@L["Users.AllKinds"]</a>
                                @foreach (var k in TOP4HoneyChains.Web.Services.OrgModel.ConsumerRules.Kinds)
                                {
                                    <a href="/UserManagement/Index?kind=@k" class="@(kindFilter == k ? "fw-bold" : "")">@L["Users.Kind." + k]</a>
                                }
                            </nav>

                            <table id="datatable-buttons"
                                   class="table table-striped table-bordered dt-responsive nowrap"
                                   style="width:100%">

                                <thead>

                                    <tr>

                                        <th>@L["User Name"]</th>
                                        <th>@L["Email"]</th>
                                        <th>@L["Users.Kind"]</th>
                                        <th>@L["Role"]</th>
                                        <th style="width:220px">@L["Actions"]</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var user in Model)
                                    {

                                        var roles = await UserManager.GetRolesAsync(user);
                                        var kind = kinds.TryGetValue(user.Id, out var k2) ? k2 : TOP4HoneyChains.Web.Services.OrgModel.ConsumerRules.Staff;
                                        consumerRows.TryGetValue(user.Id, out var consumerRow);
                                        var isConsumer = kind == TOP4HoneyChains.Web.Services.OrgModel.ConsumerRules.Consumer;

                                        <tr>

                                           

                                            <td>@user.UserName @if (user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.UtcNow) {<span class="badge bg-danger-subtle text-danger border ms-1 user-locked" title="@user.LockoutEnd.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")"><i class="mdi mdi-lock-outline"></i> @L["Locked"]</span>}</td>

                                            <td>@user.Email</td>

                                            <td data-kind="@kind">
                                                <span class="badge bg-light text-dark border user-kind">@L["Users.Kind." + kind]</span>
                                                @if (consumerRow != null)
                                                {
                                                    <code class="ms-1">@consumerRow.Pseudonym</code>
                                                    @if (consumerRow.Status == TOP4HoneyChains.Web.Models.Entities.ConsumerAccountStatus.Locked)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border ms-1 consumer-locked">@L["Users.ConsumerLocked"]</span>
                                                    }
                                                }
                                            </td>

                                            <td>

                                                @foreach (var role in roles)
                                                {
                                                    <span class="badge badge-soft-dark mr-1"><i class="mdi mdi-shield-account"></i> @(L[role].ResourceNotFound ? Ref.Role(role) : L[role].Value)</span>
                                                }

                                            </td>

                                            <td>

                                                <div class="d-flex gap-2">
                                                    @if (isConsumer)
                                                    {
                                                        @* D-87: consumers set their own password and phone; the administrator locks, unlocks or deletes *@
                                                        @if (consumerRow != null && consumerRow.Status == TOP4HoneyChains.Web.Models.Entities.ConsumerAccountStatus.Active)
                                                        {
                                                            <form asp-action="LockConsumer" asp-route-id="@user.Id" method="post" class="m-0">
                                                                <button type="submit" class="btn btn-sm btn-outline-danger lock-consumer"><i class="mdi mdi-lock-outline"></i> @L["Users.LockConsumer"]</button>
                                                            </form>
                                                        }
                                                        else if (consumerRow != null)
                                                        {
                                                            <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="m-0">
                                                                <button type="submit" class="btn btn-sm btn-outline-success unlock-user"><i class="mdi mdi-lock-open-variant-outline"></i> @L["Unlock"]</button>
                                                            </form>
                                                        }
                                                        @if (consumerRow != null)
                                                        {
                                                            <button class="btn btn-sm btn-danger" onclick="deleteUser('@user.Id')">@L["Delete"]</button>
                                                        }
                                                    }
                                                    else
                                                    {

                                                    <button class="btn btn-warning btn-sm"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#changePasswordModal"
                                                            data-userid="@user.Id"
                                                            data-username="@user.UserName">

                                                        <i class="mdi mdi-lock-reset"></i>
                                                        @L["Reset Password"]

                                                    </button>

                                                    <form asp-action="IssueCredentials" asp-route-id="@user.Id" method="post" class="m-0 d-flex gap-1 issue-credentials">
                                                        <input name="phone" type="tel" class="form-control form-control-sm" style="width: 9.5rem" value="@user.PhoneNumber" placeholder="+90 5xx" aria-label="@L["Notice.MobilePhone"]" />
                                                        <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap"><i class="mdi mdi-message-lock-outline"></i> @L["UM.SendSignIn"]</button>
                                                    </form>
                                                    @if (user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.UtcNow)
                                                    {
                                                        <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="m-0">
                                                            <button type="submit" class="btn btn-sm btn-outline-success unlock-user"><i class="mdi mdi-lock-open-variant-outline"></i> @L["Unlock"]</button>
                                                        </form>
                                                    }
                                                    <button class="btn btn-sm btn-danger"
                                                            onclick="deleteUser('@user.Id')">

                                                        @L["Delete"]

                                                    </button>
                                                    }

                                                </div>

                                            </td>

                                        </tr>

                                    }

                                </tbody>

                            </table>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>


    <div id="changePasswordModal"
         class="modal fade"
         tabindex="-1"
         role="dialog">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <form asp-action="ChangePassword"
                      method="post">

                    <div class="modal-header">

                        <h5 class="modal-title">
                            @L["Reset User Password"]
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"></button>

                    </div>

                    <div class="modal-body">

                        <input type="hidden"
                               name="UserId"
                               id="modalUserId" />

                        <div class="mb-3">

                            <label class="form-label">
                                @L["New Password"]
                            </label>

                            <input type="password"
                                   name="NewPassword"
                                   class="form-control"
                                   required>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                @L["Confirm Password"]
                            </label>

                            <input type="password"
                                   name="ConfirmPassword"
                                   class="form-control"
                                   required>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">
                            @L["Cancel"]
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            @L["Update Password"]
                        </button>

                    </div>

                </form>

            </div>
        </div>
    </div>

    @* Deletes are POSTs with an anti-forgery token (no state change via GET) *@
    <form id="deleteUserForm" asp-controller="UserManagement" asp-action="Delete" method="post" class="d-none">
        <input type="hidden" name="id" />
    </form>

    @section scripts{

        <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
        <script src="~/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>

        <script src="~/assets/libs/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons-bs4/js/buttons.bootstrap4.min.js"></script>

        <script src="~/assets/libs/jszip/jszip.min.js"></script>
        <script src="~/assets/libs/pdfmake/build/pdfmake.min.js"></script>
        <script src="~/assets/libs/pdfmake/build/vfs_fonts.js"></script>

        <script src="~/assets/libs/datatables.net-buttons/js/buttons.html5.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.print.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.colVis.min.js"></script>

        <script src="~/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
        <script src="~/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>

        <script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>

        <script src="~/assets/js/pages/datatables.init.js"></script>

        <script src="~/assets/js/app.js"></script>


        <script>
            function openPasswordModal(userId) {
                $('#passwordUserId').val(userId);
                $('#passwordModal').modal('show');
            }
            function deleteUser(userId) {
                Swal.fire({
                    title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Are you sure?"].Value)),
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["This action cannot be undone"].Value)),
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#B42318',
                    cancelButtonColor: '#7B6A5C',
                    confirmButtonText: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Yes, delete"].Value)), cancelButtonText: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Cancel"].Value))
                }).then((result) => {
                    if (result.isConfirmed) {
                        var f = document.getElementById('deleteUserForm');
                        f.elements['id'].value = userId;
                        f.submit();
                    }
                });
            }
        </script>

        <script>

            var changeModal = document.getElementById('changePasswordModal')

            changeModal.addEventListener('show.bs.modal', function (event) {

            var button = event.relatedTarget

            var userId = button.getAttribute('data-userid')

            document.getElementById('modalUserId').value = userId

            })

        </script>


    }

</body>