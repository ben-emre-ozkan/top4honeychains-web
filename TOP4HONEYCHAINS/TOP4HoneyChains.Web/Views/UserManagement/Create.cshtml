@model TOP4HoneyChains.Web.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = L["Create User"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title">@L["Create New User"]</h4>

                            <form asp-action="Create"
                                  method="post"
                                  class="custom-validation">

                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                <div class="mb-3">

                                    <label class="form-label required">@L["User Name"]</label>

                                    <input asp-for="UserName"
                                           class="form-control"
                                           required
                                           placeholder="@L["Enter username"]" />

                                    <span asp-validation-for="UserName" class="text-danger"></span>

                                </div>

                                <div class="mb-3">

                                    <label class="form-label required">@L["Email"]</label>

                                    <input asp-for="Email"
                                           class="form-control"
                                           required
                                           type="email"
                                           placeholder="@L["Enter email"]" />

                                    <span asp-validation-for="Email" class="text-danger"></span>

                                </div>

                                <div class="mb-3">

                                    <label class="form-label required">@L["Password"]</label>

                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control"
                                           required
                                           id="password1"
                                           placeholder="@L["Enter password"]" />

                                    <span asp-validation-for="Password" class="text-danger"></span>

                                </div>

                                <div class="mb-3">

                                    <label class="form-label required">@L["Confirm Password"]</label>

                                    <input asp-for="ConfirmPassword"
                                           type="password"
                                           class="form-control"
                                           required
                                           data-parsley-equalto="#password1"
                                           placeholder="@L["Confirm password"]" />

                                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                                </div>

                                <div class="mb-3">

                                    <label class="form-label required">@L["Role"]</label>

                                    <select asp-for="Role" class="form-select">

                                        <option value="">@L["Select Role"]</option>

                                        @foreach (var role in ViewBag.Roles)
                                        {
                                            <option value="@role">@role</option>
                                        }

                                    </select>

                                    <span asp-validation-for="Role" class="text-danger"></span>

                                </div>

                                <div class="mb-0">

                                    <button type="submit"
                                            class="btn btn-primary waves-effect waves-light me-1">

                                        @L["Create User"]

                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-secondary waves-effect">

                                        @L["Cancel"]

                                    </a>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
    @section scripts{

        <script src="~/assets/libs/parsleyjs/parsley.min.js"></script>

        <script src="~/assets/js/pages/form-validation.init.js"></script>

        <script src="~/assets/js/app.js"></script>

    }
</body>