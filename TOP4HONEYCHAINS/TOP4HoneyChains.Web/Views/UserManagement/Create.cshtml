@model TOP4HoneyChains.Web.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = L["Create User"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title">@L["Create New User"]</h4>

                            <form asp-action="Create"
                                  method="post"
                                  class="custom-validation">

                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                <div class="mb-3">

                                    <label class="form-label required">@L["User Name"]</label>

                                    <input asp-for="UserName"
                                           class="form-control"
                                           required
                                           placeholder="@L["Enter username"]" />

                                    <span asp-validation-for="UserName" class="text-danger"></span>

                                </div>

                                <div class="mb-3">

                                    <label class="form-label">@L["Email"] <span class="text-muted small">(@L["optional"])</span></label>

                                    <input asp-for="Email"
                                           class="form-control"
                                           type="email"
                                           placeholder="@L["Enter email"]" />

                                    <span asp-validation-for="Email" class="text-danger"></span>

                                </div>

                                @* D-78 (D78-SPEC 4.3): the sign-in details go by SMS; an initial password set here is the exception *@
                                <div class="mb-3">
                                    <label class="form-label" for="PhoneNumber">@L["Notice.MobilePhone"]</label>
                                    <input asp-for="PhoneNumber" class="form-control" type="tel" placeholder="+90 532 123 45 67" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>

                                <fieldset class="mb-3" id="delivery">
                                    <legend class="form-label fs-6">@L["UM.Delivery"]</legend>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="Delivery" id="delivery-sms" value="Sms" checked="@(Model.Delivery != "Manual")" />
                                        <label class="form-check-label" for="delivery-sms">@L["UM.DeliverySms"]</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="Delivery" id="delivery-manual" value="Manual" checked="@(Model.Delivery == "Manual")" />
                                        <label class="form-check-label" for="delivery-manual">@L["UM.DeliveryManual"]</label>
                                    </div>
                                </fieldset>

                                <div id="manual-password" class="@(Model.Delivery == "Manual" ? "" : "d-none")">
                                <div class="mb-3">

                                    <label class="form-label required">@L["Password"]</label>

                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control"
                                           id="password1"
                                           autocomplete="new-password"
                                           placeholder="@L["Enter password"]" />

                                    <span asp-validation-for="Password" class="text-danger"></span>

                                </div>

                                <div class="mb-3">

                                    <label class="form-label required">@L["Confirm Password"]</label>

                                    <input asp-for="ConfirmPassword"
                                           type="password"
                                           class="form-control"
                                           data-parsley-equalto="#password1"
                                           autocomplete="new-password"
                                           placeholder="@L["Confirm Password"]" />

                                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                                </div>
                                </div>

                                <div class="mb-3">

                                    @if (ViewBag.OrgModel == true)
                                    {
                                        @* D-22: organization roles are memberships; the only global role is the platform administrator *@
                                        <label class="form-label">@L["UM.GlobalRole"]</label>
                                        <select asp-for="Role" class="form-select" id="role-select">
                                            <option value="">@L["UM.NoGlobalRole"]</option>
                                            @foreach (var role in ViewBag.Roles)
                                            {
                                                <option value="@role">@L["UM.PlatformAdmin"]</option>
                                            }
                                        </select>
                                        <div class="form-text" id="role-note">
                                            @L["UM.OrgRoleNote"] <a href="/Organizations/Index">@L["Org.Organizations"] → @L["Org.AddMember"]</a>
                                        </div>
                                    }
                                    else
                                    {
                                        <label class="form-label required">@L["Role"]</label>
                                        <select asp-for="Role" class="form-select" id="role-select">
                                            <option value="">@L["Select Role"]</option>
                                            @foreach (var role in ViewBag.Roles)
                                            {
                                                <option value="@role">@L[(string)role]</option>
                                            }
                                        </select>
                                    }

                                    <span asp-validation-for="Role" class="text-danger"></span>

                                </div>

                                <div class="mb-0">

                                    <button type="submit"
                                            class="btn btn-primary waves-effect waves-light me-1">

                                        @L["Create User"]

                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-secondary waves-effect">

                                        @L["Cancel"]

                                    </a>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
    @section scripts{

        <script src="~/assets/libs/parsleyjs/parsley.min.js"></script>

        <script src="~/assets/js/pages/form-validation.init.js"></script>

        <script src="~/assets/js/app.js"></script>

        <script>
            // D-78: the password fields only for an initial password set by the administrator
            document.querySelectorAll('input[name=Delivery]').forEach(function (r) {
                r.addEventListener('change', function () {
                    document.getElementById('manual-password').classList.toggle('d-none', document.getElementById('delivery-sms').checked);
                });
            });
        </script>

    }
</body>