@model IEnumerable<TOP4HoneyChains.Web.Models.Entities.CriticalControlPointParameter>

@{
    ViewData["Title"] = L["CCP Parameters"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

@section AddToHead {
    <link href="~/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" />
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-12">

                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title">@L["Critical Control Point Parameters"]</h4>
                            <p class="card-title-desc">
                                @L["Manage monitoring parameters assigned to critical control points."]
                            </p>

                            <p>
                                <a asp-action="Create"
                                   class="btn btn-primary waves-effect waves-light">
                                    @L["Add New Parameter"]
                                </a>
                            </p>

                            <table id="datatable-buttons"
                                   class="table table-striped table-bordered dt-responsive nowrap"
                                   style="width:100%;">

                                <thead>
                                    <tr>
                                        <th>@L["Parameter Name"]</th>
                                        <th>@L["Unit"]</th>
                                        <th>@L["Type"]</th>
                                        <th>@L["Limits"]</th>
                                        <th>CCP</th>
                                        <th>@L["Category"]</th>
                                        <th style="width:150px;">@L["Actions"]</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>
                                                    @TOP4HoneyChains.Web.Services.RefText.Short(Ref.T("Parameter", item.ParameterId, "Name", item.ParameterName), 50)
                                                    
                                                    
                                                    </strong>
                                            </td>

                                            <td>
                                                <span class="badge bg-secondary">
                                                    @Ref.T("Parameter", item.ParameterId, "Unit", item.ParameterUnit)
                                                </span>
                                            </td>

                                            <td>@(item.DataType != null ? L[item.DataType].Value : "-")@(item.IsRequired ? "" : " (" + L["optional"].Value + ")")</td>
                                            <td>
                                                @Ref.Limit(TOP4HoneyChains.Web.Services.CcpLimitEvaluator.DescribeAll(item) ?? (item.CriticalLimit == "None" ? "-" : item.CriticalLimit), k => L[k])
                                                @if (TOP4HoneyChains.Web.Services.CcpLimitEvaluator.DescribeAll(item) != null && !item.LimitVerified)
                                                {
                                                    <span class="badge bg-warning text-dark">@L["to verify"]</span>
                                                }
                                            </td>

                                            <td>
                                                <span class="badge bg-info">
                                                    @item.CCP?.Code
                                                </span>
                                            </td>

                                            <td>
                                                @Ref.T("ParameterCategory", item.ParameterCategoryNavigation?.CategoryId, "Name", item.ParameterCategoryNavigation?.CategoryName)
                                            </td>

                                            <td>
                                                <div class="d-flex gap-2">

                                                    <a asp-controller="CriticalControlPointParameterContents"
                                                       asp-action="Index"
                                                       asp-route-parameterId="@item.ParameterId"
                                                       class="btn btn-sm btn-primary w-100">
                                                        <i class="mdi mdi-play-circle-outline me-1"></i>
                                                        @L["Content"]
                                                    </a>

                                                    <a asp-action="Limits"
                                                       asp-route-id="@item.ParameterId"
                                                       class="btn btn-sm btn-warning w-100">
                                                        @L["Limits"]
                                                    </a>

                                                    <a asp-action="Edit"
                                                       asp-route-id="@item.ParameterId"
                                                       class="btn btn-sm btn-info w-100">
                                                        @L["Edit"]
                                                    </a>

                                                    <a asp-action="Delete"
                                                       asp-route-id="@item.ParameterId"
                                                       class="btn btn-sm btn-danger w-100">
                                                        @L["Delete"]
                                                    </a>

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
        <script src="~/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons-bs4/js/buttons.bootstrap4.min.js"></script>
        <script src="~/assets/libs/jszip/jszip.min.js"></script>
        <script src="~/assets/libs/pdfmake/build/pdfmake.min.js"></script>
        <script src="~/assets/libs/pdfmake/build/vfs_fonts.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.html5.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.print.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.colVis.min.js"></script>
        <script src="~/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
        <script src="~/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>
        <script src="~/assets/js/pages/datatables.init.js"></script>
        <script src="~/assets/js/app.js"></script>
    }
</body>