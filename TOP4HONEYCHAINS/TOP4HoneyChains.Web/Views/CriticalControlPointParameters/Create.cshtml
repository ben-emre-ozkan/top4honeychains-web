@model TOP4HoneyChains.Web.Models.Entities.CriticalControlPointParameter

@{
    ViewData["Title"] = "Create CCP Parameter";
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title">Create New CCP Parameter</h4>
                            <p class="card-title-desc">
                                Define a monitoring parameter for a selected Critical Control Point.
                            </p>

                            <form asp-action="Create" class="custom-validation">

                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                <!-- CCP Selection -->
                                <div class="mb-3">
                                    <label asp-for="CCPId" class="form-label required">
                                        Critical Control Point
                                    </label>

                                    <select asp-for="CCPId"
                                            class="form-select"
                                            asp-items="ViewBag.CCPId">
                                        <option value="0">-- Select CCP --</option>
                                    </select>

                                    <span asp-validation-for="CCPId" class="text-danger"></span>
                                </div>

                                <!-- Parameter Name -->
                                <div class="mb-3">
                                    <label asp-for="ParameterName" class="form-label">
                                        Parameter Name
                                    </label>

                                    <input asp-for="ParameterName"
                                           class="form-control"
                                           placeholder="Enter parameter name" />

                                    <span asp-validation-for="ParameterName" class="text-danger"></span>
                                </div>

                                <!-- Parameter Category -->
                                <div class="mb-3">
                                    <label asp-for="ParameterCategory" class="form-label">
                                        Parameter Category
                                    </label>

                                    <select asp-for="ParameterCategory"
                                            class="form-select"
                                            asp-items="ViewBag.ParameterCategory">
                                        <option value="">-- Select Category --</option>
                                    </select>

                                    <span asp-validation-for="ParameterCategory" class="text-danger"></span>
                                </div>

                                <!-- Parameter Unit -->
                                <div class="mb-3">
                                    <label asp-for="ParameterUnit" class="form-label">
                                        Unit
                                    </label>

                                    <input asp-for="ParameterUnit"
                                           class="form-control"
                                           placeholder="e.g. °C, %, ppm, CFU/g" />

                                    <span asp-validation-for="ParameterUnit" class="text-danger"></span>
                                </div>

                                <!-- Critical Limit -->
                                <div class="mb-3">
                                    <label asp-for="CriticalLimit" class="form-label">
                                        Critical Limit
                                    </label>

                                    <input asp-for="CriticalLimit"
                                           class="form-control"
                                           placeholder="Enter critical threshold value" />

                                    <span asp-validation-for="CriticalLimit" class="text-danger"></span>
                                </div>

                                <!-- Metadata (D-18) -->
                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label asp-for="DataType" class="form-label">Data type</label>
                                        <select asp-for="DataType" class="form-select">
                                            <option value="">(not set: number or text)</option>
                                            <option value="Number">Number</option>
                                            <option value="YesNo">Yes / No</option>
                                            <option value="Text">Text</option>
                                            <option value="File">File (e.g. lab report)</option>
                                        </select>
                                        <span asp-validation-for="DataType" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label asp-for="MinValue" class="form-label">Minimum</label>
                                        <input asp-for="MinValue" type="text" inputmode="decimal" class="form-control" placeholder="no minimum" />
                                        <span asp-validation-for="MinValue" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label asp-for="MaxValue" class="form-label">Maximum</label>
                                        <input asp-for="MaxValue" type="text" inputmode="decimal" class="form-control" placeholder="no maximum" />
                                        <span asp-validation-for="MaxValue" class="text-danger"></span>
                                    </div>
                                </div>
                                <small class="text-muted d-block mb-3">
                                    Minimum and maximum apply to every honey type. Honey-type specific and conditional limits
                                    are on the parameter's "Limits" page. Stored results are not recalculated when limits change.
                                </small>

                                <div class="mb-3 form-check">
                                    <input asp-for="IsRequired" class="form-check-input" />
                                    <label asp-for="IsRequired" class="form-check-label">Required for the CCP to be completed</label>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="LimitNote" class="form-label">Limit note</label>
                                    <input asp-for="LimitNote" class="form-control" maxlength="300" />
                                </div>

                                <div class="row">
                                    <div class="col-md-8 mb-3">
                                        <label asp-for="LimitSource" class="form-label">Limit source</label>
                                        <input asp-for="LimitSource" class="form-control" maxlength="200" placeholder="e.g. Turkish Food Codex, honey communique" />
                                    </div>
                                    <div class="col-md-4 mb-3 d-flex align-items-end">
                                        <div class="form-check">
                                            <input asp-for="LimitVerified" class="form-check-input" />
                                            <label asp-for="LimitVerified" class="form-check-label">Limits verified (shown publicly)</label>
                                        </div>
                                    </div>
                                </div>


                                <!-- Buttons -->
                                <div class="d-flex gap-2">

                                    <button type="submit"
                                            class="btn btn-primary waves-effect waves-light">
                                        Save
                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-secondary waves-effect">
                                        Back to List
                                    </a>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/libs/parsleyjs/parsley.min.js"></script>
        <script src="~/assets/js/pages/form-validation.init.js"></script>
        <script src="~/assets/js/app.js"></script>
    }
</body>