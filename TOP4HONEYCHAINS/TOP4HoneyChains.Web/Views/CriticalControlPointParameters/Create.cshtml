@model TOP4HoneyChains.Web.Models.Entities.CriticalControlPointParameter

@{
    ViewData["Title"] = L["Create CCP Parameter"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title">@L["Create New CCP Parameter"]</h4>
                            <p class="card-title-desc">
                                @L["Define a monitoring parameter for a selected Critical Control Point."]
                            </p>

                            <form asp-action="Create" class="custom-validation">

                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                <!-- CCP Selection -->
                                <div class="mb-3">
                                    <label asp-for="CCPId" class="form-label required">
                                        @L["Critical Control Point"]
                                    </label>

                                    <select asp-for="CCPId"
                                            class="form-select"
                                            asp-items="ViewBag.CCPId">
                                        <option value="0">@L["-- Select CCP --"]</option>
                                    </select>

                                    <span asp-validation-for="CCPId" class="text-danger"></span>
                                </div>

                                <!-- Parameter Name -->
                                <div class="mb-3">
                                    <label asp-for="ParameterName" class="form-label">
                                        @L["Parameter Name"]
                                    </label>

                                    <input asp-for="ParameterName"
                                           class="form-control"
                                           placeholder="@L["Enter parameter name"]" />

                                    <span asp-validation-for="ParameterName" class="text-danger"></span>
                                </div>

                                <!-- Parameter Category -->
                                <div class="mb-3">
                                    <label asp-for="ParameterCategory" class="form-label">
                                        @L["Parameter Category"]
                                    </label>

                                    <select asp-for="ParameterCategory"
                                            class="form-select"
                                            asp-items="ViewBag.ParameterCategory">
                                        <option value="">@L["-- Select Category --"]</option>
                                    </select>

                                    <span asp-validation-for="ParameterCategory" class="text-danger"></span>
                                </div>

                                <!-- Parameter Unit -->
                                <div class="mb-3">
                                    <label asp-for="ParameterUnit" class="form-label">
                                        @L["Unit"]
                                    </label>

                                    <input asp-for="ParameterUnit"
                                           class="form-control"
                                           placeholder="@L["e.g. °C, %, ppm, CFU/g"]" />

                                    <span asp-validation-for="ParameterUnit" class="text-danger"></span>
                                </div>

                                <!-- Critical Limit -->
                                <div class="mb-3">
                                    <label asp-for="CriticalLimit" class="form-label">
                                        @L["Critical Limit"]
                                    </label>

                                    <input asp-for="CriticalLimit"
                                           class="form-control"
                                           placeholder="@L["Enter critical threshold value"]" />

                                    <span asp-validation-for="CriticalLimit" class="text-danger"></span>
                                </div>

                                <!-- Metadata (D-18) -->
                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label asp-for="DataType" class="form-label">@L["Data Type"]</label>
                                        <select asp-for="DataType" class="form-select">
                                            <option value="">@L["(not set: number or text)"]</option>
                                            <option value="Number">@L["Number"]</option>
                                            <option value="YesNo">@L["Yes / No"]</option>
                                            <option value="Text">@L["Text"]</option>
                                            <option value="File">@L["File (e.g. lab report)"]</option>
                                        </select>
                                        <span asp-validation-for="DataType" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label asp-for="MinValue" class="form-label">@L["Minimum"]</label>
                                        <input asp-for="MinValue" type="text" inputmode="decimal" class="form-control" placeholder="@L["no minimum"]"
                                               value="@Model?.MinValue?.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)" />
                                        <span asp-validation-for="MinValue" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label asp-for="MaxValue" class="form-label">@L["Maximum"]</label>
                                        <input asp-for="MaxValue" type="text" inputmode="decimal" class="form-control" placeholder="@L["no maximum"]"
                                               value="@Model?.MaxValue?.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)" />
                                        <span asp-validation-for="MaxValue" class="text-danger"></span>
                                    </div>
                                </div>
                                <small class="text-muted d-block mb-3">
                                    @L["Minimum and maximum apply to every honey type. Honey-type specific and conditional limits are on the parameter's \"Limits\" page. Stored results are not recalculated when limits change."]
                                </small>

                                <div class="mb-3 form-check">
                                    <input asp-for="IsRequired" class="form-check-input" />
                                    <label asp-for="IsRequired" class="form-check-label">@L["Required for the CCP to be completed"]</label>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="LimitNote" class="form-label">@L["Limit Note"]</label>
                                    <input asp-for="LimitNote" class="form-control" maxlength="300" />
                                </div>

                                <div class="row">
                                    <div class="col-md-8 mb-3">
                                        <label asp-for="LimitSource" class="form-label">@L["Limit Source"]</label>
                                        <input asp-for="LimitSource" class="form-control" maxlength="200" placeholder="@L["e.g. Turkish Food Codex, honey communique"]" />
                                    </div>
                                    <div class="col-md-4 mb-3 d-flex align-items-end">
                                        <div class="form-check">
                                            <input asp-for="LimitVerified" class="form-check-input" />
                                            <label asp-for="LimitVerified" class="form-check-label">@L["Limits verified (shown publicly)"]</label>
                                        </div>
                                    </div>
                                </div>


                                <!-- Buttons -->
                                <div class="d-flex gap-2">

                                    <button type="submit"
                                            class="btn btn-primary waves-effect waves-light">
                                        @L["Save"]
                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-secondary waves-effect">
                                        @L["Back to list"]
                                    </a>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/libs/parsleyjs/parsley.min.js"></script>
        <script src="~/assets/js/pages/form-validation.init.js"></script>
        <script src="~/assets/js/app.js"></script>
    }
</body>