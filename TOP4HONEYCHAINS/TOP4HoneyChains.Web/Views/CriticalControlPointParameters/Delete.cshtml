@model TOP4HoneyChains.Web.Models.Entities.CriticalControlPointParameter

@{
    ViewData["Title"] = "Delete CCP Parameter";
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card border-danger">
                        <div class="card-body">

                            <h4 class="card-title text-danger">
                                Delete CCP Parameter
                            </h4>

                            <p class="card-title-desc">
                                <strong>Warning:</strong> This action cannot be undone.
                            </p>

                            <div class="alert alert-danger">
                                Are you sure you want to delete this parameter?
                            </div>

                            <dl class="row">

                                <dt class="col-sm-3">Parameter Name</dt>
                                <dd class="col-sm-9">
                                    <strong>@Model.ParameterName</strong>
                                </dd>

                                <dt class="col-sm-3">Unit</dt>
                                <dd class="col-sm-9">
                                    <span class="badge bg-secondary">
                                        @Model.ParameterUnit
                                    </span>
                                </dd>

                                <dt class="col-sm-3">Critical Limit</dt>
                                <dd class="col-sm-9">
                                    @Model.CriticalLimit
                                </dd>

                                <dt class="col-sm-3">Critical Control Point</dt>
                                <dd class="col-sm-9">
                                    <span class="badge bg-info">
                                        @Model.CCP?.Code
                                    </span>
                                </dd>

                                <dt class="col-sm-3">Category</dt>
                                <dd class="col-sm-9">
                                    @Model.ParameterCategoryNavigation?.CategoryName
                                </dd>

                            </dl>

                            <form asp-action="Delete">

                                <input type="hidden" asp-for="ParameterId" />

                                <div class="d-flex gap-2">

                                    <button type="submit"
                                            class="btn btn-danger waves-effect waves-light">
                                        Delete
                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-secondary waves-effect">
                                        Back to List
                                    </a>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/js/app.js"></script>
    }
</body>