@model TOP4HoneyChains.Web.Models.Entities.CriticalControlPointParameter

@{
    ViewData["Title"] = L["Delete CCP Parameter"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card border-danger">
                        <div class="card-body">

                            <h4 class="card-title text-danger">
                                @L["Delete CCP Parameter"]
                            </h4>

                            <p class="card-title-desc">
                                <strong>@L["Warning:"]</strong> @L["This action cannot be undone."]
                            </p>

                            <div class="alert alert-danger">
                                @L["Are you sure you want to delete this parameter?"]
                            </div>

                            <dl class="row">

                                <dt class="col-sm-3">@L["Parameter Name"]</dt>
                                <dd class="col-sm-9">
                                    <strong>@Ref.T("Parameter", Model.ParameterId, "Name", Model.ParameterName)</strong>
                                </dd>

                                <dt class="col-sm-3">@L["Unit"]</dt>
                                <dd class="col-sm-9">
                                    <span class="badge bg-secondary">
                                        @Ref.T("Parameter", Model.ParameterId, "Unit", Model.ParameterUnit)
                                    </span>
                                </dd>

                                <dt class="col-sm-3">@L["Critical Limit"]</dt>
                                <dd class="col-sm-9">
                                    @Ref.Limit(Model.CriticalLimit, k => L[k])
                                </dd>

                                <dt class="col-sm-3">@L["Critical Control Point"]</dt>
                                <dd class="col-sm-9">
                                    <span class="badge bg-info">
                                        @Model.CCP?.Code
                                    </span>
                                </dd>

                                <dt class="col-sm-3">@L["Category"]</dt>
                                <dd class="col-sm-9">
                                    @Ref.T("ParameterCategory", Model.ParameterCategoryNavigation?.CategoryId, "Name", Model.ParameterCategoryNavigation?.CategoryName)
                                </dd>

                            </dl>

                            <form asp-action="Delete">

                                <input type="hidden" asp-for="ParameterId" />

                                <div class="d-flex gap-2">

                                    <button type="submit"
                                            class="btn btn-danger waves-effect waves-light">
                                        @L["Delete"]
                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-secondary waves-effect">
                                        @L["Back to list"]
                                    </a>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/js/app.js"></script>
    }
</body>