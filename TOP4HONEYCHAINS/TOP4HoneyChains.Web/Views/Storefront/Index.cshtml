@using System.Globalization
@using TOP4HoneyChains.Web.Services
@using TOP4HoneyChains.Web.Models.ViewModels.Storefront
@model StorefrontPageViewModel
@{
    // Public beekeeper page (D-30, D-43). Design: docs/design/beekeeper-page; styles: wwwroot/css/storefront.css.
    // Every section is hidden when it has no data. Sample texts and photos only on the demo storefront.
    Layout = null;
    var culture = CultureInfo.CurrentUICulture;
    string Month(int m) => culture.DateTimeFormat.GetMonthName(m);
    string MonthInitial(int m) => culture.TextInfo.ToUpper(culture.DateTimeFormat.AbbreviatedMonthNames[m - 1].Substring(0, 1));
    string Date(DateTime? d) => d?.ToString("d MMM yyyy", culture) ?? "";
    string Num(decimal v) => v.ToString("0.##", culture);
    string Unit(LabValue v) => Units.IsNone(v.Unit) ? "" : Ref.Unit(v.ParameterId, v.Unit);
    var hasBatches = Model.Batches.Any();
    var name = Model.DisplayName;
}
<!doctype html>
<html lang="@culture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@name · @L["P5.BeekeeperPage"]</title>
    <partial name="~/Views/Shared/_Favicons.cshtml" />
    <meta name="theme-color" content="#FFFFFF">
    <link href="~/css/brand.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/storefront.css" rel="stylesheet" asp-append-version="true">
</head>
<body class="sf-body">
<div class="sf" id="storefront" data-code="@Model.Code">

<partial name="_PublicTopBar" model="@(L["P5.BeekeeperPage"].Value)" />

@if (Model.IsDemo)
{
    <div class="sf-ribbon" id="sf-demo">@L["Sf.DemoRibbon"]</div>
}

<main id="top" class="sf-main">

    @* hero *@
    <section class="sf-hero">
        <div class="sf-hero-main">
            @if (Model.HoneyTypes.Any() || Model.Region != null)
            {
                <div class="sf-tags" id="sf-honey">
                    @foreach (var h in Model.HoneyTypes)
                    {
                        <span class="sf-tag">@Ref.Text("HoneyType", "Title", h)</span>
                    }
                    @if (Model.Region != null)
                    {
                        <span class="sf-tag is-region">@L["Region." + Model.Region]</span>
                    }
                </div>
            }
            <h1 class="sf-name" id="sf-name">@name</h1>
            @if (Model.IsDemo)
            {
                <p class="sf-tagline">@L["Sf.Demo.Tagline"]</p>
            }
            <div class="sf-facts">
                @if (Model.Place.Length > 0)
                {
                    <span class="sf-fact" id="sf-place"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0B7A75" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>@Model.Place</span>
                }
                @if (Model.Association != null)
                {
                    <span class="sf-fact" id="sf-association"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0B7A75" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"></path><circle cx="10" cy="7" r="4"></circle><path d="M21 21v-2a4 4 0 0 0-3-3.9"></path></svg>@L["Sf.MemberOf", Model.Association]</span>
                }
                @if (Model.MemberSinceYear != null)
                {
                    <span class="sf-fact"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0B7A75" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>@L["Sf.OnPlatformSince", Model.MemberSinceYear]</span>
                }
            </div>
            @if (Model.RegistryVerified || Model.AccreditedLab || Model.AllCcpsApproved)
            {
                <div class="sf-badges" id="sf-badges">
                    @if (Model.RegistryVerified)
                    {
                        <span class="sf-badge"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0B7A75" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>@L["Sf.BadgeRegistry"]</span>
                    }
                    @if (Model.AccreditedLab)
                    {
                        <span class="sf-badge" id="sf-badge-lab"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0B7A75" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.7 3h10.6a2 2 0 0 0 1.7-3l-5-9V3"></path></svg>@L["Hs.AccreditedLab"]</span>
                    }
                    @if (Model.AllCcpsApproved)
                    {
                        <span class="sf-badge" id="sf-badge-ccp"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0B7A75" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"></path><path d="m9 12 2 2 4-4"></path></svg>@L["Hs.AllCcpsApproved"]</span>
                    }
                </div>
            }
            @if (Model.HasActivity)
            {
                <div class="sf-activity">
                    <div class="sf-activity-title">@L["Sf.RecentActivity"]</div>
                    <div class="sf-activity-grid">
                        @if (Model.LatestBatch != null)
                        {
                            <div class="sf-card">
                                <div class="sf-card-kicker">@L["Sf.LatestBatch"]</div>
                                <div class="sf-card-value">@Model.LatestBatch.Title</div>
                                @if (Model.LatestBatch.Date != null)
                                {
                                    <div class="sf-card-note">@L["Sf.FinalisedOn", Date(Model.LatestBatch.Date)]</div>
                                }
                            </div>
                        }
                        @if (Model.LatestReport != null)
                        {
                            <div class="sf-card">
                                <div class="sf-card-kicker">@L["Sf.LatestReport"]</div>
                                @if (Model.LatestReport.Checked > 0)
                                {
                                    <div class="sf-card-value">@L["Sf.WithinLimitCount", Model.LatestReport.WithinLimit, Model.LatestReport.Checked]</div>
                                }
                                <div class="sf-card-note">@L["Sf.ReportCode", Model.LatestReport.Code]</div>
                            </div>
                        }
                        @if (Model.Ccp0PassedSeason != null)
                        {
                            <div class="sf-card">
                                <div class="sf-card-kicker">@L["Sf.HygieneAudit"]</div>
                                <div class="sf-card-value">@L["Sf.Passed"]</div>
                                <div class="sf-card-note">@L["Sf.SeasonByAssociation", Model.Ccp0PassedSeason]</div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* profile card *@
        <aside class="sf-profile">
            <div class="sf-profile-mark">
                <svg width="132" height="132" viewBox="0 0 132 132" role="img" aria-label="@L["Sf.ProfileMark", name]">
                    <polygon points="66,4 120,35 120,97 66,128 12,97 12,35" fill="#0B7A75"></polygon>
                    <polygon points="66,16 110,41 110,91 66,116 22,91 22,41" fill="none" stroke="#FFB547" stroke-width="2"></polygon>
                    <text x="66" y="80" text-anchor="middle" font-family="Bricolage Grotesque, sans-serif" font-weight="800" font-size="40" fill="#FFFFFF">@Model.Initials</text>
                </svg>
            </div>
            <div class="sf-profile-name">
                <strong>@name</strong>
                <span>@L["Sf.Beekeeper"]@(Model.Place.Length > 0 ? " · " + Model.Place : "")</span>
            </div>
            @if (Model.HasStats)
            {
                <div class="sf-stats" id="sf-stats">
                    @if (Model.VerifiedLots > 0)
                    {
                        <div class="sf-stat"><b id="sf-lots">@Model.VerifiedLots</b><span>@L["P5.VerifiedLots"]</span></div>
                    }
                    @if (Model.BatchCount > 0)
                    {
                        <div class="sf-stat"><b>@Model.BatchCount</b><span>@L["Sf.StatBatches"]</span></div>
                    }
                    @if (Model.LabReportCount > 0)
                    {
                        <div class="sf-stat"><b>@Model.LabReportCount</b><span>@L["Sf.StatReports"]</span></div>
                    }
                    @if (Model.KgTraced > 0)
                    {
                        <div class="sf-stat"><b>@Model.KgTraced.ToString("N0", culture) kg</b><span>@L["Sf.StatKg"]</span></div>
                    }
                </div>
            }
            @if (hasBatches)
            {
                <a href="#batches" class="sf-cta">@L["Sf.WhereToBuy"]</a>
            }
            @if (Model.Association != null)
            {
                <a href="#contact" class="sf-cta-2">@L["Sf.ContactViaAssociation"]</a>
            }
            <div class="sf-qr">
                <img src="/storefront/@Model.Code/qr" alt="@L["Sf.QrAlt"]" width="64" height="64" loading="lazy">
                <span>@L["Sf.QrHint"]</span>
            </div>
        </aside>
    </section>

    @* about the apiary: story (association text; demo only so far), facts from the data, photos *@
    @if (Model.HasAbout || Model.Photos.Any())
    {
        <section class="sf-section sf-story" id="sf-about">
            <div class="sf-story-text">
                <div class="sf-kicker">@L["Sf.About"]</div>
                @if (Model.IsDemo)
                {
                    <h2 class="sf-story-title">@L["Sf.Demo.StoryTitle"]</h2>
                    <p>@L["Sf.Demo.Story1"]</p>
                    <p>@L["Sf.Demo.Story2"]</p>
                }
                <div class="sf-features">
                    @if (Model.HoneyTypes.Any())
                    {
                        <div class="sf-feature"><b>@L["P5.HoneyTypes"]</b><span>@string.Join(", ", Model.HoneyTypes.Select(h => Ref.Text("HoneyType", "Title", h)))</span></div>
                    }
                    @if (Model.HarvestFrom != null)
                    {
                        <div class="sf-feature"><b>@L["Sf.FeatureHarvest"]</b><span>@(Model.HarvestFrom == Model.HarvestTo ? Month(Model.HarvestFrom.Value) : L["Sf.MonthRange", Month(Model.HarvestFrom.Value), Month(Model.HarvestTo!.Value)].Value)</span></div>
                    }
                    @if (Model.Ccp0PassedForAllLots)
                    {
                        <div class="sf-feature"><b>@L["Sf.FeatureHygiene"]</b><span>@L["Sf.Ccp0AllLots"]</span></div>
                    }
                </div>
            </div>
            @if (Model.Photos.Any())
            {
                <div class="sf-gallery" id="sf-gallery">
                    @foreach (var p in Model.Photos)
                    {
                        <figure class="sf-photo@(p.Wide ? " is-wide" : "")">
                            <img src="@p.Url" alt="@L[p.AltKey]" class="@p.PositionClass" loading="lazy">
                            <figcaption>@L[p.CaptionKey]</figcaption>
                        </figure>
                    }
                </div>
            }
        </section>
    }

    @* origin map + calendar *@
    @if (Model.Marker != null || Model.Calendar.Any())
    {
        var hasFlowering = Model.Calendar.Any(r => r.Flowering.Count > 0);
        <section class="sf-section sf-origin" id="sf-origin">
            @if (Model.Marker != null)
            {
                var m = Model.Marker;
                var right = m.X > 470;
                <div class="sf-origin-map">
                    <div class="sf-kicker">@L["Sf.Origin"]</div>
                    <h2 class="sf-h2">@L["Sf.WhereFrom"]</h2>
                    <svg viewBox="0 0 640 300" role="img" aria-label="@L["Sf.MapLabel", m.Label]" id="sf-map">
                        <partial name="_TurkeyOutline" />
                        @foreach (var plate in new[] { 34, 6 })
                        {
                            var c = ProvinceMap.ByPlate(plate)!;
                            var (cx, cy) = ProvinceMap.ToMap(c.Latitude, c.Longitude);
                            if (Math.Abs(cx - m.X) < 40 && Math.Abs(cy - m.Y) < 30)
                            {
                                continue;
                            }
                            // İstanbul's label goes to the upper left, out of the way of a marker in the north-west (as in the design)
                            var west = plate == 34;
                            <g class="sf-map-ref">
                                <circle class="sf-map-city" cx="@cx.ToString(CultureInfo.InvariantCulture)" cy="@cy.ToString(CultureInfo.InvariantCulture)" r="3"></circle>
                                <text class="sf-map-city-label" x="@((west ? cx - 6 : cx + 7).ToString(CultureInfo.InvariantCulture))" y="@((west ? cy - 14 : cy + 4).ToString(CultureInfo.InvariantCulture))" text-anchor="@(west ? "end" : "start")">@Provinces.ByPlate(plate)</text>
                            </g>
                        }
                        @{
                            var x = m.X.ToString(CultureInfo.InvariantCulture);
                            var y = m.Y.ToString(CultureInfo.InvariantCulture);
                            var lx = (right ? m.X - 33 : m.X + 33).ToString(CultureInfo.InvariantCulture);
                            var anchor = right ? "end" : "start";
                        }
                        <circle class="sf-map-halo-1" cx="@x" cy="@y" r="26"></circle>
                        <circle class="sf-map-halo-2" cx="@x" cy="@y" r="14"></circle>
                        <circle class="sf-map-dot" cx="@x" cy="@y" r="5"></circle>
                        <text class="sf-map-label" x="@lx" y="@((m.Y - 4).ToString(CultureInfo.InvariantCulture))" text-anchor="@anchor">@m.Label</text>
                        <text class="sf-map-sub" x="@lx" y="@((m.Y + 12).ToString(CultureInfo.InvariantCulture))" text-anchor="@anchor">@L["Sf.ApproxArea"]</text>
                    </svg>
                    <p class="sf-origin-note">@L["Sf.MapNote"]</p>
                </div>
            }
            @if (Model.Calendar.Any())
            {
                <div class="sf-calendar" id="sf-calendar">
                    <h3>@(hasFlowering ? L["Sf.Calendar"] : L["Sf.HarvestCalendar"])</h3>
                    <p>@(hasFlowering ? L["Sf.CalendarHelpDemo"] : L["Sf.CalendarHelp"])</p>
                    <div class="sf-cal-row is-head">
                        <span></span>
                        @for (var i = 1; i <= 12; i++)
                        {
                            <span title="@Month(i)">@MonthInitial(i)</span>
                        }
                    </div>
                    @foreach (var row in Model.Calendar)
                    {
                        var label = row.LabelIsKey ? L[row.Label].Value : Ref.Text("HoneyType", "Title", row.Label);
                        <div class="sf-cal-row">
                            <span class="sf-cal-label" title="@label">@label</span>
                            @for (var i = 1; i <= 12; i++)
                            {
                                var cls = row.Harvest.Contains(i) ? " is-harvest" : row.Flowering.Contains(i) ? " is-flower" : "";
                                <span class="sf-cal-cell@(cls)"></span>
                            }
                        </div>
                    }
                    <div class="sf-legend">
                        @if (hasFlowering)
                        {
                            <span><i class="is-flower"></i>@L["Sf.Flowering"]</span>
                        }
                        <span><i class="is-harvest"></i>@L["Sf.Harvest"]</span>
                    </div>
                </div>
            }
        </section>
    }

    @* latest approved lab report *@
    @if (Model.Lab != null)
    {
        <section class="sf-section" id="verify">
            <div class="sf-lab-head">
                <div>
                    <div class="sf-kicker">@L["Sf.Quality"]</div>
                    <h2 class="sf-h2">@L["Sf.LatestResults"]</h2>
                </div>
                <a class="sf-lab-link" href="/verify-report?code=@Model.Lab.ReportCode"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0B7A75" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6M9 15l2 2 4-4"></path></svg>@L["Sf.VerifyReportCode", Model.Lab.ReportCode]</a>
            </div>
            @{ var anyVerified = Model.Lab.Values.Any(v => v.InRange != null); }
            @if (anyVerified)
            {
                <p class="sf-lead">@(Model.Lab.Accredited ? L["Sf.LabNoteAccredited", Model.Lab.Laboratory] : L["Sf.LabNote", Model.Lab.Laboratory])</p>
            }
            else
            {
                <p class="sf-lead">@(Model.Lab.Accredited ? L["Sf.LabNoteAccreditedShort", Model.Lab.Laboratory] : L["Sf.LabNoteShort", Model.Lab.Laboratory])</p>
                <p class="sf-lead" id="sf-limits-pending">@L["Hst.LimitsPending"]</p>
            }
            <div class="sf-lab-grid" id="sf-lab">
                @foreach (var v in Model.Lab.Values)
                {
                    var unit = Unit(v);
                    var outOfLimit = v.InRange == false;
                    <div class="sf-lab-card">
                        <div class="sf-lab-top">
                            <b>@Ref.Parameter(v.ParameterId, v.Name)</b>
                            @if (v.InRange != null)
                            {
                                <span class="sf-pill@(outOfLimit ? " is-out" : "")">@(outOfLimit ? L["Sf.OutOfLimit"] : L["Sf.WithinLimit"])</span>
                            }
                        </div>
                        <div class="sf-lab-value">@Num(v.Value) <small title="@unit">@Units.Symbol(unit)</small></div>
                        @if (v.LimitPercent != null)
                        {
                            <div class="sf-bar">
                                <div class="sf-bar-fill@(outOfLimit ? " is-out" : "")" style="width: @v.ValuePercent.ToString(CultureInfo.InvariantCulture)%"></div>
                                <div class="sf-bar-mark" style="left: @v.LimitPercent.Value.ToString(CultureInfo.InvariantCulture)%"></div>
                                @if (v.MinPercent != null)
                                {
                                    <div class="sf-bar-mark" style="left: @v.MinPercent.Value.ToString(CultureInfo.InvariantCulture)%"></div>
                                }
                            </div>
                        }
                        @if (v.Min != null || v.Max != null)
                        {
                            <div class="sf-lab-limit">@L["Sf.Limit", CcpLimitEvaluator.Describe(v.Min, v.Max, Units.Symbol(unit))]</div>
                        }
                    </div>
                }
            </div>
        </section>
    }

    @* batches with this honey *@
    @if (hasBatches)
    {
        <section class="sf-section" id="batches">
            <div class="sf-kicker">@L["Sf.Traceability"]</div>
            <h2 class="sf-h2">@L["Sf.BatchesWith"]</h2>
            <p class="sf-lead">@L["Sf.BatchesHelp"]</p>
            <div class="sf-batches" id="sf-batches">
                @foreach (var b in Model.Batches)
                {
                    var meta = new List<string>();
                    if (b.Date != null) { meta.Add(Date(b.Date)); }
                    if (b.PackedBy != null) { meta.Add(L["Sf.PackedBy", b.PackedBy].Value); }
                    if (b.Origins.Any()) { meta.Add(L["Sf.OriginShort", string.Join(", ", b.Origins.Select(o => o.Country + " " + o.Percentage.ToString("0.##", culture) + "%"))].Value); }
                    <div class="sf-batch" data-qr="@b.Qr">
                        <div class="sf-batch-main">
                            <b>@b.Title</b>
                            @if (meta.Any())
                            {
                                <span>@string.Join(" · ", meta)</span>
                            }
                        </div>
                        @if (b.SharePercent > 0)
                        {
                            <div class="sf-share">
                                <div class="sf-share-head"><span>@L["Sf.ShareOf"]</span><b class="sf-share-value">@b.SharePercent%</b></div>
                                <div class="sf-share-track"><div class="sf-share-fill" style="width: @b.SharePercent%"></div></div>
                            </div>
                        }
                        @if (b.AllCcpsApproved || b.AccreditedLab)
                        {
                            <div class="sf-batch-badges">
                                @if (b.AllCcpsApproved) { <span>@L["Hs.AllCcpsApproved"]</span> }
                                @if (b.AccreditedLab) { <span>@L["Sf.AccreditedTested"]</span> }
                            </div>
                        }
                        <a class="sf-batch-link" href="/honeystory/@b.Qr">@L["Sf.OpenHoneyStory"]</a>
                    </div>
                }
            </div>
        </section>
    }

    @* references: recorded relationships only, no reviews or ratings *@
    @if (Model.References.Any())
    {
        <section class="sf-section sf-refs" id="sf-references">
            <div class="sf-refs-list">
                <div class="sf-kicker">@L["Sf.References"]</div>
                <h2 class="sf-h2">@L["Sf.TrustedChain"]</h2>
                <p class="sf-lead">@L["Sf.RefHelp"]</p>
                <div class="sf-refs-grid">
                    @foreach (var r in Model.References)
                    {
                        var note = r.Kind switch
                        {
                            ReferenceKinds.Association => r.Year != null ? L["Sf.RefMemberSince", r.Year].Value : L["Sf.RefAssociation"].Value,
                            ReferenceKinds.Laboratory or ReferenceKinds.AccreditedLaboratory => L["Sf.RefTested", r.Lots].Value,
                            ReferenceKinds.Wholesaler or ReferenceKinds.Retailer => L["Sf.RefHolds", r.Batches].Value,
                            _ => L["Sf.RefProcessed", r.Lots, r.Batches].Value
                        };
                        <div class="sf-ref" id="@(r.Kind == ReferenceKinds.Association ? "ref-association" : null)" data-kind="@r.Kind">
                            <svg width="48" height="48" viewBox="0 0 48 48" aria-hidden="true"><polygon points="24,2 44,13.5 44,34.5 24,46 4,34.5 4,13.5" fill="#FFF4D6"></polygon>
                                <g transform="translate(12 12)" fill="none" stroke="#8C5E2E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    @switch (r.Kind)
                                    {
                                        case ReferenceKinds.Association:
                                            <path d="M6 19h12"></path><path d="M7 19c-1-2-1.5-4-1.5-6a6.5 6.5 0 0 1 13 0c0 2-.5 4-1.5 6"></path><path d="M6 13h12M7.2 9.5h9.6M6.4 16h11.2"></path><path d="M11 19v-1.5a1 1 0 0 1 2 0V19"></path>
                                            break;
                                        case ReferenceKinds.Laboratory:
                                        case ReferenceKinds.AccreditedLaboratory:
                                            <path d="M9.5 3h5"></path><path d="M10.5 3v6L5 19a1.5 1.5 0 0 0 1.3 2h11.4a1.5 1.5 0 0 0 1.3-2l-5.5-10V3"></path><path d="M7.5 15h9"></path>
                                            break;
                                        case ReferenceKinds.Wholesaler:
                                        case ReferenceKinds.Retailer:
                                            <path d="M4 10v10h16V10"></path><path d="M3 10l2-6h14l2 6z"></path><path d="M10 20v-5h4v5"></path>
                                            break;
                                        default:
                                            <path d="M3 20h18"></path><path d="M4 20V9l5 3V9l5 3V9l5 3v8"></path><path d="M15 5h3v6"></path><path d="M8 16h1M12 16h1M16 16h1"></path>
                                            break;
                                    }
                                </g>
                            </svg>
                            <div class="sf-ref-body">
                                <b>@r.Name</b>
                                <div class="sf-ref-kind">@L["Sf.Kind" + r.Kind]</div>
                                <div class="sf-ref-note">@note</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            @if (Model.IsDemo)
            {
                <figure class="sf-quote">
                    <svg width="34" height="28" viewBox="0 0 34 28" aria-hidden="true"><path d="M0 28V16C0 7 5 1 14 0v6c-4 1-6 4-6 9h6v13zm20 0V16c0-9 5-15 14-16v6c-4 1-6 4-6 9h6v13z" fill="#FFB547"></path></svg>
                    <blockquote>@L["Sf.Demo.Quote"]</blockquote>
                    <figcaption>@L["Sf.Demo.QuoteCaption"]</figcaption>
                </figure>
            }
        </section>
    }

    @* contact: only through the association *@
    @if (Model.Association != null)
    {
        <section class="sf-section sf-contact" id="contact">
            <div class="sf-contact-text">
                <h2>@L["Sf.LookingFor"]</h2>
                <p>@L["Sf.ContactText", Model.Association]</p>
            </div>
            <div class="sf-contact-actions">
                @if (hasBatches)
                {
                    <a class="sf-contact-main" href="#batches">@L["Sf.SeeShops"]</a>
                }
                <a class="sf-contact-alt" href="#ref-association">@L["Sf.RequestViaAssociation"]</a>
            </div>
        </section>
    }

</main>

<footer class="sf-footer">
    <span class="sf-foot-brand"><img class="b-logo" src="~/img/brand/top4-logo-w2.svg" alt="TOP4HoneyChains" width="96" height="40"><span>@L["Sf.FooterTag"]</span></span>
    <span>@L["Sf.FooterNote"]</span>
</footer>
</div>
</body>
</html>
