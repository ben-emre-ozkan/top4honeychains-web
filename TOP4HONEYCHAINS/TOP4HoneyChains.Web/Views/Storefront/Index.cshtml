@model TOP4HoneyChains.Web.Controllers.StorefrontController.Page
@{
    ViewData["Title"] = Model.DisplayName;
    Layout = "~/Views/Shared/_BlankLayout.cshtml";
}

<div class="container py-5" style="max-width:820px">
    <div class="card shadow-sm" id="storefront">
        <div class="card-body p-4">
            <div class="small text-muted">TOP4HoneyChains · @L["P5.BeekeeperPage"]</div>
            <h2 class="mb-1" id="sf-name">@Model.DisplayName</h2>
            <div class="text-muted mb-3" id="sf-place">
                <i class="mdi mdi-map-marker-outline"></i>
                @(string.IsNullOrEmpty(Model.Province) ? "–" : Model.Province)@(string.IsNullOrEmpty(Model.District) ? "" : " / " + Model.District)
                @if (Model.Association != null) { <span class="ms-2"><i class="mdi mdi-account-group-outline"></i> <span id="sf-association">@Model.Association</span></span> }
            </div>

            <div class="row g-3 mb-3">
                <div class="col-sm-4"><div class="border rounded p-3 text-center"><div class="fs-3 fw-bold" id="sf-lots">@Model.VerifiedLots</div><div class="small text-muted">@L["P5.VerifiedLots"]</div></div></div>
                <div class="col-sm-8"><div class="border rounded p-3"><div class="small text-muted mb-1">@L["P5.HoneyTypes"]</div>
                    <div id="sf-honey">@foreach (var h in Model.HoneyTypes) { <span class="badge bg-warning text-dark me-1">@h</span> }@if (!Model.HoneyTypes.Any()) { <span class="text-muted">–</span> }</div></div></div>
            </div>

            <h6>@L["P5.LabResults"]</h6>
            <div class="mb-3" id="sf-lab">
                @foreach (var r in Model.LabReports)
                {
                    <a href="/verify-report?code=@r.Code" class="badge @(r.Accredited ? "bg-success" : "bg-secondary") text-decoration-none me-1 mb-1 sf-lab-badge">
                        <i class="mdi mdi-flask-outline"></i> @r.Laboratory @(r.Accredited ? "· " + L["Org.Accredited"].Value + " " + r.AccreditationNumber : "") @(r.InHouse ? "· " + L["Hs.InHouseLab"].Value : "") · @r.Code
                    </a>
                }
                @if (!Model.LabReports.Any()) { <span class="text-muted">–</span> }
            </div>

            <h6>@L["P5.Batches"]</h6>
            <ul id="sf-batches">
                @foreach (var b in Model.Batches)
                {
                    <li><a href="/honeystory/@b.Qr">@b.Title</a> <small class="text-muted">@b.Date?.ToString("dd.MM.yyyy")</small></li>
                }
                @if (!Model.Batches.Any()) { <li class="text-muted">–</li> }
            </ul>
            <div class="small text-muted mt-4">@L["P5.PublicNote"]</div>
        </div>
    </div>
</div>
