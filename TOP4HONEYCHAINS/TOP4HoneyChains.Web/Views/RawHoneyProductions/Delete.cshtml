@model TOP4HoneyChains.Web.Models.Entities.RawHoneyProduction

@{
    ViewData["Title"] = L["Delete Production"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title text-danger">@L["Delete Production"]</h4>
                            <p class="card-title-desc">
                                @L["Are you sure you want to delete this production record?"]
                            </p>

                            <hr />

                            <dl class="row">

                                <dt class="col-sm-3">@L["Amount (kg)"]</dt>
                                <dd class="col-sm-9">@Model.RawHoneyProductionAmount</dd>

                                <dt class="col-sm-3">@L["Production Date"]</dt>
                                <dd class="col-sm-9">
                                    @Model.RawHoneyProductionDate.Value.ToString("dd.MM.yyyy")
                                </dd>

                                <dt class="col-sm-3">@L["Apiary"]</dt>
                                <dd class="col-sm-9">
                                    @Model.RawHoneyProductionApiary?.ApiaryTitle
                                </dd>

                                <dt class="col-sm-3">@L["Honey Type"]</dt>
                                <dd class="col-sm-9">
                                    @Ref.T("HoneyType", Model.RawHoneyProductionHoneyTypeNavigation?.HoneyTypeId, "Title", Model.RawHoneyProductionHoneyTypeNavigation?.HoneyTypeTitle)
                                </dd>

                                <dt class="col-sm-3">@L["Production Period"]</dt>
                                <dd class="col-sm-9">
                                    @Ref.T("ProductionPeriod", Model.RawHoneyProductionPeriod?.RawHoneyProductionPeriodId, "Title", Model.RawHoneyProductionPeriod?.RawHoneyProductionPeriodTitle)
                                </dd>

                            </dl>

                            <form asp-action="Delete" method="post" class="mt-4">

                                <input type="hidden" asp-for="RawHoneyProductionId" />

                                <div class="d-flex gap-2">

                                    <button type="submit"
                                            class="btn btn-danger waves-effect waves-light">
                                        @L["Delete"]
                                    </button>

                                    <a asp-action="RawHoneyProductionByApiary"
                                       asp-route-id="@Model.RawHoneyProductionApiaryId"
                                       class="btn btn-secondary waves-effect">
                                        @L["Back to List"]
                                    </a>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
    @section scripts{
        <script src="~/assets/js/app.js"></script>
    }
</body>
