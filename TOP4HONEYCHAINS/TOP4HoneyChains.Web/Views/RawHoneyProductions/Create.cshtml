@model TOP4HoneyChains.Web.Models.Entities.RawHoneyProduction

@{
    ViewData["Title"] = L["Add Raw Honey Production"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

@{
    var apiary = ViewBag.Apiary as TOP4HoneyChains.Web.Models.Entities.Apiary;
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <!-- 🔷 HEADER CARD -->
            <div class="card mb-4 border-0 shadow-lg">
                <div class="card-body text-white rounded app-hero app-hero-honey">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h3 class="fw-bold mb-1">
                                <i class="mdi mdi-barrel-outline me-2"></i>
                                @L["Add Raw Honey Production"]
                            </h3>
                            <small class="opacity-75">
                                @L["Enter production details for the selected apiary"]
                            </small>
                        </div>

                        <div class="text-end">
                            <span class="badge bg-dark px-3 py-2">
                                @L["New Entry"]
                            </span>
                        </div>

                    </div>

                </div>
            </div>

            @if (apiary != null)
            {
                <div class="card mb-4 border-0 shadow-sm">
                    <div class="card-body bg-light rounded">

                        <div class="row text-center">

                            <div class="col-md-4">
                                <small class="text-uppercase text-muted">@L["Beekeeper"]</small>
                                <div class="fw-bold fs-5">
                                    <i class="mdi mdi-account-outline me-1 text-secondary"></i>
                                    @apiary.ApiaryBeekeeper?.BeekeeperFirstName
                                    @apiary.ApiaryBeekeeper?.BeekeeperLastName
                                </div>
                            </div>

                            <div class="col-md-4">
                                <small class="text-uppercase text-muted">@L["Apiary"]</small>
                                <div class="fw-bold fs-5">
                                    <i class="mdi mdi-home-group-outline me-1 text-secondary"></i>
                                    @apiary.ApiaryTitle
                                </div>
                            </div>

                            <div class="col-md-4">
                                <small class="text-uppercase text-muted">@L["Location"]</small>
                                <div class="fw-bold fs-5">
                                    <i class="mdi mdi-map-marker-outline me-1 text-secondary"></i>
                                    @L["Lat:"] @apiary.ApiaryLocationLatitude
                                    @L["Long:"] @apiary.ApiaryLocationLongitude
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            }

            <!-- 🔷 FORM CARD -->
            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <form asp-action="Create" class="custom-validation">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="RawHoneyProductionApiaryId" />

                        <div class="row">

                            <!-- Production Period -->
                            <div class="col-md-4 mb-4">
                                <label class="form-label fw-semibold required">
                                    <i class="mdi mdi-calendar-range me-1 text-muted"></i>
                                    @L["Production Period"]
                                </label>
                                <select asp-for="RawHoneyProductionPeriodId"
                                        class="form-select shadow-sm"
                                        asp-items="ViewBag.RawHoneyProductionPeriodId"
                                        required>
                                    <option value="">@L["Select Period"]</option>
                                </select>
                                <span asp-validation-for="RawHoneyProductionPeriodId" class="text-danger"></span>
                            </div>

                            <!-- Honey Type -->
                            <div class="col-md-4 mb-4">
                                <label class="form-label fw-semibold required">
                                    <i class="mdi mdi-flower-outline me-1 text-muted"></i>
                                    @L["Honey Type"]
                                </label>
                                @* D-98: "Other" adds a new honey type with its class *@
                                <partial name="_HoneyTypeSelect" model="@(new TOP4HoneyChains.Web.Models.ViewModels.HoneyTypeChoice("RawHoneyProductionHoneyType", "RawHoneyProductionHoneyType", (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.RawHoneyProductionHoneyType, Model.RawHoneyProductionHoneyType, ViewBag.MayAddHoneyType == true, ViewBag.NewHoneyTypeName as string, ViewBag.NewHoneyTypeClass as string, Placeholder: true))" />
                                <span asp-validation-for="RawHoneyProductionHoneyType" class="text-danger"></span>
                            </div>

                            <!-- Wholesaler -->
                            <div class="col-md-4 mb-4">
                                <label class="form-label fw-semibold required">
                                    <i class="mdi mdi-truck-outline me-1 text-muted"></i>
                                    @L["Wholesaler"]
                                </label>
                                <select asp-for="RawHoneyProductionWholesalerId"
                                        class="form-select shadow-sm"
                                        asp-items="ViewBag.RawHoneyProductionWholesalerId"
                                        required>
                                    <option value="">@L["Select Wholesaler"]</option>
                                </select>
                                <span asp-validation-for="RawHoneyProductionWholesalerId"
                                      class="text-danger"></span>
                            </div>

                            @if (ViewBag.Origins != null)
                            {
                                @* D-31: country of origin (organization model only) *@
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold" for="OriginCountry">@L["P5.OriginCountry"]</label>
                                    <select name="OriginCountry" id="OriginCountry" class="form-select shadow-sm" asp-items="ViewBag.Origins"></select>
                                </div>
                            }

                        </div>

                        <!-- Divider -->
                        <hr class="my-4" />

                        <div class="row">

                            <!-- Production Amount -->
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-semibold required">
                                    <i class="mdi mdi-weight-kilogram me-1 text-muted"></i>
                                    @L["Production Amount (kg)"]
                                </label>

                                <div class="input-group shadow-sm">
                                    <input asp-for="RawHoneyProductionAmount"
                                           class="form-control"
                                           placeholder="@L["Enter amount in kilograms"]"
                                           step="0.01"
                                           required />
                                    <span class="input-group-text">kg</span>
                                </div>

                                <span asp-validation-for="RawHoneyProductionAmount"
                                      class="text-danger"></span>
                            </div>

                        </div>

                        <!-- 🔷 ACTION BAR -->
                        <div class="d-flex justify-content-between align-items-center mt-4">

                            <a asp-action="RawHoneyProductionByApiary"
                               asp-route-id="@Model.RawHoneyProductionApiaryId"
                               class="btn btn-link app-back">
                                <i class="mdi mdi-arrow-left me-1"></i>
                                @L["Back to list"]
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-5 shadow">
                                <i class="mdi mdi-content-save-outline me-1"></i>
                                @L["Save Production"]
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/libs/parsleyjs/parsley.min.js"></script>
        <script src="~/assets/js/pages/form-validation.init.js"></script>
        <script src="~/assets/js/app.js"></script>
    }

</body>