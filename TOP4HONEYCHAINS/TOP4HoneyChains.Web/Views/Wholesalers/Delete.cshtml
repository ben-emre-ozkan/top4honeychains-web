@model TOP4HoneyChains.Web.Models.Entities.Wholesaler

@{
    ViewData["Title"] = L["Delete Wholesaler"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <!-- Danger Header Card -->
                    <div class="card border-0 shadow-lg mb-4">
                        <div class="card-body text-white rounded app-hero app-hero-danger">

                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h3 class="fw-bold mb-1">
                                        <i class="mdi mdi-alert-circle-outline me-2"></i>
                                        @L["Delete Wholesaler"]
                                    </h3>
                                    <small class="opacity-75">
                                        @L["This action will permanently remove the wholesaler record."]
                                    </small>
                                </div>

                                <div class="text-end">
                                    <span class="badge bg-dark fs-6 px-3 py-2">
                                        @L["Dangerous Action"]
                                    </span>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Wholesaler Info Card -->
                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title">@L["Wholesaler Details"]</h4>
                            <p class="card-title-desc">
                                @L["Please review the information before deleting this wholesaler."]
                            </p>

                            <!-- COMPANY HEADER (En önemli bilgi tek satır) -->
                            <div class="border rounded p-3 mb-4 bg-light">
                                <div class="d-flex justify-content-between align-items-center flex-wrap">

                                    <div>
                                        <small class="text-uppercase text-muted">@L["Company Name"]</small>
                                        <div class="fw-bold fs-4">
                                            @Model.WholesalerTitle
                                        </div>
                                    </div>

                                    <div class="text-end">
                                        <small class="text-uppercase text-muted d-block">@L["Status"]</small>
                                        @if (Model.WholesalerIsActive)
                                        {
                                            <span class="badge bg-success px-3 py-2 fs-6">
                                                @L["Active"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2 fs-6">
                                                @L["Passive"]
                                            </span>
                                        }
                                    </div>

                                </div>
                            </div>

                            <div class="row">

                                <!-- CONTACT INFORMATION -->
                                <div class="col-md-6">
                                    <div class="border rounded p-3 mb-3 h-100">
                                        <h5 class="mb-3">
                                            <i class="mdi mdi-account-outline me-1"></i>
                                            @L["Contact Information"]
                                        </h5>

                                        <div class="mb-2">
                                            <small class="text-uppercase text-muted">@L["Contact Person"]</small>
                                            <div class="fw-bold">
                                                @(string.IsNullOrEmpty(Model.WholesalerContactName) ? "—" : Model.WholesalerContactName)
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <small class="text-uppercase text-muted">@L["Phone"]</small>
                                            <div class="fw-bold">
                                                @(string.IsNullOrEmpty(Model.WholesalerPhone) ? "—" : Model.WholesalerPhone)
                                            </div>
                                        </div>

                                        <div>
                                            <small class="text-uppercase text-muted">@L["Email"]</small>
                                            <div class="fw-bold">
                                                @(string.IsNullOrEmpty(Model.WholesalerEmail) ? "—" : Model.WholesalerEmail)
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- LOCATION & COMPANY DATA -->
                                <div class="col-md-6">
                                    <div class="border rounded p-3 mb-3 h-100">
                                        <h5 class="mb-3">
                                            <i class="mdi mdi-office-building-outline me-1"></i>
                                            @L["Company & Location"]
                                        </h5>

                                        <div class="mb-2">
                                            <small class="text-uppercase text-muted">@L["Tax Number"]</small>
                                            <div class="fw-bold">
                                                @(string.IsNullOrEmpty(Model.WholesalerTaxNo) ? "—" : Model.WholesalerTaxNo)
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <small class="text-uppercase text-muted">@L["City / Country"]</small>
                                            <div class="fw-bold">
                                                @(string.IsNullOrEmpty(Model.WholesalerCity) ? "—" : Model.WholesalerCity)
                                                /
                                                @(string.IsNullOrEmpty(Model.WholesalerCountry) ? "—" : Model.WholesalerCountry)
                                            </div>
                                        </div>

                                        <div>
                                            <small class="text-uppercase text-muted">@L["Address"]</small>
                                            <div class="fw-bold">
                                                @(string.IsNullOrEmpty(Model.WholesalerAddress) ? "—" : Model.WholesalerAddress)
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <!-- SYSTEM INFO (Audit alanları ayrı blok - çok profesyonel) -->
                            <div class="card border-0 shadow-sm mt-3">
                                <div class="card-body">

                                    <h6 class="mb-3">
                                        <i class="mdi mdi-database-outline me-1"></i>
                                        @L["System Information"]
                                    </h6>

                                    <div class="row">
                                        <div class="col-md-4">
                                            <small class="text-uppercase text-muted">@L["Record ID"]</small>
                                            <div class="fw-bold">#@Model.WholesalerId</div>
                                        </div>

                                        <div class="col-md-4">
                                            <small class="text-uppercase text-muted">@L["Created At"]</small>
                                            <div class="fw-bold">
                                                @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <!-- Warning Alert -->
                            <div class="alert alert-danger mt-3">
                                <i class="mdi mdi-alert-outline me-2"></i>
                                @L["Warning: Deleting this wholesaler may affect raw honey production traceability records."]
                            </div>

                            <!-- Actions -->
                            <form asp-action="Delete" class="mt-3">
                                <input type="hidden" asp-for="WholesalerId" />

                                <div class="d-flex gap-2">
                                    <button type="submit"
                                            class="btn btn-danger waves-effect waves-light">
                                        <i class="mdi mdi-delete me-1"></i>
                                        @L["Delete Permanently"]
                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-link app-back"><i class="mdi mdi-arrow-left" aria-hidden="true"></i> @L["Back to list"]</a>
                                </div>
                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/js/app.js"></script>
    }

</body>