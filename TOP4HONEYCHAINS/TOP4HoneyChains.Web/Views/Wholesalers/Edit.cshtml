@model TOP4HoneyChains.Web.Models.Entities.Wholesaler

@{
    ViewData["Title"] = L["Edit Wholesaler"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title">@L["Edit Wholesaler"]</h4>
                            <p class="card-title-desc">
                                @L["Update wholesaler company and contact information."]
                            </p>

                            <!-- Meta Information Bar -->
                            <div class="mb-4">
                                <div class="d-flex flex-wrap gap-4 align-items-center">

                                    <div>
                                        <small class="text-uppercase text-muted">@L["Created At"]</small>
                                        <div class="fw-bold">
                                            <i class="mdi mdi-clock-outline me-1"></i>
                                            @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                        </div>
                                    </div>

                                    <div>
                                        <small class="text-uppercase text-muted">@L["Record ID"]</small>
                                        <div class="fw-bold">
                                            #@Model.WholesalerId
                                        </div>
                                    </div>

                                    <div>
                                        <small class="text-uppercase text-muted">@L["Status"]</small>
                                        <div>
                                            @if (Model.WholesalerIsActive)
                                            {
                                                <span class="badge bg-success px-3 py-2">
                                                    @L["Active"]
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary px-3 py-2">
                                                    @L["Passive"]
                                                </span>
                                            }
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <form asp-action="Edit" class="custom-validation">

                                <div asp-validation-summary="All" class="text-danger"></div>

                                <!-- Hidden Keys -->
                                <input type="hidden" asp-for="WholesalerId" />

                                <div class="row">

                                    <!-- Company Name -->
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="WholesalerTitle" class="form-label required">
                                            @L["Company Name"]
                                        </label>
                                        <input asp-for="WholesalerTitle"
                                               class="form-control"
                                               placeholder="@L["Enter company name"]"
                                               required />
                                        <span asp-validation-for="WholesalerTitle" class="text-danger"></span>
                                    </div>

                                    <!-- Tax No -->
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="WholesalerTaxNo" class="form-label">
                                            @L["Tax Number (Optional)"]
                                        </label>
                                        <input asp-for="WholesalerTaxNo"
                                               class="form-control"
                                               placeholder="@L["Enter tax number"]" />
                                        <span asp-validation-for="WholesalerTaxNo" class="text-danger"></span>
                                    </div>

                                    <!-- Contact Person -->
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="WholesalerContactName" class="form-label">
                                            @L["Contact Person"]
                                        </label>
                                        <input asp-for="WholesalerContactName"
                                               class="form-control"
                                               placeholder="@L["Enter contact person name"]" />
                                        <span asp-validation-for="WholesalerContactName" class="text-danger"></span>
                                    </div>

                                    <!-- Phone -->
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="WholesalerPhone" class="form-label">
                                            @L["Phone"]
                                        </label>
                                        <input asp-for="WholesalerPhone"
                                               class="form-control"
                                               placeholder="@L["Enter phone number"]" />
                                        <span asp-validation-for="WholesalerPhone" class="text-danger"></span>
                                    </div>

                                    <!-- Email -->
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="WholesalerEmail" class="form-label">
                                            @L["Email"]
                                        </label>
                                        <input asp-for="WholesalerEmail"
                                               type="email"
                                               class="form-control"
                                               placeholder="@L["Enter email address"]" />
                                        <span asp-validation-for="WholesalerEmail" class="text-danger"></span>
                                    </div>

                                    <!-- City -->
                                    <div class="col-md-3 mb-3">
                                        <label asp-for="WholesalerCity" class="form-label">
                                            @L["City"]
                                        </label>
                                        <input asp-for="WholesalerCity"
                                               class="form-control"
                                               placeholder="@L["City"]" />
                                        <span asp-validation-for="WholesalerCity" class="text-danger"></span>
                                    </div>

                                    <!-- Country -->
                                    <div class="col-md-3 mb-3">
                                        <label asp-for="WholesalerCountry" class="form-label">
                                            @L["Country"]
                                        </label>
                                        <input asp-for="WholesalerCountry"
                                               class="form-control"
                                               placeholder="@L["Country"]" />
                                        <span asp-validation-for="WholesalerCountry" class="text-danger"></span>
                                    </div>

                                    <!-- Address -->
                                    <div class="col-md-12 mb-3">
                                        <label asp-for="WholesalerAddress" class="form-label">
                                            @L["Address"]
                                        </label>
                                        <textarea asp-for="WholesalerAddress"
                                                  class="form-control"
                                                  rows="3"
                                                  placeholder="@L["Enter full address"]"></textarea>
                                        <span asp-validation-for="WholesalerAddress" class="text-danger"></span>
                                    </div>

                                    <!-- Active Status -->
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label d-block">@L["Status"]</label>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input"
                                                   asp-for="WholesalerIsActive"
                                                   type="checkbox" />
                                            <label class="form-check-label" for="WholesalerIsActive">
                                                @L["Active Wholesaler"]
                                            </label>
                                        </div>
                                    </div>

                                   

                                </div>

                                <div class="d-flex gap-2 mt-3">

                                    <button type="submit"
                                            class="btn btn-primary waves-effect waves-light">
                                        @L["Save Changes"]
                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-secondary waves-effect">
                                        @L["Back to list"]
                                    </a>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/libs/parsleyjs/parsley.min.js"></script>
        <script src="~/assets/js/pages/form-validation.init.js"></script>
        <script src="~/assets/js/app.js"></script>
    }

</body>