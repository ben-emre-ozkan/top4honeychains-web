@model IEnumerable<TOP4HoneyChains.Web.Models.Entities.RawHoneyProduction>

@{
    ViewData["Title"] = L["Raw Honey Batches"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var wholesaler = ViewBag.Wholesaler as TOP4HoneyChains.Web.Models.Entities.Wholesaler;



    var totalProductions = Model.Count();
    var totalRawHoneyStock = Model.Sum(m => m.RawHoneyProductionAmount);
    var missingCcpCount = Model.Count(r => !(r.RawHoneyCCPAssignments?.Any() ?? false));
    var fullyCompletedCount = Model.Count(r =>
        (r.RawHoneyCCPAssignments?.Count() ?? 0) > 0 &&
        r.RawHoneyCCPAssignments.Count(a => a.RawHoneyCCPAssignmentStatus == 3)
        == r.RawHoneyCCPAssignments.Count());
}

@section AddToHead {
    <link href="~/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" />
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <!-- PROFESSIONAL HEADER -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card shadow-sm border-0 app-hero">
                        <div class="card-body text-white">

                            <div class="d-flex justify-content-between align-items-center flex-wrap">

                                <!-- LEFT SIDE -->
                                <div>
                                    <h3 class="mb-1 fw-bold">
                                        @wholesaler?.WholesalerTitle
                                    </h3>

                                    <div class="text-light opacity-75">
                                        @L["Raw Honey Production Monitoring Panel"]
                                    </div>
                                </div>

                                <!-- RIGHT SIDE INFO -->
                                <div class="mt-3 mt-md-0">

                                    <div class="d-flex flex-wrap gap-3 text-end">

                                        <div>
                                            <div class="small text-light opacity-75">
                                                @L["City"]
                                            </div>
                                            <div class="fw-semibold">
                                                @wholesaler?.WholesalerCity
                                            </div>
                                        </div>

                                        <div>
                                            <div class="small text-light opacity-75">
                                                @L["Contact Person"]
                                            </div>
                                            <div class="fw-semibold">
                                                @wholesaler?.WholesalerContactName
                                            </div>
                                        </div>

                                        <div>
                                            <div class="small text-light opacity-75">
                                                @L["Email"]
                                            </div>
                                            <div class="fw-semibold">
                                                @wholesaler?.WholesalerEmail
                                            </div>
                                        </div>

                                    </div>
                                </div>

                            </div>

                            <!-- SUBTLE DIVIDER -->
                            <hr class="mt-3 mb-0" style="border-color: rgba(255,255,255,0.15);" />

                        </div>
                    </div>
                </div>
            </div>

            <!-- KPI CARDS -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card shadow-sm">
                        <div class="card-body text-center">
                            <h6 class="text-muted">@L["Total Batches"]</h6>
                            <h3 class="fw-bold">@totalProductions</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm">
                        <div class="card-body text-center">
                            <h6 class="text-muted">@L["Total Raw Honey"]</h6>
                            <h3 class="fw-bold">@string.Format("{0:N2}", totalRawHoneyStock) kg</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm">
                        <div class="card-body text-center">
                            <h6 class="text-muted">@L["Fully Completed"]</h6>
                            <h3 class="fw-bold text-success">@fullyCompletedCount</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm">
                        <div class="card-body text-center">
                            <h6 class="text-muted">@L["Missing CCP"]</h6>
                            <h3 class="fw-bold text-danger">@missingCcpCount</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- DATATABLE -->
            <div class="row">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-body">

                            <h4 class="card-title mb-4">@L["Assigned Raw Honey Productions"]</h4>

                            <table id="datatable"
                                   class="table table-bordered table-hover dt-responsive nowrap"
                                   style="border-collapse: collapse; border-spacing: 0; width: 100%;">

                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>@L["Apiary"]</th>
                                        <th>@L["Period"]</th>
                                        <th>@L["Honey Type"]</th>
                                        <th>@L["Amount (kg)"]</th>
                                        <th>@L["Date"]</th>
                                        <th style="min-width:220px;">@L["CCP Progress"]</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        var totalCcp = item.RawHoneyCCPAssignments?.Count() ?? 0;
                                        var completedCcp = item.RawHoneyCCPAssignments?
                                        .Count(a => a.RawHoneyCCPAssignmentStatus == 3) ?? 0;

                                        <tr class="@(totalCcp == 0 ? "table-danger" : "")">

                                            <td class="fw-bold">@item.RawHoneyProductionId</td>
                                            <td>@item.RawHoneyProductionApiary?.ApiaryTitle</td>
                                            <td>@Ref.T("ProductionPeriod", item.RawHoneyProductionPeriod?.RawHoneyProductionPeriodId, "Title", item.RawHoneyProductionPeriod?.RawHoneyProductionPeriodTitle)</td>
                                            <td>@Ref.T("HoneyType", item.RawHoneyProductionHoneyTypeNavigation?.HoneyTypeId, "Title", item.RawHoneyProductionHoneyTypeNavigation?.HoneyTypeTitle)</td>
                                            <td>@string.Format("{0:N2}", item.RawHoneyProductionAmount)</td>
                                            <td>@item.RawHoneyProductionDate?.ToString("dd.MM.yyyy")</td>

                                            <td>
                                                @if (totalCcp == 0)
                                                {
                                                    <span class="badge bg-danger px-3 py-2">
                                                        @L["No CCP Assigned"]
                                                    </span>
                                                }
                                                else
                                                {
                                                    var percent = (int)((double)completedCcp / totalCcp * 100);

                                                    string barClass =
                                                    percent == 100 ? "bg-success" :
                                                    percent > 0 ? "bg-warning" :
                                                    "bg-secondary";

                                                    <div class="progress" style="height:14px;">
                                                        <div class="progress-bar @barClass"
                                                             role="progressbar"
                                                             style="width:@percent%;"
                                                             aria-valuenow="@percent"
                                                             aria-valuemin="0"
                                                             aria-valuemax="100">
                                                        </div>
                                                    </div>

                                                    <div class="d-flex justify-content-between mt-1">
                                                        <small class="text-muted">
                                                            @completedCcp / @totalCcp
                                                        </small>
                                                        <small class="fw-bold">
                                                            @percent%
                                                        </small>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <div class="mt-4 text-end">
                                <a asp-action="Index"
                                   class="btn btn-outline-secondary">
                                    @L["← Back to Wholesalers"]
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
        <script src="~/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons-bs4/js/buttons.bootstrap4.min.js"></script>
        <script src="~/assets/libs/jszip/jszip.min.js"></script>
        <script src="~/assets/libs/pdfmake/build/pdfmake.min.js"></script>
        <script src="~/assets/libs/pdfmake/build/vfs_fonts.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.html5.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.print.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.colVis.min.js"></script>
        <script src="~/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
        <script src="~/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>

        <script src="~/assets/js/pages/datatables.init.js"></script>
        <script src="~/assets/js/app.js"></script>
    }
</body>