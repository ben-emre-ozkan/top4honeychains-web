@model List<TOP4HoneyChains.Web.Services.OrgModel.AuditRow>
@{
    ViewData["Title"] = L["Audit.Title"];
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    int page = ViewBag.Page, size = ViewBag.PageSize, total = ViewBag.Total;
    dynamic f = ViewBag.Filter;
    var entities = ViewBag.Entities as List<string> ?? new();
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h4 class="card-title mb-1">@L["Audit.Title"]</h4>
                            <p class="card-title-desc mb-0">@L["Audit.Help"]</p>
                        </div>
                        <form asp-action="Verify" method="post">
                            <button type="submit" class="btn btn-outline-primary" id="verify-chain">@L["Audit.Verify"]</button>
                        </form>
                    </div>

                    <form method="get" class="row g-2 mb-3">
                        <div class="col-md-3">
                            <select name="entity" class="form-select">
                                <option value="">@L["Audit.AllEntities"]</option>
                                @foreach (var e in entities) { <option value="@e" selected="@(e == (string?)f.entity)">@L[e]</option> }
                            </select>
                        </div>
                        <div class="col-md-2"><input name="act" value="@f.act" class="form-control" placeholder="@L["Action"]" /></div>
                        <div class="col-md-3"><input name="user" value="@f.user" class="form-control" placeholder="@L["Org.UserName"]" /></div>
                        <div class="col-md-2"><input name="flag" value="@f.flag" class="form-control" placeholder="@L["flag, e.g. SelfApproved"]" /></div>
                        <div class="col-md-2"><button type="submit" class="btn btn-secondary w-100">@L["Audit.Filter"]</button></div>
                    </form>

                    <div class="small text-muted mb-1">@L["{0} rows", total]</div>
                    @* D-73: who, when, which record and the changed fields as "old → new"; the stored JSON behind "Show raw" *@
                    <div class="table-responsive"><table class="table table-sm table-bordered small audit-table" id="audit-table">
                        <thead><tr><th>#</th><th>@L["Audit.When"]</th><th>@L["Audit.Who"]</th><th>@L["Audit.Action"]</th><th>@L["Audit.Record"]</th><th>@L["Audit.Changes"]</th><th>@L["Hash"]</th></tr></thead>
                        <tbody>
                            @foreach (var a in Model)
                            {
                                <tr data-audit-id="@a.Id">
                                    <td>@a.Id</td>
                                    <td class="text-nowrap"><time datetime="@a.AtUtc.ToString("yyyy-MM-ddTHH:mm:ssZ", System.Globalization.CultureInfo.InvariantCulture)" title="UTC @a.AtUtc.ToString("dd.MM.yyyy HH:mm:ss")">@a.AtLocal.ToString("dd.MM.yyyy HH:mm:ss")</time></td>
                                    <td><b>@(a.UserName ?? "—")</b>@if (a.OrgName != null) {<div class="text-muted">@a.OrgName</div>}</td>
                                    <td>@L[a.Action]@if (a.Flags != null) { <div><span class="badge bg-warning text-dark">@string.Join(", ", a.Flags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).Select(f => L[f].Value))</span></div> }</td>
                                    <td>@L[a.Entity]@if (a.Key != null) {<text> · </text>@if (a.RecordUrl != null) {<a href="@a.RecordUrl">#@a.Key</a>} else {<span>#@a.Key</span>}}</td>
                                    <td class="audit-changes">
                                        @if (a.Changes.Any())
                                        {
                                            <ul>
                                                @foreach (var c in a.Changes)
                                                {
                                                    <li><span class="audit-field">@c.Label:</span> @if (c.Old != null) {<span class="audit-old">@c.Old</span> <span class="audit-arrow" aria-label="@L["Audit.ChangedTo"]">→</span> }<span class="audit-new">@(c.New ?? "—")</span></li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@L["Audit.NoFields"]</span>
                                        }
                                        @if (a.OldJson != null || a.NewJson != null)
                                        {
                                            <details class="audit-raw">
                                                <summary>@L["Audit.ShowRaw"]</summary>
                                                @if (a.OldJson != null) {<div><b>@L["Audit.Old"]</b><pre>@a.OldJson</pre></div>}
                                                @if (a.NewJson != null) {<div><b>@L["Audit.New"]</b><pre>@a.NewJson</pre></div>}
                                            </details>
                                        }
                                    </td>
                                    <td><code title="@a.Hash">@a.Hash[..10]…</code></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>

                    <div class="d-flex gap-2">
                        @if (page > 1)
                        {
                            <a asp-action="Index" asp-route-page="@(page - 1)" asp-route-entity="@f.entity" asp-route-act="@f.act" asp-route-user="@f.user" asp-route-flag="@f.flag" class="btn btn-sm btn-outline-secondary">@L["Audit.Newer"]</a>
                        }
                        @if (page * size < total)
                        {
                            <a asp-action="Index" asp-route-page="@(page + 1)" asp-route-entity="@f.entity" asp-route-act="@f.act" asp-route-user="@f.user" asp-route-flag="@f.flag" class="btn btn-sm btn-outline-secondary">@L["Audit.Older"]</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
