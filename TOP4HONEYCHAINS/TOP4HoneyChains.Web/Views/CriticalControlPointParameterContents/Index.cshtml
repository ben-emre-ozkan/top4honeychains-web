@model IEnumerable<TOP4HoneyChains.Web.Models.Entities.CriticalControlPointParameterContent>

@{
    ViewData["Title"] = L["Parameter Contents"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

@section AddToHead {
    <link href="~/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <!-- 🔷 HEADER -->
            <div class="row mb-3">
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body d-flex justify-content-between align-items-center">

                            <div>
                                <h4 class="card-title mb-1">
                                    @L["Parameter Contents"]
                                </h4>
                                <p class="text-muted mb-0">
                                    @L["Manage educational content (video + explanations) for CCP parameters."]
                                </p>
                            </div>



                            <div class="d-flex gap-2 flex-wrap">

                                @if (ViewBag.ParameterId != null)
                                {
                                    <a asp-action="Create"
                                       asp-route-parameterId="@ViewBag.ParameterId"
                                       class="btn btn-primary waves-effect waves-light">
                                        <i class="mdi mdi-plus-circle me-1"></i>
                                        @L["Add Content"]
                                    </a>
                                }

                                <a asp-controller="CriticalControlPointParameters"
                                   asp-action="Index"
                                   class="btn btn-link app-back">
                                    <i class="mdi mdi-arrow-left me-1"></i>
                                    @L["Back"]
                                </a>

                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- 🔷 TABLE -->
            <div class="card">
                <div class="card-body">

                    <table id="datatable-buttons"
                           class="table table-bordered dt-responsive nowrap"
                           style="width:100%;">

                        <thead class="table-light">
                            <tr>
                                <th>@L["Type"]</th>
                                <th>@L["What?"]</th>
                                <th>@L["Why Important?"]</th>
                                <th>@L["Video"]</th>
                                <th>@L["Order"]</th>
                                <th>@L["Status"]</th>
                                <th>@L["Parameter"]</th>
                                <th style="width:220px;">@L["Actions"]</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- 🔵 TYPE -->
                                    <td>
                                        @{
                                            var typeClass =
                                            item.ContentType == "Video" ? "bg-primary" :
                                            item.ContentType == "Warning" ? "bg-danger" :
                                            "bg-info";
                                        }

                                    <span class="badge @typeClass px-3 py-2">
                                        @L[item.ContentType ?? ""]
                                    </span>
                                </td>

                                <!-- 🔵 WHAT -->
                                <td>
                                    @(string.IsNullOrWhiteSpace(item.WhatIsIt) ? "—" : TOP4HoneyChains.Web.Services.RefText.Short(Ref.T("ParameterContent", item.ContentId, "WhatIsIt", item.WhatIsIt), 25))
                                                                                    </td>

                                <!-- 🔵 WHY -->
                                <td>
                                    @(string.IsNullOrWhiteSpace(item.WhyImportant) ? "—" : TOP4HoneyChains.Web.Services.RefText.Short(Ref.T("ParameterContent", item.ContentId, "WhyImportant", item.WhyImportant), 25))
                                </td>

                                    <!-- 🔵 VIDEO -->
                                    <td>
                                    @if (!string.IsNullOrEmpty(item.VideoPath))
                                        {
                                            <a href="@item.VideoPath" target="_blank"
                                               class="btn btn-sm btn-outline-success">
                                                <i class="mdi mdi-play-circle-outline"></i>
                                                @L["Watch"]
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@L["No Video"]</span>
                                        }
                                    </td>

                                    <!-- 🔵 ORDER -->
                                    <td>
                                        <span class="badge bg-dark">
                                            @item.SortOrder
                                        </span>
                                    </td>

                                    <!-- 🔵 STATUS -->
                                    <td>
                                        @if (item.IsActive == true)
                                        {
                                            <span class="badge bg-success px-3 py-2">
                                                @L["Active"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2">
                                                @L["Passive"]
                                            </span>
                                        }
                                    </td>

                                    <!-- 🔵 PARAMETER -->
                                    <td>
                                        <span class="badge bg-info">
                                            @Ref.T("Parameter", item.Parameter?.ParameterId, "Name", item.Parameter?.ParameterName)
                                        </span>
                                    </td>

                                    <!-- 🔵 ACTIONS -->
                                    <td>
                                        <div class="d-flex gap-2">

                                            <a asp-action="Edit"
                                               asp-route-id="@item.ContentId"
                                               class="btn btn-sm btn-info w-100">
                                                <i class="mdi mdi-pencil me-1"></i>
                                                @L["Edit"]
                                            </a>

                                            <button class="btn btn-sm btn-danger w-100"
                                                    onclick="deleteContent(@item.ContentId)">
                                                <i class="mdi mdi-delete-outline me-1"></i>
                                                @L["Delete"]
                                            </button>

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            </div>

        </div>
    </div>

    @* Deletes are POSTs with an anti-forgery token (no state change via GET) *@
    <form id="deleteContentForm" asp-controller="CriticalControlPointParameterContents" asp-action="Delete" method="post" class="d-none">
        <input type="hidden" name="id" />
    </form>

    @section scripts{
        <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
        <script src="~/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons-bs4/js/buttons.bootstrap4.min.js"></script>
        <script src="~/assets/libs/jszip/jszip.min.js"></script>
        <script src="~/assets/libs/pdfmake/build/pdfmake.min.js"></script>
        <script src="~/assets/libs/pdfmake/build/vfs_fonts.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.html5.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.print.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.colVis.min.js"></script>
        <script src="~/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
        <script src="~/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>

        <script src="~/assets/js/pages/datatables.init.js"></script>
        <script src="~/assets/js/app.js"></script>

        <script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>

        <script>
            function deleteContent(id){

                Swal.fire({
                    title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Delete content?"].Value)),
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["This action cannot be undone"].Value)),
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#B42318',
                    cancelButtonColor: '#5E574C',
                    confirmButtonText: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Yes, delete"].Value)), cancelButtonText: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Cancel"].Value))
                }).then((result)=>{

                    if(result.isConfirmed){

                        var f = document.getElementById('deleteContentForm'); f.elements['id'].value = id; f.submit();

                    }

                })

            }
        </script>
    }
</body>