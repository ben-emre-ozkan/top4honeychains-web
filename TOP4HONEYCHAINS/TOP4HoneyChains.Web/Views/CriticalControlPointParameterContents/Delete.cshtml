@model TOP4HoneyChains.Web.Models.Entities.CriticalControlPointParameterContent

@{
    ViewData["Title"] = L["Delete"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<h1>@L["Delete"]</h1>

<h3>@L["Are you sure you want to delete this?"]</h3>
<div>
    <h4>@L["CriticalControlPointParameterContent"]</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ContentType)
        </dt>
        <dd class = "col-sm-10">
            @L[Model.ContentType ?? ""]
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.WhatIsIt)
        </dt>
        <dd class = "col-sm-10">
            @Ref.T("ParameterContent", Model.ContentId, "WhatIsIt", Model.WhatIsIt)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.WhyImportant)
        </dt>
        <dd class = "col-sm-10">
            @Ref.T("ParameterContent", Model.ContentId, "WhyImportant", Model.WhyImportant)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ExtraInfo)
        </dt>
        <dd class = "col-sm-10">
            @Ref.T("ParameterContent", Model.ContentId, "ExtraInfo", Model.ExtraInfo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.VideoPath)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.VideoPath)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SortOrder)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SortOrder)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsActive)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsActive)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Parameter)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Parameter.ParameterId)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="ContentId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">@L["Back to list"]</a>
    </form>
</div>
