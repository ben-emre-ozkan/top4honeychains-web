@model List<TOP4HoneyChains.Web.Models.Entities.Apiary>
@{
    ViewBag.Title = L["Me.Nav.Apiaries"].Value;
    var districts = ViewBag.Districts as Dictionary<int, string> ?? new();
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<h1>@L["Me.Nav.Apiaries"]</h1>
<p class="me-sub">@L["Me.ApiariesHelp"]</p>
@foreach (var a in Model)
{
    var district = a.DistrictId is int d && districts.TryGetValue(d, out var name) ? name : "–";
    <div class="me-card me-apiary">
        <h3>@a.ApiaryTitle</h3>
        <dl class="me-kv">
            <dt>@L["Me.Province"]</dt><dd>@(a.Province ?? "–")</dd>
            <dt>@L["Me.District"]</dt><dd>@district</dd>
            <dt>@L["Me.Hives"]</dt><dd>@a.ApiaryBeehivesCount</dd>
            <dt>@L["Me.Pin"]</dt><dd><code>@a.ApiaryLocationLatitude.ToString("0.00000", inv), @a.ApiaryLocationLongitude.ToString("0.00000", inv)</code></dd>
        </dl>
    </div>
}
@if (!Model.Any())
{
    <p class="me-muted">@L["Org.None"]</p>
}
