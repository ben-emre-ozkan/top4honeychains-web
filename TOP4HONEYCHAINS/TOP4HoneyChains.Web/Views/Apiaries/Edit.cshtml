@model TOP4HoneyChains.Web.Models.Entities.Apiary

@{
    ViewData["Title"] = "Edit Apiary";
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-xl-12">
                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title">Edit Apiary</h4>
                            <p class="card-title-desc">
                                <a asp-action="ByBeekeeper"
                                   asp-route-beekeeperId="@Model.ApiaryBeekeeperId"
                                   class="btn btn-secondary waves-effect waves-light">
                                    Back to Apiaries
                                </a>
                            </p>

                            <form asp-action="Edit">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                <!-- Hidden Fields -->
                                <input type="hidden" asp-for="ApiaryId" />
                                <input type="hidden" asp-for="ApiaryBeekeeperId" />
                                <input type="hidden" asp-for="ApiaryQRCode" />

                                <div class="mb-3">
                                    <label asp-for="ApiaryTitle" class="form-label">Title </label>
                                    <input asp-for="ApiaryTitle" class="form-control" />
                                    <span asp-validation-for="ApiaryTitle" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ApiaryBeehivesCount" class="form-label">Beehives Count</label>
                                    <input asp-for="ApiaryBeehivesCount" class="form-control" />
                                    <span asp-validation-for="ApiaryBeehivesCount" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ApiaryLocationLatitude" class="form-label">Location Latitude</label>
                                    <input asp-for="ApiaryLocationLatitude" class="form-control" />
                                    <span asp-validation-for="ApiaryLocationLatitude" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ApiaryLocationLongitude" class="form-label">Location Longitude</label>
                                    <input asp-for="ApiaryLocationLongitude" class="form-control" />
                                    <span asp-validation-for="ApiaryLocationLongitude" class="text-danger"></span>
                                </div>

                                <!-- QR Display (Readonly) -->
                                <div class="mb-3">
                                    <label class="form-label">QR Code</label>
                                    <input value="@Model.ApiaryQRCode"
                                           class="form-control"
                                           readonly />
                                </div>

                                <div class="mb-0">
                                    <button type="submit"
                                            class="btn btn-primary waves-effect waves-light me-1">
                                        Save Changes
                                    </button>
                                </div>

                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
