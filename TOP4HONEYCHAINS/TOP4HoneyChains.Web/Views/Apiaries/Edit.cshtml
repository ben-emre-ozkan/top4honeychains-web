@model TOP4HoneyChains.Web.Models.Entities.Apiary

@{
    ViewData["Title"] = L["Edit Apiary"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-xl-12">
                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title">@L["Edit Apiary"]</h4>
                            <p class="card-title-desc">
                                <a asp-action="ByBeekeeper"
                                   asp-route-beekeeperId="@Model.ApiaryBeekeeperId"
                                   class="btn btn-secondary waves-effect waves-light">
                                    @L["Back to Apiaries"]
                                </a>
                            </p>

                            <form asp-action="Edit">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                <!-- Hidden Fields -->
                                <input type="hidden" asp-for="ApiaryId" />
                                <input type="hidden" asp-for="ApiaryBeekeeperId" />
                                <input type="hidden" asp-for="ApiaryQRCode" />

                                <div class="mb-3">
                                    <label asp-for="ApiaryTitle" class="form-label required">@L["Title"] </label>
                                    <input asp-for="ApiaryTitle" class="form-control" />
                                    <span asp-validation-for="ApiaryTitle" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ApiaryBeehivesCount" class="form-label required">@L["Beehives Count"]</label>
                                    <input asp-for="ApiaryBeehivesCount" class="form-control" />
                                    <span asp-validation-for="ApiaryBeehivesCount" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ApiaryLocationLatitude" class="form-label required">@L["Location Latitude"]</label>
                                    <input asp-for="ApiaryLocationLatitude" asp-format="{0:0.#########}" inputmode="decimal" class="form-control" />
                                    <span asp-validation-for="ApiaryLocationLatitude" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ApiaryLocationLongitude" class="form-label required">@L["Location Longitude"]</label>
                                    <input asp-for="ApiaryLocationLongitude" asp-format="{0:0.#########}" inputmode="decimal" class="form-control" />
                                    <span asp-validation-for="ApiaryLocationLongitude" class="text-danger"></span>
                                </div>

                                <partial name="_LocationPicker" />

                                <!-- internal reference of the apiary (D-78): read-only; not a QR code -->
                                <div class="mb-3">
                                    <label class="form-label" for="apiary-reference">@L["Apiary reference"]</label>
                                    <input id="apiary-reference" value="@Model.ApiaryQRCode" class="form-control form-control-sm text-muted" readonly aria-describedby="apiary-reference-help" />
                                    <div id="apiary-reference-help" class="form-text">@L["Internal reference of the apiary, created automatically. It is not a QR code and is not shown publicly."]</div>
                                </div>

                                <div class="mb-0">
                                    <button type="submit"
                                            class="btn btn-primary waves-effect waves-light me-1">
                                        @L["Save Changes"]
                                    </button>
                                </div>

                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @section AddToHead {
        <link href="~/assets/libs/leaflet/leaflet.css" rel="stylesheet" asp-append-version="true" />
    }
    @section scripts{
        <script src="~/assets/libs/leaflet/leaflet.js" asp-append-version="true"></script>
        <script src="~/js/apiary-map.js" asp-append-version="true"></script>
    }
</body>
