@model TOP4HoneyChains.Web.Models.Entities.Apiary

@{
    ViewData["Title"] = L["Create"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-xl-12">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="card-title">@L["Create apiary"]</h4>
                            <p class="card-title-desc">
                                <a asp-action="ByBeekeeper"
                                   asp-route-beekeeperId="@Model.ApiaryBeekeeperId">
                                    @L["Back to Apiaries"]
                                </a>
                            </p>
                            <form class="custom-validation" asp-action="Create">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <input type="hidden" asp-for="ApiaryBeekeeperId" />

                                <div class="mb-3">
                                    <label asp-for="ApiaryTitle" class="form-label required">@L["Title"]</label>
                                    <input asp-for="ApiaryTitle" class="form-control" />
                                    <span asp-validation-for="ApiaryTitle" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ApiaryBeehivesCount" class="form-label required">@L["Beehives Count"]</label>
                                    <input asp-for="ApiaryBeehivesCount" class="form-control" />
                                    <span asp-validation-for="ApiaryBeehivesCount" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ApiaryLocationLatitude" class="form-label required">@L["Location Latitude"]</label>
                                    <input asp-for="ApiaryLocationLatitude" class="form-control" />
                                    <span asp-validation-for="ApiaryLocationLatitude" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ApiaryLocationLongitude" class="form-label required">@L["Location Longitude"]</label>
                                    <input asp-for="ApiaryLocationLongitude" class="form-control" />
                                    <span asp-validation-for="ApiaryLocationLongitude" class="text-danger"></span>
                                </div>



                                <div class="mb-0">
                                    <div>
                                        <button type="submit" class="btn btn-primary waves-effect waves-light me-1">
                                            @L["Submit"]
                                        </button>
                                        <a asp-action="ByBeekeeper" asp-route-beekeeperId="@Model.ApiaryBeekeeperId"
                                           class="btn btn-secondary waves-effect">
                                            @L["Cancel"]
                                        </a>
                                    </div>
                                </div>
                            </form>
                            <!-- end form -->
                        </div>
                    </div>
                </div> <!-- end col -->
            </div>
        </div>
    </div>
    @section scripts{
        <script src="~/assets/libs/parsleyjs/parsley.min.js"></script>
        <script src="~/assets/js/pages/form-validation.init.js"></script>
        <script src="~/assets/js/app.js"></script>
    }
</body>