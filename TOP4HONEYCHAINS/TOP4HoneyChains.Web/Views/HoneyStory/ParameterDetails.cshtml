@using System.Globalization
@using TOP4HoneyChains.Web.Services
@using TOP4HoneyChains.Web.Models.ViewModels.HoneyStory
@model HoneyStoryParameterViewModel
@{
    // Public parameter page (mobile: parameter detail). Limits and compliance only when the limit is verified (D-18).
    Layout = null;
    var culture = CultureInfo.CurrentUICulture;
    var p = Model.Parameter;
    var c = Model.Content;
    var name = Ref.Parameter(p.ParameterId, p.ParameterName);
    var unit = Ref.Unit(p.ParameterId, p.ParameterUnit);
    var symbol = Units.Symbol(unit);
    var jar = Model.InJar;
    var bar = jar == null ? null : HoneyStoryLab.Bar(jar);
    var back = Model.Qr != null ? $"/honeystory/{Model.Qr}#lab-report" : null;
    var query = Model.Qr != null ? $"?qr={Model.Qr}&lot={Model.Lot}" : "";
}
<!doctype html>
<html lang="@culture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@name · @L["Hst.Parameters"]</title>
    <partial name="~/Views/Shared/_Favicons.cshtml" />
    <meta name="theme-color" content="#FFFBF0">
    <link href="~/css/brand.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/storefront.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/honeystory.css" rel="stylesheet" asp-append-version="true">
</head>
<body class="sf-body">
<div class="sf hs" id="parameter" data-parameter="@p.ParameterId">

<partial name="_PublicTopBar" model="@(L["Hst.Parameters"].Value)" />

<main id="top" class="sf-main hs-stack-cards">
    @if (back != null)
    {
        <a class="hs-back" href="@back">← @L["Hst.BackToStory"]</a>
    }

    <section class="hs-hero">
        <svg class="hs-hero-hex" viewBox="0 0 100 100" aria-hidden="true"><polygon points="50,3 93,27 93,73 50,97 7,73 7,27" fill="none" stroke="#FFB547" stroke-width="5"></polygon></svg>
        <div class="hs-hero-row hs-param-hero">
            <div class="hs-param-icon"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#A2450B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.7 3h10.6a2 2 0 0 0 1.7-3l-5-9V3"></path><path d="M7.5 15h9"></path></svg></div>
            <div>
                <h1 class="hs-batch">@name</h1>
                <div class="hs-param-sub">@Ref.Code(p.CCP?.Code) · @Ref.CcpTitle(p.CCP?.Id, p.CCP?.Title)</div>
                @if (symbol.Length > 0)
                {
                    <div class="hs-maker">@L["Hst.Unit", symbol]</div>
                }
            </div>
        </div>
        <div class="hs-badges">
            @if (p.ParameterCategoryNavigation != null)
            {
                <span class="hs-tag">@Ref.Category(p.ParameterCategoryNavigation.CategoryId, p.ParameterCategoryNavigation.CategoryName)</span>
            }
            @if (p.LimitVerified && (p.MinValue != null || p.MaxValue != null))
            {
                <span class="hs-tag is-limit">⚠ @CcpLimitEvaluator.Describe(p.MinValue, p.MaxValue, symbol)</span>
            }
        </div>
    </section>

    @if (jar != null)
    {
        <section class="hs-card" id="in-this-jar">
            <h2 class="hs-title">@L["Hst.InThisJar"]</h2>
            <div class="hs-jar-value">
                <b>@jar.NumericValue!.Value.ToString("0.##", culture) <small title="@unit">@symbol</small></b>
                @if (jar.Compliant == true)
                {
                    <span class="hs-status is-ok">✓ @L["Hst.Within"]</span>
                }
                else if (jar.Compliant == false)
                {
                    <span class="hs-status is-out">! @L["Hst.Out"]</span>
                }
            </div>
            @if (Model.JarSource != null)
            {
                <p class="hs-note">@L["Hst.FromSource", Model.JarSource]</p>
            }
            @if (bar != null)
            {
                <div class="hs-bar" aria-hidden="true">
                    <div class="hs-bar-zone" style="left: @bar.Value.ZoneStart.ToString(CultureInfo.InvariantCulture)%; right: @((100 - bar.Value.ZoneEnd).ToString(CultureInfo.InvariantCulture))%"></div>
                    <div class="hs-bar-dot@(jar.Compliant == false ? " is-out" : "")" style="left: @bar.Value.Value.ToString(CultureInfo.InvariantCulture)%"></div>
                </div>
            }
            @if (jar.Compliant != null && jar.LimitText != null)
            {
                <div class="hs-limit">@L["Limit:"] @Ref.Limit(jar.LimitText, k => L[k])</div>
            }
            else
            {
                <div class="hs-pending">ⓘ <span>@L["Hst.LimitsPending"]</span></div>
            }
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(c?.VideoPath))
    {
        <section class="hs-card hs-text">
            <h2>▶ @L["Hst.EducationalVideo"]</h2>
            <video class="hs-video" controls preload="metadata"><source src="@c!.VideoPath" type="video/mp4"></video>
        </section>
    }
    @if (!string.IsNullOrWhiteSpace(c?.WhatIsIt))
    {
        <section class="hs-card hs-text"><h2>ⓘ @L["Hst.WhatIsIt"]</h2><p>@Ref.T("ParameterContent", c!.ContentId, "WhatIsIt", c.WhatIsIt)</p></section>
    }
    @if (!string.IsNullOrWhiteSpace(c?.WhyImportant))
    {
        <section class="hs-card hs-text"><h2>! @L["Hst.WhyImportant"]</h2><p>@Ref.T("ParameterContent", c!.ContentId, "WhyImportant", c.WhyImportant)</p></section>
    }
    @if (!string.IsNullOrWhiteSpace(c?.ExtraInfo))
    {
        <section class="hs-card hs-text"><h2>📊 @L["Hst.ReferenceValues"]</h2><p>@Ref.T("ParameterContent", c!.ContentId, "ExtraInfo", c.ExtraInfo)</p></section>
    }
    @if (string.IsNullOrWhiteSpace(c?.WhatIsIt) && string.IsNullOrWhiteSpace(c?.WhyImportant) && string.IsNullOrWhiteSpace(c?.ExtraInfo) && string.IsNullOrWhiteSpace(c?.VideoPath))
    {
        <section class="hs-card hs-text"><p>@L["No information available for this parameter."]</p></section>
    }

    @if (Model.Related.Any())
    {
        <section class="hs-card hs-text">
            <h2>🔗 @L["Hst.ReadTogether"]</h2>
            <p class="hs-note">@L["Hst.ReadTogetherHint"]</p>
            @foreach (var r in Model.Related)
            {
                <a class="hs-related" href="/honeystory/parameter/@r.ParameterId@(query)">
                    <span class="grow"><b>@Ref.Parameter(r.ParameterId, r.ParameterName)</b></span><span aria-hidden="true">›</span>
                </a>
            }
        </section>
    }
</main>

<footer class="sf-footer">
    <span class="sf-foot-brand"><img class="b-logo" src="~/img/brand/top4-logo-w2.svg" alt="TOP4HoneyChains" width="96" height="40"><span>@L["Sf.FooterTag"]</span></span>
    <span>@L["Hst.FooterNote"]</span>
</footer>
</div>
</body>
</html>
