@model TOP4HoneyChains.Web.Models.Entities.CriticalControlPointParameterContent

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/css/icons.min.css" rel="stylesheet" />
    <link href="~/assets/css/app.min.css" rel="stylesheet" />

    <style>
        body {
            background: radial-gradient(circle at 20% 20%,rgba(44,83,100,.05),transparent 40%), radial-gradient(circle at 80% 10%,rgba(15,32,39,.04),transparent 40%), linear-gradient(180deg,#f6f9fc,#eef2f7);
        }

        .container {
            max-width: 1100px;
        }

        .hero-wrap {
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 12px 40px rgba(0,0,0,.25);
        }

        .hero-icon {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            background: rgba(255,255,255,.15);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .section-header {
            padding: 16px 20px;
            border-radius: 12px;
            background: linear-gradient(135deg,#134e4a,#166534,#14532d);
        }

        .section-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            background: rgba(255,255,255,.15);
            color: white;
        }

        .section-divider {
            height: 2px;
            border: none;
            background: linear-gradient(90deg,#16a34a,transparent);
            margin-top: 14px;
            margin-bottom: 20px;
        }

        .soft-shadow {
            box-shadow: 0 10px 35px rgba(0,0,0,.08);
        }

        .video-frame {
            border-radius: 14px;
            overflow: hidden;
        }

        .video-sticky {
            position: sticky;
            top: 100px;
        }

        .content-text p {
            font-size: 15px;
            line-height: 1.7;
            color: #444;
        }

        @@media (max-width: 991px) {
            .video-sticky {
                position: relative;
                top: 0;
            }
        }
    </style>

</head>

<body>
    <partial name="~/Views/Shared/_LanguageSwitch.cshtml" />

    <div class="container py-5">

        <!-- HERO -->
        <div class="card border-0 hero-wrap mb-5">
            <div class="card-body text-white p-4"
                 style="background:linear-gradient(135deg,#0f2027,#203a43,#2c5364);">

                <div class="d-flex align-items-center">

                    <div class="me-3 hero-icon">
                        <i class="mdi mdi-flask-outline"></i>
                    </div>

                    <div>
                        <h3 class="fw-bold mb-1">
                            @L["Honey Quality Parameter"]
                        </h3>

                        <div class="opacity-75">
                            @L["Educational explanation"]
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <!-- MAIN GRID -->
        <div class="row g-5 align-items-start">

            <!-- LEFT TEXT -->
            <div class="col-lg-5">

                <div class="card border-0 soft-shadow">
                    <div class="card-body">

                        <div class="section-header mb-3 d-flex align-items-center">
                            <div class="section-icon me-3">
                                <i class="mdi mdi-information-outline"></i>
                            </div>

                            <div class="text-white fw-bold">

                                @(Model?.Parameter?.ParameterName ?? L["Parameter Details"].Value)

                                @if (!string.IsNullOrEmpty(Model?.Parameter?.ParameterUnit))
                                {
                                    <span class="ms-2 badge bg-light text-dark">
                                        @Ref.T("Parameter", Model.Parameter.ParameterId, "Unit", Model.Parameter.ParameterUnit)
                                    </span>
                                    <span class="badge bg-success ms-2">
                                        @Model.Parameter?.CCP?.Code
                                    </span>
                                }
                                <small class="text-white-50 d-block mt-1">
                                    @L["Honey quality control parameter"]
                                </small>



                            </div>
                        </div>

                        <hr class="section-divider">

                        <div class="content-text">

                            @if (!string.IsNullOrEmpty(Model?.WhatIsIt))
                            {
                                <p>
                                    <strong>@L["What is it?"]</strong><br>
                                    @Ref.T("ParameterContent", Model.ContentId, "WhatIsIt", Model.WhatIsIt)
                                </p>
                            }

                            @if (!string.IsNullOrEmpty(Model?.WhyImportant))
                            {
                                <p>
                                    <strong>@L["Why it matters?"]</strong><br>
                                    @Ref.T("ParameterContent", Model.ContentId, "WhyImportant", Model.WhyImportant)
                                </p>
                            }

                            @if (!string.IsNullOrEmpty(Model?.ExtraInfo))
                            {
                                <p>
                                    <strong>@L["Additional Info"]</strong><br>
                                    @Ref.T("ParameterContent", Model.ContentId, "ExtraInfo", Model.ExtraInfo)
                                </p>
                            }

                            @if (Model == null)
                            {
                                <div class="alert alert-warning">
                                    @L["No information available for this parameter."]
                                </div>
                            }

                        </div>

                    </div>
                </div>

            </div>

            <!-- RIGHT VIDEO -->
            <div class="col-lg-7">

                <div class="video-sticky">

                    <div class="card border-0 soft-shadow">
                        <div class="card-body">

                            <div class="section-header mb-4 d-flex align-items-center">
                                <div class="section-icon me-3">
                                    <i class="mdi mdi-play-circle-outline"></i>
                                </div>

                                <div class="text-white fw-bold">
                                    @L["Parameter Video"]
                                </div>
                            </div>

                            <hr class="section-divider">

                            <div class="video-frame">

                                @if (!string.IsNullOrEmpty(Model?.VideoPath))
                                {
                                    <video controls preload="metadata"
                                           style="width:100%;border-radius:14px"
                                           onerror="this.outerHTML='<div class=&quot;alert alert-warning&quot;>@L["Video not found"]</div>'">

                                        <source src="@Model.VideoPath" type="video/mp4">

                                    </video>
                                }
                                else
                                {
                                    <div class="alert alert-warning">
                                        @L["Video not available for this parameter."]
                                    </div>
                                }

                            </div>

                            <small class="text-muted d-block mt-2">
                                @L["⏱ Quick explanation (30–60 sec)"]
                            </small>

                        </div>
                    </div>

                </div>

            </div>

        </div>

        <!-- FOOTER -->
        <div class="text-center text-muted mt-5 small">
            <i class="mdi mdi-shield-check-outline me-1"></i>
            @L["TOP4HoneyChains Educational Content"]
        </div>

    </div>

    <script src="~/assets/libs/jquery/jquery.min.js"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>

</body>
</html>