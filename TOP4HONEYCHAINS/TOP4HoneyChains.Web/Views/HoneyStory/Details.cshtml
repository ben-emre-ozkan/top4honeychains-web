@using TOP4HoneyChains.Web.Models.ViewModels.HoneyStory
@model HoneyStoryViewModel

@{
    Layout = null;
    var tr = new System.Globalization.CultureInfo("tr-TR");
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@(Model.BatchTitle ?? "Honey Story")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/css/icons.min.css" rel="stylesheet" />
    <link href="~/assets/css/app.min.css" rel="stylesheet" />

    <style>
        body {
            background: radial-gradient(circle at 20% 20%,rgba(44,83,100,.05),transparent 40%), radial-gradient(circle at 80% 10%,rgba(15,32,39,.04),transparent 40%), linear-gradient(180deg,#f6f9fc,#eef2f7);
        }

        .container {
            max-width: 1200px;
        }

        .soft-shadow {
            box-shadow: 0 10px 35px rgba(0,0,0,.08);
        }

        .section-title {
            font-weight: 800;
            margin-bottom: 18px;
            letter-spacing: .2px;
        }

        .section-subtle {
            color: #6c757d;
            margin-top: -10px;
            margin-bottom: 20px;
        }

        /* HERO */
        .hero-wrap {
            border-radius: 18px;
            overflow: hidden;
        }

        .qr-frame {
            width: 128px;
            height: 128px;
            background: #fff;
            padding: 8px;
            border-radius: 14px;
            border: 1px solid rgba(0,0,0,.08);
            box-shadow: 0 10px 28px rgba(0,0,0,.20);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .metric-pill {
            background: rgba(255,255,255,.10);
            border: 1px solid rgba(255,255,255,.18);
            border-radius: 12px;
            padding: 10px 12px;
        }

        /* ORIGIN CARDS */
        .origin-card {
            border-radius: 16px;
            overflow: hidden;
        }

        .origin-header {
            background: #f1f4f6;
            border-bottom: 1px solid rgba(0,0,0,.06);
        }

        .tag-soft {
            background: #eef2f7;
            color: #203a43;
            border: 1px solid rgba(32,58,67,.12);
            border-radius: 999px;
            padding: 6px 10px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        /* Gallery */
        .carousel-item img {
            height: 420px;
            object-fit: cover;
            border-radius: 14px;
        }

        .ccp-card {
            background: #fff;
            border-radius: 18px;
            padding: 28px;
            margin-bottom: 32px;
            box-shadow: 0 10px 35px rgba(0,0,0,.08);
            border-left: 6px solid #2c5364;
        }

        .ccp-header {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .ccp-step {
            min-width: 72px;
            height: 42px;
            border-radius: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg,#203a43,#2c5364);
            color: #fff;
            font-weight: 700;
            font-size: 13px;
            padding: 0 14px;
            letter-spacing: .5px;
            box-shadow: 0 4px 12px rgba(0,0,0,.15);
        }

        .ccp-title {
            font-size: 18px;
            font-weight: 700;
        }

        .ccp-phase {
            font-size: 13px;
            opacity: .6;
        }

        .parameter-card {
            background: #f7f9fb;
            border-radius: 12px;
            padding: 14px 16px;
            border: 1px solid #eef1f4;
        }

        .param-name {
            font-size: 13px;
            color: #6c757d;
        }

        .param-value {
            margin-top: 6px;
            font-weight: 600;
        }

        /* Parameter tiles */
        .param-tile {
            background: #f8fafc;
            border: 1px solid rgba(0,0,0,.06);
            border-radius: 14px;
            padding: 14px;
            height: 100%;
        }

        .param-name {
            color: #6c757d;
            font-size: .85rem;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .param-value .badge {
            white-space: normal;
            word-break: break-word;
            border-radius: 10px;
            padding: .55rem .7rem;
        }

        /* IMPORTANT: Razor-friendly media query => @@media */
        @@media (max-width: 991px) {
            .timeline::before {
                left: 20px;
                transform: none;
            }

            .timeline-icon {
                left: 20px;
                transform: none;
            }

            .timeline-left, .timeline-right {
                padding-left: 70px;
                padding-right: 0;
            }
        }
    </style>
</head>

<body>

    <div class="container py-5">

        <!-- HERO -->
        <div class="card mb-5 border-0 shadow-lg hero-wrap">
            <div class="card-body text-white p-4"
                 style="background: linear-gradient(135deg,#0f2027,#203a43,#2c5364);">

                <div class="row align-items-center g-3">

                    <!-- LEFT : QR -->
                    <div class="col-md-2 text-center">
                        <div class="qr-frame">
                            <img src="@Url.Action("BatchQRCode", "HoneyStory", new { code = Model.BatchQR })"
                                 style="width:100%;height:100%;object-fit:contain;border-radius:10px;" />
                        </div>

                        <div class="small mt-2 opacity-75">
                            @L["Scan to verify authenticity"]
                        </div>
                    </div>

                    <!-- CENTER : BATCH INFO -->
                    <div class="col-md-6">
                        <h2 class="fw-bold mb-2">
                            <i class="mdi mdi-shield-check-outline me-2"></i>
                            @(Model.BatchTitle ?? "Honey Traceability Certificate")
                        </h2>

                        <div class="opacity-75 mb-3">
                            @L["Verified lifecycle & quality control record"]
                        </div>
                        @if (Model.Badges != null)
                        {
                            <partial name="_Badges" model="Model.Badges" />
                        }

                        <div class="row small g-2">

                            <div class="col-md-6">
                                <div class="metric-pill">
                                    <div class="opacity-75">@L["Wholesaler"]</div>
                                    <div class="fw-bold">@Model.WholesalerName</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="metric-pill">
                                    <div class="opacity-75">@L["Production"]</div>
                                    <div class="fw-bold">
                                        @(Model.ProductionDate?.ToString("dd MMM yyyy", tr) ?? "-")
                                    </div>
                                </div>
                            </div>

                           

                        </div>
                    </div>

                    <!-- RIGHT : METRICS -->
                    <div class="col-md-4 text-md-end">
                        <div class="display-6 fw-bold">
                            @((Model.TotalAmount ?? 0).ToString("N2", tr)) kg
                        </div>

                        <div class="opacity-75">@L["Total Batch Amount"]</div>

                        <div class="mt-3">
                            <span class="badge bg-success px-3 py-2 fs-6">
                                <i class="mdi mdi-certificate-outline me-1"></i>
                                @L["Traceable Product"]
                            </span>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- HONEY ORIGINS -->
        <h3 class="section-title">
            <i class="mdi mdi-map-marker-radius"></i> @L["Honey Origins"]
        </h3>
        <div class="section-subtle">
            @L["Source apiaries and photo evidence from collection stage."]
        </div>

        <div class="row g-4">
            @foreach (var source in Model.RawSources ?? new List<HoneyStoryRawSource>())
            {
                <div class="col-12">
                    <div class="card border-0 soft-shadow origin-card">
                        <!-- APIARY HEADER -->
                        <div class="p-4 origin-header">

                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

                                <!-- LEFT -->
                                <div>

                                    <h4 class="fw-bold mb-1 text-dark">
                                        <i class="mdi mdi-beehive-outline text-primary me-2"></i>
                                        @source.BeekeeperName – @source.ApiaryName
                                    </h4>

                                    <div class="text-muted small">
                                        @L["Raw Honey Collection Point"]
                                    </div>

                                </div>

                                <!-- RIGHT -->
                                <span class="badge bg-dark px-3 py-2">
                                    <i class="mdi mdi-map-marker-radius me-1"></i>
                                    @L["Source Apiary"]
                                </span>

                            </div>


                            <div class="row mt-3">

                                <div class="col-md-4">

                                    <small class="text-muted">@L["Beekeeper"]</small>

                                    <div class="fw-semibold">
                                        @source.BeekeeperName
                                        @if (source.StorefrontCode != null)
                                        {
                                            <a href="/storefront/@source.StorefrontCode" class="small ms-1 storefront-link">@L["P5.BeekeeperPage"]</a>
                                        }
                                    </div>

                                </div>


                                <div class="col-md-4">

                                    <small class="text-muted">@L["Honey Type"]</small>

                                    <div class="mt-1">

                                        <span class="badge bg-light text-dark border px-3 py-2">
                                            <i class="mdi mdi-water-outline me-1 text-primary"></i>
                                            @source.HoneyType
                                        </span>

                                    </div>

                                </div>


                                <div class="col-md-4">

                                    <small class="text-muted">@L["Used Amount"]</small>

                                    <div class="fw-bold text-success fs-5">
                                        @source.UsedAmount.ToString("N2", tr) kg
                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- PHOTO GALLERY -->
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">
                                <i class="mdi mdi-image-multiple-outline"></i> @L["Apiary Photo Gallery"]
                            </h5>

                            @if (source.Photos == null || source.Photos.Count == 0)
                            {
                                <div class="alert alert-warning mb-0">@L["No photos uploaded for this apiary."]</div>
                            }
                            else
                            {
                                var carouselId = $"carousel_{source.RawHoneyProductionId}";

                                <div id="@carouselId" class="carousel slide" data-bs-ride="carousel">
                                    <div class="carousel-inner">
                                        @{
                                            var isFirstPhoto = true;
                                            foreach (var p in source.Photos)
                                            {
                                                <div class="carousel-item @(isFirstPhoto ? "active" : "")">
                                                    <img src="@Url.Action("Image", "ApiaryPhotos", new { id = p.ApiaryPhotoId })"
                                                         class="d-block w-100" />
                                                </div>
                                                isFirstPhoto = false;
                                            }
                                        }
                                    </div>

                                    @if (source.Photos.Count > 1)
                                    {
                                        <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev">
                                            <span class="carousel-control-prev-icon"></span>
                                        </button>
                                        <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next">
                                            <span class="carousel-control-next-icon"></span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>

        <!-- HONEY JOURNEY -->
        <h3 class="section-title mt-5">
            <i class="mdi mdi-timeline-clock-outline"></i> @L["Honey Processing Traceability & CCP Monitoring"]
        </h3>
        <div class="section-subtle">
            @L["Critical Control Points monitored throughout honey processing and packaging stages."]
        </div>

        @{
            var batchBlocks = Model.BatchCcpBlocks ?? new List<HoneyStoryCcpBlock>();
            var gapCount = (Model.RawSources ?? new List<HoneyStoryRawSource>()).SelectMany(s => s.CcpBlocks)
                .Concat(batchBlocks)
                .Count(b => b.State == HoneyStoryCcpBlock.NotRecorded || b.State == HoneyStoryCcpBlock.Incomplete);
        }

        @if (gapCount > 0)
        {
            <div class="alert alert-light border small" id="ccp-gaps">
                <i class="mdi mdi-information-outline me-1"></i>
                @gapCount control point record(s) of this batch are missing or incomplete; they are marked "Not recorded" or "Partly recorded" below.
            </div>
        }

        @foreach (var source in Model.RawSources ?? new List<HoneyStoryRawSource>())
        {
            <h5 class="mt-4 mb-3">
                <span class="badge bg-secondary me-2">@L["Raw honey"]</span>
                @source.ApiaryName · @source.HoneyType
            </h5>
            <div class="ccp-container">
                @foreach (var block in source.CcpBlocks)
                {
                    <partial name="_CcpBlock" model="block" />
                }
            </div>
        }

        <h5 class="mt-5 mb-3">
            <span class="badge bg-primary me-2">@L["Final batch"]</span>
            @L["Processing & packaging"]
        </h5>
        <div class="ccp-container">
            @foreach (var block in batchBlocks)
            {
                <partial name="_CcpBlock" model="block" />
            }
        </div>

        <div class="text-center text-muted mt-5 small">
            <i class="mdi mdi-shield-check-outline me-1"></i>
            @L["Verified by"] <strong>@L["TOP4HoneyChains Traceability System"]</strong>
        </div>

    </div>

    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>