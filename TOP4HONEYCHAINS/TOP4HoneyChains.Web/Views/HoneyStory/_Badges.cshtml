@model TOP4HoneyChains.Web.Models.ViewModels.HoneyStory.HoneyStoryBadges
@* P4 (D-42): badges only from approved, verified data; shown only with the organization model *@
<div class="d-flex flex-wrap gap-2 mb-3" id="honeystory-badges">
    @if (Model.AccreditedLab)
    {
        <span class="badge bg-success px-3 py-2" id="badge-accredited" title="@string.Join(", ", Model.AccreditationNumbers)">
            <i class="mdi mdi-flask-outline me-1"></i>@L["Hs.AccreditedLab"]
            @if (Model.AccreditationNumbers.Any()) { <small class="ms-1">(@string.Join(", ", Model.AccreditationNumbers))</small> }
        </span>
    }
    @if (Model.InHouseLab)
    {
        <span class="badge bg-warning text-dark px-3 py-2" id="badge-inhouse"><i class="mdi mdi-home-outline me-1"></i>@L["Hs.InHouseLab"]</span>
    }
    @if (Model.AllCcpsApproved)
    {
        <span class="badge bg-success px-3 py-2" id="badge-approved"><i class="mdi mdi-check-decagram-outline me-1"></i>@L["Hs.AllCcpsApproved"]</span>
    }
    @if (Model.LimitsCompliant)
    {
        <span class="badge bg-success px-3 py-2" id="badge-limits"><i class="mdi mdi-scale-balance me-1"></i>@L["Hs.LimitsCompliant"]</span>
    }
    @foreach (var code in Model.ReportCodes)
    {
        <a href="/verify-report?code=@code" class="badge bg-light text-dark border px-3 py-2 text-decoration-none report-code"><i class="mdi mdi-file-certificate-outline me-1"></i>@L["Hs.LabReport"] @code</a>
    }
</div>
