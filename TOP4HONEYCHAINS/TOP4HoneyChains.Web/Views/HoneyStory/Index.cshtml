    <script>

        function initMap() {

            var center = { lat: 39.0, lng: 35.0 };

            var map = new google.maps.Map(
                document.getElementById("apiary-map"),
                {
                    zoom: 6,
                    center: center,
                    styles: [
                        {
                            featureType: "poi",
                            stylers: [{ visibility: "off" }]
                        }
                    ]
                }
            );

            var bounds = new google.maps.LatLngBounds();

            apiaries.forEach(function(a) {

                var position = { lat: a.lat, lng: a.lng };

                // D-12: an area of about 10 km instead of an exact pin
                var area = new google.maps.Circle({
                    map: map,
                    center: position,
                    radius: 7000,
                    strokeColor: "#16a34a",
                    strokeOpacity: 0.8,
                    strokeWeight: 2,
                    fillColor: "#16a34a",
                    fillOpacity: 0.25
                });

                // Built from text nodes, so names cannot inject HTML
                var content = document.createElement("div");
                content.style.minWidth = "220px";
                var name = document.createElement("b"); name.textContent = a.beekeeper || "";
                var apiaryName = document.createElement("span"); apiaryName.style.color = "#16a34a"; apiaryName.style.fontWeight = "600"; apiaryName.textContent = a.apiary || "";
                var used = document.createElement("div"); used.textContent = "Honey Used: " + a.amount;
                var share = document.createElement("div"); share.textContent = "Contribution: " + a.percent;
                var note = document.createElement("div"); note.style.color = "#6b7280"; note.textContent = "Approximate area";
                content.append(name, document.createElement("br"), apiaryName, document.createElement("br"), used, share, note);

                var infowindow = new google.maps.InfoWindow({ content: content, position: position });

                area.addListener("click", function() {
                    infowindow.open(map);
                });

                bounds.extend(position);

            });

            if (apiaries.length > 0)
                map.fitBounds(bounds);

            // Never zoom in closer than the approximate area (D-12)
            google.maps.event.addListenerOnce(map, "idle", function () {
                if (map.getZoom() > 10) map.setZoom(10);
            });

        }

    </script>

    @if (!string.IsNullOrWhiteSpace(mapsApiKey))
    {
        <script async defer
                src="https://maps.googleapis.com/maps/api/js?key=@Uri.EscapeDataString(mapsApiKey)&callback=initMap">
        </script>
    }
</body>
</html>