    <script>

        var chart = c3.generate({

            bindto: '#honey-donut-chart',

            data: {
                columns: honeyData,
                type: 'donut',

                onclick: function (d) {
                    console.log("clicked", d);
                }
            },

            donut: {
                title: "@Model.TotalAmount?.ToString("N0", tr) kg\nTOTAL HONEY"
            },

            tooltip: {
                format: {
                    value: function (value, ratio, id) {

                        var kg = honeyKg[id];

                        return kg.toLocaleString("tr-TR", {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }) + " kg (" + value.toFixed(1) + "%)";
                    }
                }
            },

            color: {
                pattern: [
                    "#134e4a",
                    "#166534",
                    "#15803d",
                    "#16a34a",
                    "#22c55e",
                    "#4ade80"
                ]
            },

            legend: {
                position: 'right'
            },

            padding: {
                top: 10,
                bottom: 10
            }

        });

    </script>

