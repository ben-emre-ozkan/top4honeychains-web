@using TOP4HoneyChains.Web.Models.Entities
@{
    ViewData["Title"] = L["Cust.Intakes"];
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var intakes = ViewBag.Intakes as List<LotIntake> ?? new();
    var denied = ViewBag.Denied as string;
    var prices = ViewBag.Prices as Dictionary<int, LotPrice>;
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <h4 class="card-title">@L["Cust.Intakes"]</h4>
                            <p class="card-title-desc">@L["Cust.IntakesHelp"]</p>
                        </div>
                        @if (denied == null)
                        {
                            <a asp-action="Create" class="btn btn-primary" id="new-intake"><i class="mdi mdi-plus"></i> @L["Cust.NewIntake"]</a>
                        }
                        else
                        {
                            <div class="text-muted small" id="intake-denied">@Msg.T(denied)</div>
                        }
                    </div>
                    <div class="table-responsive"><table class="table table-sm table-bordered mt-2" id="intakes">
                        <thead><tr><th>@L["Cust.Lot"]</th><th>@L["Org.Date"]</th><th>@L["Org.Apiary"]</th><th>@L["Org.HoneyType"]</th><th>@L["Org.Amount"]</th><th>@L["Cust.Origin"]</th><th>@L["Ci.Confirmation"]</th><th>SMS</th>@if (prices != null) { <th>@L["Me.Price"]</th> }<th></th></tr></thead>
                        <tbody>
                            @foreach (var i in intakes)
                            {
                                <tr data-lot-id="@i.RawHoneyProductionId">
                                    <td>#@i.RawHoneyProductionId</td>
                                    <td>@i.DeliveryDate.ToString("dd.MM.yyyy")</td>
                                    <td>@i.RawHoneyProduction?.RawHoneyProductionApiary?.ApiaryTitle</td>
                                    <td>@Ref.T("HoneyType", i.RawHoneyProduction?.RawHoneyProductionHoneyTypeNavigation?.HoneyTypeId, "Title", i.RawHoneyProduction?.RawHoneyProductionHoneyTypeNavigation?.HoneyTypeTitle)</td>
                                    <td>@i.Quantity.ToString("0.##")</td>
                                    <td>@i.Province / @i.District</td>
                                    <td>
                                        @if (i.IsLegacy)
                                        {
                                            <span class="badge bg-light text-dark border intake-legacy">@L["Ci.Legacy"]</span>
                                            @if (i.FormStoredFileName != null)
                                            {
                                                <a asp-action="Form" asp-route-id="@i.IntakeId" target="_blank">@L["Org.Open"]</a> <small class="text-muted" title="SHA-256">@i.FormSha256?[..12]…</small>
                                            }
                                        }
                                        else
                                        {
                                            <span>@L["Reg78.Method." + i.ConfirmationMethod]</span>
                                            <span class="badge @(i.EvidenceStatus == "Accepted" ? "bg-success" : i.EvidenceStatus == "Rejected" ? "bg-danger" : "bg-warning text-dark")">@L["Reg78.Evidence." + i.EvidenceStatus]</span>
                                        }
                                    </td>
                                    <td>@(i.SmsStatus != null ? L[i.SmsStatus].Value : "–")</td>
                                    @if (prices != null)
                                    {
                                        <td class="lot-price">@(prices.TryGetValue(i.RawHoneyProductionId, out var price) ? TOP4HoneyChains.Web.Services.OrgModel.BeekeeperPortalService.Money(price.PricePerKg, price.Currency) + " / kg" : "–")</td>
                                    }
                                    <td class="text-nowrap">
                                        @if (i.IsLegacy)
                                        {
                                            <a asp-controller="Samples" asp-action="Create" asp-route-lotId="@i.RawHoneyProductionId" class="btn btn-sm btn-outline-primary">@L["Lab.Sample"]</a>
                                        }
                                        else
                                        {
                                            <a asp-action="Details" asp-route-id="@i.IntakeId" class="btn btn-sm btn-outline-primary intake-details">@L["Ci.DetailsTitle"]</a>
                                        }
                                        <a asp-controller="Recall" asp-action="Lot" asp-route-id="@i.RawHoneyProductionId" class="btn btn-sm btn-outline-secondary">@L["Cust.Recall"]</a></td>
                                </tr>
                            }
                            @if (!intakes.Any())
                            {
                                <tr><td colspan="@(prices != null ? 10 : 9)" class="text-muted">@L["Org.None"]</td></tr>
                            }
                        </tbody>
                    </table></div>
                </div>
            </div>
            <a asp-controller="OrgWorkspace" asp-action="Index" class="btn btn-link app-back"><i class="mdi mdi-arrow-left" aria-hidden="true"></i> @L["Org.Back"]</a>
        </div>
    </div>
</body>
