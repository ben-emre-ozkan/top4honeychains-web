@model TOP4HoneyChains.Web.Services.OrgModel.IntakeForm
@using TOP4HoneyChains.Web.Models.Entities
@{
    ViewData["Title"] = L["Cust.NewIntake"];
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var bk = ViewBag.Beekeeper as Beekeeper;
    var labs = ViewBag.Labs as List<Organization> ?? new();
    var codeSent = ViewBag.CodeSent == true;
    var hasPhone = ViewBag.HasPhone == true;
    var rows = Model.Containers.Count == 0 ? new List<TOP4HoneyChains.Web.Services.OrgModel.ContainerRow> { new() } : Model.Containers;
    var capType = JarCap.All.Contains(Model.CapType ?? "") ? Model.CapType! : JarCap.SafetyButton;
}
@* D-78 P2 (D78-SPEC 4.4-4.5), D-97: one card per container in three steps (container, samples, closing), the jar cap once per
   delivery, every seal from the organization's seal pool, confirmation by the beekeeper's SMS code over all codes *@

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">@L["Cust.NewIntake"]</h4>
                    <p class="card-title-desc">@L["Ci.Help"]</p>
                    <ol class="ci-stepper">
                        <li><span class="ci-num" aria-hidden="true">1</span> @L["Ci.Delivery"]</li>
                        <li><span class="ci-num" aria-hidden="true">2</span> @L["Ci.Containers"]</li>
                        <li><span class="ci-num" aria-hidden="true">3</span> @L["Ci.Confirm"]</li>
                    </ol>
                    <honey-scene name="delivery" trigger="first" class="hs-compact" />

                    <form asp-action="Create" method="get" class="row g-2 align-items-end mb-4 field-form" id="find-beekeeper">
                        <div class="col-md-5">
                            <label class="form-label fw-semibold" for="number">@L["Cust.BeekeeperNumber"]</label><info-tip key="Cust.Info.Number" about="@L["Cust.BeekeeperNumber"].Value" />
                            <input name="number" id="number" class="form-control" value="@Model.Number" maxlength="50" autocomplete="off" autocapitalize="characters" />
                        </div>
                        <div class="col-md-2"><button type="submit" class="btn btn-outline-primary">@L["Cust.Find"]</button></div>
                    </form>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" role="alert" id="intake-errors">
                            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@Msg.T(e.ErrorMessage)</div>
                            }
                        </div>
                    }
                    @if (ViewBag.SameDayLot is int sameDayLot)
                    {
                        @* D-88 follow-up: several deliveries per apiary are allowed; the same honey type on the same day is only pointed out *@
                        <div class="alert alert-warning" role="status" id="same-day-warning">@Msg.T($"Lot #{sameDayLot} is a delivery of the same honey type from this apiary on the same day. Check that this is another delivery.")</div>
                    }

                    @if (bk != null)
                    {
                        <form asp-action="Record" method="post" enctype="multipart/form-data" id="custody-form" class="field-form" data-dup="@L["Ci.SealDup"]">
                            <input type="hidden" name="Number" value="@Model.Number" />
                            <input type="hidden" name="DraftKey" value="@Model.DraftKey" />
                            <div class="alert alert-light border" id="beekeeper-found">
                                <strong>@bk.BeekeeperFirstName @bk.BeekeeperLastName</strong> · <span id="beekeeper-official">@(ViewBag.BeekeeperRegistry as string ?? "–")</span> <small class="text-muted" id="beekeeper-platform">@L["Num.Platform"]: @bk.BeekeeperBusinessNumber</small>
                                @if (!hasPhone)
                                {
                                    <span class="badge bg-warning text-dark ms-2" id="no-phone">@L["Ci.NoPhone"]</span>
                                }
                            </div>

                            <section class="ci-section">
                            <h5 class="ci-h"><span class="ci-num" aria-hidden="true">1</span> @L["Ci.Delivery"]</h5>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label required" for="ApiaryId">@L["Org.Apiary"]</label>
                                    @* D-93: every active apiary with its hives; with more than one the officer chooses (no pre-selection) *@
                                    @{ var activeApiaries = bk.Apiaries.Where(a => a.ApiaryIsActive).OrderBy(a => a.ApiaryTitle).ToList(); }
                                    <select name="ApiaryId" id="ApiaryId" class="form-select" required>
                                        @if (activeApiaries.Count > 1)
                                        {
                                            <option value="">@L["-- Select --"]</option>
                                        }
                                        @foreach (var a in activeApiaries)
                                        {
                                            <option value="@a.ApiaryId" selected="@(a.ApiaryId == Model.ApiaryId)">@a.ApiaryTitle · @a.ApiaryBeehivesCount @L["Reg78.Hives"]</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label required" for="HoneyTypeId">@L["Org.HoneyType"]</label>
                                    <partial name="_HoneyTypeSelect" model="@(new TOP4HoneyChains.Web.Models.ViewModels.HoneyTypeChoice("HoneyTypeId", "HoneyTypeId", (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.HoneyTypes, Model.HoneyTypeId, ViewBag.MayAddHoneyType == true, Model.NewHoneyTypeName, Model.NewHoneyTypeClass))" />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label required" for="PeriodId">@L["Cust.Period"]</label>
                                    <select name="PeriodId" id="PeriodId" class="form-select" asp-items="ViewBag.Periods" asp-for="PeriodId" data-val="false"></select>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label required" for="OriginCountry">@L["P5.OriginCountry"]</label>
                                    <select name="OriginCountry" id="OriginCountry" class="form-select" asp-items="ViewBag.Origins" asp-for="OriginCountry" data-val="false"></select>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label required" for="DeliveryDate">@L["Cust.DeliveryDate"]</label>
                                    <input type="date" name="DeliveryDate" id="DeliveryDate" class="form-control" value="@Model.DeliveryDate?.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    @await Html.PartialAsync("~/Views/Shared/_ProvinceDistrict.cshtml", new TOP4HoneyChains.Web.Models.ViewModels.ProvinceDistrictField("Province", "District", Model.Province, Model.District, true, "Org.Province", "Org.District"))
                                </div>
                            </div>

                            </section>

                            @* D-97: section 2, the sample jars of the delivery (cap type once, laboratory, counter-samples), then one card per container *@
                            <section class="ci-section" id="ci-containers">
                            <h5 class="ci-h"><span class="ci-num" aria-hidden="true">2</span> @L["Ci.Containers"]</h5>
                            <p class="small text-muted">@L["Ci.ContainersHelp"]</p>

                            <div class="ci-panel" id="ci-jars">
                                <h6 class="fw-semibold mb-2"><i class="mdi mdi-flask-outline" aria-hidden="true"></i> @L["Ci.JarSetup"]</h6>
                                <fieldset>
                                    <legend class="form-label fw-semibold">@L["Ci.CapType"]</legend>
                                    <div class="ci-tiles ci-tiles-2">
                                        @foreach (var (value, scene) in new[] { (JarCap.SafetyButton, "button"), (JarCap.TamperRing, "ring") })
                                        {
                                            <label class="ci-tile" data-scene-on-pick="@scene">
                                                <input type="radio" class="ci-tile-input" name="CapType" value="@value" checked="@(capType == value)" />
                                                <span class="hs hs-@scene ci-ill" data-duration="@TOP4HoneyChains.Web.TagHelpers.HoneySceneTagHelper.Durations[scene]">@Html.Raw(TOP4HoneyChains.Web.TagHelpers.HoneySceneTagHelper.Template(scene).Replace("<svg ", "<svg class=\"hs-art\" aria-hidden=\"true\" focusable=\"false\" ", StringComparison.Ordinal))</span>
                                                <span class="ci-tile-title">@L["Ci.Cap." + value]</span>
                                                <span class="ci-tile-help">@L["Ci.Cap." + value + ".Help"]</span>
                                            </label>
                                        }
                                    </div>
                                </fieldset>
                                <aside class="ci-info" data-cap-info="@JarCap.SafetyButton" hidden="@(capType != JarCap.SafetyButton)">
                                    <i class="mdi mdi-lightbulb-on-outline ci-info-icon" aria-hidden="true"></i>
                                    <div><strong>@L["Ci.InfoCard.Button.Title"]</strong><p>@L["Ci.InfoCard.Button"]</p></div>
                                </aside>
                                <aside class="ci-info" data-cap-info="@JarCap.TamperRing" hidden="@(capType != JarCap.TamperRing)">
                                    <i class="mdi mdi-lightbulb-on-outline ci-info-icon" aria-hidden="true"></i>
                                    <div><strong>@L["Ci.InfoCard.Ring.Title"]</strong><p>@L["Ci.InfoCard.Ring"]</p></div>
                                </aside>
                                <div class="row mt-2">
                                    <div class="col-md-4 mb-2">
                                        <label class="form-label required" for="LabOrgId">@L["Lab.Laboratory"]</label>
                                        <select name="LabOrgId" id="LabOrgId" class="form-select">
                                            @foreach (var lab in labs)
                                            {
                                                <option value="@lab.OrgId" selected="@(lab.OrgId == Model.LabOrgId)">@lab.DisplayName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-5 mb-2">
                                        <label class="form-label required" for="CounterLocation">@L["Ci.CounterLocation"]</label><info-tip key="Ci.Info.CounterLocation" about="@L["Ci.CounterLocation"].Value" />
                                        <input name="CounterLocation" id="CounterLocation" class="form-control" value="@Model.CounterLocation" maxlength="200" />
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <label class="form-label required" for="RetainUntil">@L["Ci.RetainUntil"]</label>
                                        <input type="date" name="RetainUntil" id="RetainUntil" class="form-control" value="@Model.RetainUntil?.ToString("yyyy-MM-dd")" />
                                    </div>
                                </div>
                            </div>

                            <details class="ci-info ci-info-wide" id="ci-closure-info" open>
                                <summary><i class="mdi mdi-lightbulb-on-outline ci-info-icon" aria-hidden="true"></i> <strong>@L["Ci.InfoCard.Closure.Title"]</strong></summary>
                                <p class="mb-2">@L["Ci.InfoCard.Closure"]</p>
                                <ul class="ci-info-list">
                                    <li><strong>@L["Ci.Closure.SealLabel"]:</strong> @L["Ci.Closure.SealLabel.Help"]</li>
                                    <li><strong>@L["Ci.Closure.OrgContainer"]:</strong> @L["Ci.Closure.OrgContainer.Help"]</li>
                                </ul>
                                <p class="mb-0 small">@L["Ci.InfoCard.Closure.Pool"] <a href="/Seals/Index" id="seal-pool-link">@L["Seal.Title"]</a></p>
                            </details>

                            <div id="ci-cards" data-check-url="/Seals/Check" data-box-url="/Seals/FindBox" data-number="@Model.Number"
                                 data-ok="@L["Ci.SealOk"]" data-box-ok="@L["Ci.BoxOk"]" data-tare="@L["Ci.TareHint"]">
                                @for (var i = 0; i < rows.Count; i++)
                                {
                                    <partial name="_ContainerCard" model="@(new TOP4HoneyChains.Web.Models.ViewModels.ContainerCardModel(i.ToString(System.Globalization.CultureInfo.InvariantCulture), (i + 1).ToString(System.Globalization.CultureInfo.InvariantCulture), rows[i], capType))" />
                                }
                            </div>
                            <template id="ci-card-template">
                                <partial name="_ContainerCard" model="@(new TOP4HoneyChains.Web.Models.ViewModels.ContainerCardModel("__i__", "", new TOP4HoneyChains.Web.Services.OrgModel.ContainerRow(), capType))" />
                            </template>
                            <div class="d-flex flex-wrap gap-3 align-items-center mb-2">
                                <button type="button" class="btn btn-outline-primary" id="add-container"><i class="mdi mdi-plus"></i> @L["Ci.AddContainer"]</button>
                                <span>@L["Ci.Total"]: <strong id="total-kg">0</strong> kg</span>
                            </div>
                            </section>

                            <section class="ci-section" id="ci-confirm">
                            <h5 class="ci-h"><span class="ci-num" aria-hidden="true">3</span> @L["Ci.Confirm"]</h5>
                            <aside class="ci-info" id="ci-confirms">
                                <i class="mdi mdi-cellphone-message ci-info-icon" aria-hidden="true"></i>
                                <div>
                                    <strong>@L["Ci.Confirms.Title"]</strong>
                                    <p>@L["Ci.Confirms"]</p>
                                    <div class="ci-confirm-list" id="ci-confirm-list" data-cap-label="@L["Ci.CapType"]"
                                         data-container="@L["Ci.Container"]" data-jar="@L["Ci.SampleJar"]" data-counter="@L["Ci.CounterJar"]" data-closing="@L["Ci.Step.Closing"]" data-origin="@L["Ci.ArrivedSealed"]"></div>
                                </div>
                            </aside>
                            @if (hasPhone)
                            {
                                @if (!codeSent)
                                {
                                    <p class="small">@L["Ci.SendHelp"]</p>
                                    <button type="submit" name="op" value="send" class="btn btn-primary" id="intake-send"><i class="mdi mdi-message-processing-outline"></i> @L["Notice.SendCode"]</button>
                                }
                                else
                                {
                                    @if (ViewBag.DemoMessage is string demo)
                                    {
                                        <div class="alert alert-info small" id="demo-sms"><strong>@L["Reg78.DemoSms"]</strong> @demo</div>
                                    }
                                    <p class="small">@L["Ci.NotPresent"]</p>
                                    <div class="row g-2 align-items-end">
                                        <div class="col-auto">
                                            <label class="form-label" for="Code">@L["Notice.Code"]</label>
                                            <input class="form-control" name="Code" id="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" />
                                        </div>
                                        <div class="col-auto"><button type="submit" name="op" value="confirm" class="btn btn-success" id="intake-confirm">@L["Ci.ConfirmButton"]</button></div>
                                        <div class="col-auto"><button type="submit" name="op" value="send" class="btn btn-outline-secondary">@L["Notice.SendNewCode"]</button></div>
                                    </div>
                                }
                            }

                            <details class="mt-4" id="intake-fallback" open="@(!hasPhone || !string.IsNullOrEmpty(Model.FallbackReason))">
                                <summary>@L["Ci.Fallback"]</summary>
                                <p class="small mt-2">@L["Ci.FallbackHelp"]</p>
                                <div class="row g-2">
                                    <div class="col-md-6"><label class="form-label" for="FallbackReason">@L["Reg78.FallbackReason"]</label><input class="form-control" name="FallbackReason" id="FallbackReason" value="@Model.FallbackReason" maxlength="300" /></div>
                                    <div class="col-md-6"><label class="form-label" for="deliveryForm">@L["Cust.DeliveryFormPhoto"]</label><input type="file" name="deliveryForm" id="deliveryForm" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.webp" data-camera="@L["Mob.Camera"]" /></div>
                                </div>
                                <button type="submit" name="op" value="photo" class="btn btn-warning mt-2" id="intake-photo">@L["Ci.SaveWithPhoto"]</button>
                            </details>
                            </section>
                        </form>
                    }
                </div>
            </div>
            <a asp-action="Index" class="btn btn-link app-back"><i class="mdi mdi-arrow-left" aria-hidden="true"></i> @L["Org.Back"]</a>
        </div>
    </div>
    @section scripts {
        <link rel="stylesheet" href="~/css/intake-cards.css" asp-append-version="true" />
        <script src="~/js/intake-containers.js" asp-append-version="true"></script>
    }
</body>
