@model TOP4HoneyChains.Web.Controllers.VerifyController.ReportInfo?
@{
    // B5 (D-84): the public check in the brand of the sign-in pages; only an approved report is found (C4)
    ViewBag.Title = L["Ver.Title"].Value;
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<h1 class="au-title">@L["Ver.Title"]</h1>
<p class="au-sub">@L["Ver.Help"]</p>

<form method="get" action="/verify-report" class="au-form" id="verify-form">
    <div class="au-field">
        <label for="code">@L["Lab.ReportCode"]</label>
        <div class="au-verify-row">
            <input id="code" name="code" class="au-verify-code" maxlength="20" value="@ViewBag.Code" placeholder="@L["Lab.ReportCode"]" autocomplete="off" autocapitalize="characters" spellcheck="false" />
            <button type="submit" class="b-btn b-btn-honey">@L["Ver.Check"]</button>
        </div>
    </div>
</form>

@if (Model != null)
{
    <dl class="au-facts" id="verify-result">
        <dt>@L["Lab.ReportCode"]</dt><dd>@Model.Code</dd>
        <dt>@L["Org.Status"]</dt>
        <dd id="verify-status"><span class="au-pill au-pill-ok">@L["Ver.Approved"]</span> @Model.ApprovedAt?.ToString("dd.MM.yyyy")</dd>
        <dt>@L["Lab.Laboratory"]</dt>
        <dd>@Model.Laboratory
            @if (Model.Accredited) { <span class="au-pill au-pill-ok">@L["Org.Accredited"] @Model.AccreditationNumber</span> }
            @if (Model.InHouse) { <span class="au-pill au-pill-warn">@L["Hs.InHouseLab"]</span> }
        </dd>
        <dt>@L["Lab.ReportNumber"]</dt><dd>@Model.ReportNumber</dd>
        <dt>@L["Lab.IssuedOn"]</dt><dd>@Model.IssuedOn?.ToString("dd.MM.yyyy")</dd>
        <dt>SHA-256</dt><dd><code id="verify-sha">@Model.Sha256</code></dd>
    </dl>
    @if (Model.Sha256 != null)
    {
        <div class="au-field au-verify-file">
            <span class="au-label" id="pdf-label">@L["Ver.CompareFile"]</span>
            @* the localized picker over the native input (kept for keyboard and screen readers), as on the other file fields (D-67) *@
            <div class="au-file">
                <input type="file" id="pdf" class="au-file-input" accept=".pdf" aria-labelledby="pdf-label" />
                <label for="pdf" class="b-btn au-file-btn">@L["Choose PDF"]</label>
                <span class="au-file-name" id="pdf-name" aria-live="polite">@L["No file chosen"]</span>
            </div>
            <div class="au-alert" id="compare-result" role="status" hidden></div>
        </div>
        <script>
            // The file is hashed in the browser; it is never uploaded
            document.getElementById('pdf').addEventListener('change', async e => {
                const f = e.target.files[0]; if (!f) return;
                document.getElementById('pdf-name').textContent = f.name;
                const hash = await crypto.subtle.digest('SHA-256', await f.arrayBuffer());
                const hex = [...new Uint8Array(hash)].map(b => b.toString(16).padStart(2, '0')).join('');
                const ok = hex === '@Model.Sha256';
                const out = document.getElementById('compare-result');
                out.textContent = ok ? '@Html.Raw(L["Ver.Match"].Value.Replace("'", "\\'"))' : '@Html.Raw(L["Ver.NoMatch"].Value.Replace("'", "\\'"))';
                out.className = 'au-alert ' + (ok ? 'au-alert-ok' : 'au-alert-error');
                out.hidden = false;
            });
        </script>
    }
}
else if (ViewBag.Searched == true)
{
    <div class="au-alert au-alert-warn" role="status" id="verify-none">@L["Ver.NotFound"]</div>
}
