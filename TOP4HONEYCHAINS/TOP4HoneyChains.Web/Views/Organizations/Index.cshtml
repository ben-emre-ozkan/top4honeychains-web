@using TOP4HoneyChains.Web.Models.Entities
@model List<Organization>
@{
    ViewData["Title"] = "Organizations";
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var counts = ViewBag.MemberCounts as Dictionary<int, int> ?? new();
    var isAdmin = User.IsInRole("Administrator");
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h4 class="card-title mb-1">Organizations</h4>
                            <p class="card-title-desc mb-0">Organizations take part through capabilities; people join them through memberships. Only verified organizations can enter data.</p>
                        </div>
                        @if (isAdmin)
                        {
                            <a asp-action="Create" class="btn btn-success"><i class="mdi mdi-plus"></i> New organization</a>
                        }
                    </div>

                    <table class="table table-bordered table-sm align-middle" id="org-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Capabilities</th>
                                <th>Status</th>
                                <th>Province</th>
                                <th>Members</th>
                                <th>Four-eyes exemption</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model)
                            {
                                var badge = o.Status switch { OrgStatus.Verified => "bg-success", OrgStatus.Suspended => "bg-danger", _ => "bg-warning text-dark" };
                                <tr data-org-id="@o.OrgId">
                                    <td>@o.DisplayName @if (o.IsPlatform) { <span class="badge bg-dark ms-1">platform</span> } @if (o.LegacyWholesalerId != null) { <span class="badge bg-light text-dark border ms-1" title="Created from a wholesaler record">wholesaler</span> }</td>
                                    <td>@string.Join(", ", o.Capabilities.Select(c => c.Capability))</td>
                                    <td><span class="badge @badge org-status">@o.Status</span></td>
                                    <td>@o.Province</td>
                                    <td>@(counts.TryGetValue(o.OrgId, out var n) ? n : 0)</td>
                                    <td>@(o.FourEyesExempt ? "yes" : "no")</td>
                                    <td><a asp-action="Details" asp-route-id="@o.OrgId" class="btn btn-sm btn-primary">Open</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
