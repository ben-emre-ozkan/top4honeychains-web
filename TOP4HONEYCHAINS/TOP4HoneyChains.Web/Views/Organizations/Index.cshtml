@using TOP4HoneyChains.Web.Models.Entities
@model List<Organization>
@{
    ViewData["Title"] = L["Org.Organizations"];
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var counts = ViewBag.MemberCounts as Dictionary<int, int> ?? new();
    var isAdmin = User.IsInRole("Administrator");
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h4 class="card-title mb-1">@L["Org.Organizations"]</h4>
                            <p class="card-title-desc mb-0">@L["Org.OrganizationsHelp"]</p>
                        </div>
                        @if (isAdmin)
                        {
                            <a asp-action="Create" class="btn btn-success"><i class="mdi mdi-plus"></i> @L["Org.NewOrganization"]</a>
                        }
                    </div>

                    <div class="table-responsive"><table class="table table-bordered table-sm align-middle" id="org-table">
                        <thead>
                            <tr>
                                <th>@L["Org.Name"]</th>
                                <th>@L["Org.Capabilities"]</th>
                                <th>@L["Org.Status"]</th>
                                <th>@L["Org.Province"]</th>
                                <th>@L["Org.Members"]</th>
                                <th>@L["Org.FourEyesExemption"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model)
                            {
                                var badge = o.Status switch { OrgStatus.Verified => "bg-success", OrgStatus.Suspended => "bg-danger", _ => "bg-warning text-dark" };
                                <tr data-org-id="@o.OrgId">
                                    <td>@o.DisplayName @if (o.IsPlatform) { <span class="badge bg-dark ms-1">@L["platform"]</span> }@* D-95: no "Wholesaler" tag; the link to a wholesaler record is internal (every plant gets one, D-88) and matches no capability *@</td>
                                    <td>@string.Join(", ", o.Capabilities.Select(c => Ref.Capability(c.Capability)))</td>
                                    <td><span class="badge @badge org-status">@L[o.Status ?? ""]</span></td>
                                    <td>@o.Province</td>
                                    <td>@(counts.TryGetValue(o.OrgId, out var n) ? n : 0)</td>
                                    <td>@(o.FourEyesExempt ? L["Yes"] : L["No"])</td>
                                    <td><a asp-action="Details" asp-route-id="@o.OrgId" class="btn btn-sm btn-primary">@L["Org.Open"]</a></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                </div>
            </div>
        </div>
    </div>
</body>
