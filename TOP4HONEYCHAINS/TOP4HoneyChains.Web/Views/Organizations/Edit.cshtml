@using TOP4HoneyChains.Web.Models.Entities
@model Organization
@{
    ViewData["Title"] = "Edit organization";
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">@L["Org.EditOrganization"]</h4>
                    <p class="card-title-desc">@L["Org.EditHelp"]</p>

                    <form asp-action="Edit" asp-route-id="@Model.OrgId" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DisplayName" class="form-label required">@L["Org.DisplayName"]</label>
                                <input asp-for="DisplayName" class="form-control" maxlength="200" />
                                <span asp-validation-for="DisplayName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LegalName" class="form-label">@L["Org.LegalName"]</label>
                                <input asp-for="LegalName" class="form-control" maxlength="300" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="TaxNo" class="form-label">@L["Org.TaxNumber"]</label>
                                <input asp-for="TaxNo" class="form-control" maxlength="50" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Province" class="form-label">@L["Org.Province"]</label>
                                <input asp-for="Province" class="form-control" maxlength="100" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="District" class="form-label">@L["Org.District"]</label>
                                <input asp-for="District" class="form-control" maxlength="100" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">@L["Org.Save"]</button>
                        <a asp-action="Details" asp-route-id="@Model.OrgId" class="btn btn-secondary">@L["Org.Cancel"]</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
