@using TOP4HoneyChains.Web.Models.Entities
@model Organization
@{
    ViewData["Title"] = Model.DisplayName;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var isAdmin = (bool)ViewBag.IsAdmin;
    var canDocs = (bool)ViewBag.CanManageDocuments;
    var canVerify = (bool)ViewBag.CanVerify;
    var members = ViewBag.Members as List<Membership> ?? new();
    var names = ViewBag.UserNames as Dictionary<string, string> ?? new();
    var allCaps = ViewBag.AllCapabilities as List<Capability> ?? new();
    var roles = ViewBag.Roles as string[] ?? Array.Empty<string>();
    var kinds = ViewBag.DocumentKinds as string[] ?? Array.Empty<string>();
    var badge = Model.Status switch { OrgStatus.Verified => "bg-success", OrgStatus.Suspended => "bg-danger", _ => "bg-warning text-dark" };
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">

            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h4 class="card-title mb-1">@Model.DisplayName @if (Model.IsPlatform) { <span class="badge bg-dark">@L["platform"]</span> }</h4>
                            <div class="text-muted small">
                                @Model.LegalName @(Model.TaxNo != null ? " · Tax no. " + Model.TaxNo : "") @(Model.Province != null ? " · " + Model.Province : "") @(Model.District != null ? " / " + Model.District : "")
                                @if (Model.LegacyWholesaler != null) { <span> · @L["created from the wholesaler record \"{0}\"", Model.LegacyWholesaler.WholesalerTitle]</span> }
                            </div>
                        </div>
                        <div class="text-end">
                            <span class="badge @badge fs-6" id="org-status">@L[Model.Status ?? ""]</span>
                            @if (isAdmin)
                            {
                                <div class="mt-2"><a asp-action="Edit" asp-route-id="@Model.OrgId" class="btn btn-sm btn-outline-primary">@L["Org.EditDetails"]</a></div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Verification -->
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">@L["Org.Verification"]</h5>
                            <p class="text-muted small mb-2">@L["Org.VerificationHelp"]</p>
                            @if (canVerify && !Model.IsPlatform)
                            {
                                <form asp-action="ChangeStatus" asp-route-id="@Model.OrgId" method="post" class="mb-3" id="verify-form">
                                    <textarea name="reason" class="form-control mb-2" rows="2" maxlength="500" placeholder="@L["Org.ReasonPlaceholder"]"></textarea>
                                    @if (Model.Status != OrgStatus.Verified)
                                    {
                                        <button type="submit" name="toStatus" value="Verified" class="btn btn-sm btn-success">@(Model.Status == OrgStatus.Suspended ? L["Reinstate"] : L["Verify"])</button>
                                    }
                                    @if (Model.Status == OrgStatus.Pending)
                                    {
                                        <button type="submit" name="toStatus" value="Pending" class="btn btn-sm btn-outline-secondary">@L["Org.RequestDocuments"]</button>
                                    }
                                    @if (Model.Status == OrgStatus.Verified)
                                    {
                                        <button type="submit" name="toStatus" value="Suspended" class="btn btn-sm btn-danger">@L["Org.Suspend"]</button>
                                    }
                                </form>
                            }
                            <div class="table-responsive"><table class="table table-sm">
                                <thead><tr><th>@L["Org.When"]</th><th>@L["Org.From"]</th><th>@L["Org.To"]</th><th>@L["Org.Reason"]</th></tr></thead>
                                <tbody>
                                    @foreach (var e in Model.VerificationEvents.OrderByDescending(e => e.EventId))
                                    {
                                        <tr><td>@e.At.ToString("dd.MM.yyyy HH:mm")</td><td>@(e.FromStatus == null ? "-" : L[e.FromStatus].Value)</td><td>@(e.ToStatus == null ? "-" : L[e.ToStatus].Value)</td><td>@e.Reason</td></tr>
                                    }
                                    @if (!Model.VerificationEvents.Any())
                                    {
                                        <tr><td colspan="4" class="text-muted">@L["Org.NoStatusChanges"]</td></tr>
                                    }
                                </tbody>
                            </table></div>
                        </div>
                    </div>

                    <!-- Documents -->
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">@L["Org.Documents"]</h5>
                            <div class="table-responsive"><table class="table table-sm" id="documents">
                                <thead><tr><th>@L["Org.Type"]</th><th>@L["Org.File"]</th><th>SHA-256</th><th>@L["Org.Uploaded"]</th></tr></thead>
                                <tbody>
                                    @foreach (var d in Model.Documents.OrderByDescending(d => d.DocumentId))
                                    {
                                        <tr>
                                            <td>@L[d.Kind ?? ""]</td>
                                            <td><a asp-action="Document" asp-route-id="@d.DocumentId" target="_blank">@d.OriginalFileName</a></td>
                                            <td><code title="@d.Sha256">@d.Sha256[..12]…</code></td>
                                            <td>@d.UploadedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                        </tr>
                                    }
                                    @if (!Model.Documents.Any())
                                    {
                                        <tr><td colspan="4" class="text-muted">@L["Org.NoDocuments"]</td></tr>
                                    }
                                </tbody>
                            </table></div>
                            @if (canDocs)
                            {
                                <form asp-action="UploadDocument" asp-route-id="@Model.OrgId" method="post" enctype="multipart/form-data" class="row g-2" id="upload-form">
                                    <div class="col-md-4">
                                        <select name="kind" class="form-select">
                                            @foreach (var k in kinds) { <option value="@k">@L[k]</option> }
                                        </select>
                                    </div>
                                    <div class="col-md-6"><input type="file" name="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.webp" /></div>
                                    <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">@L["Org.Upload"]</button></div>
                                    <small class="text-muted">@L["Org.UploadHelp"]</small>
                                </form>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <!-- Capabilities -->
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">@L["Org.Capabilities"]</h5>
                            <ul class="list-group mb-3" id="capabilities">
                                @foreach (var c in Model.Capabilities.OrderBy(c => c.Capability))
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>
                                            <strong>@Ref.Capability(c.Capability)</strong>
                                            @if (c.Capability == Capabilities.Laboratory)
                                            {
                                                <small class="text-muted">@(c.IsAccredited ? L["accredited, no. {0}", c.AccreditationNumber ?? ""] : L["not accredited"]) @(c.AccreditationValidUntil != null ? L[", valid until {0}", c.AccreditationValidUntil.Value.ToString("dd.MM.yyyy")].Value : "")</small>
                                            }
                                        </span>
                                        @if (isAdmin && c.Capability != Capabilities.PlatformAdmin)
                                        {
                                            <form asp-action="RemoveCapability" asp-route-id="@Model.OrgId" method="post">
                                                <input type="hidden" name="capability" value="@c.Capability" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">@L["Org.Remove"]</button>
                                            </form>
                                        }
                                    </li>
                                }
                            </ul>
                            @if (isAdmin && !Model.IsPlatform)
                            {
                                <form asp-action="AddCapability" asp-route-id="@Model.OrgId" method="post" class="row g-2">
                                    <div class="col-md-4">
                                        <select name="capability" class="form-select">
                                            @foreach (var c in allCaps.Where(c => c.Code != Capabilities.PlatformAdmin && Model.Capabilities.All(x => x.Capability != c.Code)))
                                            {
                                                <option value="@c.Code">@Ref.Capability(c.Code)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-8 small">
                                        <label><input type="checkbox" name="isAccredited" value="true" /> @L["Org.Accredited"]</label>
                                        <input name="accreditationNumber" class="form-control form-control-sm d-inline-block w-auto" placeholder="@L["Org.AccreditationNo"]" maxlength="100" />
                                        <input name="accreditationValidUntil" type="date" class="form-control form-control-sm d-inline-block w-auto" />
                                    </div>
                                    <div class="col-12"><button type="submit" class="btn btn-sm btn-primary">@L["Org.AddCapability"]</button></div>
                                </form>
                            }
                        </div>
                    </div>

                    <!-- Four-eyes -->
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">@L["Org.FourEyesExemption"]</h5>
                            <p class="small text-muted mb-2">
                                @Html.Raw(L["Note.FourEyesExemption"].Value)
                            </p>
                            <div>@L["Org.Current"] <strong id="four-eyes">@(Model.FourEyesExempt ? L["exempt"] : L["not exempt"])</strong></div>
                            @if (isAdmin)
                            {
                                <form asp-action="SetFourEyesExempt" asp-route-id="@Model.OrgId" method="post" class="mt-2">
                                    <input type="hidden" name="exempt" value="@(!Model.FourEyesExempt)" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning">@(Model.FourEyesExempt ? L["Remove exemption"] : L["Grant exemption"])</button>
                                </form>
                            }
                        </div>
                    </div>

                    <!-- Members -->
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">@L["Org.Members"]</h5>
                            <div class="table-responsive"><table class="table table-sm" id="members">
                                <thead><tr><th>@L["Org.User"]</th><th>@L["Org.OrgRole"]</th><th>@L["Org.Status"]</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var m in members)
                                    {
                                        <tr>
                                            <td>@(names.TryGetValue(m.UserId, out var n) ? n : m.UserId)</td>
                                            <td>@Ref.Role(m.OrgRole)</td>
                                            <td>@L[m.Status ?? ""]</td>
                                            <td>
                                                @if (isAdmin && m.Status == MembershipStatus.Active)
                                                {
                                                    <form asp-action="RevokeMember" method="post">
                                                        <input type="hidden" name="membershipId" value="@m.MembershipId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">@L["Org.Revoke"]</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    @if (!members.Any())
                                    {
                                        <tr><td colspan="4" class="text-muted">@L["Org.NoMembers"]</td></tr>
                                    }
                                </tbody>
                            </table></div>
                            @if (isAdmin)
                            {
                                <form asp-action="AddMember" asp-route-id="@Model.OrgId" method="post" class="row g-2" id="add-member">
                                    <div class="col-md-4">
                                        <label class="form-label small">@L["Org.OrgRole"]</label>
                                        <select name="orgRole" class="form-select">
                                            @foreach (var r in roles) { <option value="@r">@Ref.Role(r)</option> }
                                        </select>
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label small">@L["Org.ExistingUser"]</label>
                                        <input name="existingUserName" class="form-control" autocomplete="off" />
                                    </div>
                                    <div class="col-12 small text-muted">@L["Org.NewUserHint"]</div>
                                    <div class="col-md-4"><input name="newUserName" class="form-control" placeholder="@L["Org.UserName"]" autocomplete="off" /></div>
                                    <div class="col-md-4"><input name="newEmail" type="email" class="form-control" placeholder="@L["Org.Email"]" autocomplete="off" /></div>
                                    <div class="col-md-4"><input name="newPassword" type="password" class="form-control" placeholder="@L["Org.Password"]" autocomplete="new-password" /></div>
                                    <div class="col-12"><button type="submit" class="btn btn-sm btn-primary">@L["Org.AddMember"]</button></div>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <a asp-action="Index" class="btn btn-link app-back"><i class="mdi mdi-arrow-left" aria-hidden="true"></i> @L["Org.Back"]</a>
        </div>
    </div>
</body>
