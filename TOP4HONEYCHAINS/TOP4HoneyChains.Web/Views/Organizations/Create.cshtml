@using TOP4HoneyChains.Web.Models.Entities
@model Organization
@{
    ViewData["Title"] = L["New organization"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var caps = ViewBag.Capabilities as List<Capability> ?? new();
    var selected = ViewBag.Selected as string[] ?? Array.Empty<string>();
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">@L["Org.NewOrganization"]</h4>
                    <p class="card-title-desc">@Html.Raw(L["Note.OrgStartsPending"].Value)</p>

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DisplayName" class="form-label required">@L["Org.DisplayName"]</label>
                                <input asp-for="DisplayName" class="form-control" maxlength="200" />
                                <span asp-validation-for="DisplayName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LegalName" class="form-label">@L["Org.LegalName"]</label>
                                <input asp-for="LegalName" class="form-control" maxlength="300" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="TaxNo" class="form-label">@L["Org.TaxNumber"]</label>
                                <input asp-for="TaxNo" class="form-control" maxlength="50" />
                            </div>
                            <div class="col-md-8 mb-3">
                                @await Html.PartialAsync("~/Views/Shared/_ProvinceDistrict.cshtml", new TOP4HoneyChains.Web.Models.ViewModels.ProvinceDistrictField("Province", "District", Model?.Province, Model?.District, false, "Org.Province", "Org.District"))
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LegacyWholesalerId" class="form-label">@L["Org.ExistingWholesaler"]</label>
                                <select asp-for="LegacyWholesalerId" asp-items="ViewBag.Wholesalers" class="form-select">
                                    <option value="">@L["(none)"]</option>
                                </select>
                                <small class="text-muted">@L["Org.ExistingWholesalerHelp"]</small>
                            </div>
                        </div>

                        <label class="form-label required">@L["Org.Capabilities"]</label>
                        <div class="row mb-3">
                            @foreach (var c in caps)
                            {
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="capabilities" value="@c.Code" id="cap_@c.Code" @(selected.Contains(c.Code) ? "checked" : "") />
                                        <label class="form-check-label" for="cap_@c.Code"><strong>@Ref.Capability(c.Code)</strong> <small class="text-muted">@Ref.CapabilityDescription(c.Code, c.Description)</small></label>
                                    </div>
                                </div>
                            }
                        </div>

                        @* D-88 follow-up: a laboratory's accreditation is entered with the organization, not in a second step *@
                        <fieldset class="border rounded p-3 mb-3" id="lab-accreditation">
                            <legend class="fs-6 mb-1">@L["Org.LabAccreditation"]</legend>
                            <p class="small text-muted mb-2">@L["Org.LabAccreditationHelp"]</p>
                            <div class="row g-2 align-items-end">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="isAccredited" value="true" id="isAccredited" @(ViewBag.IsAccredited == true ? "checked" : "") />
                                        <label class="form-check-label" for="isAccredited">@L["Org.IsAccredited"]</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="accreditationNumber">@L["Org.AccreditationNumber"]</label>
                                    <input class="form-control" name="accreditationNumber" id="accreditationNumber" maxlength="100" value="@ViewBag.AccreditationNumber" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="accreditationValidUntil">@L["Org.AccreditationValidUntil"]</label>
                                    <input class="form-control" type="date" name="accreditationValidUntil" id="accreditationValidUntil" value="@ViewBag.AccreditationValidUntil" />
                                </div>
                            </div>
                        </fieldset>

                        <button type="submit" class="btn btn-success">@L["Org.Create"]</button>
                        <a asp-action="Index" class="btn btn-secondary">@L["Org.Cancel"]</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
