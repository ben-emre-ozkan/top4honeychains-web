@model IEnumerable<TOP4HoneyChains.Web.Models.Entities.Beekeeper>

@{
    ViewData["Title"] = L["Index"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var photoVersions = ViewBag.PhotoVersions as Dictionary<string, int> ?? new();
}


@section AddToHead {
    <!-- DataTables -->
    
    <link href="~/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />

    <!-- Responsive datatable examples -->
    <link href="~/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title">@L["Beekeepers List"]</h4>

                            @* Beekeepers are deactivated, never deleted (docs/DECISIONS.md, D-04) *@
                            <div class="alert alert-info d-flex align-items-start" role="note" id="deactivation-note">
                                <i class="mdi mdi-information-outline me-2 font-size-18"></i>
                                <div>
                                    @Html.Raw(L["Note.BeekeeperDeactivation"].Value)
                                </div>
                            </div>
                            <p class="card-title-desc">
                                <a href="/Beekeepers/Create" class="btn btn-primary waves-effect waves-light">@L["Add new"]</a>
                            </p>

                            <table id="datatable-buttons" class="table table-striped table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
                                <thead>
                                    <tr>
                                        <th>@L["Profile Photo"]</th>
                                        <th>@L["First Name"]</th>
                                        <th>@L["Last Name"]</th>
                                        <th>@L["Birth Date"]</th>
                                        <th>@L["Experience Time"]</th>
                                        <th>@L["Phone Number"]</th>
                                        <th>@L["Num.Official"]</th>
                                        <th>@L["Beekeeping Purpose Type"]</th>
                                        <th>@L["Beekeeping Type"]</th>
                                        <th>@L["Education Level"]</th>
                                        <th>@L["Status"]</th>
                                        <th></th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr class="@(item.IsActive ? "" : "table-light text-muted")">
                                            <td>
                                                @* D-73: a small cached thumbnail, loaded lazily, or the initials *@
                                                @if (photoVersions.TryGetValue(item.BeekeeperId ?? "", out var version))
                                                {
                                                    <img src="/Beekeepers/Thumb/@item.BeekeeperId?v=@version" alt="" class="rounded-circle bk-thumb" width="44" height="44" loading="lazy" decoding="async" />
                                                }
                                                else
                                                {
                                                    <span class="bk-initials" aria-hidden="true">@TOP4HoneyChains.Web.Services.OrgModel.StorefrontPage.Initials(item.BeekeeperFirstName + " " + item.BeekeeperLastName)</span>
                                                }
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.BeekeeperFirstName)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.BeekeeperLastName)
                                            </td>
                                            <td>
                                                @item.BeekeeperBirthDate.ToString("dd.MM.yyyy")
                                            </td>
                                            <td>
                                                @(item.BeekeeperExperienceTime.HasValue? item.BeekeeperExperienceTime + " years" : "-")
                                            </td>
                                            <td>
                                                @TOP4HoneyChains.Web.Services.PhoneNumberPolicy.Display(item.BeekeeperPhoneNumber)
                                            </td>
                                            <td>
                                                <partial name="_BeekeeperNumbers" model="@(((ViewBag.Registry as Dictionary<string, string?>)?.GetValueOrDefault(item.BeekeeperId!), item.BeekeeperBusinessNumber))" />
                                            </td>
                                            <td>
                                                @Ref.T("BeekeepingPurposeType", item.BeekeeperBeekeepingPurposeType?.BeekeepingPurposeTypeId, "Title", item.BeekeeperBeekeepingPurposeType?.BeekeepingPurposeTypeTitle)
                                            </td>
                                            <td>
                                                @Ref.T("BeekeepingType", item.BeekeeperBeekeepingType?.BeekeepingTypeId, "Title", item.BeekeeperBeekeepingType?.BeekeepingTypeTitle)
                                            </td>
                                            <td>
                                                @Ref.T("EducationLevel", item.BeekeeperEducationLevel?.BeekeeperEducationLevelId, "Title", item.BeekeeperEducationLevel?.BeekeeperEducationLevelTitle)
                                            </td>
                                            <td>

                                                @if (item.IsActive)
                                                {
                                                    <span class="badge bg-success">@L["Active"]</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">@L["Inactive"]</span>
                                                }

                                            </td>
                                            <td>
                                                <div class="d-flex flex-wrap gap-2">
                                                    <a asp-action="Edit" asp-route-id="@item.BeekeeperId" class="btn btn-sm btn-info">@L["Edit"]</a>

                                                    @if (item.IsActive)
                                                    {
                                                        <form asp-action="Deactivate" asp-route-id="@item.BeekeeperId" method="post" class="d-inline"
                                                              data-confirm="@L["Deactivate this beekeeper? All records are kept and the login is locked. Beekeepers are never deleted."]" onsubmit="return confirm(this.dataset.confirm);">
                                                            <button type="submit" class="btn btn-sm btn-warning"
                                                                    title="@L["Keeps all records; greys out the beekeeper and locks their login. Beekeepers are never deleted."]">
                                                                @L["Deactivate"]
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <form asp-action="Activate" asp-route-id="@item.BeekeeperId" method="post" class="d-inline"
                                                              data-confirm="@L["Activate this beekeeper again?"]" onsubmit="return confirm(this.dataset.confirm);">
                                                            <button type="submit" class="btn btn-sm btn-success"
                                                                    title="@L["Makes the beekeeper active again."]">
                                                                @L["Activate"]
                                                            </button>
                                                        </form>
                                                    }

                                                    <a asp-controller="Apiaries"
                                                       asp-action="ByBeekeeper"
                                                       asp-route-beekeeperId="@item.BeekeeperId"
                                                       class="btn btn-sm btn-primary">
                                                        @L["Apiaries"]
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- end col -->
            </div>
        </div>
    </div>
    @section scripts{
        <!-- Required datatable js -->
        <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
        <script src="~/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
        <!-- Buttons examples -->
        <script src="~/assets/libs/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons-bs4/js/buttons.bootstrap4.min.js"></script>
        <script src="~/assets/libs/jszip/jszip.min.js"></script>
        <script src="~/assets/libs/pdfmake/build/pdfmake.min.js"></script>
        <script src="~/assets/libs/pdfmake/build/vfs_fonts.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.html5.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.print.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.colVis.min.js"></script>
        <!-- Responsive examples -->
        <script src="~/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
        <script src="~/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>

        <!-- Datatable init js -->
        <script src="~/assets/js/pages/datatables.init.js"></script>

        <!-- App js -->
        <script src="~/assets/js/app.js"></script>
    }
</body>