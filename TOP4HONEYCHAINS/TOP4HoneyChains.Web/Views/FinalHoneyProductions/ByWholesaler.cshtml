@using TOP4HoneyChains.Web.Models.Entities
@model IEnumerable<TOP4HoneyChains.Web.Models.Entities.FinalHoneyProduction>

@{
    var wholesaler = ViewBag.Wholesaler as TOP4HoneyChains.Web.Models.Entities.Wholesaler;
    ViewData["Title"] = L["Final Batches"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";

    var totalAmount = Model.Sum(x => x.FinalHoneyProductionTotalAmount ?? 0);
}

@section AddToHead {
    <link href="~/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" />
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <!-- 🔷 HEADER -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow-lg">
                        <div class="card-body d-flex justify-content-between align-items-center">

                            <div>
                                <h3 class="fw-bold mb-1">
                                    @wholesaler?.WholesalerTitle
                                </h3>
                                <small class="text-muted">
                                    @wholesaler?.WholesalerCity - @wholesaler?.WholesalerCountry
                                </small>
                            </div>

                            <div class="text-end">
                                <a asp-action="Create"
                                   asp-route-wholesalerId="@wholesaler?.WholesalerId"
                                   class="btn btn-primary waves-effect waves-light">
                                    <i class="mdi mdi-plus-circle me-1"></i>
                                    @L["New Batch"]
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- 🔷 KPI CARDS -->
            <div class="row mb-4 align-items-stretch">

                <div class="col-md-4">
                    <div class="card border-primary h-100">
                        <div class="card-body">
                            <h6 class="text-primary fw-bold">@L["Total Batches"]</h6>
                            <h3 class="fw-bold">@Model.Count()</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-success h-100">
                        <div class="card-body">
                            <h6 class="text-success fw-bold">@L["Total Production (kg)"]</h6>
                            <h3 class="fw-bold">@totalAmount.ToString("N2", new System.Globalization.CultureInfo("tr-TR"))</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-info h-100">
                        <div class="card-body">
                            <h6 class="text-info fw-bold">@L["Active Status"]</h6>
                            <h5>
                                @if (wholesaler?.WholesalerIsActive == true)
                                {
                                    <span class="badge bg-success px-3 py-2">@L["Active"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">@L["Passive"]</span>
                                }
                            </h5>
                        </div>
                    </div>
                </div>

            </div>

            <!-- 🔷 TABLE -->
            <div class="card">
                <div class="card-body">

                    <table id="datatable"
                           class="table table-bordered table-hover dt-responsive nowrap"
                           style="border-collapse: collapse; border-spacing: 0; width: 100%;">

                        <thead class="table-dark">
                            <tr>
                                <th>@L["Batch Title"]</th>
                                <th>@L["QR Code"]</th>
                                <th>@L["Production Date"]</th>
                                <th>@L["Total Amount (kg)"]</th>
                                <th>@L["Assigned CCPs"]</th>
                                <th style="width:300px;">@L["Actions"]</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>

                                        <!-- 1 -->
                                        <td>
                                            <strong>@item.FinalHoneyProductionTitle</strong>
                                        </td>

                                        <!-- 2 -->
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.FinalHoneyProductionQR.ToString()))
                                            {
                                                <span class="badge bg-dark">
                                                    @item.FinalHoneyProductionQR.ToString().Substring(0, Math.Min(8, item.FinalHoneyProductionQR.ToString().Length))...
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>

                                        <!-- 3 -->
                                        <td>
                                            @(item.FinalHoneyProductionDate?.ToString("dd.MM.yyyy") ?? "—")
                                        </td>

                                        <!-- 4 -->
                                        <td>
                                            <span class="badge bg-light text-success border border-success fs-6 px-3 py-2 rounded-3">
                                                <i class="mdi mdi-weight-kilogram me-1"></i>
                                                @(item.FinalHoneyProductionTotalAmount?.ToString("N2", new System.Globalization.CultureInfo("tr-TR")) ?? "0,00") kg
                                            </span>
                                        </td>

                                        <!-- 5 -->
                                        <td>
                                            @if (item.FinalHoneyCCPAssignments != null &&
                                                                                item.FinalHoneyCCPAssignments.Any())
                                            {
                                                foreach (var assignment in item.FinalHoneyCCPAssignments)
                                                {
                                                    var btnClass = assignment.FinalHoneyCCPAssignmentStatus switch
                                                    {
                                                        AssignmentStatusIds.Completed => "btn-success",
                                                        AssignmentStatusIds.NotApplicable => "btn-outline-dark",
                                                        _ => "btn-secondary"
                                                    };

                                                    <a asp-controller="CCPMonitoring"
                                                       asp-action="FinalHoneyProductionManageCCP"
                                                       asp-route-finalHoneyProductionId="@item.FinalHoneyProductionId"
                                                       asp-route-ccpId="@assignment.FinalHoneyCCPAssignmentCCP"
                                                       class="btn btn-sm @btnClass me-1 mb-1">

                                                        @assignment.CCP?.Code
                                                    </a>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">@L["No CCP assigned yet."]</span>
                                            }
                                        </td>

                                        <!-- 6 -->
                                        <td>
                                            <div class="d-flex gap-2 flex-wrap">

                                                <a asp-action="ManageBatch"
                                                   asp-route-id="@item.FinalHoneyProductionId"
                                                   class="btn btn-warning btn-sm w-100 text-start">
                                                    <i class="mdi mdi-tune me-1"></i>
                                                    @L["Manage"]
                                                </a>

                                                @if ((item.FinalHoneyProductionTotalAmount ?? 0) > 0)
                                                {
                                                    <a asp-action="ManageCCP"
                                                       asp-route-id="@item.FinalHoneyProductionId"
                                                       class="btn btn-dark btn-sm w-100 text-start">
                                                        <i class="mdi mdi-clipboard-check-outline me-1"></i>
                                                        @L["Manage CCP"]
                                                    </a>
                                                }

                                                @if (item.FinalHoneyProductionIsFinalized)
                                                {
                                                    @* D-14: finalized batches are locked *@
                                                    <span class="badge bg-success w-100 text-start py-2"
                                                          title="@L["Finalized batches cannot be edited or deleted"]">
                                                        <i class="mdi mdi-lock-outline me-1"></i>
                                                        @L["Finalized (locked)"]
                                                    </span>
                                                }
                                                else
                                                {
                                                    <a asp-action="Edit"
                                                       asp-route-id="@item.FinalHoneyProductionId"
                                                       class="btn btn-info btn-sm w-100 text-start">
                                                        <i class="mdi mdi-pencil me-1"></i>
                                                        @L["Edit"]
                                                    </a>

                                                    <a asp-action="Delete"
                                                       asp-route-id="@item.FinalHoneyProductionId"
                                                       class="btn btn-danger btn-sm w-100 text-start">
                                                        <i class="mdi mdi-delete me-1"></i>
                                                        @L["Delete"]
                                                    </a>
                                                }

                                            </div>
                                        </td>

                                    </tr>
                                }
                            }
                           

                        </tbody>

                    </table>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
        <script src="~/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons-bs4/js/buttons.bootstrap4.min.js"></script>
        <script src="~/assets/libs/jszip/jszip.min.js"></script>
        <script src="~/assets/libs/pdfmake/build/pdfmake.min.js"></script>
        <script src="~/assets/libs/pdfmake/build/vfs_fonts.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.html5.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.print.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.colVis.min.js"></script>
        <script src="~/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
        <script src="~/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>
        <script src="~/assets/js/pages/datatables.init.js"></script>
        <script src="~/assets/js/app.js"></script>
    }

</body>