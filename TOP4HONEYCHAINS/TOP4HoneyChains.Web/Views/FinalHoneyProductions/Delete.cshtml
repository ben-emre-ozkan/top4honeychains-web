@model TOP4HoneyChains.Web.Models.Entities.FinalHoneyProduction

@{
    ViewData["Title"] = "Delete Final Honey Batch";
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card border-danger">
                        <div class="card-body">

                            <h4 class="card-title text-danger">
                                Delete Final Honey Batch
                            </h4>

                            <p class="card-title-desc">
                                <strong>Warning:</strong> This action may affect traceability records.
                                Deleting a batch cannot be undone.
                            </p>

                            <div class="alert alert-danger">
                                Are you sure you want to permanently delete this honey batch?
                            </div>

                            <dl class="row">

                                <dt class="col-sm-3">Batch Title</dt>
                                <dd class="col-sm-9">
                                    <strong>@Model.FinalHoneyProductionTitle</strong>
                                </dd>

                                <dt class="col-sm-3">QR Code</dt>
                                <dd class="col-sm-9">
                                    <span class="badge bg-dark">
                                        @Model.FinalHoneyProductionQR
                                    </span>
                                </dd>

                                <dt class="col-sm-3">Production Date</dt>
                                <dd class="col-sm-9">
                                    @Model.FinalHoneyProductionDate?.ToString("dd.MM.yyyy")
                                </dd>

                                <dt class="col-sm-3">Total Amount</dt>
                                <dd class="col-sm-9">
                                    <span class="badge bg-success">
                                        @Model.FinalHoneyProductionTotalAmount kg
                                    </span>
                                </dd>


                            </dl>

                            <form asp-action="Delete">

                                <input type="hidden" asp-for="FinalHoneyProductionId" />

                                <div class="d-flex gap-2">

                                    <button type="submit"
                                            class="btn btn-danger waves-effect waves-light">
                                        Delete
                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-secondary waves-effect">
                                        Back to List
                                    </a>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/js/app.js"></script>
    }
</body>