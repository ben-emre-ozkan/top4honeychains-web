@using TOP4HoneyChains.Web.Models.ViewModels.Timeline
@model CCPOverviewViewModel

@{
    ViewData["Title"] = L["CCP Process Overview"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";

    var progressPercent = ViewBag.ProgressPercent ?? 0;

    var progressColor = (int)progressPercent == 100
        ? "success"
        : (int)progressPercent > 0
            ? "warning"
            : "secondary";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="card mb-4 border-0 shadow-lg">
                <div class="card-body text-white rounded app-hero">

                    <div class="row align-items-center">

                        <!-- LEFT SIDE -->
                        <div class="col-md-4">

                            <h3 class="fw-bold mb-1">
                                <i class="mdi mdi-barrel-outline me-2"></i>
                                @L["CCP Process Overview"]
                            </h3>

                            <small class="opacity-75">
                                @L["Lifecycle & Traceability Monitoring"]
                            </small>

                            <div class="mt-3 small">
                                <div><strong>@L["Source:"]</strong> @Model.BeekeeperName</div>
                                <div><strong>@L["Production:"]</strong> @Model.ApiaryName</div>
                                <div><strong>@L["Wholesaler:"]</strong> @Model.WholesalerName</div>
                            </div>

                        </div>


                        <!-- CENTER -->
                        <div class="col-md-3 text-center">

                            <div class="display-6 fw-bold">
                                @Model.Amount?.ToString("0.00") kg
                            </div>
                            <small>@L["Total Batch Amount"]</small>

                            <div class="mt-2">
                                <small>
                                    @Model.ProductionDate?.ToString("dd.MM.yyyy")
                                </small>
                            </div>

                        </div>


                        <!-- RIGHT SIDE -->
                        <div class="col-md-5 text-end">

                            @{
                                var progressPercent = ViewBag.ProgressPercent ?? 0;
                                var progressColor = (int)progressPercent == 100
                                ? "success"
                                : (int)progressPercent > 0
                                ? "warning"
                                : "secondary";
                            }

                            <!-- Completion -->
                            <div class="fw-bold fs-4">
                                @progressPercent%
                            </div>
                            <small>@L["Completion"]</small>

                            <div class="progress mt-2 mb-3"
                                 style="height:6px; background:rgba(255,255,255,0.2);">
                                <div class="progress-bar bg-@progressColor"
                                     style="width:@progressPercent%">
                                </div>
                            </div>

                            <!-- Action Row -->
                            <div class="d-flex justify-content-end gap-2">

                                @if ((int)progressPercent == 100)
                                {
                                    <span class="badge bg-success px-3 py-2">
                                        <i class="mdi mdi-certificate-outline me-1"></i>
                                        @L["Certified Batch"]
                                    </span>
                                }

                                @if (ViewBag.ReturnUrl != null)
                                {
                                    <a href="@ViewBag.ReturnUrl"
                                       class="btn btn-outline-light btn-sm">
                                        <i class="mdi mdi-arrow-left"></i>
                                    </a>
                                }

                            </div>

                        </div>

                    </div>
                </div>
            </div>


            <!-- 🔷 TIMELINE -->
            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <section id="cd-timeline" class="cd-container">

                        @for (int i = 0; i < Model.Timeline.Count; i++)
                        {
                            var item = Model.Timeline[i];
                            var isLast = i == Model.Timeline.Count - 1;

                            var statusClass = item.StatusName switch
                            {
                                "Completed" => "success",
                                "In Progress" => "warning",
                                "Rejected" => "danger",
                                "Not applicable" => "dark",
                                _ => "secondary"
                            };

                            var alignment = i % 2 == 0 ? "timeline-right" : "timeline-left";

                            <div class="cd-timeline-block @(isLast ? "" : alignment)">

                                <div class="cd-timeline-img bg-@statusClass @(isLast ? "d-xl-none" : "")">
                                    <i class="mdi mdi-checkbox-marked-circle-outline"></i>
                                </div>

                                <div class="cd-timeline-content shadow border-0 rounded p-4">

                                    <div class="d-flex justify-content-between align-items-center mb-2">

                                        <h5 class="fw-bold mb-0">
                                            @item.CCPCode - @Ref.CcpTitle(item.CcpId, item.CCPTitle)
                                        </h5>

                                        <span class="badge bg-@statusClass fs-6 px-3 py-2">
                                            @Ref.Status(item.StatusId, item.StatusName)
                                        </span>

                                    </div>

                                    @if (item.StartDate != null)
                                    {
                                        <div class="text-muted small">
                                            <i class="mdi mdi-clock-start me-1"></i>
                                            @L["Started:"]
                                            @item.StartDate.Value.ToString("dd.MM.yyyy HH:mm")
                                        </div>
                                    }

                                    @if (item.EndDate != null)
                                    {
                                        <div class="text-muted small">
                                            <i class="mdi mdi-check-circle-outline me-1"></i>
                                            @L["Completed:"]
                                            @item.EndDate.Value.ToString("dd.MM.yyyy HH:mm")
                                        </div>
                                    }

                                    @if (isLast)
                                    {
                                        <div class="mt-3">
                                            <span class="badge bg-dark px-3 py-2">
                                                @L["Process End"]
                                            </span>
                                        </div>
                                    }

                                </div>
                            </div>
                        }

                    </section>

                </div>
            </div>
        </div>
    </div>

    @section scripts{
        <script src="~/assets/js/app.js"></script>
    }

</body>