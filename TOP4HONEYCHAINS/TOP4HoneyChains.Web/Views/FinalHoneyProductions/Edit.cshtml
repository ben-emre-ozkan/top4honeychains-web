@model TOP4HoneyChains.Web.Models.Entities.FinalHoneyProduction

@{
    ViewData["Title"] = "Edit Final Honey Batch";
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card shadow-sm">
                        <div class="card-body">

                            <h4 class="card-title">Edit Final Honey Batch</h4>
                            <p class="card-title-desc">
                                Update batch metadata. Composition and total amount are managed separately.
                            </p>

                            <form asp-action="Edit" method="post" class="custom-validation">
                                @Html.AntiForgeryToken()

                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                <input type="hidden" asp-for="FinalHoneyProductionId" />
                                <input type="hidden" asp-for="FinalHoneyProductionQR" />
                                <input type="hidden" asp-for="FinalHoneyProductionWholesalerId" />
                                <input type="hidden" asp-for="FinalHoneyProductionTotalAmount" />

                                <!-- Batch Title -->
                                <div class="mb-3">
                                    <label asp-for="FinalHoneyProductionTitle" class="form-label required">
                                        Batch Title
                                    </label>

                                    <input asp-for="FinalHoneyProductionTitle"
                                           class="form-control"
                                           placeholder="Enter batch title" />

                                    <span asp-validation-for="FinalHoneyProductionTitle" class="text-danger"></span>
                                </div>

                                <!-- QR (Readonly Display) -->
                                <div class="mb-3">
                                    <label class="form-label">QR Code</label>
                                    <input value="@Model.FinalHoneyProductionQR"
                                           class="form-control"
                                           readonly />
                                </div>

                                <!-- Production Date -->
                                <div class="mb-3">
                                    <label asp-for="FinalHoneyProductionDate" class="form-label required">
                                        Production Date
                                    </label>

                                    <input asp-for="FinalHoneyProductionDate"
                                           type="date"
                                           class="form-control" />

                                    <span asp-validation-for="FinalHoneyProductionDate" class="text-danger"></span>
                                </div>

                            @if (ViewBag.OwnerOrgs != null)
                            {
                                @* D-36: owning organization (organization model only) *@
                                <div class="mb-3">
                                    <label class="form-label fw-semibold" for="OwnerOrgId">@L["Org.OwningOrg"]</label>
                                    <select name="OwnerOrgId" id="OwnerOrgId" class="form-select shadow-sm" asp-items="ViewBag.OwnerOrgs">
                                        <option value="">@L["Org.OwningOrgDefault"]</option>
                                    </select>
                                </div>
                            }

                                <!-- Total (Readonly) -->
                                <div class="mb-3">
                                    <label class="form-label">Total Amount (kg)</label>
                                    <input value="@Model.FinalHoneyProductionTotalAmount?.ToString("0.00")"
                                           class="form-control"
                                           readonly />
                                </div>

                                <div class="d-flex gap-2">

                                    <button type="submit"
                                            class="btn btn-primary waves-effect waves-light">
                                        Update Metadata
                                    </button>

                                    <a asp-action="ByWholesaler"
                                       asp-route-wholesalerId="@Model.FinalHoneyProductionWholesalerId"
                                       class="btn btn-secondary waves-effect">
                                        Back
                                    </a>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/libs/parsleyjs/parsley.min.js"></script>
        <script src="~/assets/js/pages/form-validation.init.js"></script>
        <script src="~/assets/js/app.js"></script>
    }

</body>