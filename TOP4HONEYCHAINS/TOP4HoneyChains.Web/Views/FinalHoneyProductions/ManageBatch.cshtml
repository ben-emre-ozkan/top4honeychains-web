@model TOP4HoneyChains.Web.Models.ViewModels.FinalProduct.ManageBatchViewModel

@{
    ViewData["FlashHandled"] = true; // this page shows Success/Error itself (SweetAlert)
    ViewData["Title"] = L["Manage Batch"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}


@section AddToHead {
    <!-- DataTables -->
    <link href="~/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />

    <!-- Responsive datatable examples -->
    <link href="~/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />

    <link href="~/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">


            <!-- HEADER CARDS -->
            <div class="row">

                <div class="col-xl-4 col-sm-6">
                    <div class="card mini-stat bg-info">
                        <div class="card-body mini-stat-img">
                            <div class="mini-stat-icon">
                                <i class="mdi mdi-information-outline float-end"></i>
                            </div>
                            <div class="text-white">
                                <h6 class="text-uppercase mb-3 font-size-16 text-white">@L["Batch Info"]</h6>
                                <p><strong>@L["Title:"]</strong> @Model.Batch.FinalHoneyProductionTitle</p>
                                <p><strong>@L["Date:"]</strong> @Model.Batch.FinalHoneyProductionDate?.ToString("dd.MM.yyyy")</p>
                                <p><strong>@L["QR:"]</strong> @Model.Batch.FinalHoneyProductionQR.ToString().Substring(0, 8)...</p>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="col-xl-4 col-sm-6">
                    <div class="card mini-stat bg-warning">
                        <div class="card-body mini-stat-img">
                            <div class="mini-stat-icon">
                                <i class="mdi mdi-truck-outline float-end"></i>
                            </div>
                            <div class="text-white">
                                <h6 class="text-uppercase mb-3 font-size-16 text-white">@L["Wholesaler"]</h6>
                                <p><strong>@L["Company:"]</strong> @Model.Wholesaler?.WholesalerTitle</p>
                                <p><strong>@L["City:"]</strong> @Model.Wholesaler?.WholesalerCity</p>
                                <p>
                                    <strong>@L["Status:"]</strong>
                                    @(Model.Wholesaler?.WholesalerIsActive == true
                                                                        ? L["Active"].Value : L["Passive"].Value)
                                </p>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="col-xl-4 col-sm-6">
                    <div class="card mini-stat bg-primary">
                        <div class="card-body mini-stat-img">
                            <div class="mini-stat-icon">
                                <i class="mdi mdi-file-table-outline float-end"></i>
                            </div>
                            <div class="text-white">
                                <h6 class="text-uppercase mb-3 font-size-16 text-white">@L["Summary"]</h6>
                                <p>
                                    <strong>@L["Target:"]</strong>
                                    <span id="targetAmount">
                                        @Model.Batch.FinalHoneyProductionTotalAmount
                                    </span> kg
                                </p>

                                <p>
                                    <strong>@L["Total Selected:"]</strong>
                                    <span id="selectedTotal">0</span> kg
                                </p>
                                <p>
                                    <strong>@L["Status:"]</strong>
                                    @if (Model.Batch.FinalHoneyProductionIsFinalized)
                                    {
                                        <span class="badge bg-success">@L["Finalized"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@L["Draft"]</span>
                                    }
                                </p>


                            </div>
                        </div>
                    </div>
                </div>

            </div>




            <div class="row">
                <div class="col-12">
                    <!-- RAW HONEY TABLE -->
                    <div class="card">
                        <div class="card-body">

                            <h5 class="card-title mb-3">@L["Raw Honey Sources"]</h5>

                            <p class="text-muted mb-3">
                                <i class="mdi mdi-information-outline me-1"></i>
                                @Html.Raw(L["Note.EligibleLots"].Value)
                            </p>

                            @if (!Model.RawHoneyList.Any())
                            {
                                <div class="alert alert-warning" id="no-eligible-lots">
                                    <i class="mdi mdi-alert-outline me-1"></i>
                                    No raw honey lot of this wholesaler is eligible yet.
                                    @if (!Model.Batch.FinalHoneyProductionIsFinalized && Model.IneligibleRawHoneyList.Any())
                                    {
                                        <span>@Html.Raw(L["Note.SeeIneligible"].Value)</span>
                                    }
                                    else
                                    {
                                        <span>@L["This wholesaler has no raw honey production yet."]</span>
                                    }
                                </div>
                            }

                            <form id="manageBatchForm" asp-action="ManageBatchPost" method="post">

                                <input type="hidden" name="batchId" value="@Model.Batch.FinalHoneyProductionId" />

                                <div class="table-responsive">
                                    <table id="datatable"
                                           class="table table-bordered table-hover dt-responsive nowrap"
                                           style="border-collapse: collapse; border-spacing: 0; width: 100%;">

                                        <thead class="table-dark">
                                            <tr>
                                                <th>ID</th>
                                                <th>@L["Apiary"]</th>
                                                <th>@L["Beekeeper"]</th>
                                                <th>@L["Honey Type"]</th>
                                                <th>@L["Total (kg)"]</th>
                                                <th>@L["Use Amount (kg)"]</th>
                                                <th>@L["Available Amount"]</th>
                                                <th>@L["Add Amount"]</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @foreach (var item in Model.RawHoneyList)
                                            {
                                                <tr>

                                                    <td>@item.RawHoney.RawHoneyProductionId</td>

                                                    <td>@item.RawHoney.RawHoneyProductionApiary?.ApiaryTitle</td>

                                                    <td>
                                                        @item.RawHoney.RawHoneyProductionApiary?.ApiaryBeekeeper?.BeekeeperFirstName
                                                        @item.RawHoney.RawHoneyProductionApiary?.ApiaryBeekeeper?.BeekeeperLastName
                                                    </td>

                                                    <td>
                                                        <span class="badge bg-warning text-dark">
                                                            @Ref.T("HoneyType", item.RawHoney.RawHoneyProductionHoneyTypeNavigation?.HoneyTypeId, "Title", item.RawHoney.RawHoneyProductionHoneyTypeNavigation?.HoneyTypeTitle)
                                                        </span>
                                                    </td>

                                                    <td>
                                                        <span class="badge bg-info">
                                                            @item.RawHoney.RawHoneyProductionAmount kg
                                                        </span>
                                                    </td>

                                                    <td>
                                                        <span class="badge bg-danger">
                                                            @item.AlreadyUsed kg
                                                        </span>
                                                    </td>

                                                    <td>
                                                        <span class="badge bg-success">
                                                            @item.AvailableAmount kg
                                                        </span>
                                                    </td>

                                                    <td>
                                                        <input type="text" inputmode="decimal" autocomplete="off"
                                                               @(Model.Batch.FinalHoneyProductionIsFinalized ? "disabled" : "")
                                                               value="@item.CurrentBatchAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                               name="usedAmounts[@item.RawHoney.RawHoneyProductionId]"
                                                               class="form-control use-amount"
                                                               data-max="@item.AvailableAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                               placeholder="0.00" />
                                                    </td>

                                                </tr>
                                            }
                                        </tbody>

                                    </table>
                                </div>
                            </form>
                            <!-- ✅ ACTIONS (NO NESTED FORM) -->
                            <div class="mt-4 d-flex justify-content-between align-items-center gap-2 flex-wrap">

                                <!-- Back -->
                                <a asp-action="ByWholesaler"
                                   asp-route-wholesalerId="@Model.Batch.FinalHoneyProductionWholesalerId"
                                   class="btn btn-outline-secondary btn-lg px-4">
                                    <i class="mdi mdi-arrow-left me-2"></i>
                                    @L["Back to Batches"]
                                </a>

                                <div class="d-flex align-items-center gap-2 flex-wrap">

                                    @if (ViewBag.MemberFinalize == true)
                                    {
                                        <a asp-controller="Recall" asp-action="Batch" asp-route-id="@Model.Batch.FinalHoneyProductionId" class="btn btn-outline-secondary" id="admin-recall">@L["Cust.RecallReport"]</a>
                                        <a asp-controller="Flow" asp-action="Batch" asp-route-id="@Model.Batch.FinalHoneyProductionId" class="btn btn-outline-secondary">@L["Flow.Title"]</a>
                                    }
                                    @if (!Model.Batch.FinalHoneyProductionIsFinalized)
                                    {
                                        <!-- Save (submits main form) -->
                                        <button type="button"
                                                class="btn btn-success btn-lg px-4 shadow-sm"
                                                onclick="confirmSaveBatch()">
                                            <i class="mdi mdi-content-save-outline me-2"></i>
                                            @L["Save Batch Composition"]
                                        </button>

                                        @if (ViewBag.MemberFinalize == true)
                                        {
                                            <span class="text-muted small" id="member-finalize-note">@L["Org.MemberFinalizeNote"]</span>
                                        }
                                        else
                                        {
                                        <!-- Finalize: only when nothing is missing (D-16) -->
                                        <form id="finalizeForm" asp-action="FinalizeBatch" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Batch.FinalHoneyProductionId" />
                                            <button type="button"
                                                    class="btn btn-danger btn-lg px-4"
                                                    @(Model.FinalizeBlockers.Any() ? "disabled title=\"" + L["See what is missing below"].Value + "\"" : "")
                                                    onclick="confirmFinalize()">
                                                <i class="mdi mdi-lock-outline me-2"></i>
                                                @L["Finalize Batch"]
                                            </button>
                                        </form>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-success fs-6">
                                            <i class="mdi mdi-lock-check-outline"></i>
                                            @L["Finalized"]
                                        </span>

                                        <span class="text-muted small">
                                            @L["A finalized batch is permanent: its data, composition and CCPs can no longer be changed."]
                                        </span>
                                    }

                                </div>

                            </div>



                        </div>
                    </div>
                </div>
            </div>




            @if (!Model.Batch.FinalHoneyProductionIsFinalized && Model.FinalizeBlockers.Any())
            {
                <div class="row" id="finalize-blockers">
                    <div class="col-12">
                        <div class="card border-warning">
                            <div class="card-body">
                                <h5 class="card-title"><i class="mdi mdi-clipboard-alert-outline me-1"></i> @L["Missing before this batch can be finalized"]</h5>
                                <p class="text-muted small mb-2">
                                    @L["Every final-batch CCP must be assigned and Completed or \"Not applicable\", and every lot in the batch must have all its CCPs Completed or \"Not applicable\"."]
                                </p>
                                <ul class="mb-2">
                                    @foreach (var b in Model.FinalizeBlockers)
                                    {
                                        <li>@Msg.T(b)</li>
                                    }
                                </ul>
                                <a asp-action="ManageCCP" asp-route-id="@Model.Batch.FinalHoneyProductionId" class="btn btn-sm btn-dark">@L["Manage batch CCPs"]</a>
                                <a asp-action="ByWholesaler" asp-route-wholesalerId="@Model.Batch.FinalHoneyProductionWholesalerId" class="btn btn-sm btn-outline-secondary">@L["Record CCP values"]</a>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* A finalized batch cannot take more lots, so the list would only be noise *@
            @if (!Model.Batch.FinalHoneyProductionIsFinalized && Model.IneligibleRawHoneyList.Any())
            {
                <div class="row" id="not-eligible-lots">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">

                                <h5 class="card-title mb-1">@L["Raw honey lots not yet eligible"]</h5>
                                <p class="text-muted mb-3">
                                    @L["These lots of {0} cannot be added until all their CCP checks are completed.", Model.Wholesaler?.WholesalerTitle ?? L["this wholesaler"].Value]
                                </p>

                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>ID</th>
                                                <th>@L["Apiary"]</th>
                                                <th>@L["Beekeeper"]</th>
                                                <th>@L["Honey Type"]</th>
                                                <th>@L["Total (kg)"]</th>
                                                <th>@L["Missing CCP checks"]</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.IneligibleRawHoneyList)
                                            {
                                                <tr>
                                                    <td>@item.RawHoney.RawHoneyProductionId</td>
                                                    <td>@item.RawHoney.RawHoneyProductionApiary?.ApiaryTitle</td>
                                                    <td>
                                                        @item.RawHoney.RawHoneyProductionApiary?.ApiaryBeekeeper?.BeekeeperFirstName
                                                        @item.RawHoney.RawHoneyProductionApiary?.ApiaryBeekeeper?.BeekeeperLastName
                                                    </td>
                                                    <td>@Ref.T("HoneyType", item.RawHoney.RawHoneyProductionHoneyTypeNavigation?.HoneyTypeId, "Title", item.RawHoney.RawHoneyProductionHoneyTypeNavigation?.HoneyTypeTitle)</td>
                                                    <td>@item.RawHoney.RawHoneyProductionAmount kg</td>
                                                    <td>
                                                        @if (item.NoChecksAssigned)
                                                        {
                                                            <span class="text-danger">@L["No CCP checks assigned."]</span>
                                                            <a asp-controller="RawHoneyProductions"
                                                               asp-action="ManageCCP"
                                                               asp-route-id="@item.RawHoney.RawHoneyProductionId"
                                                               class="ms-1">@L["Assign CCP checks"]</a>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var check in item.PendingChecks)
                                                            {
                                                                <a asp-controller="CCPMonitoring"
                                                                   asp-action="RawHoneyProductionManageCCP"
                                                                   asp-route-rawHoneyProductionId="@item.RawHoney.RawHoneyProductionId"
                                                                   asp-route-ccpId="@check.CcpId"
                                                                   class="badge bg-warning text-dark me-1 mb-1 pending-ccp"
                                                                   title="@Ref.CcpTitle(check.CcpId, check.Title)">
                                                                    @check.Code: @Ref.Status(check.StatusId, check.StatusName)
                                                                </a>
                                                            }
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>

    @section scripts{


        <!-- Required datatable js -->
        <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
        <script src="~/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
        <!-- Buttons examples -->
        <script src="~/assets/libs/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons-bs4/js/buttons.bootstrap4.min.js"></script>
        <script src="~/assets/libs/jszip/jszip.min.js"></script>
        <script src="~/assets/libs/pdfmake/build/pdfmake.min.js"></script>
        <script src="~/assets/libs/pdfmake/build/vfs_fonts.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.html5.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.print.min.js"></script>
        <script src="~/assets/libs/datatables.net-buttons/js/buttons.colVis.min.js"></script>
        <!-- Responsive examples -->
        <script src="~/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
        <script src="~/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>

        <!-- Datatable init js -->
        <script src="~/assets/js/pages/datatables.init.js"></script>

        <script>

            // D-53: a comma or a dot as decimal separator
            function toNumber(v) {
                var s = String(v == null ? '' : v).replace(/\s/g, '');
                var dot = s.lastIndexOf('.'), comma = s.lastIndexOf(',');
                if (dot >= 0 && comma >= 0) s = dot > comma ? s.replace(/,/g, '') : s.replace(/\./g, '').replace(',', '.');
                else s = s.replace(',', '.');
                return parseFloat(s);
            }

            function updateTotals() {

                let inputs = document.querySelectorAll('.use-amount');
                let total = 0;

                inputs.forEach(function (input) {
                    let val = toNumber(input.value);
                    if (!isNaN(val)) {
                        total += val;
                    }
                });

                document.getElementById('selectedTotal').innerText = total.toFixed(2);

                // The batch progress bar no longer exists on this page; the leftover code that
                // coloured it referenced an undefined "bar" and threw on every load (ENG-05)
            }

            document.querySelectorAll('.use-amount').forEach(function(input){

                input.addEventListener('input', function(){

                    let max = toNumber(this.dataset.max);
                    let val = toNumber(this.value);

                    if (isNaN(val)) return;

                    if (val > max) this.value = max;
                    if (val < 0) this.value = 0;

                    updateTotals();
                });

            });

            // Sayfa yüklenince de hesapla
            updateTotals();

        </script>


        <script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>

        <script>

            // ✅ SUCCESS MESSAGE
            @if (TempData["Success"] != null)
            {
                            <text>
                            Swal.fire({
                                icon: 'success',
                                title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Success"].Value)),
                                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Msg.T(TempData["Success"] as string))),
                                confirmButtonColor: '#28a745'
                            });
                            </text>
            }

            // ❌ ERROR MESSAGE
            @if (TempData["Error"] != null)
            {
                            <text>
                            Swal.fire({
                                icon: 'error',
                                title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Error"].Value)),
                                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Msg.T(TempData["Error"] as string))),
                                confirmButtonColor: '#dc3545'
                            });
                            </text>
            }

            // 🔒 Finalize Confirm
            function confirmFinalize() {
                Swal.fire({
                    title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Finalize this batch?"].Value)),
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["After finalizing, editing will be disabled."].Value)),
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Yes, finalize it"].Value)),
                    cancelButtonText: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Cancel"].Value))
                }).then((result) => {
                    if (result.isConfirmed) {
                        document.getElementById('finalizeForm').submit();
                    }
                });
            }

             function confirmSaveBatch() {

                Swal.fire({
                    title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Save batch changes?"].Value)),
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["This will update the batch composition."].Value)),
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Yes, save it"].Value)),
                    cancelButtonText: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Cancel"].Value))
                }).then((result) => {

                    if (result.isConfirmed) {
                        document.getElementById('manageBatchForm').submit();
                    }

                });
            }
        </script>



        <script src="~/assets/js/app.js"></script>
    }

</body>