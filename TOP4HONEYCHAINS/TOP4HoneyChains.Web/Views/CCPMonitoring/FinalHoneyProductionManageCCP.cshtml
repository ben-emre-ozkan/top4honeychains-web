@using TOP4HoneyChains.Web.Models.ViewModels.Monitoring
@model CCPMonitoringViewModelForFinalBatch

@{
    ViewData["Title"] = "Final Batch CCP Monitoring";
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">

            <!-- 🔷 CCP HEADER -->
            <div class="card mb-4 border-0 shadow-lg">
                <div class="card-body text-white rounded"
                     style="background: linear-gradient(135deg,#0f2027,#203a43,#2c5364);">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h3 class="fw-bold mb-1">
                                <i class="mdi mdi-shield-check-outline me-2"></i>
                                @Model.CCPCode - @Model.CCPTitle
                            </h3>
                            <small class="opacity-75">
                                @Model.ProcessingStep
                            </small>
                        </div>

                        <div class="text-end">
                            <span class="badge bg-light text-dark fs-6 px-3 py-2 shadow">
                                FINAL BATCH MONITORING
                            </span>
                        </div>

                    </div>

                    <hr class="border-light opacity-25" />

                    <small class="opacity-75">
                        @Model.CriticalityJustification
                    </small>
                </div>
            </div>


            <!-- 🔷 BATCH INTELLIGENCE CARD -->
            <div class="card mb-4 border-0 shadow-sm">
                <div class="card-body bg-light rounded">

                    <div class="row text-center">

                        <div class="col-md-3">
                            <small class="text-muted text-uppercase">Batch</small>
                            <div class="fw-bold fs-5">@Model.BatchTitle</div>
                        </div>

                        <div class="col-md-3">
                            <small class="text-muted text-uppercase">Production Date</small>
                            <div class="fw-bold fs-5">
                                @Model.ProductionDate?.ToString("dd.MM.yyyy")
                            </div>
                        </div>

                        <div class="col-md-3">
                            <small class="text-muted text-uppercase">Total Amount</small>
                            <div class="fw-bold fs-5 text-success">
                                @Model.TotalAmount?.ToString("0.00") kg
                            </div>
                        </div>

                        <div class="col-md-3">
                            <small class="text-muted text-uppercase">Wholesaler</small>
                            <div class="fw-bold fs-5">@Model.WholesalerName</div>
                        </div>

                    </div>

                    <hr />

                    <div class="text-center">
                        <span class="badge bg-info px-3 py-2">
                            @Model.RawSourceCount Raw Source(s)
                        </span>
                    </div>

                </div>
            </div>


            <!-- 🔷 RAW SOURCE BREAKDOWN -->
            <div class="card mb-5 border-0 shadow-sm">
                <div class="card-header bg-dark text-white">
                    <i class="mdi mdi-database-outline me-2"></i>
                    Source Composition
                </div>

                <div class="card-body">

                    <div class="row">
                        @foreach (var source in Model.RawSources)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="p-3 border rounded shadow-sm bg-light h-100">

                                    <div class="fw-bold">@source.ApiaryName</div>

                                    <small class="text-muted">
                                        @source.BeekeeperName
                                    </small>

                                    <div class="mt-2">
                                        <span class="badge bg-warning text-dark">
                                            @source.HoneyType
                                        </span>
                                    </div>

                                    <div class="mt-2 fw-bold text-success">
                                        @source.UsedAmount?.ToString("0.00") kg
                                    </div>

                                </div>
                            </div>
                        }
                    </div>

                </div>
            </div>


            <!-- 🔷 MONITORING FORM -->
            <div class="card border-0 shadow-lg">
                <div class="card-body">

                    <form asp-action="FinalHoneyProductionManageCCP" method="post">

                        <input type="hidden" asp-for="CCPId" />
                        <input type="hidden" asp-for="FinalHoneyProductionId" />
                        <input type="hidden" asp-for="WholesalerId" />

                        @for (int i = 0; i < Model.Groups.Count; i++)
                        {
                            <div class="card mb-4 border-0 shadow-sm">

                                <div class="card-header text-white"
                                     style="background: linear-gradient(135deg,#1e3c72,#2a5298);">

                                    <div class="d-flex justify-content-between">

                                        <div>
                                            <strong>@Model.Groups[i].CategoryName</strong>

                                            @if (!string.IsNullOrEmpty(Model.Groups[i].CategoryDescription))
                                            {
                                                <div class="small opacity-75">
                                                    @Model.Groups[i].CategoryDescription
                                                </div>
                                            }
                                        </div>

                                        <span class="badge bg-light text-dark">
                                            @Model.Groups[i].Parameters.Count Parameters
                                        </span>

                                    </div>
                                </div>

                                <div class="card-body">

                                    @for (int j = 0; j < Model.Groups[i].Parameters.Count; j++)
                                    {
                                        <input type="hidden"
                                               asp-for="Groups[i].Parameters[j].ParameterId" />

                                        <div class="mb-4 p-4 rounded shadow-sm"
                                             style="background:#f4f7fa; transition:.3s ease;"
                                             onmouseover="this.style.transform='scale(1.01)'"
                                             onmouseout="this.style.transform='scale(1)'">

                                            <label class="fw-bold">
                                                @Model.Groups[i].Parameters[j].ParameterName

                                                @if (!string.IsNullOrEmpty(Model.Groups[i].Parameters[j].Unit))
                                                {
                                                    <span class="text-muted">
                                                        (@Model.Groups[i].Parameters[j].Unit)
                                                    </span>
                                                }
                                            </label>

                                            <div class="row mt-3">

                                                <div class="col-md-6">
                                                    <label class="form-label small text-muted fw-semibold">
                                                        Numeric Value
                                                    </label>
                                                    <input type="number"
                                                           step="0.0001"
                                                           class="form-control shadow-sm"
                                                           asp-for="Groups[i].Parameters[j].MeasuredNumericValue"
                                                           placeholder="Enter numeric value..." />
                                                </div>

                                                <div class="col-md-6">
                                                    <label class="form-label small text-muted fw-semibold">
                                                        Text Value
                                                    </label>
                                                    <input type="text"
                                                           class="form-control shadow-sm"
                                                           asp-for="Groups[i].Parameters[j].MeasuredTextValue"
                                                           placeholder="Enter text value..." />
                                                </div>

                                            </div>

                                            <div class="mt-3">
                                                <textarea class="form-control shadow-sm"
                                                          rows="2"
                                                          asp-for="Groups[i].Parameters[j].Notes"
                                                          placeholder="Professional observation...">
                                </textarea>
                                            </div>

                                            @if (!string.IsNullOrEmpty(Model.Groups[i].Parameters[j].CriticalLimit))
                                            {
                                                <div class="mt-3 p-2 rounded"
                                                     style="background:#fff5f5; border-left:4px solid #dc3545;">
                                                    <small class="text-danger fw-semibold">
                                                        Critical Limit:
                                                        @Model.Groups[i].Parameters[j].CriticalLimit
                                                    </small>
                                                </div>
                                            }

                                        </div>
                                    }

                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-between mt-4">

                            <a asp-controller="FinalHoneyProductions"
                               asp-action="ByWholesaler"
                               asp-route-wholesalerId="@Model.WholesalerId"
                               class="btn btn-outline-secondary px-4">
                                <i class="mdi mdi-arrow-left me-1"></i>
                                Back
                            </a>

                            <button type="submit"
                                    class="btn btn-success px-5 shadow">
                                <i class="mdi mdi-content-save-outline me-1"></i>
                                Save Monitoring Logs
                            </button>

                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</body>