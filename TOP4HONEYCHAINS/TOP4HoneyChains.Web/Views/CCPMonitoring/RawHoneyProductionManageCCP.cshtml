@using TOP4HoneyChains.Web.Models.ViewModels.Monitoring
@model CCPMonitoringViewModelForRawHoney

@{
    ViewData["Title"] = L["CCP Monitoring"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">

            <!-- 🔷 CCP HEADER -->
            <div class="card mb-4 border-0 shadow-lg">
                <div class="card-body text-white rounded app-hero">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h3 class="mb-1 fw-bold">
                                <i class="mdi mdi-shield-check-outline me-2"></i>
                                @Ref.Code(Model.CCPCode) - @Ref.CcpTitle(Model.CCPId, Model.CCPTitle)
                            </h3>

                            <small class="opacity-75">
                                @Ref.T("Ccp", Model.CCPId, "ProcessingStep", Model.ProcessingStep)
                            </small>
                        </div>

                        <div class="text-end">
                            <span class="badge bg-light text-dark fs-6 px-3 py-2 shadow-sm">
                                @L["CCP Monitoring"]
                            </span>
                        </div>

                    </div>

                    <hr class="border-light opacity-25" />

                    <div>
                        <small class="opacity-75">
                            @Ref.T("Ccp", Model.CCPId, "CriticalityJustification", Model.CriticalityJustification)
                        </small>
                    </div>

                </div>
            </div>


            <!-- 🔷 PRODUCTION CARD -->
            <div class="card mb-5 border-0 shadow-sm">
                <div class="card-body bg-light rounded">

                    <div class="row text-center">

                        <div class="col-md-3">
                            <small class="text-uppercase text-muted">@L["Beekeeper"]</small>
                            <div class="fw-bold fs-5">@(Model.BeekeeperName ?? L["not shown"].Value)</div>
                        </div>

                        <div class="col-md-3">
                            <small class="text-uppercase text-muted">@L["Apiary"]</small>
                            <div class="fw-bold fs-5">@(Model.ApiaryName ?? L["not shown"].Value)</div>
                        </div>

                        <div class="col-md-3">
                            <small class="text-uppercase text-muted">@L["Honey Type"]</small>
                            <div class="fw-bold fs-5">@Ref.Text("HoneyType", "Title", Model.HoneyType)</div>
                        </div>

                        <div class="col-md-3">
                            <small class="text-uppercase text-muted">@L["Production Date"]</small>
                            <div class="fw-bold fs-5">
                                @Model.ProductionDate?.ToString("dd.MM.yyyy")
                            </div>
                        </div>

                    </div>

                </div>
            </div>



            <partial name="_CcpStatusPanel" model="Model" />

            @if (Model.Path == TOP4HoneyChains.Web.Services.OrgModel.CcpPaths.Association)
            {
                @* D-98: association path, the honey goes from the approved lab report straight to packing *@
                <div class="card mb-4 border-0 shadow-sm" id="packing-ready">
                    <div class="card-body">
                        <h2 class="h6 mb-1"><i class="mdi mdi-package-variant-closed me-1" aria-hidden="true"></i>@L["Path.PackingReady"]<info-tip key="Path.Info.Association" about="@L["Path.PackingReady"].Value" /></h2>
                        @if (Model.PackingReadyAt != null)
                        {
                            <div id="packing-ready-state"><partial name="_StatusPill" model="@(new TOP4HoneyChains.Web.Models.ViewModels.StatusPill(TOP4HoneyChains.Web.Models.ViewModels.StatusPill.Approved, L["Path.IsReady"].Value))" /> <span class="small text-muted">@Model.PackingReadyAt?.ToString("dd.MM.yyyy HH:mm")</span></div>
                            <p class="small text-muted mb-0 mt-1">@L["Path.ReadyHelp"]</p>
                        }
                        else if (Model.PackingReadyDenied == null)
                        {
                            <p class="small text-muted mb-2">@L["Path.ButtonHelp"]</p>
                            <form asp-action="PackingReady" method="post">
                                <input type="hidden" name="lotId" value="@Model.RawHoneyProductionId" />
                                <input type="hidden" name="ccpId" value="@Model.CCPId" />
                                <button type="submit" class="btn btn-success" id="packing-ready-button"><i class="mdi mdi-check-decagram-outline me-1" aria-hidden="true"></i>@L["Path.PackingReady"]</button>
                            </form>
                        }
                        else
                        {
                            <p class="small text-muted mb-0" id="packing-ready-denied">@Msg.T(Model.PackingReadyDenied)</p>
                        }
                    </div>
                </div>
            }

            <!-- 🔷 MONITORING FORM -->
            <div class="card border-0 shadow-lg">
                <div class="card-body">

                    <form asp-action="RawHoneyProductionManageCCP" method="post" enctype="multipart/form-data" class="@(Model.OrgModelOn ? "field-form" : null)">

                        <input type="hidden" asp-for="CCPId" />
                        <input type="hidden" asp-for="RawHoneyProductionId" />
                        <input type="hidden" asp-for="ApiaryId" />

                        <partial name="_CcpParameters" model="Model" />

                        <!-- ACTION BUTTONS -->
                        <div class="d-flex justify-content-between mt-4">

                            @if (!User.IsInRole("Administrator"))
                            {
                                <a href="/OrgWorkspace/Index" class="btn btn-link app-back"><i class="mdi mdi-arrow-left me-1"></i> @L["Back"]</a>
                            }
                            else
                            {
                            <a asp-controller="RawHoneyProductions"
                               asp-action="RawHoneyProductionByApiary"
                               asp-route-id="@Model.ApiaryId"
                               class="btn btn-link app-back">
                                <i class="mdi mdi-arrow-left me-1"></i>
                                @L["Back"]
                            </a>
                            }

                            @if (Model.LockReason == null && Model.CanEnter && Model.StatusId != TOP4HoneyChains.Web.Models.Entities.AssignmentStatusIds.NotApplicable)
                            {
                            <button type="submit"
                                    class="btn btn-success px-5 shadow">
                                <i class="mdi mdi-content-save-outline me-1"></i>
                                @L["Save Monitoring Logs"]
                            </button>
                            }

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/libs/parsleyjs/parsley.min.js"></script>
        <script src="~/assets/js/pages/form-validation.init.js"></script>
        <script src="~/assets/js/app.js"></script>
    }
</body>
