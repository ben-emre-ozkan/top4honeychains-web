@using TOP4HoneyChains.Web.Models.Entities
@using TOP4HoneyChains.Web.Models.ViewModels.Monitoring
@model CcpMonitoringViewModelBase

@* Parameter inputs by data type, limits and the stored in-range result (D-18, D-19).
   Rendered inside the page's form; disabled when the page is read-only. *@
@{
    var readOnly = Model.LockReason != null || Model.StatusId == AssignmentStatusIds.NotApplicable || !Model.CanEnter;
}

<fieldset @(readOnly ? "disabled" : "")>
@for (int i = 0; i < Model.Groups.Count; i++)
{
    <div class="card mb-4 border-0 shadow-sm">

        <div class="card-header border-0 app-band">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h2 class="h6 mb-1 fw-bold">
                        <i class="mdi mdi-folder-outline me-2"></i>
                        @(Model.Groups[i].CategoryId != null ? Ref.Category(Model.Groups[i].CategoryId, Model.Groups[i].CategoryName) : L[Model.Groups[i].CategoryName].Value)
                    </h2>
                    @if (!string.IsNullOrEmpty(Model.Groups[i].CategoryDescription))
                    {
                        <small class="opacity-75">@Ref.CategoryDescription(Model.Groups[i].CategoryId, Model.Groups[i].CategoryDescription)</small>
                    }
                </div>
                <span class="badge bg-light text-dark">@L["{0} parameters", Model.Groups[i].Parameters.Count]</span>
            </div>
        </div>

        <div class="card-body">
            @for (int j = 0; j < Model.Groups[i].Parameters.Count; j++)
            {
                var p = Model.Groups[i].Parameters[j];
                var hasValue = p.MeasuredNumericValue != null || !string.IsNullOrEmpty(p.MeasuredTextValue);
                var state = p.IsInRange == true ? "is-in" : p.IsInRange == false ? "is-out" : "";
                // D-67: the limit in the selected language, for this honey class
                var limitText = p.Definition != null ? Limits.Describe(p.Definition, new TOP4HoneyChains.Web.Services.HoneyProfile(null, Model.HoneyClass)) : Ref.Limit(p.LimitText, k => L[k]);

                <input type="hidden" asp-for="Groups[i].Parameters[j].ParameterId" />

                @if (p.LabReportId != null)
                {
                    @:<fieldset disabled class="lab-value">
                }
                <div class="mb-4 p-4 rounded ccp-param @state" data-parameter-id="@p.ParameterId">
                    @if (p.LabReportId != null)
                    {
                        <span class="badge bg-info text-dark mb-2 lab-badge"><i class="mdi mdi-flask-outline"></i> @L["Lab.ValueFromReport"]</span>
                    }

                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                        @* D-66: the label names its input (number: the numeric value; yes/no and text: the text value) *@
                        <label class="form-label fw-bold fs-6 @(p.IsRequired ? "required" : "")"
                               for="@(p.DataType == CcpDataType.Number ? Html.IdFor(m => m.Groups[i].Parameters[j].MeasuredNumericValue) : p.DataType is CcpDataType.YesNo or CcpDataType.Text ? Html.IdFor(m => m.Groups[i].Parameters[j].MeasuredTextValue) : null)">
                            @Ref.T("Parameter", p.ParameterId, "Name", p.ParameterName)
                            @if (!string.IsNullOrEmpty(p.Unit) && p.Unit != "None")
                            {
                                <span class="text-muted">(@TOP4HoneyChains.Web.Services.Units.Symbol(Ref.Text("Parameter", "Unit", p.Unit)))</span>
                            }
                            @if (p.IsRequired && p.RequiredIfParameterId != null)
                            {
                                var parent = Model.Groups.SelectMany(g => g.Parameters).FirstOrDefault(x => x.ParameterId == p.RequiredIfParameterId);
                                <span class="d-block small fw-normal text-muted required-if" data-required-if="@p.RequiredIfParameterId">
                                    @L["Required only when “{0}” is answered {1}.", parent == null ? "" : Ref.T("Parameter", parent.ParameterId, "Name", parent.ParameterName), L[p.RequiredIfValue ?? ""].Value]
                                </span>
                            }
                        </label>

                        @if (p.IsInRange == true)
                        {
                            <span class="st-pill st-inlimit ccp-range" title="@limitText">
                                <i class="mdi mdi-check-circle-outline" aria-hidden="true"></i> @L["Within limit"] (@limitText)
                            </span>
                        }
                        else if (p.IsInRange == false)
                        {
                            <span class="st-pill st-outlimit ccp-range" title="@limitText">
                                <i class="mdi mdi-alert-circle-outline" aria-hidden="true"></i> @L["Out of limit"] (@limitText)
                            </span>
                        }
                        else if (hasValue && p.LimitText != null)
                        {
                            <span class="st-pill st-na ccp-range"><i class="mdi mdi-minus-circle-outline" aria-hidden="true"></i><span>@L["Not checked"]</span></span>
                        }
                    </div>

                    <div class="row mt-2">
                        @switch (p.DataType)
                        {
                            case CcpDataType.Number:
                                <div class="col-md-6">
                                    <input type="text" inputmode="decimal" autocomplete="off" class="form-control shadow-sm"
                                           asp-for="Groups[i].Parameters[j].MeasuredNumericValue" asp-format="{0:0.####}" />
                                </div>
                                break;
                            case CcpDataType.YesNo:
                                <div class="col-md-6">
                                    <select class="form-select shadow-sm" asp-for="Groups[i].Parameters[j].MeasuredTextValue">
                                        <option value="">@L["-- not recorded --"]</option>
                                        <option value="Yes">@L["Yes"]</option>
                                        <option value="No">@L["No"]</option>
                                    </select>
                                </div>
                                break;
                            case CcpDataType.Text:
                                <div class="col-12">
                                    <input type="text" maxlength="100" class="form-control shadow-sm"
                                           asp-for="Groups[i].Parameters[j].MeasuredTextValue" />
                                </div>
                                break;
                            case CcpDataType.File:
                                <div class="col-12">
                                    @if (p.HasStoredFile)
                                    {
                                        <div class="mb-2">
                                            <a asp-action="File" asp-route-id="@p.LogId" target="_blank">
                                                <i class="mdi mdi-file-document-outline"></i> @p.MeasuredTextValue
                                            </a>
                                            @if (!readOnly)
                                            {
                                                <label class="ms-3 small">
                                                    <input type="checkbox" asp-for="Groups[i].Parameters[j].RemoveFile" /> @L["Remove"]
                                                </label>
                                            }
                                        </div>
                                    }
                                    <input type="file" class="form-control shadow-sm" accept=".pdf,.jpg,.jpeg,.png,.webp" data-camera="@(Model.OrgModelOn ? L["Mob.Camera"].Value : null)"
                                           name="Groups[@i].Parameters[@j].File" />
                                    <small class="text-muted">@UploadValidatorRule</small>
                                </div>
                                break;
                            default:
                                <div class="col-md-6">
                                    <label class="form-label small text-muted">@L["Numeric Value"]</label>
                                    <input type="text" inputmode="decimal" autocomplete="off" class="form-control shadow-sm"
                                           asp-for="Groups[i].Parameters[j].MeasuredNumericValue" asp-format="{0:0.####}" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small text-muted">@L["Text Value"]</label>
                                    <input type="text" maxlength="100" class="form-control shadow-sm"
                                           asp-for="Groups[i].Parameters[j].MeasuredTextValue" />
                                </div>
                                break;
                        }
                    </div>

                    <div class="row mt-3">
                        <div class="col-12">
                            <label class="form-label small text-muted">@L["Notes"]</label>
                            <textarea class="form-control shadow-sm" rows="2" maxlength="500"
                                      asp-for="Groups[i].Parameters[j].Notes"
                                      placeholder="@L["Optional professional observation..."]"></textarea>
                        </div>
                    </div>

                    @if (p.LimitText != null || (!string.IsNullOrEmpty(p.CriticalLimit) && p.CriticalLimit != "None"))
                    {
                        <div class="mt-3 p-2 rounded ccp-limit-note">
                            <small class="fw-semibold">
                                <i class="mdi mdi-alert-circle-outline me-1"></i>
                                @L["Critical limit:"] @(limitText ?? Ref.Limit(p.CriticalLimit, k => L[k]))
                            </small>
                            @if (p.LimitText != null && !p.LimitVerified)
                            {
                                <span class="badge bg-warning text-dark ms-2" title="@L["Seeded from the Turkish Food Codex; to be verified"]">@L["to verify"]</span>
                            }
                        </div>
                    }
                </div>
                @if (p.LabReportId != null)
                {
                    @:</fieldset>
                }
            }
        </div>
    </div>
}
</fieldset>

@functions {
    private string UploadValidatorRule => L["Allowed: {0}", L[TOP4HoneyChains.Web.Services.UploadValidator.DocumentRule].Value].Value;   // D-75: translated
}
