@using TOP4HoneyChains.Web.Models.Entities
@using TOP4HoneyChains.Web.Models.ViewModels.Monitoring
@model CcpMonitoringViewModelBase

@* Parameter inputs by data type, limits and the stored in-range result (D-18, D-19).
   Rendered inside the page's form; disabled when the page is read-only. *@
@{
    var readOnly = Model.LockReason != null || Model.StatusId == AssignmentStatusIds.NotApplicable || !Model.CanEnter;
}

<fieldset @(readOnly ? "disabled" : "")>
@for (int i = 0; i < Model.Groups.Count; i++)
{
    <div class="card mb-4 border-0 shadow-sm">

        <div class="card-header border-0 text-white"
             style="background: linear-gradient(135deg,#2c3e50,#4ca1af);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="mb-1 fw-bold">
                        <i class="mdi mdi-folder-outline me-2"></i>
                        @Model.Groups[i].CategoryName
                    </h6>
                    @if (!string.IsNullOrEmpty(Model.Groups[i].CategoryDescription))
                    {
                        <small class="opacity-75">@Model.Groups[i].CategoryDescription</small>
                    }
                </div>
                <span class="badge bg-light text-dark">@Model.Groups[i].Parameters.Count Parameters</span>
            </div>
        </div>

        <div class="card-body">
            @for (int j = 0; j < Model.Groups[i].Parameters.Count; j++)
            {
                var p = Model.Groups[i].Parameters[j];
                var hasValue = p.MeasuredNumericValue != null || !string.IsNullOrEmpty(p.MeasuredTextValue);
                var border = p.IsInRange == true ? "#198754" : p.IsInRange == false ? "#dc3545" : "transparent";

                <input type="hidden" asp-for="Groups[i].Parameters[j].ParameterId" />

                <div class="mb-4 p-4 rounded shadow-sm ccp-param" data-parameter-id="@p.ParameterId"
                     style="background:#f8fafc; border-left:5px solid @border;">

                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                        <label class="form-label fw-bold fs-6 @(p.IsRequired ? "required" : "")">
                            @p.ParameterName
                            @if (!string.IsNullOrEmpty(p.Unit) && p.Unit != "None")
                            {
                                <span class="text-muted">(@p.Unit)</span>
                            }
                        </label>

                        @if (p.IsInRange == true)
                        {
                            <span class="badge bg-success ccp-range" title="@p.AppliedLimit">
                                <i class="mdi mdi-check-circle-outline"></i> Within limit (@p.AppliedLimit)
                            </span>
                        }
                        else if (p.IsInRange == false)
                        {
                            <span class="badge bg-danger ccp-range" title="@p.AppliedLimit">
                                <i class="mdi mdi-alert-circle-outline"></i> Out of limit (@p.AppliedLimit)
                            </span>
                        }
                        else if (hasValue && p.LimitText != null)
                        {
                            <span class="badge bg-secondary ccp-range">Not checked</span>
                        }
                    </div>

                    <div class="row mt-2">
                        @switch (p.DataType)
                        {
                            case CcpDataType.Number:
                                <div class="col-md-6">
                                    <input type="number" step="0.0001" class="form-control shadow-sm"
                                           asp-for="Groups[i].Parameters[j].MeasuredNumericValue" />
                                </div>
                                break;
                            case CcpDataType.YesNo:
                                <div class="col-md-6">
                                    <select class="form-select shadow-sm" asp-for="Groups[i].Parameters[j].MeasuredTextValue">
                                        <option value="">-- not recorded --</option>
                                        <option value="Yes">Yes</option>
                                        <option value="No">No</option>
                                    </select>
                                </div>
                                break;
                            case CcpDataType.Text:
                                <div class="col-12">
                                    <input type="text" maxlength="100" class="form-control shadow-sm"
                                           asp-for="Groups[i].Parameters[j].MeasuredTextValue" />
                                </div>
                                break;
                            case CcpDataType.File:
                                <div class="col-12">
                                    @if (p.HasStoredFile)
                                    {
                                        <div class="mb-2">
                                            <a asp-action="File" asp-route-id="@p.LogId" target="_blank">
                                                <i class="mdi mdi-file-document-outline"></i> @p.MeasuredTextValue
                                            </a>
                                            @if (!readOnly)
                                            {
                                                <label class="ms-3 small">
                                                    <input type="checkbox" asp-for="Groups[i].Parameters[j].RemoveFile" /> remove
                                                </label>
                                            }
                                        </div>
                                    }
                                    <input type="file" class="form-control shadow-sm" accept=".pdf,.jpg,.jpeg,.png,.webp"
                                           name="Groups[@i].Parameters[@j].File" />
                                    <small class="text-muted">@UploadValidatorRule</small>
                                </div>
                                break;
                            default:
                                <div class="col-md-6">
                                    <label class="form-label small text-muted">Numeric Value</label>
                                    <input type="number" step="0.0001" class="form-control shadow-sm"
                                           asp-for="Groups[i].Parameters[j].MeasuredNumericValue" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small text-muted">Text Value</label>
                                    <input type="text" maxlength="100" class="form-control shadow-sm"
                                           asp-for="Groups[i].Parameters[j].MeasuredTextValue" />
                                </div>
                                break;
                        }
                    </div>

                    <div class="row mt-3">
                        <div class="col-12">
                            <label class="form-label small text-muted">Notes</label>
                            <textarea class="form-control shadow-sm" rows="2" maxlength="500"
                                      asp-for="Groups[i].Parameters[j].Notes"
                                      placeholder="Optional professional observation..."></textarea>
                        </div>
                    </div>

                    @if (p.LimitText != null || (!string.IsNullOrEmpty(p.CriticalLimit) && p.CriticalLimit != "None"))
                    {
                        <div class="mt-3 p-2 rounded" style="background:#fff5f5; border-left:4px solid #dc3545;">
                            <small class="text-danger fw-semibold">
                                <i class="mdi mdi-alert-circle-outline me-1"></i>
                                Critical limit: @(p.LimitText ?? p.CriticalLimit)
                            </small>
                            @if (p.LimitText != null && !p.LimitVerified)
                            {
                                <span class="badge bg-warning text-dark ms-2" title="Seeded from the Turkish Food Codex; to be verified">to verify</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}
</fieldset>

@functions {
    private string UploadValidatorRule => "Allowed: " + TOP4HoneyChains.Web.Services.UploadValidator.DocumentRule;
}
