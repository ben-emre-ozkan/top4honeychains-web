@using TOP4HoneyChains.Web.Models.Entities
@using TOP4HoneyChains.Web.Models.ViewModels.Monitoring
@model CcpMonitoringViewModelBase

@* Lock banner, status and the "Not applicable" record / form (D-14, D-15) *@

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

@if (Model.LockReason != null)
{
    <div class="alert alert-warning">
        <i class="mdi mdi-lock-outline me-1"></i> @Msg.T(Model.LockReason)
    </div>
}
else if (!Model.CanEnter)
{
    <div class="alert alert-info" id="ccp-read-only">
        <i class="mdi mdi-eye-outline me-1"></i> @L["Ccp.ReadOnly"]: @Msg.T(Model.EnterDeniedReason)
    </div>
}

<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <span class="text-muted small text-uppercase">@L["Status"]</span>
                @{
                    var badge = Model.StatusId switch
                    {
                        AssignmentStatusIds.Completed => "bg-success",
                        AssignmentStatusIds.NotApplicable => "bg-dark",
                        AssignmentStatusIds.InProgress => "bg-warning text-dark",
                        AssignmentStatusIds.Submitted => "bg-info text-dark",
                        _ => "bg-secondary"
                    };
                }
                <span class="badge @badge fs-6 ms-2" id="ccp-status">@(Model.StatusName != null ? Ref.Status(Model.StatusId, Model.StatusName) : L["Not assigned"].Value)</span>
                @if (Model.HoneyClass != null)
                {
                    <span class="text-muted small ms-3">@L["Limits for honey class:"] <strong>@L[Model.HoneyClass ?? ""]</strong></span>
                }
                else
                {
                    <span class="text-muted small ms-3">@L["Honey class unknown or mixed: only limits for every honey class apply"]</span>
                }
            </div>
        </div>

        @if (Model.StatusId == AssignmentStatusIds.NotApplicable)
        {
            <div class="mt-3 p-3 rounded bg-light border" id="ccp-not-applicable">
                <strong>@L["Not applicable."]</strong> Reason: @Model.NotApplicableReason
                <div class="small text-muted">
                    Recorded by @Model.NotApplicableBy on @Model.NotApplicableAt?.ToString("dd.MM.yyyy HH:mm")
                </div>
                @if (Model.LockReason == null)
                {
                    @if (Model.CanEnter)
                {
                <form asp-action="ClearNotApplicable" method="post" class="mt-2">
                        <input type="hidden" name="ownerKind" value="@Model.OwnerKind" />
                        <input type="hidden" name="ownerId" value="@Model.OwnerId" />
                        <input type="hidden" name="ccpId" value="@Model.CCPId" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">@L["Remove \"Not applicable\""]</button>
                    </form>
                }
                }
            </div>
        }
        else if (Model.LockReason == null && !Model.HasValues && Model.CanEnter)
        {
            <details class="mt-3">
                <summary class="text-primary" style="cursor:pointer">@L["This CCP does not apply here (mark as \"Not applicable\")"]</summary>
                <form asp-action="SetNotApplicable" method="post" class="mt-2">
                    <input type="hidden" name="ownerKind" value="@Model.OwnerKind" />
                    <input type="hidden" name="ownerId" value="@Model.OwnerId" />
                    <input type="hidden" name="ccpId" value="@Model.CCPId" />
                    <label for="na-reason" class="form-label required">@L["Reason"]</label>
                    <textarea id="na-reason" name="reason" class="form-control" rows="2" maxlength="500" required
                              placeholder="@L["e.g. Raw honey is not heated or pasteurized"]"></textarea>
                    <small class="text-muted">@L["Your user name and the time are recorded with the reason. It is shown as \"Not applicable\" on the public Honey Story page."]</small>
                    <div class="mt-2">
                        <button type="submit" class="btn btn-sm btn-dark">@L["Mark as \"Not applicable\""]</button>
                    </div>
                </form>
            </details>
        }
    </div>
</div>

@if (Model.OrgModelOn && Model.StatusId != 0)
{
    @* Four-eyes approval of the CCP record (D-27) *@
    <div class="card mb-4 border-0 shadow-sm" id="ccp-approval">
        <div class="card-body">
            <h6 class="mb-2">@L["Ccp.ApprovalTitle"]</h6>
            @if (Model.ApprovedAt != null)
            {
                <div id="approval-state">
                    <span class="badge bg-success">@L["Ccp.Approved"]</span> @Model.ApprovedBy · @Model.ApprovedAt?.ToString("dd.MM.yyyy HH:mm")
                    @if (Model.SelfApproved)
                    {
                        <span class="badge bg-warning text-dark ms-1">@L["Org.SelfApproved"]</span>
                    }
                </div>
            }
            else
            {
                <div id="approval-state" class="text-muted">@L["Ccp.NotApproved"]</div>
                @if (Model.CanApprove && Model.LockReason == null && (Model.StatusId == AssignmentStatusIds.Submitted || Model.StatusId == AssignmentStatusIds.Completed || Model.StatusId == AssignmentStatusIds.NotApplicable))
                {
                    <form asp-action="Approve" method="post" class="mt-2">
                        <input type="hidden" name="ownerKind" value="@Model.OwnerKind" />
                        <input type="hidden" name="ownerId" value="@Model.OwnerId" />
                        <input type="hidden" name="ccpId" value="@Model.CCPId" />
                        <button type="submit" class="btn btn-sm btn-success" id="approve-button">@L["Ccp.Approve"]</button>
                    </form>
                }
                else if (Model.ApproveDeniedReason != null)
                {
                    <div class="small text-muted mt-1">@Msg.T(Model.ApproveDeniedReason)</div>
                }
            }
        </div>
    </div>
}

@if (Model.AdminCorrections)
{
    @* D-35: platform administrators correct values only through a correction record and a second administrator *@
    var allParams = Model.Groups.SelectMany(g => g.Parameters).Where(p => p.DataType != CcpDataType.File).ToList();
    <div class="card mb-4 border-0 shadow-sm" id="ccp-corrections">
        <div class="card-body">
            <h6 class="mb-1">@L["Corr.Title"]</h6>
            <p class="small text-muted">@L["Corr.FormHelp"]</p>
            <form asp-action="RequestCorrection" method="post" class="row g-2" id="correction-form">
                <input type="hidden" name="ownerKind" value="@Model.OwnerKind" />
                <input type="hidden" name="ownerId" value="@Model.OwnerId" />
                <input type="hidden" name="ccpId" value="@Model.CCPId" />
                <div class="col-md-4">
                    <select name="parameterId" class="form-select form-select-sm">
                        @foreach (var p in allParams) { <option value="@p.ParameterId">@Ref.T("Parameter", p.ParameterId, "Name", p.ParameterName)</option> }
                    </select>
                </div>
                <div class="col-md-2"><input name="newNumericValue" type="text" inputmode="decimal" class="form-control form-control-sm" placeholder="@L["Corr.Number"]" /></div>
                <div class="col-md-2"><input name="newTextValue" class="form-control form-control-sm" maxlength="100" placeholder="@L["Corr.Text"]" /></div>
                <div class="col-md-3"><input name="reason" class="form-control form-control-sm" maxlength="500" placeholder="@L["Corr.Reason"]" /></div>
                <div class="col-md-1"><button type="submit" class="btn btn-sm btn-outline-primary w-100">@L["Corr.Request"]</button></div>
            </form>
            @if (Model.Corrections.Any())
            {
                <table class="table table-sm mt-3 mb-0">
                    <tbody>
                        @foreach (var c in Model.Corrections)
                        {
                            <tr><td>#@c.CorrectionId</td><td>@Ref.T("Parameter", c.Parameter?.ParameterId, "Name", c.Parameter?.ParameterName)</td><td>@(c.OldNumericValue?.ToString("0.####") ?? c.OldTextValue ?? "–") → @(c.NewNumericValue?.ToString("0.####") ?? c.NewTextValue)</td><td>@c.Reason</td><td>@L[c.Status ?? ""]</td></tr>
                        }
                    </tbody>
                </table>
            }
            <a asp-action="Corrections" class="small">@L["Corr.All"]</a>
        </div>
    </div>
}
