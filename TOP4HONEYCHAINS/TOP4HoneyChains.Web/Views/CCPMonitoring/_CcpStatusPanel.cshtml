@using TOP4HoneyChains.Web.Models.Entities
@using TOP4HoneyChains.Web.Models.ViewModels.Monitoring
@model CcpMonitoringViewModelBase

@* Lock banner, status and the "Not applicable" record / form (D-14, D-15) *@

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

@if (Model.LockReason != null)
{
    <div class="alert alert-warning">
        <i class="mdi mdi-lock-outline me-1"></i> @Model.LockReason
    </div>
}

<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <span class="text-muted small text-uppercase">Status</span>
                @{
                    var badge = Model.StatusId switch
                    {
                        AssignmentStatusIds.Completed => "bg-success",
                        AssignmentStatusIds.NotApplicable => "bg-dark",
                        AssignmentStatusIds.InProgress => "bg-warning text-dark",
                        _ => "bg-secondary"
                    };
                }
                <span class="badge @badge fs-6 ms-2" id="ccp-status">@(Model.StatusName ?? "Not assigned")</span>
                @if (Model.HoneyClass != null)
                {
                    <span class="text-muted small ms-3">Limits for honey class: <strong>@Model.HoneyClass</strong></span>
                }
                else
                {
                    <span class="text-muted small ms-3">Honey class unknown or mixed: only limits for every honey class apply</span>
                }
            </div>
        </div>

        @if (Model.StatusId == AssignmentStatusIds.NotApplicable)
        {
            <div class="mt-3 p-3 rounded bg-light border" id="ccp-not-applicable">
                <strong>Not applicable.</strong> Reason: @Model.NotApplicableReason
                <div class="small text-muted">
                    Recorded by @Model.NotApplicableBy on @Model.NotApplicableAt?.ToString("dd.MM.yyyy HH:mm")
                </div>
                @if (Model.LockReason == null)
                {
                    <form asp-action="ClearNotApplicable" method="post" class="mt-2">
                        <input type="hidden" name="ownerKind" value="@Model.OwnerKind" />
                        <input type="hidden" name="ownerId" value="@Model.OwnerId" />
                        <input type="hidden" name="ccpId" value="@Model.CCPId" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Remove "Not applicable"</button>
                    </form>
                }
            </div>
        }
        else if (Model.LockReason == null && !Model.HasValues)
        {
            <details class="mt-3">
                <summary class="text-primary" style="cursor:pointer">This CCP does not apply here (mark as "Not applicable")</summary>
                <form asp-action="SetNotApplicable" method="post" class="mt-2">
                    <input type="hidden" name="ownerKind" value="@Model.OwnerKind" />
                    <input type="hidden" name="ownerId" value="@Model.OwnerId" />
                    <input type="hidden" name="ccpId" value="@Model.CCPId" />
                    <label for="na-reason" class="form-label required">Reason</label>
                    <textarea id="na-reason" name="reason" class="form-control" rows="2" maxlength="500" required
                              placeholder="e.g. Raw honey is not heated or pasteurized"></textarea>
                    <small class="text-muted">Your user name and the time are recorded with the reason. It is shown as "Not applicable" on the public Honey Story page.</small>
                    <div class="mt-2">
                        <button type="submit" class="btn btn-sm btn-dark">Mark as "Not applicable"</button>
                    </div>
                </form>
            </details>
        }
    </div>
</div>
