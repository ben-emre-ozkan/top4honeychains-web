@using TOP4HoneyChains.Web.Models.Entities
@using TOP4HoneyChains.Web.Models.ViewModels
@using TOP4HoneyChains.Web.Models.ViewModels.Monitoring
@model ControlSheetViewModel
@{
    // D-88: all CCPs of a lot (CCP 2–3) or a batch (CCP 4–10) on one page; approved in one action, four-eyes per record
    ViewData["Title"] = L["Sheet.Title"];
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var isLot = Model.Kind == "raw";
    var codes = TOP4HoneyChains.Web.Services.OrgModel.ControlSheets.Codes(Model.Ccps.Select(c => c.CCPCode));
    var approvable = Model.Ccps.Where(c => Model.Approvable.Contains(c.CCPId)).ToList();
    var outOfLimit = approvable.SelectMany(c => c.Groups.SelectMany(g => g.Parameters).Where(p => p.IsInRange == false)
        .Select(p => new OutOfLimitItem(p.ParameterId, p.ParameterName, p.MeasuredNumericValue, p.MeasuredTextValue, p.Unit,
            p.Definition != null ? Limits.Describe(p.Definition, new TOP4HoneyChains.Web.Services.HoneyProfile(null, c.HoneyClass)) : Ref.Limit(p.AppliedLimit, k => L[k]), p.LimitVerified))).ToList();
    var isAdmin = User.IsInRole("Administrator");
    var backUrl = isLot ? "/OrgWorkspace/Index" : isAdmin ? $"/FinalHoneyProductions/Details/{Model.Id}" : $"/OrgWorkspace/Batch/{Model.Id}";
    if (isLot && isAdmin) { backUrl = "/Records/Index"; }
    string SingleUrl(int ccpId) => isLot
        ? $"/CCPMonitoring/RawHoneyProductionManageCCP?rawHoneyProductionId={Model.Id}&ccpId={ccpId}"
        : $"/CCPMonitoring/FinalHoneyProductionManageCCP?finalHoneyProductionId={Model.Id}&ccpId={ccpId}";
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid" id="control-sheet" data-kind="@Model.Kind" data-id="@Model.Id">

            <div class="card mb-4 border-0 shadow-sm">
                <div class="card-body app-hero text-white rounded">
                    <p class="app-kicker mb-1 opacity-75">@L["Sheet.Title"] · @Ref.Code(codes)</p>
                    @if (Model.Batch != null)
                    {
                        <h1 class="h3 fw-bold mb-1" id="sheet-record">@Model.Batch.BatchTitle</h1>
                        <div class="opacity-75 small">
                            @Model.Batch.ProductionDate?.ToString("dd.MM.yyyy") · @Model.Batch.TotalAmount?.ToString("0.##") kg · @L["Raw sources: {0}", Model.Batch.RawSourceCount]
                        </div>
                    }
                    else if (Model.Lot != null)
                    {
                        <h1 class="h3 fw-bold mb-1" id="sheet-record">@L["Sheet.Lot", Model.Id]</h1>
                        <div class="opacity-75 small">
                            @Ref.Text("HoneyType", "Title", Model.Lot.HoneyType)
                            @if (Model.Lot.ApiaryName != null) { <text> · @Model.Lot.ApiaryName</text> }
                            · @Model.Lot.ProductionDate?.ToString("dd.MM.yyyy") · @Model.Lot.Amount?.ToString("0.##") kg
                        </div>
                    }
                    <p class="mb-0 mt-2 small opacity-75">@L["Sheet.Help"]</p>
                </div>
            </div>

            @if (Model.Errors.Any())
            {
                <div class="alert alert-danger" id="sheet-errors" role="alert">
                    <strong>@L["Sheet.NothingSaved"]</strong>
                    <ul class="mb-0">@foreach (var e in Model.Errors) { <li>@Msg.T(e)</li> }</ul>
                </div>
            }
            @if (Model.LockReason != null)
            {
                <div class="alert alert-warning" id="sheet-locked"><i class="mdi mdi-lock-outline me-1" aria-hidden="true"></i>@Msg.T(Model.LockReason)</div>
            }

            <form asp-action="Sheet" method="post" enctype="multipart/form-data" id="sheet-form" class="field-form">
                <input type="hidden" name="Kind" value="@Model.Kind" />
                <input type="hidden" name="Id" value="@Model.Id" />

                @foreach (var c in Model.Ccps)
                {
                    var editable = ControlSheetViewModel.Editable(c);
                    var na = Model.NotApplicable.TryGetValue(c.CCPId, out var posted) ? posted : (false, (string?)null);
                    <section class="card mb-4 border-0 shadow-sm sheet-ccp" id="ccp-@c.CCPId" data-ccp="@c.CCPCode" aria-labelledby="ccp-title-@c.CCPId">
                        <div class="card-body">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                                <div>
                                    <h2 class="h5 fw-bold mb-1" id="ccp-title-@c.CCPId">@Ref.Code(c.CCPCode) – @Ref.CcpTitle(c.CCPId, c.CCPTitle)</h2>
                                    <div class="small text-muted">@Ref.T("Ccp", c.CCPId, "ProcessingStep", c.ProcessingStep)</div>
                                </div>
                                <div class="text-end">
                                    <partial name="_StatusPill" model="@(new StatusPill(StatusPill.ForAssignment(c.StatusId, c.ApprovedAt != null), c.StatusName != null ? Ref.Status(c.StatusId, c.StatusName) : L["Not assigned"].Value, "ccp-status-" + c.CCPId))" />
                                    <partial name="_RecordStrip" model="@(new RecordStrip(c.EnteredBy, c.EnteredAt, c.ApprovedBy, c.ApprovedAt, c.SelfApproved))" />
                                </div>
                            </div>

                            @if (c.StatusId == AssignmentStatusIds.NotApplicable)
                            {
                                <div class="mt-3 p-3 rounded bg-light border sheet-na">
                                    <strong>@L["Not applicable."]</strong> @L["Reason:"] @c.NotApplicableReason
                                    <div class="small text-muted">@L["Recorded by {0} on {1}", c.NotApplicableBy ?? "", c.NotApplicableAt?.ToString("dd.MM.yyyy HH:mm") ?? ""]</div>
                                </div>
                            }
                            else if (!c.CanEnter && c.LockReason == null)
                            {
                                <div class="alert alert-info mt-3 mb-0 sheet-read-only"><i class="mdi mdi-eye-outline me-1" aria-hidden="true"></i>@L["Ccp.ReadOnly"]: @Msg.T(c.EnterDeniedReason)</div>
                            }

                            @if (editable)
                            {
                                <input type="hidden" name="Ccps.Index" value="@c.CCPId" />
                                <input type="hidden" name="Ccps[@c.CCPId].CCPId" value="@c.CCPId" />
                                @if (!c.HasValues)
                                {
                                    <details class="mt-3 sheet-na-choice" open="@na.Item1">
                                        <summary class="text-primary" style="cursor:pointer">@L["This CCP does not apply here (mark as \"Not applicable\")"]</summary>
                                        <div class="form-check mt-2">
                                            <input class="form-check-input" type="checkbox" name="Ccps[@c.CCPId].NotApplicable" value="true" id="na-@c.CCPId" checked="@na.Item1" />
                                            <label class="form-check-label" for="na-@c.CCPId">@L["Mark as \"Not applicable\""]</label>
                                        </div>
                                        <label for="na-reason-@c.CCPId" class="form-label mt-2">@L["Reason"]</label>
                                        <textarea id="na-reason-@c.CCPId" name="Ccps[@c.CCPId].NotApplicableReason" class="form-control" rows="2" maxlength="500"
                                                  placeholder="@L["e.g. Raw honey is not heated or pasteurized"]">@na.Item2</textarea>
                                    </details>
                                }
                            }

                            @if (c.StatusId != AssignmentStatusIds.NotApplicable)
                            {
                                var vd = new ViewDataDictionary<CcpMonitoringViewModelBase>(ViewData, c);
                                vd.TemplateInfo.HtmlFieldPrefix = $"Ccps[{c.CCPId}]";
                                <div class="mt-3">
                                    @await Html.PartialAsync("_CcpParameters", c, vd)
                                </div>
                            }
                            <a href="@SingleUrl(c.CCPId)" class="small sheet-single"><i class="mdi mdi-open-in-new me-1" aria-hidden="true"></i>@L["Sheet.OpenSingle"]</a>
                        </div>
                    </section>
                }

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                    <a href="@backUrl" class="btn btn-link app-back"><i class="mdi mdi-arrow-left me-1" aria-hidden="true"></i>@L["Back"]</a>
                    @if (Model.CanEnterAny)
                    {
                        <button type="submit" class="btn btn-success px-5 shadow" id="sheet-save"><i class="mdi mdi-content-save-outline me-1" aria-hidden="true"></i>@L["Sheet.Save"]</button>
                    }
                </div>
            </form>

            @if (approvable.Any() || Model.NotApprovable.Any())
            {
                <section class="card mb-4 border-0 shadow-sm" id="sheet-approval" aria-labelledby="sheet-approval-title">
                    <div class="card-body">
                        <h2 class="h5 fw-bold" id="sheet-approval-title">@L["Sheet.ApproveTitle"]</h2>
                        @if (approvable.Any())
                        {
                            <p class="small text-muted mb-2">@L["Sheet.ApproveHelp"]</p>
                            <p class="mb-1">@L["Sheet.WillApprove"]</p>
                            <ul id="sheet-approvable">@foreach (var c in approvable) { <li data-ccp="@c.CCPCode">@Ref.Code(c.CCPCode) – @Ref.CcpTitle(c.CCPId, c.CCPTitle)</li> }</ul>
                        }
                        @if (Model.NotApprovable.Any())
                        {
                            <p class="mb-1">@L["Sheet.CannotApprove"]</p>
                            <ul class="text-muted" id="sheet-not-approvable">@foreach (var r in Model.NotApprovable) { <li>@Msg.T(r)</li> }</ul>
                        }
                        @if (approvable.Any())
                        {
                            <form asp-action="ApproveSheet" method="post" id="sheet-approve-form">
                                <input type="hidden" name="kind" value="@Model.Kind" />
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="confirmOutOfLimit" value="false" />
                                <button type="submit" class="btn btn-success" id="sheet-approve-button"><i class="mdi mdi-check-decagram me-1" aria-hidden="true"></i>@L["Sheet.Approve"]</button>
                            </form>
                            <partial name="_OutOfLimitConfirm" model="@(new OutOfLimitConfirm("sheet-approve-form", "sheet-approve-button", outOfLimit))" />
                        }
                    </div>
                </section>
            }
        </div>
    </div>
</body>
