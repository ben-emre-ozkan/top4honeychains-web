@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>

@{
    ViewData["Title"] = L["Role Management"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

@section AddToHead {

    <link href="~/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" />

    <link href="~/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" />

}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-12">

                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title">@L["Roles"]</h4>

                            <p class="card-title-desc">

                                <button class="btn btn-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#createRoleModal">

                                    <i class="mdi mdi-plus"></i>
                                    @L["Add Role"]

                                </button>

                            </p>

                            <table id="datatable-buttons"
                                   class="table table-striped table-bordered dt-responsive nowrap"
                                   style="width:100%;">

                                <thead>

                                    <tr>

                                        <th>@L["Role Name"]</th>
                                        <th width="200">@L["Actions"]</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var role in Model)
                                    {
                                        <tr>

                                            <td>

                                                <span class="badge bg-primary fs-6">
                                                    @L[role.Name ?? ""]
                                                </span>

                                            </td>

                                            <td>

                                                <div class="d-flex gap-2">

                                                    <button class="btn btn-sm btn-info"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#editRoleModal"
                                                            data-id="@role.Id"
                                                            data-name="@role.Name">

                                                        @L["Edit"]

                                                    </button>

                                                    <button class="btn btn-sm btn-danger"
                                                            onclick="deleteRole('@role.Id')">

                                                        @L["Delete"]

                                                    </button>

                                                </div>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>


    <div id="createRoleModal" class="modal fade">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <form asp-action="Create" method="post">

                    <div class="modal-header">

                        <h5 class="modal-title">@L["Create Role"]</h5>

                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>

                    </div>

                    <div class="modal-body">

                        <div class="mb-3">

                            <label class="form-label">@L["Role Name"]</label>

                            <input type="text"
                                   name="roleName"
                                   class="form-control"
                                   required>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">

                            @L["Cancel"]

                        </button>

                        <button type="submit"
                                class="btn btn-primary">

                            @L["Create"]

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <div id="editRoleModal" class="modal fade">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <form asp-action="Edit" method="post">

                    <div class="modal-header">

                        <h5 class="modal-title">@L["Edit Role"]</h5>

                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>

                    </div>

                    <div class="modal-body">

                        <input type="hidden" name="id" id="editRoleId" />

                        <div class="mb-3">

                            <label class="form-label">@L["Role Name"]</label>

                            <input type="text"
                                   name="roleName"
                                   id="editRoleName"
                                   class="form-control"
                                   required>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">

                            @L["Cancel"]

                        </button>

                        <button type="submit"
                                class="btn btn-primary">

                            @L["Update"]

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>


    @* Deletes are POSTs with an anti-forgery token (no state change via GET) *@
    <form id="deleteRoleForm" asp-controller="RoleManagement" asp-action="Delete" method="post" class="d-none">
        <input type="hidden" name="id" />
    </form>

    @section scripts{

        <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
        <script src="~/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>

        <script src="~/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
        <script src="~/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>

        <script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>

        <script src="~/assets/js/pages/datatables.init.js"></script>

        <script src="~/assets/js/app.js"></script>

    }

    <script>

        var editModal = document.getElementById('editRoleModal')

        editModal.addEventListener('show.bs.modal', function (event) {

        var button = event.relatedTarget

        var id = button.getAttribute('data-id')
        var name = button.getAttribute('data-name')

        document.getElementById('editRoleId').value = id
        document.getElementById('editRoleName').value = name

        })

    </script>

    <script>

        function deleteRole(id){

        Swal.fire({

        title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Delete role?"].Value)),
        text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["This action cannot be undone"].Value)),
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Yes, delete"].Value)), cancelButtonText: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Cancel"].Value))

        }).then((result)=>{

        if(result.isConfirmed){

        var f = document.getElementById('deleteRoleForm'); f.elements['id'].value = id; f.submit();

        }

        })

        }

    </script>


</body>