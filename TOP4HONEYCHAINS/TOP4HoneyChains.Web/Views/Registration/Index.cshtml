@model List<TOP4HoneyChains.Web.Models.Entities.BeekeeperRegistration>
@using TOP4HoneyChains.Web.Models.Entities
@{
    ViewData["Title"] = L["Reg78.Title"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var registrar = (TOP4HoneyChains.Web.Services.OrgModel.Registrar)ViewBag.Registrar;
    string StatusBadge(string s) => s switch { EvidenceStatus.Accepted => "bg-success", EvidenceStatus.Rejected => "bg-danger", _ => "bg-warning text-dark" };
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-1">@L["Reg78.Title"]</h4>
                    <p class="card-title-desc">@L["Reg78.Help"] <strong>@registrar.OrgName</strong></p>

                    @if (ViewBag.CanRegister == true)
                    {
                        <form asp-action="Find" method="post" class="row g-2 align-items-end mb-4" id="registration-find">
                            <div class="col-sm-6 col-md-4">
                                <label class="form-label" for="number">@L["Reg78.FindLabel"]</label>
                                <input class="form-control" id="number" name="number" placeholder="TR061234567890" autocomplete="off" required />
                            </div>
                            <div class="col-auto"><button type="submit" class="btn btn-primary"><i class="mdi mdi-account-search-outline"></i> @L["Reg78.Find"]</button></div>
                            <div class="col-12 form-text">@L["Reg78.FindHelp"]@if (Demo.Enabled) {<text> </text><span id="registry-demo-help">@L["Demo.RegistryHelp"]</span>}</div>
                        </form>
                    }

                    <div class="table-responsive">
                        <table class="table table-sm table-hover" id="registrations">
                            <thead class="table-light">
                                <tr>
                                    <th>@L["Reg78.Date"]</th><th>@L["Reg78.Beekeeper"]</th><th>@L["Reg78.RegistryNumber"]</th><th>@L["Reg78.Kind"]</th>
                                    <th>@L["Reg78.Method"]</th><th>@L["Reg78.Evidence"]</th>
                                    @if (registrar.IsPlatformAdmin)
                                    {
                                        <th>@L["Organization"]</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model)
                                {
                                    <tr>
                                        <td class="text-nowrap"><a href="/Registration/Details/@r.RegistrationId">@r.At.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</a></td>
                                        <td>@r.Beekeeper?.BeekeeperFirstName @r.Beekeeper?.BeekeeperLastName <small class="text-muted">@r.Beekeeper?.BeekeeperBusinessNumber</small></td>
                                        <td>@r.RegistryNumber</td>
                                        <td>@L["Reg78.Kind." + r.Kind]</td>
                                        <td>@L["Reg78.Method." + r.Method]</td>
                                        <td><span class="badge @StatusBadge(r.EvidenceStatus)">@L["Reg78.Evidence." + r.EvidenceStatus]</span></td>
                                        @if (registrar.IsPlatformAdmin)
                                        {
                                            <td>@r.RegisteringOrg?.DisplayName</td>
                                        }
                                    </tr>
                                }
                                @if (Model.Count == 0)
                                {
                                    <tr><td colspan="7" class="text-muted">@L["Reg78.None"]</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
