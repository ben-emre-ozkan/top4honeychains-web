@using TOP4HoneyChains.Web.Models.Entities
@{
    ViewData["Title"] = L["Lab.Samples"];
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var sent = ViewBag.Sent as List<Sample> ?? new();
    var received = ViewBag.Received as List<Sample> ?? new();
    var canReceive = ViewBag.CanReceive == true;
    var compositeReady = ViewBag.CompositeReady as List<int> ?? new();
    string StatusText(Sample s) => s.Status switch { "Sent" => L["Lab.StatusSent"], "Received" => L["Lab.StatusReceived"], "Rejected" => L["Lab.StatusRejected"], _ => s.Status };
    string ReportText(Sample s) => s.Report == null ? "–" : s.Report.Status switch { "Draft" => L["Org.Draft"], "Submitted" => L["Cust.Pending"], "Approved" => L["Ccp.Approved"], _ => s.Report.Status };
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    @if (TempData.Peek("Scene") != null)
                    {
                        <partial name="_SceneNow" />
                    }
                    else if (ViewBag.IsAdmin != true)
                    {
                        @* the first visit: a laboratory sees the reception check, a plant the jars travelling to the lab *@
                        <honey-scene name="@(canReceive ? "reception" : "send")" trigger="first" class="hs-compact" />
                    }
                    <h4 class="card-title">@(ViewBag.IsAdmin == true ? L["Lab.AllSamples"] : L["Lab.SentSamples"])</h4>
                    <div class="table-responsive"><table class="table table-sm table-bordered" id="sent-samples">
                        <thead><tr><th>@L["Lab.Sample"]</th><th>@L["Cust.Lot"]</th><th>@L["Lab.Laboratory"]</th><th>@L["Lab.SealNumber"]</th><th>@L["Lab.CounterSample"]</th><th>@L["Org.Status"]</th><th>@L["Lab.Report"]</th></tr></thead>
                        <tbody>
                            @foreach (var s in sent)
                            {
                                <tr data-sample-id="@s.SampleId">
                                    <td>@s.SampleCode <partial name="_SampleKind" model="s" /></td>
                                    <td><a href="/Flow/Lot/@s.RawHoneyProductionId" class="flow-link">#@s.RawHoneyProductionId</a> @Ref.T("HoneyType", s.RawHoneyProduction?.RawHoneyProductionHoneyTypeNavigation?.HoneyTypeId, "Title", s.RawHoneyProduction?.RawHoneyProductionHoneyTypeNavigation?.HoneyTypeTitle)</td>
                                    <td>@s.LabOrg?.DisplayName</td>
                                    <td>@s.SealNumber</td>
                                    <td>@s.CounterSealNumber · @s.CounterLocation · @s.RetainUntil.ToString("dd.MM.yyyy")</td>
                                    <td class="sample-status"><partial name="_StatusPill" model="@(new TOP4HoneyChains.Web.Models.ViewModels.StatusPill(TOP4HoneyChains.Web.Models.ViewModels.StatusPill.ForSample(s.Status), StatusText(s)))" /> <partial name="_ReceptionChecks" model="s" /> @s.RejectReason</td>
                                    <td><a asp-controller="LabReports" asp-action="Edit" asp-route-id="@s.SampleId">@ReportText(s)</a></td>
                                </tr>
                            }
                            @if (!sent.Any())
                            {
                                <tr><td colspan="7" class="text-muted">@L["Org.None"]</td></tr>
                            }
                        </tbody>
                    </table></div>
                </div>
            </div>

            @if (ViewBag.IsAdmin != true && compositeReady.Any())
            {
                <div class="card" id="composite-ready">
                    <div class="card-body">
                        <h4 class="card-title">@L["Lab.CompositeTitle"]</h4>
                        <p class="card-title-desc">@L["Lab.CompositeHelp"]</p>
                        @foreach (var lotId in compositeReady)
                        {
                            <form asp-action="Composite" method="post" class="d-inline-block me-2 mb-2 composite-form">
                                <input type="hidden" name="lotId" value="@lotId" />
                                <button type="submit" class="btn btn-sm btn-primary">@L["Lab.MakeComposite"] · #@lotId</button>
                            </form>
                        }
                    </div>
                </div>
            }
            @if (ViewBag.IsAdmin != true)
            {
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">@L["Lab.ReceivedSamples"]</h4>
                        <p class="card-title-desc">@L["Lab.ReceivedHelp"]</p>
                        @if (canReceive)
                        {
                            @* D-97: what the three reception checks look at and what a failed check means *@
                            <link rel="stylesheet" href="~/css/intake-cards.css" asp-append-version="true" />
                            <aside class="ci-info" id="reception-info">
                                <i class="mdi mdi-lightbulb-on-outline ci-info-icon" aria-hidden="true"></i>
                                <div><strong>@L["Lab.Info.Reception.Title"]</strong><p>@L["Lab.Info.Reception"]</p></div>
                            </aside>
                        }
                        <div class="table-responsive"><table class="table table-sm table-bordered" id="lab-samples">
                            <thead><tr><th>@L["Lab.Sample"]</th><th>@L["Cust.From"]</th><th>@L["Lab.SealNumber"]</th><th>@L["Org.Status"]</th><th>@L["Lab.Report"]</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var s in received)
                                {
                                    <tr data-sample-id="@s.SampleId">
                                        <td>@s.SampleCode <partial name="_SampleKind" model="s" /></td>
                                        <td>@s.TakingOrg?.DisplayName <a href="/Flow/Lot/@s.RawHoneyProductionId" class="small flow-link">@L["Flow.Title"]</a></td>
                                        <td>@s.SealNumber</td>
                                        <td class="sample-status"><partial name="_StatusPill" model="@(new TOP4HoneyChains.Web.Models.ViewModels.StatusPill(TOP4HoneyChains.Web.Models.ViewModels.StatusPill.ForSample(s.Status), StatusText(s)))" /> <partial name="_ReceptionChecks" model="s" /> @s.RejectReason</td>
                                        <td><a asp-controller="LabReports" asp-action="Edit" asp-route-id="@s.SampleId" class="report-link">@ReportText(s)</a></td>
                                        <td>
                                            @if (s.Status == SampleStatus.Sent && canReceive && s.Kind == SampleKind.Container)
                                            {
                                                <form asp-action="Receive" method="post" class="receive-jar-form small">
                                                    <input type="hidden" name="id" value="@s.SampleId" />
                                                    @foreach (var (field, label) in new[] { ("sealMatches", L["Lab.CheckSeal"].Value), ("labelIntact", L["Lab.CheckLabel"].Value), ("capIntact", L[s.CapType != null ? "Lab.CheckCap." + s.CapType : "Lab.CheckCap"].Value) })
                                                    {
                                                        <div class="d-flex align-items-center gap-2 mb-1">
                                                            <span class="flex-grow-1">@label</span>
                                                            <label class="text-nowrap"><input type="radio" name="@field" value="true" required /> @L["Yes"]</label>
                                                            <label class="text-nowrap"><input type="radio" name="@field" value="false" /> @L["No"]</label>
                                                        </div>
                                                    }
                                                    <input name="note" class="form-control form-control-sm mb-1" maxlength="500" placeholder="@L["Lab.RejectReason"]" />
                                                    <button type="submit" class="btn btn-sm btn-success ib"><partial name="_ActionIcon" model="@("flask")" /> @L["Lab.RecordReception"]</button>
                                                </form>
                                            }
                                            else if (s.Status == SampleStatus.Sent && canReceive)
                                            {
                                                <form asp-action="Receive" method="post" class="d-flex gap-1 receive-form">
                                                    <input type="hidden" name="id" value="@s.SampleId" />
                                                    <input name="note" class="form-control form-control-sm" maxlength="500" placeholder="@L["Lab.BrokenReason"]" />
                                                    <button type="submit" name="sealIntact" value="true" class="btn btn-sm btn-success ib"><partial name="_ActionIcon" model="@("flask")" /> @L["Lab.ReceiveIntact"]</button>
                                                    <button type="submit" name="sealIntact" value="false" class="btn btn-sm btn-outline-danger">@L["Lab.ReceiveBroken"]</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (!received.Any())
                                {
                                    <tr><td colspan="6" class="text-muted">@L["Org.None"]</td></tr>
                                }
                            </tbody>
                        </table></div>
                    </div>
                </div>
            }
            <a asp-controller="OrgWorkspace" asp-action="Index" class="btn btn-link app-back"><i class="mdi mdi-arrow-left" aria-hidden="true"></i> @L["Org.Back"]</a>
        </div>
    </div>
</body>
