@using TOP4HoneyChains.Web.Models.Entities
@{
    ViewData["Title"] = L["Lab.TakeSample"];
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var lot = (RawHoneyProduction)ViewBag.Lot;
    var labs = ViewBag.Labs as List<Organization> ?? new();
    var existing = ViewBag.Existing as List<Sample> ?? new();
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">@L["Lab.TakeSample"]: @L["Cust.Lot"] #@lot.RawHoneyProductionId</h4>
                    <p class="card-title-desc">@L["Lab.TakeSampleHelp"]</p>
                    @if (existing.Any())
                    {
                        <div class="alert alert-light border" id="existing-samples">
                            @foreach (var s in existing) { <div>@s.SampleCode · @s.LabOrg?.DisplayName · @L[s.Status ?? ""]</div> }
                        </div>
                    }
                    <form asp-action="Create" method="post" id="sample-form" class="field-form">
                        <input type="hidden" name="lotId" value="@lot.RawHoneyProductionId" />
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label required" for="labOrgId">@L["Lab.Laboratory"]</label>
                                <select name="labOrgId" id="labOrgId" class="form-select">
                                    @foreach (var o in labs)
                                    {
                                        var cap = o.Capabilities.FirstOrDefault(c => c.Capability == Capabilities.Laboratory);
                                        <option value="@o.OrgId">@o.DisplayName @(cap?.IsAccredited == true ? "· ✓ " + cap.AccreditationNumber : "")</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label required" for="sealNumber">@L["Lab.SealNumber"]</label>
                                <input name="sealNumber" id="sealNumber" class="form-control" maxlength="50" autocapitalize="characters" autocomplete="off" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label required" for="counterSealNumber">@L["Lab.CounterSealNumber"]</label>
                                <input name="counterSealNumber" id="counterSealNumber" class="form-control" maxlength="50" autocapitalize="characters" autocomplete="off" />
                            </div>
                            <div class="col-md-8 mb-3">
                                <label class="form-label required" for="counterLocation">@L["Lab.CounterLocation"]</label>
                                <input name="counterLocation" id="counterLocation" class="form-control" maxlength="200" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label required" for="retainUntil">@L["Lab.RetainUntil"]</label>
                                <input type="date" name="retainUntil" id="retainUntil" class="form-control" value="@DateTime.Today.AddMonths(12).ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success ib ib-jar"><partial name="_ActionIcon" model="@("jar")" /> @L["Lab.SendSample"]</button>
                        <a asp-action="Index" class="btn btn-secondary">@L["Lab.Later"]</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
