@using TOP4HoneyChains.Web.Models.Entities
@using TOP4HoneyChains.Web.Services
@model LabReport?
@{
    ViewData["Title"] = L["Lab.Report"];
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var sample = (Sample)ViewBag.Sample;
    var parameters = ViewBag.Parameters as List<CriticalControlPointParameter> ?? new();
    var enterDenied = ViewBag.EnterDenied as string;
    var approveDenied = ViewBag.ApproveDenied as string;
    var ccp0Pending = ViewBag.Ccp0Pending as string;
    var editable = enterDenied == null && (Model == null || Model.Status == LabReportStatus.Draft);
    LabResult? ResultOf(int id) => Model?.Results.FirstOrDefault(r => r.ParameterId == id);
    string StatusText(string s) => s switch { "Draft" => L["Org.Draft"], "Submitted" => L["Lab.Submitted"], "Approved" => L["Ccp.Approved"], _ => s };
    // D-67: limits for the lot's honey, in the selected language; values as text once the report cannot be edited
    var honeyType = sample.RawHoneyProduction?.RawHoneyProductionHoneyTypeNavigation;
    var honey = new HoneyProfile(honeyType?.HoneyTypeId, honeyType?.HoneyClass);
    string ValueText(LabResult? r) => r == null ? "–" : r.MeasuredNumericValue?.ToString("0.####", System.Globalization.CultureInfo.CurrentCulture)
        ?? (r.MeasuredTextValue is "Yes" or "No" ? L[r.MeasuredTextValue].Value : r.MeasuredTextValue) ?? "–";
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">@L["Lab.Report"]: @sample.SampleCode</h4>
                    <div class="small text-muted mb-2">
                        @L["Cust.Lot"] #@sample.RawHoneyProductionId · @Ref.T("HoneyType", sample.RawHoneyProduction?.RawHoneyProductionHoneyTypeNavigation?.HoneyTypeId, "Title", sample.RawHoneyProduction?.RawHoneyProductionHoneyTypeNavigation?.HoneyTypeTitle) ·
                        @L["Lab.Laboratory"]: @sample.LabOrg?.DisplayName · @L["Lab.SealNumber"]: @sample.SealNumber ·
                        @L["Sample status"]: <strong id="sample-status">@L[sample.Status ?? ""]</strong>
                        @if (Model != null)
                        {
                            <text>· @L["Report status"]:</text> <partial name="_StatusPill" model="@(new TOP4HoneyChains.Web.Models.ViewModels.StatusPill(TOP4HoneyChains.Web.Models.ViewModels.StatusPill.ForReport(Model.Status, Model.ReturnReason != null), StatusText(Model.Status)))" />
                        }
                    </div>
                    <h6 class="mt-3">@L["Lab.Custody"]</h6>
                    <ul class="small" id="custody-events">
                        @foreach (var e in sample.Events.OrderBy(e => e.EventId))
                        {
                            <li>@e.At.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @L[e.Event ?? ""] @(e.SealIntact == true ? "· " + L["Lab.SealIntact"].Value : e.SealIntact == false ? "· " + L["Lab.SealBroken"].Value : "") @e.Note</li>
                        }
                    </ul>
                </div>
            </div>

            <div class="card" id="lab-report">
                <div class="card-body">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <h5 class="card-title">@L["Lab.Results"]</h5>
                        @if (Model != null)
                        {
                            <div>
                                <partial name="_StatusPill" model="@(new TOP4HoneyChains.Web.Models.ViewModels.StatusPill(TOP4HoneyChains.Web.Models.ViewModels.StatusPill.ForReport(Model.Status, Model.ReturnReason != null), StatusText(Model.Status), "report-status", Fresh: TempData["JustApproved"] as bool? == true))" />
                                <span class="small text-muted ms-2">@L["Lab.ReportCode"]: <strong id="report-code">@Model.ReportCode</strong></span>
                                <button type="button" class="btn btn-outline-secondary btn-sm ms-2 no-print" onclick="window.print()"><i class="mdi mdi-printer" aria-hidden="true"></i>@L["Cust.Print"]</button>
                            </div>
                        }
                    </div>
                    @if (Model != null)
                    {
                        <partial name="_RecordStrip" model="@(new TOP4HoneyChains.Web.Models.ViewModels.RecordStrip(Model.EnteredByUserId, Model.SubmittedAt ?? Model.CreatedAt, Model.Status == LabReportStatus.Approved ? Model.ApprovedByUserId : null, Model.ApprovedAt, IdsNotNames: true, TimesAreUtc: true))" />
                    }
                    @if (ViewBag.SetsLotValues == false)
                    {
                        <div class="alert alert-info small" id="jar-report-only">@L["Lab.JarReportOnly"]</div>
                    }
                    @if (Model?.ReturnReason != null)
                    {
                        <div class="alert alert-warning" id="return-reason">@L["Lab.Returned"]: @Model.ReturnReason</div>
                    }
                    @if (!editable && enterDenied != null && (Model == null || Model.Status == LabReportStatus.Draft))
                    {
                        <div class="alert alert-secondary" id="enter-denied">@L["Ccp.ReadOnly"]: @Msg.T(enterDenied)</div>
                    }

                    @if (!editable)
                    {
                        @* D-67: once the report cannot be edited, its fields and values are text, not input boxes *@
                        <dl class="app-facts" id="report-readonly">
                            <div><dt>@L["Lab.ReportNumber"]</dt><dd>@(Model?.ReportNumber ?? "–")</dd></div>
                            <div><dt>@L["Lab.IssuedOn"]</dt><dd>@(Model?.IssuedOn?.ToString("dd.MM.yyyy") ?? "–")</dd></div>
                            <div><dt>@L["Lab.ReportPdf"]</dt><dd>@if (Model?.Sha256 != null) { <partial name="_ReportFile" model="@((sample.SampleId, Model))" /> } else { <text>–</text> }</dd></div>
                        </dl>
                        <div class="table-responsive"><table class="table table-sm" id="report-values">
                            <thead><tr><th>@L["Corr.Parameter"]</th><th class="num">@L["Cust.Value"]</th><th>@L["Cust.Limit"]</th></tr></thead>
                            <tbody>
                                @foreach (var p in parameters)
                                {
                                    var r = ResultOf(p.ParameterId);
                                    var unit = Limits.UnitSymbol(p);
                                    <tr data-parameter-id="@p.ParameterId">
                                        <td>@Limits.Name(p.ParameterId, p.ParameterName)</td>
                                        <td class="num">@ValueText(r)@(r?.MeasuredNumericValue != null && unit.Length > 0 ? " " + unit : "")</td>
                                        <td class="small">
                                            @Limits.Describe(p, honey)
                                            @if (r?.IsInRange == false) { <span class="st-pill st-outlimit"><i class="mdi mdi-alert-outline" aria-hidden="true"></i><span>@L["Out of limit"]</span></span> }
                                            @if (r?.IsInRange == true) { <span class="st-pill st-inlimit"><i class="mdi mdi-check" aria-hidden="true"></i><span>@L["Within limit"]</span></span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                    }
                    else
                    {
                    <form asp-action="Save" asp-route-id="@sample.SampleId" method="post" enctype="multipart/form-data" id="report-form" class="field-form" data-loader="upload">
                        <fieldset>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label" for="reportNumber">@L["Lab.ReportNumber"]</label>
                                    <input name="reportNumber" id="reportNumber" class="form-control" maxlength="50" value="@Model?.ReportNumber" />
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label" for="issuedOn">@L["Lab.IssuedOn"]</label>
                                    <input type="date" name="issuedOn" id="issuedOn" class="form-control" value="@Model?.IssuedOn?.ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="col-md-5 mb-3">
                                    <label class="form-label" for="reportFile">@L["Lab.ReportPdf"]</label>
                                    @* D-67: a styled, localised file picker over the native input (kept for keyboard and screen readers) *@
                                    <div class="app-file">
                                        <input type="file" name="reportFile" id="reportFile" class="app-file-input" accept=".pdf" />
                                        <label for="reportFile" class="btn btn-outline-secondary app-file-btn"><i class="mdi mdi-paperclip" aria-hidden="true"></i>@L["Choose PDF"]</label>
                                        <span class="app-file-name" data-empty="@L["No file chosen"]" aria-live="polite">@L["No file chosen"]</span>
                                    </div>
                                    @if (Model?.Sha256 != null)
                                    {
                                        <partial name="_ReportFile" model="@((sample.SampleId, Model))" />
                                    }
                                </div>
                            </div>
                            <div class="table-responsive"><table class="table table-sm">
                                <thead><tr><th>@L["Corr.Parameter"]</th><th>@L["Cust.Value"]</th><th>@L["Cust.Limit"]</th></tr></thead>
                                <tbody>
                                    @foreach (var p in parameters)
                                    {
                                        var r = ResultOf(p.ParameterId);
                                        <tr data-parameter-id="@p.ParameterId">
                                            <td><label for="value-@p.ParameterId" class="mb-0 fw-normal">@Limits.Label(p)</label> @if (p.IsRequired) { <span class="text-danger" title="@L["Required"]">*</span> }</td>
                                            <td style="max-width:180px">
                                                <input name="values[@p.ParameterId]" id="value-@p.ParameterId" class="form-control form-control-sm" maxlength="100"
                                                       value="@(r?.MeasuredNumericValue?.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) ?? r?.MeasuredTextValue)" />
                                            </td>
                                            <td class="small">
                                                @Limits.Describe(p, honey)
                                                @if (r?.IsInRange == false) { <span class="st-pill st-outlimit"><i class="mdi mdi-alert-outline" aria-hidden="true"></i><span>@L["Out of limit"]</span></span> }
                                                @if (r?.IsInRange == true) { <span class="st-pill st-inlimit"><i class="mdi mdi-check" aria-hidden="true"></i><span>@L["Within limit"]</span></span> }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table></div>
                            @if (editable)
                            {
                                <button type="submit" class="btn btn-success">@L["Org.Save"]</button>
                            }
                        </fieldset>
                    </form>
                    }

                    @{
                        // D-54: progress of the required values; submitting waits until all are entered
                        var required = parameters.Where(p => p.IsRequired).ToList();
                        var missing = TOP4HoneyChains.Web.Services.OrgModel.LabService.MissingRequired(Model, required);
                    }
                    @if (required.Count > 0)
                    {
                        <div class="mt-2 small" id="required-progress" data-entered="@(required.Count - missing.Count)" data-required="@required.Count">
                            <strong>@L["Required values entered: {0} of {1}", required.Count - missing.Count, required.Count]</strong>
                            @if (missing.Count > 0)
                            {
                                <span class="text-danger" id="required-missing"> · @L["Missing:"] @string.Join(", ", missing.Select(p => Ref.T("Parameter", p.ParameterId, "Name", p.ParameterName)))</span>
                            }
                        </div>
                    }
                    @if (editable && Model != null)
                    {
                        <form asp-action="Submit" asp-route-id="@sample.SampleId" method="post" class="mt-2" data-loader="report">
                            <button type="submit" class="btn btn-primary" id="submit-report" disabled="@(missing.Count > 0)"
                                    title="@(missing.Count > 0 ? L["Submitting is possible once every required value is entered."].Value : "")">@L["Lab.Submit"]</button>
                        </form>
                    }
                    @if (Model?.Status == LabReportStatus.Submitted)
                    {
                        <div class="mt-3" id="approval">
                            @if (approveDenied == null)
                            {
                                <form asp-action="Decide" asp-route-id="@sample.SampleId" method="post" id="decide-form">
                                    <input type="hidden" name="confirmOutOfLimit" value="false" />
                                    <textarea name="reason" id="return-reason" class="form-control mb-2" rows="3" maxlength="500" placeholder="@L["Lab.ReturnReason"]"></textarea>
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <button type="submit" name="approve" value="true" class="btn btn-success" id="approve-report" disabled="@(ccp0Pending != null)">@L["Ccp.Approve"]</button>
                                        <button type="submit" name="approve" value="false" class="btn btn-outline-warning">@L["Lab.Return"]</button>
                                        <small class="text-muted approve-note" id="approve-note">@L["Lab.ApproveNote"]</small>
                                    </div>
                                </form>
                                    // D-64: the values outside their limits, confirmed in-page before approving
                                    var outOfLimit = Model!.Results.Where(r => r.IsInRange == false)
                                        .Select(r => (Result: r, Parameter: parameters.FirstOrDefault(p => p.ParameterId == r.ParameterId)))
                                        .Select(x => new TOP4HoneyChains.Web.Models.ViewModels.OutOfLimitItem(x.Result.ParameterId, x.Parameter?.ParameterName, x.Result.MeasuredNumericValue,
                                            x.Result.MeasuredTextValue, x.Parameter?.ParameterUnit, x.Parameter != null ? Limits.Describe(x.Parameter, honey) : x.Result.AppliedLimit, x.Parameter?.LimitVerified == true))
                                        .ToList();
                                <partial name="_OutOfLimitConfirm" model="@(new TOP4HoneyChains.Web.Models.ViewModels.OutOfLimitConfirm("decide-form", "approve-report", outOfLimit))" />
                                @if (ccp0Pending != null)
                                {
                                    <div class="small text-warning mt-1" id="ccp0-pending">@Msg.T(ccp0Pending)</div>
                                }
                                <div class="small text-muted mt-1">@L["Lab.NoExemption"]</div>
                            }
                            else
                            {
                                <div class="small text-muted">@Msg.T(approveDenied)</div>
                            }
                        </div>
                    }
                    @if (Model?.Status == LabReportStatus.Approved)
                    {
                        <div class="alert alert-success mt-3" id="approved-info">
                            @L["Ccp.Approved"] · @Model.ApprovedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            @if (Model.IsAccredited) { <span class="badge bg-success ms-1">@L["Org.Accredited"] @Model.AccreditationNumber</span> }
                            @if (Model.InHouse) { <span class="badge bg-warning text-dark ms-1">@L["Hs.InHouseLab"]</span> }
                            · <a class="app-tap" href="/verify-report?code=@Model.ReportCode" target="_blank">@L["Lab.VerifyPage"]</a>
                        </div>
                    }
                    <partial name="_ContainerValues" />
                </div>
            </div>
            <a asp-controller="Samples" asp-action="Index" class="btn btn-link app-back"><i class="mdi mdi-arrow-left" aria-hidden="true"></i> @L["Org.Back"]</a>
        </div>
    </div>
</body>
