@model TOP4HoneyChains.Web.Models.Entities.CriticalControlPoint

@{
    ViewData["Title"] = "Create Critical Control Point";
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title">Create New Critical Control Point</h4>
                            <p class="card-title-desc">
                                Define a new CCP to monitor quality and safety in the honey production process.
                            </p>

                            <form asp-action="Create" class="custom-validation">

                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                <!-- Processing Step -->
                                <div class="mb-3">
                                    <label asp-for="ProcessingStep" class="form-label required">
                                        Processing Step
                                    </label>

                                    <input asp-for="ProcessingStep"
                                           class="form-control"
                                           placeholder="Enter processing step (e.g., Mixing, Filtering)" />

                                    <span asp-validation-for="ProcessingStep" class="text-danger"></span>
                                </div>

                                <!-- Code -->
                                <div class="mb-3">
                                    <label asp-for="Code" class="form-label required">
                                        CCP Code
                                    </label>

                                    <input asp-for="Code"
                                           class="form-control"
                                           placeholder="Enter CCP Code (e.g., CCP1, CCP2)" />

                                    <span asp-validation-for="Code" class="text-danger"></span>
                                </div>

                                <!-- Applies to (D-17) -->
                                <div class="mb-3">
                                    <label asp-for="AppliesTo" class="form-label required">
                                        Applies to
                                    </label>

                                    <select asp-for="AppliesTo" class="form-select">
                                        <option value="">-- Select --</option>
                                        <option value="RawLot">Raw honey lot</option>
                                        <option value="Batch">Final batch</option>
                                    </select>
                                    <small class="text-muted">Only lots or batches of this kind are offered this CCP.</small>

                                    <span asp-validation-for="AppliesTo" class="text-danger"></span>
                                </div>

                                <!-- Public text values (D-20) -->
                                <div class="mb-3 form-check">
                                    <input asp-for="PublicTextValues" class="form-check-input" />
                                    <label asp-for="PublicTextValues" class="form-check-label">Show free-text values on the public Honey Story page</label>
                                    <div><small class="text-muted">Leave off when answers may contain personal data or locations (e.g. a field audit at the beekeeper). Yes/No and numbers are always shown; files never.</small></div>
                                </div>

                                <!-- Title -->
                                <div class="mb-3">
                                    <label asp-for="Title" class="form-label">
                                        Title
                                    </label>

                                    <input asp-for="Title"
                                           class="form-control"
                                           placeholder="Enter title" />

                                    <span asp-validation-for="Title" class="text-danger"></span>
                                </div>

                                <!-- Criticality Justification -->
                                <div class="mb-3">
                                    <label asp-for="CriticalityJustification" class="form-label">
                                        Criticality Justification
                                    </label>

                                    <textarea asp-for="CriticalityJustification"
                                              class="form-control"
                                              rows="4"
                                              placeholder="Explain why this step is critical..."></textarea>

                                    <span asp-validation-for="CriticalityJustification" class="text-danger"></span>
                                </div>

                                <!-- Buttons -->
                                <div class="d-flex gap-2">

                                    <button type="submit"
                                            class="btn btn-primary waves-effect waves-light">
                                        Save
                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-secondary waves-effect">
                                        Back to List
                                    </a>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/libs/parsleyjs/parsley.min.js"></script>
        <script src="~/assets/js/pages/form-validation.init.js"></script>
        <script src="~/assets/js/app.js"></script>
    }
</body>