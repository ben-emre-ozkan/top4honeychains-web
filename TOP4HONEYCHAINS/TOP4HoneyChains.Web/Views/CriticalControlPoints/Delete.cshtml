@model TOP4HoneyChains.Web.Models.Entities.CriticalControlPoint

@{
    ViewData["Title"] = L["Delete Critical Control Point"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card border-danger">
                        <div class="card-body">

                            <h4 class="card-title text-danger">
                                @L["Delete Critical Control Point"]
                            </h4>

                            <p class="card-title-desc">
                                <strong>@L["Warning:"]</strong> @L["This action cannot be undone. Please confirm before deleting."]
                            </p>

                            <div class="alert alert-danger">
                                @L["Are you sure you want to delete this CCP?"]
                            </div>

                            <dl class="row">

                                <dt class="col-sm-3">@L["Processing Step"]</dt>
                                <dd class="col-sm-9">@Ref.T("Ccp", Model.Id, "ProcessingStep", Model.ProcessingStep)</dd>

                                <dt class="col-sm-3">@L["Code"]</dt>
                                <dd class="col-sm-9">
                                    <span class="badge bg-info">
                                        @Model.Code
                                    </span>
                                </dd>

                                <dt class="col-sm-3">@L["Title"]</dt>
                                <dd class="col-sm-9">@Ref.CcpTitle(Model.Id, Model.Title)</dd>

                                <dt class="col-sm-3">@L["Criticality Justification"]</dt>
                                <dd class="col-sm-9">
                                    @Ref.T("Ccp", Model.Id, "CriticalityJustification", Model.CriticalityJustification)
                                </dd>

                            </dl>

                            <form asp-action="Delete">

                                <input type="hidden" asp-for="Id" />

                                <div class="d-flex gap-2">

                                    <button type="submit"
                                            class="btn btn-danger waves-effect waves-light">
                                        @L["Delete"]
                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-secondary waves-effect">
                                        @L["Back to List"]
                                    </a>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/js/app.js"></script>
    }
</body>