@model List<TOP4HoneyChains.Web.Controllers.RegistryRow>
@{
    ViewData["Title"] = L["Beekeeper registry"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">@L["Reg.Title"]</h4>
                    <p class="card-title-desc">
                        @L["Beekeepers are records, not users: they never log in, and their association records data for them. The national registry (AKS) number is verified manually for now (document + approval)."]
                    </p>
                    <div class="table-responsive"><table class="table table-sm table-bordered" id="registry-table">
                        <thead><tr><th>@L["Reg.BusinessNo"]</th><th>@L["Reg.Beekeeper"]</th><th>@L["Reg.RegistryNo"]</th><th>@L["Org.Status"]</th><th>@L["Reg.Association"]</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                <tr>
                                    <td>@r.BusinessNumber</td>
                                    <td>@r.Name</td>
                                    <td>@r.RegistryNumber</td>
                                    <td>@L[r.Status ?? ""]</td>
                                    <td>@r.Association</td>
                                    <td><a asp-action="Edit" asp-route-id="@r.BeekeeperId" class="btn btn-sm btn-primary">@L["Org.Open"]</a></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                </div>
            </div>
        </div>
    </div>
</body>
