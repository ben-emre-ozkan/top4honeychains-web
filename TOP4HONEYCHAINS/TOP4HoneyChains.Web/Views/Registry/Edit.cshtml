@using TOP4HoneyChains.Web.Models.Entities
@{
    ViewData["Title"] = "Beekeeper registry";
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var b = (Beekeeper)ViewBag.Beekeeper;
    var registry = ViewBag.Registry as BeekeeperRegistry;
    var requests = ViewBag.Requests as List<RegistryVerification> ?? new();
    var link = ViewBag.Link as BeekeeperAssociation;
    var associations = ViewBag.Associations as List<Organization> ?? new();
}

<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">@b.BeekeeperFirstName @b.BeekeeperLastName <small class="text-muted">@b.BeekeeperBusinessNumber</small></h4>
                    <div>Registry number: <strong id="registry-number">@(registry?.RegistryNumber ?? "-")</strong> · Status: <strong id="registry-status">@(registry?.Status ?? RegistryStatus.Unverified)</strong></div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Association</h5>
                            <p class="small text-muted">The association records data on behalf of the beekeeper. Changes keep the history.</p>
                            <form asp-action="SetAssociation" asp-route-id="@b.BeekeeperId" method="post" class="row g-2">
                                <div class="col-md-8">
                                    <select name="associationOrgId" class="form-select" id="association">
                                        <option value="">(none)</option>
                                        @foreach (var a in associations)
                                        {
                                            <option value="@a.OrgId" selected="@(link?.AssociationOrgId == a.OrgId)">@a.DisplayName (@a.Status)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4"><button type="submit" class="btn btn-primary w-100">Save</button></div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Registry verification (@ViewBag.Method)</h5>
                            <form asp-action="Submit" asp-route-id="@b.BeekeeperId" method="post" enctype="multipart/form-data" class="row g-2" id="registry-submit">
                                <div class="col-md-5"><input name="enterpriseNumber" class="form-control" placeholder="TR + 2 + 10 digits" maxlength="16" /></div>
                                <div class="col-md-5"><input type="file" name="proof" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.webp" /></div>
                                <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Submit</button></div>
                                <small class="text-muted">Format TR, a province code 01-81 and 10 digits. A proof document (registry printout or photo) is required.</small>
                            </form>

                            <table class="table table-sm mt-3" id="registry-requests">
                                <thead><tr><th>#</th><th>Number</th><th>Status</th><th>Proof</th><th>Decision</th></tr></thead>
                                <tbody>
                                    @foreach (var r in requests)
                                    {
                                        <tr>
                                            <td>@r.Id</td>
                                            <td>@r.EnterpriseNumber</td>
                                            <td>@r.Status @(r.Reason != null ? "(" + r.Reason + ")" : "")</td>
                                            <td>@if (r.StoredFileName != null) { <a asp-action="Proof" asp-route-id="@r.Id" target="_blank">file</a> }</td>
                                            <td>
                                                @if (r.Status == RegistryStatus.Pending)
                                                {
                                                    <form asp-action="Decide" method="post" class="d-flex gap-1">
                                                        <input type="hidden" name="requestId" value="@r.Id" />
                                                        <input name="reason" class="form-control form-control-sm" placeholder="reason (to reject)" maxlength="500" />
                                                        <button type="submit" name="approve" value="true" class="btn btn-sm btn-success">Verify</button>
                                                        <button type="submit" name="approve" value="false" class="btn btn-sm btn-outline-danger">Reject</button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    @r.DecidedAt?.ToString("dd.MM.yyyy HH:mm")
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </div>
</body>
