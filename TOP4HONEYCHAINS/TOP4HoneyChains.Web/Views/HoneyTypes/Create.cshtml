@model TOP4HoneyChains.Web.Models.Entities.HoneyType

@{
    ViewData["Title"] = L["Create Honey Type"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title">@L["Create New Honey Type"]</h4>
                            <p class="card-title-desc">
                                @L["Add a new honey type and its description."]
                            </p>

                            <form asp-action="Create" class="custom-validation">

                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                <!-- Honey Type Title -->
                                <div class="mb-3">
                                    <label asp-for="HoneyTypeTitle"
                                           class="form-label required">
                                        @L["Honey Type Title"]
                                    </label>

                                    <input asp-for="HoneyTypeTitle"
                                           class="form-control"
                                           placeholder="@L["Enter honey type title"]" />

                                    <span asp-validation-for="HoneyTypeTitle"
                                          class="text-danger"></span>
                                </div>

                                <!-- Description -->
                                <div class="mb-3">
                                    <label asp-for="HoneyTypeDescription"
                                           class="form-label">
                                        @L["Description"]
                                    </label>

                                    <textarea asp-for="HoneyTypeDescription"
                                              class="form-control"
                                              rows="4"
                                              placeholder="@L["Enter description for this honey type"]">
                                    </textarea>

                                    <span asp-validation-for="HoneyTypeDescription"
                                          class="text-danger"></span>
                                </div>

                                <!-- Honey class (D-18) -->
                                <div class="mb-3">
                                    <label asp-for="HoneyClass" class="form-label">@L["Honey class for CCP limits"]</label>
                                    <select asp-for="HoneyClass" class="form-select">
                                        <option value="">@L["(unknown: only limits for every honey class apply)"]</option>
                                        <option value="Floral">@L["Floral (blossom)"]</option>
                                        <option value="Honeydew">@L["Honeydew"]</option>
                                        <option value="Pine">@L["Pine (honeydew)"]</option>
                                    </select>
                                    <span asp-validation-for="HoneyClass" class="text-danger"></span>
                                </div>

                                <!-- Buttons -->
                                <div class="d-flex gap-2">

                                    <button type="submit"
                                            class="btn btn-primary waves-effect waves-light">
                                        @L["Save"]
                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-secondary waves-effect">
                                        @L["Back to List"]
                                    </a>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/libs/parsleyjs/parsley.min.js"></script>
        <script src="~/assets/js/pages/form-validation.init.js"></script>
        <script src="~/assets/js/app.js"></script>
    }

</body>
