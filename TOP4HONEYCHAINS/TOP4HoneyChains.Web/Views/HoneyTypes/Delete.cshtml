@model TOP4HoneyChains.Web.Models.Entities.HoneyType

@{
    ViewData["Title"] = "Delete Honey Type";
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-8 col-lg-10">

                    <div class="card border-danger">
                        <div class="card-body">

                            <h4 class="card-title text-danger">
                                Confirm Deletion
                            </h4>

                            <p class="card-title-desc text-muted">
                                Are you sure you want to delete this honey type?
                                This action cannot be undone.
                            </p>

                            <hr />

                            <!-- Honey Type Title -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    @Html.DisplayNameFor(model => model.HoneyTypeTitle)
                                </label>

                                <div class="form-control bg-light">
                                    @Html.DisplayFor(model => model.HoneyTypeTitle)
                                </div>
                            </div>

                            <!-- Description -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    @Html.DisplayNameFor(model => model.HoneyTypeDescription)
                                </label>

                                <div class="form-control bg-light" style="min-height:80px;">
                                    @if (!string.IsNullOrEmpty(Model.HoneyTypeDescription))
                                    {
                                        @Model.HoneyTypeDescription
                                    }
                                    else
                                    {
                                        <span class="text-muted">No description</span>
                                    }
                                </div>
                            </div>

                            <form asp-action="Delete">

                                <input type="hidden" asp-for="HoneyTypeId" />

                                <div class="d-flex gap-2">

                                    <button type="submit"
                                            class="btn btn-danger waves-effect waves-light">
                                        Delete
                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-secondary waves-effect">
                                        Cancel
                                    </a>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/js/app.js"></script>
    }

</body>
