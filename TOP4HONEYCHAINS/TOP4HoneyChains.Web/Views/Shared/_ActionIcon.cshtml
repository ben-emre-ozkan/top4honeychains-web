@model string
@* D-78 P4 (D-83): the icon of a key action, drawn like the scenes (2 px ink, round ends, honey). Decorative: the button keeps its text.
   jar = take sample (its cap button presses down while the button is pressed), truck = record delivery, seal = apply seal,
   flask = lab reception, box = ship. *@
@switch (Model)
{
    case "jar":
        <svg class="ib-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="5" y="9" width="14" height="13" rx="3.5" fill="#FFD25A" stroke="currentColor" stroke-width="1.8"/><rect x="4" y="5.5" width="16" height="4" rx="1.4" fill="#FFFBF0" stroke="currentColor" stroke-width="1.8"/><circle class="ib-capbtn" cx="12" cy="3.6" r="1.7" fill="#FFB547" stroke="currentColor" stroke-width="1.3"/></svg>
        break;
    case "truck":
        <svg class="ib-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="1.8" y="6" width="13" height="10" rx="1.5" fill="#FFFBF0" stroke="currentColor" stroke-width="1.8"/><path d="M14.8 9.5H18.5L21.8 13.2V16H14.8Z" fill="#FFE7AE" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="6.5" cy="17.5" r="2" fill="currentColor"/><circle cx="17.5" cy="17.5" r="2" fill="currentColor"/></svg>
        break;
    case "seal":
        <svg class="ib-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 8H15L20 12L15 16H4Z" fill="#FFB547" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="15" cy="12" r="1.5" fill="#FFFBF0" stroke="currentColor" stroke-width="1.2"/><path d="M7 11H11M7 13.5H10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        break;
    case "flask":
        <svg class="ib-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14 3V9L19.5 18.5C20.3 20 19.3 21 17.8 21H6.2C4.7 21 3.7 20 4.5 18.5L10 9V3" fill="#FFFBF0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M8.5 3H15.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M6.5 16.5H17.5" stroke="#FFB547" stroke-width="2.4" stroke-linecap="round"/></svg>
        break;
    case "box":
        <svg class="ib-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="7" width="18" height="13" rx="1.6" fill="#FFFBF0" stroke="currentColor" stroke-width="1.8"/><path d="M3 11H21M12 7V20" stroke="currentColor" stroke-width="1.5"/><rect x="9.5" y="8.5" width="5" height="4.5" rx="1" fill="#FFB547" stroke="currentColor" stroke-width="1.2"/></svg>
        break;
}
