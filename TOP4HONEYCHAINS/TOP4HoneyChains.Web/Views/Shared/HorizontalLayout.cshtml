<!doctype html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>

    @Html.Partial("~/Views/Shared/_meta.cshtml")

    @if (IsSectionDefined("AddToHead"))
    {
        @RenderSection("AddToHead", required: false)
    }

    @Html.Partial("~/Views/Shared/_HeadCSS.cshtml")
    <link rel="preload" href="~/fonts/bricolage-grotesque/bricolage-grotesque-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="~/fonts/instrument-sans/instrument-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>

</head>

<body class="app-skin">

    <a class="app-skip" href="#app-main">@L["Land.SkipToContent"]</a>
    <!-- Begin page -->
    <div id="layout-wrapper">

        @Html.Partial("~/Views/Shared/_horizontal.cshtml")
        <!-- ============================================================== -->
        <!-- Start right Content here -->
        <!-- ============================================================== -->
        <div class="main-content" id="app-main" tabindex="-1">

            <partial name="~/Views/Shared/_FlashMessages.cshtml" />

            @* D-67: shown only on paper (lab report, recall report) *@
            <div class="print-head" aria-hidden="true">
                <span class="print-head-brand">
                    <svg width="22" height="22" viewBox="0 0 30 30"><polygon points="15,2 26,8.5 26,21.5 15,28 4,21.5 4,8.5" fill="#FFB547"></polygon><polygon points="15,8 20.2,11 20.2,17 15,20 9.8,17 9.8,11" fill="#FFFFFF"></polygon></svg>
                    TOP4HoneyChains
                </span>
                <span class="print-head-meta">@ViewData["Title"]<br>@L["Printed on {0}", DateTime.Now.ToString("dd.MM.yyyy HH:mm")]</span>
            </div>

            @RenderBody()

            @Html.Partial("~/Views/Shared/_Footer.cshtml")
        </div>
        <!-- end main content-->

    </div>
    <!-- END layout-wrapper -->


    <!-- Right bar overlay-->
    <div class="rightbar-overlay"></div>

    <!-- JAVASCRIPT -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/metismenu/metisMenu.min.js"></script>
    <script src="~/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="~/assets/libs/node-waves/waves.min.js"></script>
    <script src="~/assets/libs/jquery-sparkline/jquery.sparkline.min.js"></script>

    <partial name="~/Views/Shared/_FieldSupport.cshtml" />
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />

    <script src="~/js/app-shell.js" asp-append-version="true"></script>
    @RenderSection("scripts", required: false)
    <partial name="~/Views/Shared/_I18nScripts.cshtml" />
</body>

</html>