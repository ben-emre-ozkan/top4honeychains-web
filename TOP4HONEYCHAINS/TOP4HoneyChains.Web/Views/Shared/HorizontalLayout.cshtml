<!doctype html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>

    @Html.Partial("~/Views/Shared/_meta.cshtml")

    @if (IsSectionDefined("AddToHead"))
    {
        @RenderSection("AddToHead", required: false)
    }

    @Html.Partial("~/Views/Shared/_HeadCSS.cshtml")

</head>

<body>

    <!-- Begin page -->
    <div id="layout-wrapper">

        @Html.Partial("~/Views/Shared/_horizontal.cshtml")
        <!-- ============================================================== -->
        <!-- Start right Content here -->
        <!-- ============================================================== -->
        <div class="main-content">

            <partial name="~/Views/Shared/_FlashMessages.cshtml" />

            @RenderBody()

            @Html.Partial("~/Views/Shared/_Footer.cshtml")
        </div>
        <!-- end main content-->

    </div>
    <!-- END layout-wrapper -->


    <!-- Right bar overlay-->
    <div class="rightbar-overlay"></div>

    <!-- JAVASCRIPT -->
    <script src="~/assets/libs/jquery/jquery.min.js"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/metismenu/metisMenu.min.js"></script>
    <script src="~/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="~/assets/libs/node-waves/waves.min.js"></script>
    <script src="~/assets/libs/jquery-sparkline/jquery.sparkline.min.js"></script>

    <partial name="~/Views/Shared/_FieldSupport.cshtml" />

    @RenderSection("scripts", required: false)
    <partial name="~/Views/Shared/_I18nScripts.cshtml" />
</body>

</html>