@inject TOP4HoneyChains.Web.Services.OrgModel.Permissions MenuPermissions
@inject Microsoft.Extensions.Options.IOptions<TOP4HoneyChains.Web.Services.OrgModel.FeatureFlags> FeatureFlagOptions
@inject TOP4HoneyChains.Web.Services.OrgModel.ICurrentOrg MenuCurrentOrg
@using System.Globalization
@* App shell top bar (D-66): sticky, translucent; brand, role chip, language and account in one row, the menu below.
   Styles: wwwroot/css/app-skin.css (driven by brand.css). The template's classes (topnav, dropdowns, collapse) stay. *@
@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    // Return to the same page including its query string (e.g. ?wholesalerId=), otherwise
    // pages that need a query parameter return 404 after switching language (FB-34)
    var languageReturnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var languages = new[] { ("en", "English", "us_flag.jpg"), ("tr", "Türkçe", "turkey_flag.jpg"), ("es", "Español", "argentina_flag.jpg"), ("pl", "Polski", "poland_flag.jpg"), ("lv", "Latviešu", "latvia_flag.jpg") };
    var (_, lang, flag) = languages.FirstOrDefault(l => l.Item1 == culture, languages[0]);

    // With Features:OrgRoleModel, organization members (no Administrator role) get their own menu
    var orgModelOn = FeatureFlagOptions.Value.OrgRoleModel;
    var isPanelAdmin = User.IsInRole("Administrator");
    var memberMenu = orgModelOn && !isPanelAdmin;
    var menuActive = memberMenu ? await MenuCurrentOrg.GetAsync() : null;
    var memberships = memberMenu ? await MenuCurrentOrg.GetMembershipsAsync() : new List<TOP4HoneyChains.Web.Services.OrgModel.MembershipOption>();

    // the menu entry of the current page gets the honey indicator (ViewBag.Controller, else the route)
    var current = new[] { ViewBag.Controller as string, ViewContext.RouteData.Values["controller"]?.ToString() }.Where(c => !string.IsNullOrEmpty(c)).ToArray();
    var groups = memberMenu
        ? new Dictionary<string, string[]>
        {
            ["work"] = new[] { "MyWork", "CCPMonitoring" }, ["org"] = new[] { "OrgWorkspace", "Organizations" }, ["intake"] = new[] { "Intake" },
            ["samples"] = new[] { "Samples", "LabReports" }, ["shipments"] = new[] { "Shipments" }, ["storefronts"] = new[] { "Storefronts" }
        }
        : new Dictionary<string, string[]>
        {
            ["dashboard"] = new[] { "Dashboard" }, ["beekeepers"] = new[] { "Beekeepers", "Apiaries", "BeekeeperEducationLevels", "BeekeepingPurposeTypes", "BeekeepingTypes", "Registry" },
            ["raw"] = new[] { "RawHoneyProductions", "HoneyTypes", "RawHoneyProductionPeriods" }, ["wholesalers"] = new[] { "Wholesalers" },
            ["final"] = new[] { "FinalHoneyProductions", "Flow" },
            ["ccp"] = new[] { "CriticalControlPoints", "CriticalControlPointParameterCategories", "CriticalControlPointParameters", "CriticalControlPointParameterContents", "ReferenceTranslations", "CCPMonitoring" },
            ["users"] = new[] { "UserManagement", "RoleManagement", "Audit" },
            ["orgs"] = new[] { "MyWork", "Organizations", "Capabilities", "Permissions", "CcpResponsibilities", "Shipments", "Samples", "LabReports", "Storefronts", "OrgWorkspace", "Intake" }
        };
    string Cur(string group) => groups.TryGetValue(group, out var c) && current.Any(x => c.Contains(x, StringComparer.OrdinalIgnoreCase)) ? "is-current" : "";
    string? Aria(string group) => Cur(group).Length > 0 ? "page" : null;

    // D-67: breadcrumb from the localised menu section and the page title (no controller or action names)
    var sectionNames = new Dictionary<string, (string Text, string? Url)>
    {
        ["work"] = (L["Work.Title"].Value, "/MyWork/Index"), ["org"] = (L["Org.MyOrganization"].Value, "/OrgWorkspace/Index"),
        ["intake"] = (L["Cust.Intakes"].Value, "/Intake/Index"), ["samples"] = (L["Lab.Samples"].Value, "/Samples/Index"),
        ["shipments"] = (L["Cust.Shipments"].Value, "/Shipments/Index"), ["storefronts"] = (L["P5.Storefronts"].Value, "/Storefronts/Index"),
        ["dashboard"] = (L["Menu.Dashboard"].Value, "/Dashboard/Index"), ["beekeepers"] = (L["Menu.Beekeepers"].Value, null),
        ["raw"] = (L["Menu.RawHoneyProduction"].Value, null), ["wholesalers"] = (L["Menu.Wholesalers"].Value, "/Wholesalers/Index"),
        ["final"] = (L["Menu.FinalHoneyProductions"].Value, "/FinalHoneyProductions/Index"), ["ccp"] = (L["Menu.CriticalControlPoints"].Value, null),
        ["users"] = (L["Menu.UserManagement"].Value, null), ["orgs"] = (L["Org.Organizations"].Value, null)
    };
    var crumbSection = groups.Keys.Where(g => Cur(g).Length > 0).Select(g => sectionNames.TryGetValue(g, out var n) ? n : default).FirstOrDefault();
    var pageTitle = (ViewData["Title"] ?? ViewBag.Title)?.ToString();
    var homeUrl = memberMenu ? "/MyWork/Index" : isPanelAdmin && !orgModelOn ? "/Dashboard/Index" : orgModelOn ? "/MyWork/Index" : "/Dashboard/Index";

    // My work badge (wwwroot/js/app-shell.js): counts per user and active membership
    var workScope = $"{MenuCurrentOrg.UserId}:{(isPanelAdmin ? "admin" : menuActive?.MembershipId.ToString() ?? "none")}";
    var userName = User.Identity?.Name ?? "";
}

<header id="page-topbar" class="app-top">
    <div class="navbar-header app-top-row">
        <div class="app-top-left">
            <button type="button" class="btn app-icon-btn d-lg-none" data-bs-toggle="collapse" data-bs-target="#topnav-menu-content"
                    aria-controls="topnav-menu-content" aria-expanded="false" aria-label="@L["Menu"]">
                <i class="mdi mdi-menu" aria-hidden="true"></i>
            </button>
            <a href="/" class="app-brand" aria-label="TOP4HoneyChains">
                <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><polygon points="15,2 26,8.5 26,21.5 15,28 4,21.5 4,8.5" fill="#FFB547"></polygon><polygon points="15,8 20.2,11 20.2,17 15,20 9.8,17 9.8,11" fill="#FFFFFF"></polygon></svg>
                <partial name="_Wordmark" />
            </a>
        </div>

        <div class="app-top-right">
            @if (menuActive != null)
            {
                <partial name="_RoleChip" model="@(new TOP4HoneyChains.Web.Models.ViewModels.RoleChipModel(menuActive, memberships))" />
            }

            <div class="dropdown d-none d-md-inline-block">
                <button type="button" class="btn app-icon-btn app-lang-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@L["Language"]: @lang">
                    <img src="~/assets/images/flags/@flag" alt="" width="21" height="14">
                    <span class="d-none d-xl-inline">@lang</span>
                    <span class="mdi mdi-chevron-down" aria-hidden="true"></span>
                </button>
                <div class="dropdown-menu dropdown-menu-end">
                    @foreach (var (code, name, file) in languages)
                    {
                        <a asp-controller="Home" asp-action="SetLanguage" asp-route-culture="@code" asp-route-returnUrl="@languageReturnUrl"
                           class="dropdown-item @(code == culture ? "active" : "")" lang="@code" hreflang="@code">
                            <img src="~/assets/images/flags/@file" alt="" class="me-2" width="18" height="12">@name
                        </a>
                    }
                </div>
            </div>

            <button type="button" class="btn app-icon-btn d-none d-lg-inline-flex" data-toggle="fullscreen" aria-label="@L["Full screen"]">
                <i class="mdi mdi-fullscreen" aria-hidden="true"></i>
            </button>

            <div class="dropdown d-inline-block">
                <button type="button" class="btn app-icon-btn app-user-btn" id="page-header-user-dropdown"
                        data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="@L["Header Avatar"]: @userName">
                    <span class="app-avatar" aria-hidden="true">@(userName.Length > 0 ? userName.Substring(0, 1).ToUpperInvariant() : "?")</span>
                </button>
                <div class="dropdown-menu dropdown-menu-end">
                    <div class="dropdown-header app-user-name">@userName</div>
                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                        <i class="mdi mdi-account-circle me-2" aria-hidden="true"></i>@L["Menu.Profile"]
                    </a>
                    <a class="dropdown-item" asp-controller="Account" asp-action="LockScreen">
                        <i class="mdi mdi-lock-open-outline me-2" aria-hidden="true"></i>@L["Menu.LockScreen"]
                    </a>
                    <div class="dropdown-divider"></div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item text-danger">
                            <i class="mdi mdi-power me-2" aria-hidden="true"></i>@L["Menu.Logout"]
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="top-navigation app-menu-row">
        <div class="container-fluid">
            <div class="topnav">
                <nav class="navbar navbar-light navbar-expand-lg topnav-menu" aria-label="@L["Menu"]">
                    <div class="collapse navbar-collapse" id="topnav-menu-content">
                        @if (memberMenu)
                        {
                            // D-44: members see only the entries their capabilities and role allow
                        <ul class="navbar-nav" id="member-menu">
                            <li class="nav-item"><a class="nav-link @Cur("work")" aria-current="@Aria("work")" href="/MyWork/Index" data-work-link data-work-scope="@workScope"><i class="mdi mdi-clipboard-check-outline" aria-hidden="true"></i>@L["Work.Title"]<span class="work-badge" data-work-badge hidden></span></a></li>
                            <li class="nav-item"><a class="nav-link @Cur("org")" aria-current="@Aria("org")" href="/OrgWorkspace/Index"><i class="mdi mdi-domain" aria-hidden="true"></i>@L["Org.MyOrganization"]</a></li>
                            @if (menuActive != null && TOP4HoneyChains.Web.Services.OrgModel.MemberMenu.Intake(menuActive, MenuPermissions))
                            {
                                <li class="nav-item"><a class="nav-link @Cur("intake")" aria-current="@Aria("intake")" href="/Intake/Index"><i class="mdi mdi-truck-delivery-outline" aria-hidden="true"></i>@L["Cust.Intakes"]</a></li>
                            }
                            @if (menuActive != null && TOP4HoneyChains.Web.Services.OrgModel.MemberMenu.Samples(menuActive, MenuPermissions))
                            {
                                <li class="nav-item"><a class="nav-link @Cur("samples")" aria-current="@Aria("samples")" href="/Samples/Index"><i class="mdi mdi-flask-outline" aria-hidden="true"></i>@L["Lab.Samples"]</a></li>
                            }
                            @if (menuActive != null && TOP4HoneyChains.Web.Services.OrgModel.MemberMenu.Shipments(menuActive, MenuPermissions))
                            {
                                <li class="nav-item"><a class="nav-link @Cur("shipments")" aria-current="@Aria("shipments")" href="/Shipments/Index"><i class="mdi mdi-truck-outline" aria-hidden="true"></i>@L["Cust.Shipments"]</a></li>
                            }
                            @if (menuActive != null && TOP4HoneyChains.Web.Services.OrgModel.MemberMenu.Storefronts(menuActive, MenuPermissions))
                            {
                                <li class="nav-item"><a class="nav-link @Cur("storefronts")" aria-current="@Aria("storefronts")" href="/Storefronts/Index"><i class="mdi mdi-storefront-outline" aria-hidden="true"></i>@L["P5.Storefronts"]</a></li>
                            }
                        </ul>
                        }
                        else
                        {
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link @Cur("dashboard")" aria-current="@Aria("dashboard")" href="/Dashboard/Index">
                                    <i class="mdi mdi-view-dashboard" aria-hidden="true"></i>@L["Menu.Dashboard"]
                                </a>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle arrow-none @Cur("beekeepers")" href="#" id="topnav-email" role="button"
                                   data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="mdi mdi-beekeeper" aria-hidden="true"></i>@L["Menu.Beekeepers"]
                                </a>
                                <div class="dropdown-menu dropdown-menu-left" aria-labelledby="topnav-email">
                                    <a href="/Beekeepers/Index" class="dropdown-item">@L["Menu.BeekeepersList"]</a>
                                    <a href="/Apiaries/Index" class="dropdown-item">@L["Menu.Apiaries"]</a>
                                    <a href="/BeekeeperEducationLevels/Index" class="dropdown-item">@L["Menu.EducationLevels"]</a>
                                    <a href="/BeekeepingPurposeTypes/Index" class="dropdown-item">@L["Menu.BeekeepingPurposeTypes"]</a>
                                    <a href="/BeekeepingTypes/Index" class="dropdown-item">@L["Menu.BeekeepingTypes"]</a>
                                </div>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle arrow-none @Cur("raw")" href="#" id="topnav-components" role="button"
                                   data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="mdi mdi-beehive-outline" aria-hidden="true"></i>@L["Menu.RawHoneyProduction"]
                                </a>
                                <div class="dropdown-menu dropdown-menu-left" aria-labelledby="topnav-components">
                                    <a href="/RawHoneyProductions/Index" class="dropdown-item">@L["Menu.RawHoneyProductions"]</a>
                                    <a href="/HoneyTypes/Index" class="dropdown-item">@L["Menu.HoneyTypes"]</a>
                                    <a href="/RawHoneyProductionPeriods/Index" class="dropdown-item">@L["Menu.RawHoneyProductionPeriods"]</a>
                                </div>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle arrow-none @Cur("wholesalers")" href="#" id="topnav-wholesalers" role="button"
                                   data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="mdi mdi-truck-delivery" aria-hidden="true"></i>@L["Menu.Wholesalers"]
                                </a>
                                <div class="dropdown-menu dropdown-menu-left" aria-labelledby="topnav-wholesalers">
                                    <a href="/Wholesalers/Index" class="dropdown-item">@L["Menu.WholesalersList"]</a>
                                    <a href="/Wholesalers/Create" class="dropdown-item">@L["Menu.AddWholesaler"]</a>
                                </div>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle arrow-none @Cur("final")" href="#" id="topnav-finalprod" role="button"
                                   data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="mdi mdi-cog-transfer" aria-hidden="true"></i>@L["Menu.FinalHoneyProductions"]
                                </a>
                                <div class="dropdown-menu dropdown-menu-left" aria-labelledby="topnav-finalprod">
                                    <a href="/FinalHoneyProductions/Index" class="dropdown-item">@L["Menu.FinalHoneyProductions"]</a>
                                </div>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle arrow-none @Cur("ccp")" href="#" id="topnav-ccp" role="button"
                                   data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="mdi mdi-timeline-text-outline" aria-hidden="true"></i>@L["Menu.CriticalControlPoints"]
                                </a>
                                <div class="dropdown-menu dropdown-menu-left" aria-labelledby="topnav-ccp">
                                    <a href="/CriticalControlPoints/Index" class="dropdown-item">@L["Menu.CriticalControlPoints"]</a>
                                    <a href="/CriticalControlPointParameterCategories/Index" class="dropdown-item">@L["Menu.ParameterCategories"]</a>
                                    <a href="/CriticalControlPointParameters/Index" class="dropdown-item">@L["Menu.Parameters"]</a>
                                    <a href="/ReferenceTranslations/Index" class="dropdown-item">@L["Translations of reference data"]</a>
                                </div>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle arrow-none @Cur("users")" href="#" id="topnav-usermanagement" role="button"
                                   data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="mdi mdi-account-cog" aria-hidden="true"></i>@L["Menu.UserManagement"]
                                </a>
                                <div class="dropdown-menu dropdown-menu-left" aria-labelledby="topnav-usermanagement">
                                    <a href="/UserManagement/Index" class="dropdown-item">@L["Menu.Users"]</a>
                                    <a href="/RoleManagement/Index" class="dropdown-item">@L["Menu.Roles"]</a>
                                    <a href="/Audit/Index" class="dropdown-item">@L["Audit.Title"]</a>
                                </div>
                            </li>

                            @if (orgModelOn)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle arrow-none @Cur("orgs")" href="#" id="topnav-orgs" role="button" data-work-glow
                                       data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="mdi mdi-domain" aria-hidden="true"></i>@L["Org.Organizations"]<span class="work-badge" data-work-badge hidden></span>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-left" aria-labelledby="topnav-orgs">
                                        <a href="/MyWork/Index" class="dropdown-item" data-work-link data-work-scope="@workScope">@L["Work.Title"]<span class="work-badge" data-work-badge hidden></span></a>
                                        <a href="/Organizations/Index" class="dropdown-item">@L["Org.Organizations"]</a>
                                        <a href="/Capabilities/Index" class="dropdown-item">@L["Org.Capabilities"]</a>
                                        <a href="/Registry/Index" class="dropdown-item">@L["Reg.Title"]</a>
                                        <a href="/Permissions/Index" class="dropdown-item">@L["Roles and permissions"]</a>
                                        <a href="/CcpResponsibilities/Index" class="dropdown-item">@L["Resp.Title"]</a>
                                        <a href="/CCPMonitoring/Corrections" class="dropdown-item">@L["Corr.Title"]</a>
                                        <a href="/Shipments/Index" class="dropdown-item">@L["Cust.Shipments"]</a>
                                        <a href="/Samples/Index" class="dropdown-item">@L["Lab.Samples"]</a>
                                        <a href="/Storefronts/Index" class="dropdown-item">@L["P5.Storefronts"]</a>
                                        <a href="/OrgWorkspace/Index" class="dropdown-item">@L["Org.MyOrganization"]</a>
                                    </div>
                                </li>
                            }
                        </ul>
                        }
                    </div>
                </nav>
            </div>
        </div>
    </div>
</header>

<div class="app-pagehead">
    <div class="container-fluid">
        <nav aria-label="@L["Breadcrumb"]">
            <ol class="breadcrumb m-0" id="app-breadcrumb">
                <li class="breadcrumb-item"><a href="@homeUrl">TOP4HoneyChains</a></li>
                @if (crumbSection.Text != null && !string.Equals(crumbSection.Text, pageTitle, StringComparison.CurrentCultureIgnoreCase))
                {
                    <li class="breadcrumb-item">@if (crumbSection.Url != null) { <a href="@crumbSection.Url">@crumbSection.Text</a> } else { @crumbSection.Text }</li>
                }
                @if (!string.IsNullOrWhiteSpace(pageTitle))
                {
                    <li class="breadcrumb-item active" aria-current="page">@pageTitle</li>
                }
            </ol>
        </nav>
    </div>
</div>
<div id="work-live" class="visually-hidden" aria-live="polite" aria-atomic="true"
     data-one="@L["Work.NewOne"]" data-many="@L["Work.NewMany"]" data-waiting="@L["Work.WaitingCount"]"></div>
@if (memberMenu || (orgModelOn && isPanelAdmin))
{
    var kindNames = new[] { "Approve", "LabApprove", "Finalize", "Confirm", "Receive", "Results", "Verify", "Registry", "Correction", "Enter" }
        .ToDictionary(k => k, k => L["Work.Kind." + k].Value);
    <script type="application/json" id="work-kinds">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(kindNames))</script>
}
