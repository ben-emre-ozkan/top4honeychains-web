@inject TOP4HoneyChains.Web.Services.UiPreferences Ui
@inject TOP4HoneyChains.Web.Services.OrgModel.ICurrentOrg TourOrg
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery TourTokens
@model bool
@* D-78 P4 (D78-SPEC 7.1): the first-use tour of the active role (js/honey-tour.js). Model: true in the beekeeper portal. *@
@if (User.Identity?.IsAuthenticated == true)
{
    var admin = User.IsInRole("Administrator");
    // D-87: the consumer area sets ViewBag.Consumer on every page
    bool consumer = ViewData["Consumer"] != null;
    var active = Model || admin || consumer ? null : await TourOrg.GetAsync();
    var role = await Ui.TourRoleAsync(Model, consumer);
    if (role != null)
    {
        // D-84: whether this user has seen the role's tour is kept on the server (UserSettings.ToursSeen)
        var seen = await Ui.TourSeenAsync(role);
        var steps = TOP4HoneyChains.Web.Services.UiPreferences.TourFor(active?.OrgRole, admin, Model, consumer)
            .Select(s => new { target = s.Target, text = L[s.TextKey].Value });
        <script type="application/json" id="hs-tour" data-key="@Ui.UserKey:@role" data-seen="@(seen ? "true" : "false")"
                data-url="/Account/TourSeen" data-token="@(seen ? null : TourTokens.GetAndStoreTokens(Context).RequestToken)"
                data-title="@L["Tour.Title"]" data-next="@L["Tour.Next"]" data-back="@L["Tour.Back"]" data-skip="@L["Tour.Skip"]" data-done="@L["Tour.Done"]" data-of="@L["Tour.Of"]">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(steps).Replace("</", "<\\/"))</script>
    }
}
