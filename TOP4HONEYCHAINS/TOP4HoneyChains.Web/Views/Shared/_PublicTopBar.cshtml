@model string
@* Top bar of the public pages (beekeeper page, Honey Story, parameter page): brand, page name, language switch,
   report verification. Styles in wwwroot/css/storefront.css. *@
@{
    var current = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<header class="sf-top">
    <div class="sf-top-in">
        <a href="#top" class="sf-brand">
            <img class="b-logo" src="~/img/brand/top4-mark-small.svg" alt="" width="37" height="32">
            <img class="b-logo sf-brand-word" src="~/img/brand/top4-wordmark-w3.svg" alt="TOP4HoneyChains" width="218" height="16">
            <span class="sf-brand-sub">@Model</span>
        </a>
        <nav class="sf-nav" aria-label="@L["Language"]">
            @foreach (var code in new[] { "tr", "en", "es", "pl", "lv" })
            {
                if (code == current)
                {
                    <span class="sf-lang is-current" lang="@code" aria-current="true">@code.ToUpperInvariant()</span>
                }
                else
                {
                    <a class="sf-lang" href="@Url.Action("SetLanguage", "Home", new { culture = code, returnUrl })" hreflang="@code" lang="@code">@code.ToUpperInvariant()</a>
                }
            }
            <a class="sf-verify-btn" href="/verify-report">@L["Sf.VerifyReport"]</a>
        </nav>
    </div>
</header>
