@* D-78 P3 (D78-SPEC 4.7): the beekeeper portal /Me. Mobile-first, the beekeeper's language, no panel menu. Styles: brand.css + me.css. *@
@using TOP4HoneyChains.Web.Models.Entities
@inject TOP4HoneyChains.Web.Services.UiPreferences Ui
@{
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var section = ViewBag.Section as string ?? "Home";
    var me = ViewBag.Me as Beekeeper;
    var error = TempData["Error"] as string;
    var success = TempData["Success"] as string;
    var sections = new[] { ("Home", "Index", "Me.Nav.Home"), ("Deliveries", "Deliveries", "Me.Nav.Deliveries"), ("Samples", "Samples", "Me.Nav.Samples"),
        ("Batches", "Batches", "Me.Nav.Batches"), ("Stories", "Stories", "Me.Nav.Stories"), ("Apiaries", "Apiaries", "Me.Nav.Apiaries"),
        ("Privacy", "Privacy", "Me.Nav.Privacy"), ("Account", "Account", "Me.Nav.Account") };
}
<!doctype html>
<html lang="@lang" data-user="@Ui.UserKey" data-scenes="@(await Ui.ShowAnimationsAsync() ? "on" : "off")">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title | TOP4HoneyChains</title>
    <meta name="robots" content="noindex">
    <meta name="theme-color" content="#FFFFFF">
    <partial name="~/Views/Shared/_Favicons.cshtml" />
    <link href="~/css/brand.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/me.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/honey-mark.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/honey-scene.css" rel="stylesheet" asp-append-version="true">
</head>
<body class="me">
    <header class="me-top">
        <a class="me-brand b-link" href="/Me" aria-label="TOP4HoneyChains"><img src="~/img/brand/top4-wordmark-w3.svg" alt="TOP4HoneyChains" width="177" height="13"></a>
        <span class="me-who">@me?.BeekeeperFirstName @me?.BeekeeperLastName</span>
        @* D-92: the portal has its own language switch; D-94: one compact select, as narrow as the panel's menu (a button for browsers without JavaScript) *@
        <form class="me-lang" method="get" action="@Url.Action("SetLanguage", "Home")">
            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
            <select name="culture" aria-label="@L["Language"]" data-lang-select>
                @foreach (var (code, name) in new[] { ("tr", "Türkçe"), ("en", "English"), ("es", "Español"), ("pl", "Polski"), ("lv", "Latviešu") })
                {
                    <option value="@code" lang="@code" selected="@(code == lang)">@name</option>
                }
            </select>
            <noscript><button type="submit" class="b-btn b-btn-ghost me-btn-sm">OK</button></noscript>
        </form>
        <form asp-controller="Account" asp-action="Logout" method="post" class="me-out">
            <button type="submit" class="b-btn b-btn-ghost me-btn-sm">@L["Menu.Logout"]</button>
        </form>
    </header>
    <nav class="me-nav" aria-label="@L["Me.Title"]">
        @foreach (var (key, action, label) in sections)
        {
            <a href="/Me/@(action == "Index" ? "" : action)" data-tour="me-@action.ToLowerInvariant()" class="me-tab @(key == section ? "is-current" : "")" @(key == section ? "aria-current=page" : "")>@L[label]</a>
        }
    </nav>
    <main class="me-main" id="main">
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="me-alert me-alert-error" role="alert" id="flash-error">@Msg.T(error)<button type="button" class="me-alert-close" aria-label="@L["Close"]">×</button></div>
        }
        @if (!string.IsNullOrEmpty(success))
        {
            <div class="me-alert me-alert-ok" role="status" id="flash-success">@Msg.T(success)<button type="button" class="me-alert-close" aria-label="@L["Close"]">×</button></div>
        }
        @RenderBody()
    </main>
    <footer class="me-foot">@string.Format(L["Land.Footer.Rights"].Value, DateTime.Now.Year)</footer>
    <script>
        document.querySelectorAll('[data-lang-select]').forEach(function (s) { s.addEventListener('change', function () { s.form.submit(); }); });
        document.querySelectorAll('.me-alert-close').forEach(function (b) { b.addEventListener('click', function () { b.parentElement.remove(); }); });
    </script>
    <script src="~/js/honey-scene.js" asp-append-version="true"></script>
    <partial name="_Tour" model="true" />
    <script src="~/js/honey-tour.js" asp-append-version="true"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
