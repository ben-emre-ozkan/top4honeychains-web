@model TOP4HoneyChains.Web.Models.Entities.ConsumerFeedback
@using TOP4HoneyChains.Web.Models.Entities
@{
    // D-87: one consumer feedback; mark it read, answer it, close it (Consumer feedback Enter)
    ViewData["Title"] = L["Feedback.Title"];
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
    var canAnswer = ViewBag.CanAnswer == true;
}
<body data-topbar="light" data-layout="horizontal">
    <div class="page-content">
        <div class="container-fluid">
            <div class="card" id="feedback-details" data-status="@Model.Status">
                <div class="card-body">
                    <h4 class="card-title">@L["Feedback.Title"] · <code>@Model.Pseudonym</code></h4>
                    <p class="card-title-desc">@L["Feedback.PseudonymOnly"]</p>
                    <dl class="row mb-0">
                        <dt class="col-sm-3">@L["Cust.Batch"]</dt>
                        <dd class="col-sm-9"><a href="/honeystory/@Model.Batch?.FinalHoneyProductionQR" target="_blank" rel="noopener">@Model.Batch?.FinalHoneyProductionTitle</a> · @Model.Org?.DisplayName</dd>
                        <dt class="col-sm-3">@L["Feedback.Category"]</dt>
                        <dd class="col-sm-9">
                            @L["Consumer.Category." + Model.Category]
                            @if (Model.Category == ConsumerFeedbackCategory.SuspectedFake)
                            {
                                <span class="badge bg-danger ms-1">@L["Feedback.SuspectedFakeBadge"]</span>
                            }
                        </dd>
                        <dt class="col-sm-3">@L["Org.Date"]</dt>
                        <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @Model.Language</dd>
                        <dt class="col-sm-3">@L["Org.Status"]</dt>
                        <dd class="col-sm-9" id="feedback-status">@L["Feedback.Status." + Model.Status]</dd>
                    </dl>
                    <h5 class="mt-3">@L["Feedback.Message"]</h5>
                    <p class="border rounded p-3 bg-light feedback-text" id="feedback-message">@Model.Message</p>

                    @if (Model.Answer != null)
                    {
                        <h5>@L["Consumer.Answer"]</h5>
                        <p class="border rounded p-3 feedback-text" id="feedback-answer">@Model.Answer</p>
                        <p class="small text-muted">@Model.AnsweredAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                    }

                    @if (canAnswer && Model.Status != ConsumerFeedbackStatus.Closed)
                    {
                        if (Model.Status == ConsumerFeedbackStatus.New)
                        {
                            <form asp-action="MarkRead" asp-route-id="@Model.FeedbackId" method="post" class="d-inline" id="mark-read-form">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@L["Feedback.MarkRead"]</button>
                            </form>
                        }
                        <form asp-action="Answer" asp-route-id="@Model.FeedbackId" method="post" class="mt-3" id="answer-form">
                            <label for="answer" class="form-label">@L["Feedback.YourAnswer"]</label>
                            <textarea id="answer" name="answer" class="form-control" rows="4" maxlength="1000" required>@Model.Answer</textarea>
                            <div class="form-text">@L["Feedback.AnswerHelp"]</div>
                            <button type="submit" class="btn btn-primary mt-2">@L["Feedback.SendAnswer"]</button>
                        </form>
                        <form asp-action="Close" asp-route-id="@Model.FeedbackId" method="post" class="mt-3" id="close-form">
                            <button type="submit" class="btn btn-outline-secondary">@L["Feedback.Close"]</button>
                        </form>
                    }
                    <p class="mt-3"><a href="/ConsumerFeedback">@L["Feedback.BackToList"]</a></p>
                </div>
            </div>
        </div>
    </div>
</body>
