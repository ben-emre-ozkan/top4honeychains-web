@model TOP4HoneyChains.Web.Models.Entities.CriticalControlPointParameterCategory

@{
    ViewData["Title"] = L["Delete CCP Parameter Category"].Value;
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card border-danger">
                        <div class="card-body">

                            <h4 class="card-title text-danger">
                                @L["Delete CCP Parameter Category"]
                            </h4>

                            <p class="card-title-desc">
                                <strong>@L["Warning:"]</strong> @L["This action cannot be undone."]
                            </p>

                            <div class="alert alert-danger">
                                @L["Are you sure you want to delete this category?"]
                            </div>

                            <dl class="row">

                                <dt class="col-sm-3">@L["Category Name"]</dt>
                                <dd class="col-sm-9">
                                    <strong>@Ref.T("ParameterCategory", Model.CategoryId, "Name", Model.CategoryName)</strong>
                                </dd>

                                <dt class="col-sm-3">@L["Description"]</dt>
                                <dd class="col-sm-9">
                                    @Ref.T("ParameterCategory", Model.CategoryId, "Description", Model.CategoryDesc)
                                </dd>

                            </dl>

                            <form asp-action="Delete">

                                <input type="hidden" asp-for="CategoryId" />

                                <div class="d-flex gap-2">

                                    <button type="submit"
                                            class="btn btn-danger waves-effect waves-light">
                                        @L["Delete"]
                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-link app-back"><i class="mdi mdi-arrow-left" aria-hidden="true"></i> @L["Back to list"]</a>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/js/app.js"></script>
    }
</body>