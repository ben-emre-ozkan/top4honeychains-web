@model TOP4HoneyChains.Web.Models.Entities.CriticalControlPointParameterCategory

@{
    ViewData["Title"] = "Delete CCP Parameter Category";
    Layout = "~/Views/Shared/HorizontalLayout.cshtml";
}

<body data-topbar="light" data-layout="horizontal">

    <div class="page-content">
        <div class="container-fluid">

            <div class="row">
                <div class="col-xl-12">

                    <div class="card border-danger">
                        <div class="card-body">

                            <h4 class="card-title text-danger">
                                Delete CCP Parameter Category
                            </h4>

                            <p class="card-title-desc">
                                <strong>Warning:</strong> This action cannot be undone.
                            </p>

                            <div class="alert alert-danger">
                                Are you sure you want to delete this category?
                            </div>

                            <dl class="row">

                                <dt class="col-sm-3">Category Name</dt>
                                <dd class="col-sm-9">
                                    <strong>@Model.CategoryName</strong>
                                </dd>

                                <dt class="col-sm-3">Description</dt>
                                <dd class="col-sm-9">
                                    @Model.CategoryDesc
                                </dd>

                            </dl>

                            <form asp-action="Delete">

                                <input type="hidden" asp-for="CategoryId" />

                                <div class="d-flex gap-2">

                                    <button type="submit"
                                            class="btn btn-danger waves-effect waves-light">
                                        Delete
                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-secondary waves-effect">
                                        Back to List
                                    </a>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    @section scripts{
        <script src="~/assets/js/app.js"></script>
    }
</body>